---
import Layout from "../layouts/Layout.astro";
import VideoCard from "../components/VideoCard.astro";
import CosmeticTile from "../components/CosmeticTile.astro";
import SectionHead from "../components/SectionHead.astro";
import HeroRings from "../components/HeroRings.astro";
import {
  getVisibleVideos,
  getPopularBrands,
  getInfluencerRanking,
  getCosmeticRankingsByTag,
  getTrendingCosmetics,
  RECENT_DAYS,
  getCategoryTop,
  formatJaDate,
  groupTagsByCategory,
  sortByPublishedDesc,
  formatCount,
  withBase,
  categoryUrl,
  getPublishedFeatures,
  getFeature,
  featureCoverImages,
  getCosmeticListEntry,
  productImageSrc,
  getRecentCounts,
  cosmeticSlug,
} from "../lib/data";

const visible = getVisibleVideos();
const latestVideos = sortByPublishedDesc(visible).slice(0, 8);
const updatedAt = sortByPublishedDesc(visible)[0]?.published_at;
const popularBrands = getPopularBrands(16);
const popularInfluencers = getInfluencerRanking().slice(0, 10);
const recent = getRecentCounts();
const trending = getTrendingCosmetics(8);

const byTag = getCosmeticRankingsByTag();
const categoryGroups = groupTagsByCategory(byTag.keys());
// 商品数の多いカテゴリ上位3つの1〜3位を、トップで先に見せる
const featuredTags = Array.from(byTag.entries())
  .sort((a, b) => b[1].length - a[1].length)
  .slice(0, 3)
  .map(([t]) => t);
const featured = featuredTags.map((t) => ({ tag: t, top: getCategoryTop(t, 3) }));
const influencerCount = getInfluencerRanking().length;
const cosmeticCount = new Set(Array.from(byTag.values()).flat().map((r) => `${r.brand_id}_${r.name_id}`)).size;

const siteLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "OsoroCosme",
  description: "YouTubeのコスメ紹介動画から、誰がいつどのコスメを使っているかを集めたデータベース",
  potentialAction: {
    "@type": "SearchAction",
    target: { "@type": "EntryPoint", urlTemplate: new URL(withBase("/search-result"), Astro.site).href + "?q={search_term_string}" },
    "query-input": "required name=search_term_string",
  },
};
// 特集カード用: 各特集の上位コスメの画像（最大3つ）と、集計元の動画数
const featureCards = getPublishedFeatures().map((d) => {
  const f = getFeature(d.slug)!;
  return { def: d, videoCount: f.videoCount, channelCount: f.channelCount, imgs: featureCoverImages(d.slug) };
});

// ヒーローの表紙：最近話題のコスメ上位3品（画像のあるもの）
const heroItems = trending
  .map((r) => ({ r, img: productImageSrc(getCosmeticListEntry(r.brand_id, r.name_id), r.rakuten_image_link), c: recent.get(`${r.brand_id}_${r.name_id}`) }))
  .filter((x) => x.img);
const heroFaces = getInfluencerRanking().filter((i) => i.channel_icon).slice(0, 6);
const ringFaces = heroFaces.map((f) => ({ src: f.channel_icon!.replace(/=s\d+-/, "=s176-"), name: f.channel_title, href: withBase(`/influencer/${f.channel_id}`) }));
const ringItems = heroItems.slice(0, 6).map((x) => ({ src: x.img!, name: `${x.r.brand} ${x.r.name}`, href: withBase(`/cosmetics/${cosmeticSlug(x.r.brand_id, x.r.name_id)}`) }));
const isLatin = (t: string) => !/[ぁ-んァ-ヶ一-龠]/.test(t);
const now = new Date();
const issue = `${now.getFullYear()}.${String(now.getMonth() + 1).padStart(2, "0")}`;
const featuredFull = featuredTags.map((t) => ({ tag: t, top: getCategoryTop(t, 5) }));
---

<Layout
  title="コスメ紹介動画から探すコスメデータベース"
  description={`YouTubeのコスメ紹介動画${visible.length}本から、インフルエンサー${influencerCount}人が使ったコスメ${cosmeticCount}品を集めました。カテゴリ別ランキングや、インフルエンサーごとの使用コスメ遍歴で探せます。`}
  jsonLd={[siteLd]}
>
  <!-- ===== HERO：雑誌の表紙のように、大きな見出しと話題のコスメの額装 ===== -->
  <section class="relative -mt-8 md:-mt-12 pt-10 md:pt-16 pb-16 md:pb-24">
    <div class="grid grid-cols-[minmax(0,1fr)] lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      <div class="lg:col-span-7 relative z-10">
        <p class="flex flex-wrap items-center gap-x-3 gap-y-1 mb-8 md:mb-10">
          <span class="label-caps text-ink">Issue {issue}</span>
          <span class="hidden min-[400px]:block h-px w-10 bg-ink/30"></span>
          <span class="eyebrow">The YouTube Cosme Database</span>
        </p>
        <h1 class="min-w-0 font-serif font-semibold text-[clamp(28px,7.6vw,36px)] lg:text-[clamp(36px,3vw,44px)] leading-[1.16] tracking-[-0.01em]">
          <span class="hero-line block"><span style="--d:0ms">あの人の</span></span>
          <span class="hero-line block"><span style="--d:60ms"><em class="not-italic text-rose">愛用</em>コスメ、</span></span>
          <span class="hero-line block whitespace-nowrap"><span style="--d:120ms">動画から見つかる。</span></span>
        </h1>
        <p class="reveal mt-8 text-[15px] md:text-base leading-[2] text-neutral-600 max-w-lg" style="--d:300ms">
          YouTubeのコスメ紹介動画<b class="font-medium text-ink">{formatCount(visible.length)}本</b>を読み解き、インフルエンサー<b class="font-medium text-ink">{formatCount(influencerCount)}人</b>が実際に紹介したコスメを、ひとつのデータベースにまとめました。
        </p>
        <form action={withBase("/search-result")} method="get" role="search" class="reveal mt-10 max-w-xl group" style="--d:400ms">
          <label for="hero-q" class="label-caps text-neutral-500">Search</label>
          <div class="mt-2 flex items-center gap-3 border-b-2 border-ink focus-within:border-rose transition-colors">
            <input id="hero-q" type="search" name="q" placeholder="コスメ名・ブランド・インフルエンサー" class="flex-1 min-w-0 bg-transparent py-3 text-lg md:text-xl font-serif placeholder:text-neutral-400 focus:outline-none" />
            <button type="submit" class="shrink-0 w-12 h-12 rounded-full bg-ink text-paper flex items-center justify-center transition-all duration-500 ease-out-expo hover:bg-rose hover:scale-105" aria-label="検索">
              <svg viewBox="0 0 24 24" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6" /></svg>
            </button>
          </div>
        </form>
        <dl class="reveal mt-12 grid grid-cols-3 max-w-xl divide-x divide-ink/15 border-t border-ink/15" style="--d:500ms">
          {[
            { n: cosmeticCount, label: "Cosmetics", ja: "コスメ", href: "/ranking/" },
            { n: visible.length, label: "Videos", ja: "紹介動画", href: "/video-list" },
            { n: influencerCount, label: "Influencers", ja: "インフルエンサー", short: "人", href: "/influencer-list" },
          ].map((x, i) => (
            <a href={withBase(x.href)} class:list={["group pt-5 block", i === 0 ? "pr-3" : "px-3 sm:px-5"]}>
              <dd class="num-display text-[24px] sm:text-[30px] leading-none group-hover:text-rose transition-colors">{formatCount(x.n)}</dd>
              <dt class="mt-2 text-xs text-neutral-500">{x.short ? <><span class="min-[400px]:hidden">{x.short}</span><span class="hidden min-[400px]:inline">{x.ja}</span></> : x.ja}</dt>
            </a>
          ))}
        </dl>
      </div>

      <!-- 表紙の絵：重なる2つの輪（人とコスメ） -->
      <div class="lg:col-span-5 relative">
        <div class="relative mx-auto w-full max-w-[560px] px-[3%]">
          <HeroRings faces={ringFaces} items={ringItems} />
          {heroItems[0] && (
            <a href={withBase(`/cosmetics/${cosmeticSlug(heroItems[0].r.brand_id, heroItems[0].r.name_id)}`)} class="group reveal mx-auto -mt-4 flex items-center gap-4 max-w-sm bg-paper/90 backdrop-blur rounded-full pl-2 pr-5 py-2 border border-ink/10 shadow-[0_20px_50px_-24px_rgba(29,21,23,0.35)]" style="--d:600ms">
              <span class="w-12 h-12 rounded-full overflow-hidden bg-white shrink-0 ring-1 ring-ink/5"><img src={heroItems[0].img} alt="" class="w-full h-full object-contain p-1.5" /></span>
              <span class="min-w-0 flex-1">
                <span class="block label-caps text-rose">Now trending No.1</span>
                <span class="block text-sm leading-snug truncate group-hover:text-rose transition-colors">{heroItems[0].r.brand} {heroItems[0].r.name}</span>
                <span class="block text-xs text-neutral-500">直近{RECENT_DAYS}日で{heroItems[0].c?.channels ?? heroItems[0].r.channelCount}人が紹介</span>
              </span>
              <span class="shrink-0 text-rose transition-transform duration-500 group-hover:translate-x-1" aria-hidden="true">→</span>
            </a>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- ===== MARQUEE：人気ブランドの名前が流れる帯 ===== -->
  <section class="marquee relative -mx-4 md:-mx-8 border-y border-ink/15 py-5 md:py-7 overflow-hidden" aria-label="人気ブランド">
    <div class="marquee-track flex w-max" style="--marquee-s:70s">
      {[0, 1].map((k) => (
        <ul class="flex items-center shrink-0" aria-hidden={k === 1 ? "true" : undefined}>
          {popularBrands.map((b) => (
            <li class="flex items-center">
              <a href={withBase(`/brand/${b.brand_id}`)} tabindex={k === 1 ? -1 : undefined} class:list={["px-6 md:px-10 text-[22px] md:text-[26px] leading-none whitespace-nowrap hover:text-rose transition-colors", isLatin(b.name) ? "font-display font-semibold" : "font-serif font-medium"]}>{b.name}</a>
              <span class="text-rose text-sm" aria-hidden="true">✦</span>
            </li>
          ))}
        </ul>
      ))}
    </div>
  </section>

  <!-- ===== 01 RANKING ===== -->
  <section class="panel mt-12 md:mt-16">
    <SectionHead num="01" en="Ranking" title="いま、よく紹介されているコスメ" lead="紹介動画の数・紹介したインフルエンサーの数・再生回数から出した人気順です。商品数の多い3つのカテゴリを先に。" href={withBase("/ranking/")} cta="All categories" />
    <!-- スマホでは3つのカテゴリを横にめくる（縦に積むと画面2枚半になるため） -->
    <div class="-mx-4 px-4 md:-mx-10 md:px-10 lg:mx-0 lg:px-0 flex lg:grid lg:grid-cols-3 gap-5 md:gap-8 lg:gap-10 overflow-x-auto lg:overflow-visible snap-x snap-mandatory scroll-px-4 md:scroll-px-10 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden" data-swipe>
      {featuredFull.map((f, fi) => (
        <article class="reveal min-w-0 shrink-0 w-[86%] sm:w-[58%] lg:w-auto snap-start" style={`--d:${fi * 120}ms`}>
          <div class="flex items-baseline justify-between mb-5">
            <h3 class="font-serif text-xl md:text-2xl font-semibold">{f.tag}</h3>
            <a href={categoryUrl(f.tag)} class="link-u text-xs tracking-[0.18em] uppercase text-neutral-600">Top 50</a>
          </div>
          {f.top[0] && (
            <a href={withBase(`/cosmetics/${cosmeticSlug(f.top[0].tile.brand_id, f.top[0].tile.name_id)}`)} class="group block">
              <div class="product-well relative aspect-[5/4] rounded-2xl overflow-hidden flex items-center justify-center">
                {f.top[0].tile.imageSrc && <img src={f.top[0].tile.imageSrc} alt={`${f.top[0].tile.brand} ${f.top[0].tile.name}`} class="h-[80%] w-auto max-w-[72%] object-contain transition-transform duration-[1.2s] ease-out-expo group-hover:scale-105" loading="lazy" />}
                <span class="absolute left-0 top-0 flex items-baseline gap-1 bg-white/90 backdrop-blur rounded-br-2xl pl-4 pr-3.5 pt-2.5 pb-1.5" aria-label="1位">
                  <span class="num-display text-rose text-[44px] leading-none">1</span>
                  <span class="label-caps text-rose text-[11px]">st</span>
                </span>
              </div>
              <p class="mt-4 text-xs tracking-[0.14em] uppercase text-neutral-500">{f.top[0].tile.brand}</p>
              <p class="mt-1 font-serif text-lg leading-snug group-hover:text-rose transition-colors tighten">{f.top[0].tile.name}</p>
              <p class="mt-1 text-xs text-neutral-500">{f.top[0].tile.videoCount}本の動画で紹介</p>
            </a>
          )}
          <ol class="mt-6 border-t border-ink/10 [&>li:last-child]:border-b-0">
            {f.top.slice(1).map(({ rank, tile }) => (
              <li class="border-b border-ink/10">
                <a href={withBase(`/cosmetics/${cosmeticSlug(tile.brand_id, tile.name_id)}`)} class="group flex items-center gap-4 py-3">
                  <span class="num-display text-[22px] w-6 text-ink/45 group-hover:text-rose transition-colors">{rank}</span>
                  <span class="product-well w-14 h-14 rounded-xl overflow-hidden shrink-0">
                    {tile.imageSrc && <img src={tile.imageSrc} alt="" class="w-full h-full object-contain p-1.5" loading="lazy" />}
                  </span>
                  <span class="min-w-0 flex-1">
                    <span class="block text-xs tracking-[0.12em] uppercase text-neutral-500 truncate">{tile.brand}</span>
                    <span class="block text-sm leading-snug line-clamp-1 group-hover:text-rose transition-colors">{tile.name}</span>
                  </span>
                  <span class="text-xs text-neutral-500 shrink-0">{tile.videoCount}<span class="font-sans text-xs ml-0.5">本</span></span>
                </a>
              </li>
            ))}
          </ol>
        </article>
      ))}
    </div>
    <div class="lg:hidden mt-6" data-swipe-dots aria-hidden="true"></div>
  </section>

  <!-- ===== 02 TRENDING ===== -->
  {trending.length > 0 && (
    <section class="panel mt-8 md:mt-10">
      <SectionHead num="02" en="Trending now" title="最近話題のコスメ" lead={`直近${RECENT_DAYS}日に投稿された動画で、紹介したインフルエンサーが多い順です。`} />
      <div class="-mx-4 md:mx-0 px-4 md:px-0 flex md:grid md:grid-cols-4 gap-4 md:gap-6 overflow-x-auto md:overflow-visible snap-x snap-mandatory scroll-px-4 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden" data-swipe>
        {trending.slice(0, 8).map((c, i) => {
          const rc = recent.get(`${c.brand_id}_${c.name_id}`);
          return (
            <div class="reveal snap-start shrink-0 w-[62%] min-[480px]:w-[42%] md:w-auto" style={`--d:${(i % 4) * 90}ms`}>
              <CosmeticTile
                tile={{ brand_id: c.brand_id, brand: c.brand, name_id: c.name_id, name: c.name, imageSrc: productImageSrc(getCosmeticListEntry(c.brand_id, c.name_id), c.rakuten_image_link), videoCount: c.videoCount }}
                rank={i + 1}
                caption={rc ? `直近${RECENT_DAYS}日で${rc.channels}人が紹介` : undefined}
              />
            </div>
          );
        })}
      </div>
      <div class="md:hidden mt-6" data-swipe-dots aria-hidden="true"></div>
    </section>
  )}

  <!-- ===== 03 FEATURES ===== -->
  {featureCards.length > 0 && (
    <section class="panel mt-8 md:mt-10">
      <SectionHead num="03" en="Features" title="特集" lead="動画のタイトルに書かれたテーマごとに、よく紹介されたコスメを集めました。" href={withBase("/feature/")} />
      <div class="grid sm:grid-cols-2 gap-6 md:gap-8">
        {featureCards.map((c, i) => (
          <a href={withBase(`/feature/${c.def.slug}/`)} class="reveal group block rounded-[28px] bg-blush/70 hover:bg-blush p-6 md:p-10 transition-colors duration-700" style={`--d:${(i % 2) * 120}ms`}>
            <div class="flex items-end justify-center gap-3 md:gap-5 h-44 md:h-56">
              {c.imgs.map((src, k) => (
                <div class:list={["arch bg-white overflow-hidden ring-[5px] ring-paper transition-transform duration-[1.2s] ease-out-expo", k === 1 ? "w-[34%] h-full group-hover:-translate-y-2" : "w-[28%] h-[78%] group-hover:-translate-y-1"]}>
                  <img src={src} alt="" class="w-[80%] h-[62%] object-contain mt-[22%] mx-auto" loading="lazy" />
                </div>
              ))}
            </div>
            <div class="mt-8 flex items-end justify-between gap-4">
              <div>
                <p class="eyebrow">Feature</p>
                <p class="mt-1 font-serif text-[20px] md:text-[22px] font-semibold leading-snug">{c.def.name}動画で<br />人気のコスメ</p>
                <p class="mt-2 text-xs text-neutral-600">{c.videoCount}本の動画・{c.channelCount}チャンネルから集計</p>
              </div>
              <span class="shrink-0 w-11 h-11 rounded-full border border-ink/25 flex items-center justify-center transition-all duration-500 ease-out-expo group-hover:bg-ink group-hover:text-paper" aria-hidden="true">→</span>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- ===== 04 INFLUENCERS ===== -->
  <section class="panel mt-8 md:mt-10">
    <SectionHead num="04" en="Influencers" title="人気のインフルエンサー" lead="登録者数と、このサイトに載っている動画・コスメの数から並べています。" href={withBase("/influencer-list")} />
    <ol class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-x-6 gap-y-10">
      {popularInfluencers.map((inf, i) => (
        <li class="reveal" style={`--d:${(i % 5) * 70}ms`}>
          <a href={withBase(`/influencer/${inf.channel_id}`)} class="group block text-center">
            <span class="relative block w-[72%] max-w-[148px] mx-auto aspect-square">
              <span class="absolute inset-0 rounded-full border border-ink/15 scale-[1.12] transition-all duration-700 ease-out-expo group-hover:scale-[1.2] group-hover:border-rose" aria-hidden="true"></span>
              {inf.channel_icon ? (
                <img referrerpolicy="no-referrer" src={inf.channel_icon.replace(/=s\d+-/, "=s240-")} alt="" data-name={inf.channel_title} class="w-full h-full rounded-full object-cover" loading="lazy" />
              ) : (
                <span class="block w-full h-full rounded-full bg-blush" />
              )}
              <span class="absolute -left-1 -top-1 num-display text-2xl text-rose leading-none">{String(i + 1).padStart(2, "0")}</span>
            </span>
            <span class="mt-5 block font-serif text-[15px] leading-snug truncate group-hover:text-rose transition-colors">{inf.channel_title}</span>
            <span class="mt-1 block text-xs text-neutral-500">動画{inf.videoCount}本・コスメ{inf.cosmeticCount}品</span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <!-- ===== 05 CATEGORIES：文字だけの索引 ===== -->
  <section class="panel mt-8 md:mt-10">
    <SectionHead num="05" en="Index" title="カテゴリから探す" href={withBase("/ranking/")} cta="Rankings" />
    <ul class="grid md:grid-cols-2 md:gap-x-12 [&>li:last-child]:border-b-0 md:[&>li:nth-last-child(2):nth-child(odd)]:border-b-0">
      {categoryGroups.map((g, i) => (
        <li class="reveal border-b border-ink/15" style={`--d:${(i % 2) * 80}ms`}>
          <a href={withBase(`/ranking/#group-${g.group}`)} class="group relative flex items-baseline gap-5 py-5 md:py-6 overflow-hidden">
            <span class="num-display text-neutral-400 text-lg w-7 shrink-0">{String(i + 1).padStart(2, "0")}</span>
            <span class="font-serif text-[20px] md:text-[22px] font-semibold transition-transform duration-700 ease-out-expo group-hover:translate-x-2 group-hover:text-rose">{g.group}</span>
            <span class="ml-auto text-xs text-neutral-500 shrink-0"><span class="num-display text-base text-ink">{g.tags.length}</span> カテゴリ</span>
            <span class="shrink-0 -mr-6 opacity-0 transition-all duration-500 ease-out-expo group-hover:mr-0 group-hover:opacity-100 text-rose" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- ===== 06 LATEST VIDEOS ===== -->
  <section class="panel mt-8 md:mt-10">
    <SectionHead num="06" en="Latest videos" title="新着の紹介動画" href={withBase("/video-list")} />
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-x-6 gap-y-10">
      {latestVideos.map((v, i) => <div class:list={["reveal min-w-0", i >= 4 && "hidden sm:block"]} style={`--d:${(i % 4) * 80}ms`}><VideoCard video={v} /></div>)}
    </div>
  </section>

  <!-- ===== HOW TO USE ===== -->
  <section class="mt-24 md:mt-36 -mb-8 md:-mb-12 -mx-4 md:-mx-8 px-4 md:px-8 py-16 md:py-24 bg-blush/60 rounded-[32px]">
    <div class="max-w-5xl mx-auto">
      <p class="eyebrow text-center">How to use</p>
      <h2 class="mt-2 font-serif text-[22px] md:text-[24px] font-semibold text-center">OsoroCosmeの使いかた</h2>
      <ol class="mt-12 md:mt-16 grid md:grid-cols-3 gap-10 md:gap-12">
        {[
          { n: "I", title: "探す", text: "カテゴリや検索で、気になるコスメを見つけます。", href: "/ranking/", cta: "ランキングを見る" },
          { n: "II", title: "比べる", text: "紹介動画数・インフルエンサー数から出した人気順を確かめます。", href: "/brand-list", cta: "ブランド一覧へ" },
          { n: "III", title: "動画で確かめる", text: "誰がいつ紹介したかを、元の動画で見られます。", href: "/video-list", cta: "動画一覧へ" },
        ].map((st, i) => (
          <li class="reveal text-center md:text-left" style={`--d:${i * 120}ms`}>
            <p class="num-display text-rose text-[30px] leading-none">{st.n}</p>
            <p class="mt-4 font-serif text-xl font-semibold">{st.title}</p>
            <p class="mt-3 text-sm leading-[1.9] text-neutral-600">{st.text}</p>
            <a href={withBase(st.href)} class="link-u mt-4 inline-block text-xs tracking-[0.1em]">{st.cta} →</a>
          </li>
        ))}
      </ol>
      <p class="mt-14 text-center text-xs text-neutral-500">データはYouTubeのコスメ紹介動画から作成しています。{updatedAt && `最新の動画：${formatJaDate(updatedAt)}`}</p>
    </div>
  </section>
</Layout>
