---
import Layout from "../layouts/Layout.astro";
import VideoCard from "../components/VideoCard.astro";
import CosmeticCard from "../components/CosmeticCard.astro";
import {
  getVisibleVideos,
  getPopularBrands,
  getInfluencerRanking,
  getCosmeticRankingsByTag,
  getTrendingCosmetics,
  groupTagsByCategory,
  sortByPublishedDesc,
  formatCount,
  withBase,
  categoryUrl,
} from "../lib/data";

const visible = getVisibleVideos();
const latestVideos = sortByPublishedDesc(visible).slice(0, 12);
const popularBrands = getPopularBrands(12);
const popularInfluencers = getInfluencerRanking().slice(0, 12);
const trending = getTrendingCosmetics(8);

const byTag = getCosmeticRankingsByTag();
const categoryGroups = groupTagsByCategory(byTag.keys());
const influencerCount = getInfluencerRanking().length;
const cosmeticCount = new Set(Array.from(byTag.values()).flat().map((r) => `${r.brand_id}_${r.name_id}`)).size;

const siteLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "OsoroCosme",
  description: "YouTubeのコスメ紹介動画から、誰がいつどのコスメを使っているかを集めたデータベース",
  potentialAction: {
    "@type": "SearchAction",
    target: { "@type": "EntryPoint", urlTemplate: new URL(withBase("/search-result"), Astro.site).href + "?q={search_term_string}" },
    "query-input": "required name=search_term_string",
  },
};
---

<Layout
  title="コスメ紹介動画から探すコスメデータベース"
  description={`YouTubeのコスメ紹介動画${visible.length}本から、インフルエンサー${influencerCount}人が使ったコスメ${cosmeticCount}品を集めました。カテゴリ別ランキングや、インフルエンサーごとの使用コスメ遍歴で探せます。`}
  jsonLd={[siteLd]}
>
  <section class="text-center mb-10 md:mb-12 pt-2 md:pt-4">
    <h1 class="text-xl sm:text-2xl md:text-3xl font-bold mb-3 text-balance">みんなが使っているコスメを、<br class="sm:hidden" />動画から探す</h1>
    <p class="text-sm text-neutral-500 mb-6">
      YouTubeのコスメ紹介動画 {visible.length}本 ／ インフルエンサー {influencerCount}人 ／ コスメ {cosmeticCount}品を集めたデータベース
    </p>
    <form action={withBase("/search-result")} method="get" class="max-w-xl mx-auto flex gap-2">
      <input
        type="text"
        name="q"
        placeholder="コスメ名・ブランドで検索"
        class="flex-1 min-w-0 border border-neutral-300 rounded-full px-4 sm:px-5 py-3 focus:outline-none focus:ring-2 focus:ring-pink-300"
      />
      <button type="submit" class="bg-pink-600 text-white px-5 sm:px-6 rounded-full hover:bg-pink-700 shrink-0">検索</button>
    </form>
  </section>

  <section class="mb-12">
    <div class="flex items-end justify-between mb-3">
      <h2 class="text-lg font-bold">カテゴリから探す</h2>
      <a href={withBase("/ranking/")} class="text-sm text-pink-600 hover:underline">ランキング一覧へ →</a>
    </div>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
      {
        categoryGroups.map((g) => {
          const top = [...g.tags].sort((a, b) => byTag.get(b)!.length - byTag.get(a)!.length).slice(0, 8);
          return (
            <div class="bg-white rounded-xl shadow-sm p-4">
              <h3 class="font-bold text-sm mb-2 text-pink-700">{g.group}</h3>
              <div class="flex flex-wrap gap-1.5">
                {top.map((t, ti) => (
                  <a href={categoryUrl(t)} class:list={["text-xs px-2.5 py-1.5 sm:py-1 rounded-full bg-pink-50 text-pink-700 hover:bg-pink-100", { "hidden sm:inline-block": ti >= 6 }]}>
                    {t}
                  </a>
                ))}
              </div>
            </div>
          );
        })
      }
    </div>
  </section>

  {
    trending.length > 0 && (
      <section class="mb-12">
        <h2 class="text-lg font-bold mb-1">最近の動画で紹介が多いコスメ</h2>
        <p class="text-xs text-neutral-500 mb-3">直近に投稿された動画で、紹介された回数が多い順です。</p>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
          {trending.map((c) => (
            <CosmeticCard brand_id={c.brand_id} brand={c.brand} name_id={c.name_id} name={c.name} rakutenImageHtml={c.rakuten_image_link} />
          ))}
        </div>
      </section>
    )
  }

  <section class="mb-12">
    <div class="flex items-end justify-between mb-3">
      <h2 class="text-lg font-bold">人気ブランド</h2>
      <a href={withBase("/brand-list")} class="text-sm text-pink-600 hover:underline">ブランド一覧へ →</a>
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3">
      {
        popularBrands.map((b, i) => (
          <a
            href={withBase(`/brand/${b.brand_id}`)}
            class="relative rounded-xl p-4 bg-gradient-to-br from-pink-50 to-rose-100 border border-pink-100 hover:shadow-md hover:-translate-y-0.5 transition group"
          >
            <span class="absolute top-2 right-3 text-xs font-bold text-pink-400">#{i + 1}</span>
            <span class="flex items-center justify-center w-10 h-10 rounded-full bg-white text-pink-600 font-bold shadow-sm mb-3">
              {b.name.charAt(0).toUpperCase()}
            </span>
            <p class="font-semibold text-sm truncate group-hover:text-pink-600">{b.name}</p>
            <p class="text-xs text-neutral-500 mt-0.5">紹介動画 {b.videoCount}本</p>
          </a>
        ))
      }
    </div>
  </section>

  <section class="mb-12">
    <div class="flex items-end justify-between mb-3">
      <h2 class="text-lg font-bold">人気インフルエンサー</h2>
      <a href={withBase("/influencer-list")} class="text-sm text-pink-600 hover:underline">インフルエンサー一覧へ →</a>
    </div>
    <div class="flex gap-4 overflow-x-auto pb-3 -mx-4 px-4 snap-x">
      {
        popularInfluencers.map((inf) => (
          <a
            href={withBase(`/influencer/${inf.channel_id}`)}
            class="snap-start shrink-0 w-36 bg-white rounded-xl shadow-sm hover:shadow-md hover:-translate-y-0.5 transition p-4 text-center"
          >
            {inf.channel_icon ? (
              <img src={inf.channel_icon} alt="" class="w-20 h-20 rounded-full mx-auto mb-2 ring-4 ring-pink-200" loading="lazy" />
            ) : (
              <div class="w-20 h-20 rounded-full mx-auto mb-2 ring-4 ring-pink-200 bg-pink-50" />
            )}
            <p class="font-semibold text-sm truncate">{inf.channel_title}</p>
            <p class="text-[11px] text-neutral-400">登録者 {formatCount(inf.subscriber_count)}人</p>
            <p class="text-[11px] text-pink-600 mt-1">動画 {inf.videoCount}本</p>
          </a>
        ))
      }
    </div>
  </section>

  <section>
    <div class="flex items-end justify-between mb-3">
      <h2 class="text-lg font-bold">新着動画</h2>
      <a href={withBase("/video-list")} class="text-sm text-pink-600 hover:underline">動画一覧へ →</a>
    </div>
    <div class="grid sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
      {latestVideos.map((v) => <VideoCard video={v} />)}
    </div>
  </section>
</Layout>
