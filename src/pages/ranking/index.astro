---
import Layout from "../../layouts/Layout.astro";
import {
  getRankingPages,
  getRankingNav,
  getCosmeticRankings,
  getCosmeticListEntry,
  productImageSrc,
  categoryUrl,
  cosmeticSlug,
  withBase,
  type CosmeticRanking,
} from "../../lib/data";

const pages = getRankingPages();
const nav = getRankingNav();
const allTags = Array.from(pages.keys());

const img = (r: CosmeticRanking) => productImageSrc(getCosmeticListEntry(r.brand_id, r.name_id), r.rakuten_image_link);
const productHref = (r: CosmeticRanking) => withBase(`/cosmetics/${cosmeticSlug(r.brand_id, r.name_id)}`);
const n2 = (n: number) => String(n).padStart(2, "0");

// 大分類の英字の小見出し
const GROUP_EN: Record<string, string> = {
  ベースメイク: "Base",
  アイブロウ: "Brow",
  アイメイク: "Eye",
  "チーク・陰影": "Cheek & Contour",
  リップ: "Lip",
  "メイク小物・その他": "Tools",
  スキンケア: "Skincare",
  ヘアケア: "Hair",
  ボディケア: "Body",
  ネイル: "Nail",
  フレグランス: "Fragrance",
};

const groups = nav.map((g) => {
  const seen = new Set<string>();
  for (const it of g.items) for (const r of pages.get(it.name)?.list || []) seen.add(`${r.brand_id}_${r.name_id}`);
  const pageCount = g.items.reduce((n, it) => n + 1 + (it.kind === "parent" ? it.children.length : 0), 0);
  return { ...g, en: GROUP_EN[g.group] || "Others", productCount: seen.size, pageCount };
});

// 全カテゴリを通した総合の順位（ランキングのページがあるカテゴリの商品だけ）。画像の無い商品も飛ばさず、順位どおりに出す
const overall = getCosmeticRankings()
  .filter((r) => r.tags.some((t) => pages.has(t)))
  .slice()
  .sort((a, b) => b.score - a.score || b.videoCount - a.videoCount);
const top10 = overall.slice(0, 10);
const rankedProducts = new Set(allTags.flatMap((t) => pages.get(t)!.list.map((r) => `${r.brand_id}_${r.name_id}`))).size;
// 総合の各商品に添えるカテゴリ名（ランキングのページがある、いちばん細かいカテゴリ）
const tagOf = (r: CosmeticRanking) => r.tags.find((t) => pages.get(t)?.kind === "category") || r.tags.find((t) => pages.has(t)) || "";
---

<Layout
  title="コスメ人気ランキング（カテゴリ別）"
  description="YouTubeのコスメ紹介動画での紹介数・再生数・紹介したインフルエンサー数から算出した、カテゴリ別の人気コスメランキング。化粧下地、ファンデーション、アイシャドウ、リップなど、カテゴリを選んで上位50位まで見られます。"
>
  {/* ===== 見出し：小さくまとめ、すぐ下に総合ランキングを出す（ヒーローの大きな絵はトップと似て、ページが変わったと分かりにくかった。286章） ===== */}
  <header class="flex flex-col md:flex-row md:items-end justify-between gap-4 md:gap-10 mb-6 md:mb-8">
    <div class="min-w-0">
      <p class="eyebrow text-rose">Ranking</p>
      <h1 class="mt-2 font-serif font-semibold h-page tracking-[-0.01em]">コスメ人気ランキング</h1>
      <p class="mt-3 text-sm leading-[1.9] text-neutral-600 max-w-2xl">YouTubeの紹介動画の合計再生回数・紹介動画数・紹介したインフルエンサー数から出した人気順です。PR・提供の紹介は数えていません。</p>
    </div>
    <dl class="flex shrink-0 divide-x divide-ink/15">
      {[
        { n: allTags.length, label: "ランキング" },
        { n: rankedProducts.toLocaleString(), label: "ランクイン", unit: "品" },
      ].map((s) => (
        <div class="px-5 first:pl-0 last:pr-0 flex flex-col-reverse">
          <dd class="mt-1 num-display text-[24px] md:text-[30px] leading-none whitespace-nowrap">{s.n}{s.unit && <span class="font-sans font-normal text-xs ml-1 text-neutral-500">{s.unit}</span>}</dd>
          <dt class="text-xs text-neutral-500 whitespace-nowrap">{s.label}</dt>
        </div>
      ))}
    </dl>
  </header>

  {/* ===== 総合ランキング TOP10 ===== */}
  {top10.length > 0 && (
    <section class="panel rk-overall mb-6 md:mb-8">
      <div class="flex items-end justify-between gap-4 mb-5 md:mb-7">
        <div>
          <p class="label-caps text-[11px] text-rose">Overall top 10</p>
          <h2 class="mt-1 font-serif h-section font-semibold">総合ランキング</h2>
        </div>
        <p class="text-xs text-neutral-500 text-right">全カテゴリを通した順位</p>
      </div>
      <div class="grid grid-cols-[minmax(0,1fr)] xl:grid-cols-12 gap-5 xl:gap-10">
        {/* 1位 */}
        <a href={productHref(top10[0])} class="group min-w-0 xl:col-span-5 rk-first rounded-2xl p-4 md:p-6 flex xl:flex-col gap-4 md:gap-6 xl:gap-5 items-center xl:items-stretch">
          <div class="relative product-well bg-white rounded-xl xl:rounded-2xl overflow-hidden flex items-center justify-center w-28 h-28 sm:w-40 sm:h-40 xl:w-auto xl:h-auto xl:aspect-[4/3] shrink-0">
            {img(top10[0]) ? <img src={img(top10[0])} alt={`${top10[0].brand} ${top10[0].name}`} class="h-[80%] w-auto max-w-[80%] object-contain transition-transform duration-[1.2s] ease-out-expo group-hover:scale-105" data-err="hide" /> : null}
            <span class="absolute left-0 top-0 flex items-baseline gap-1 bg-badge rounded-br-2xl pl-3 pr-2.5 pt-1.5 pb-1 xl:pl-4 xl:pr-3.5 xl:pt-2.5 xl:pb-1.5" aria-label="1位">
              <span class="num-display text-rose text-[30px] xl:text-[48px] leading-none">1</span>
              <span class="label-caps text-rose text-[10px] xl:text-[11px]">st</span>
            </span>
          </div>
          <div class="min-w-0">
            {tagOf(top10[0]) && <p class="text-[11px] text-rose">{tagOf(top10[0])}</p>}
            <p class="mt-1 text-xs tracking-[0.12em] text-neutral-500 truncate">{top10[0].brand}</p>
            <p class="mt-0.5 font-serif text-base md:text-xl leading-snug line-clamp-2 group-hover:text-rose transition-colors tighten">{top10[0].name}</p>
            <p class="mt-2 text-xs text-neutral-500"><span class="num-display text-sm text-ink">{top10[0].videoCount}</span>本の動画・<span class="num-display text-sm text-ink">{top10[0].channelCount}</span>人が紹介</p>
          </div>
        </a>
        {/* 2〜10位 */}
        <ol class="min-w-0 xl:col-span-7 grid grid-cols-[minmax(0,1fr)] sm:grid-cols-2 sm:grid-flow-col sm:grid-rows-5 gap-x-6 content-start">
          {top10.slice(1).map((r, i) => (
            <li class="border-b border-ink/10 sm:[&:nth-child(5)]:border-b-0 last:border-b-0">
              <a href={productHref(r)} class="group flex items-center gap-3 py-2.5 md:py-3">
                <span class:list={["num-display w-7 shrink-0 text-center leading-none", i < 2 ? "text-[26px] text-ink" : "text-[20px] text-ink/45"]}>{i + 2}</span>
                <span class="product-well w-12 h-12 md:w-14 md:h-14 rounded-xl overflow-hidden shrink-0 flex items-center justify-center">
                  {img(r) ? <img src={img(r)} alt={`${r.brand} ${r.name}`} class="w-[84%] h-[84%] object-contain" loading="lazy" data-err="hide" /> : null}
                </span>
                <span class="min-w-0 flex-1">
                  <span class="block text-[11px] text-neutral-500 truncate">{r.brand}<span class="text-ink/30 mx-1">/</span>{tagOf(r)}</span>
                  <span class="block text-sm leading-snug line-clamp-2 group-hover:text-rose transition-colors">{r.name}</span>
                </span>
                <span class="text-xs text-neutral-500 shrink-0 whitespace-nowrap"><span class="num-display text-sm text-ink">{r.videoCount}</span>本</span>
              </a>
            </li>
          ))}
        </ol>
      </div>
      <p class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-sm">
        <a href={withBase("/ranking/repeat/")} class="link-u text-rose">リピートされているコスメ →</a>
        <a href={withBase("/feature/")} class="link-u text-rose">特集：毎日メイク・プチプラ動画で人気のコスメ →</a>
      </p>
    </section>
  )}

  {/* ===== ジャンルの目次（スクロールしても上に残す） ===== */}
  <nav aria-label="ジャンル" class="rk-genre sticky top-[57px] md:top-[73px] z-30 -mx-4 md:-mx-8 px-4 md:px-8 py-2.5 mb-4 md:mb-6">
    <ol class="flex gap-1.5 overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
      {groups.map((g, gi) => (
        <li class="shrink-0">
          <a href={`#group-${g.group}`} class="flex items-baseline gap-1.5 rounded-full bg-panel px-3.5 py-1.5 text-sm shadow-[0_0_0_1px_rgb(29_21_23/0.1)] hover:text-rose hover:shadow-[0_0_0_1px_var(--color-rose)] transition-shadow duration-300 whitespace-nowrap">
            <span class="num-display text-[10px] text-neutral-400">{n2(gi + 1)}</span>{g.group}
          </a>
        </li>
      ))}
    </ol>
  </nav>

  {/* ===== 大分類ごと：カテゴリのカード（中に1〜3位） ===== */}
  {groups.map((g, gi) => (
    <section id={`group-${g.group}`} class="panel mb-6 md:mb-8 scroll-mt-32 md:scroll-mt-40">
      <header class="flex items-end justify-between gap-4 mb-5 md:mb-7">
        <div class="flex items-end gap-3 md:gap-5 min-w-0">
          <span class="rk-num num-display leading-[0.8] text-[44px] md:text-[64px]" aria-hidden="true">{n2(gi + 1)}</span>
          <div class="min-w-0">
            <p class="eyebrow text-rose text-xs">{g.en}</p>
            <h2 class="mt-0.5 font-serif h-section font-semibold">{g.group}</h2>
          </div>
        </div>
        <p class="shrink-0 pb-1 text-xs text-neutral-500 text-right leading-relaxed">
          <span class="num-display text-sm text-ink">{g.pageCount}</span> ランキング<br class="sm:hidden" /><span class="hidden sm:inline"> ・ </span><span class="num-display text-sm text-ink">{g.productCount.toLocaleString()}</span> 品
        </p>
      </header>

      <ul class:list={["grid grid-cols-[minmax(0,1fr)] sm:grid-cols-2 gap-3 md:gap-5", g.items.length >= 3 && "xl:grid-cols-3"]}>
        {g.items.map((it, ii) => {
          const top3 = (pages.get(it.name)?.list || []).slice(0, 3);
          const isParent = it.kind === "parent";
          const wide = g.items.length === 1; // 1枚だけの大分類は横いっぱいに、1〜3位を横に並べる
          return (
            <li class:list={["reveal rk-card min-w-0 rounded-2xl flex flex-col", wide && "sm:col-span-2"]} style={`--d:${(ii % 3) * 80}ms`}>
              <a href={categoryUrl(it.name)} class="group flex items-center gap-3 px-4 md:px-5 pt-4 md:pt-5 pb-2">
                <div class="min-w-0 flex-1">
                  <p class="phrase font-serif font-semibold leading-snug text-[17px] md:text-lg group-hover:text-rose transition-colors">{it.name}</p>
                  <p class="mt-0.5 text-xs text-neutral-500">
                    {isParent && <span class="mr-1.5 border border-rose text-rose rounded-full px-1.5 leading-[1.5] text-[10px]">まとめ</span>}
                    {it.count}品
                  </p>
                </div>
                <span class="u-5 shrink-0" aria-hidden="true">→</span>
              </a>
              <ol class:list={["px-4 md:px-5 flex-1", wide && "sm:grid sm:grid-cols-3 sm:gap-6"]}>
                {top3.map((r, k) => (
                  <li class:list={["border-t border-ink/8 first:border-t-0", wide && "sm:border-t-0"]}>
                    <a href={productHref(r)} class="group flex items-center gap-3 py-1.5 sm:py-2">
                      <span class:list={["num-display w-5 shrink-0 text-center leading-none", k === 0 ? "text-rose text-[22px]" : "text-ink/40 text-[17px]"]}>{k + 1}</span>
                      <span class:list={["product-well rounded-lg overflow-hidden shrink-0 items-center justify-center", k === 0 ? "flex w-14 h-14" : "hidden sm:flex w-11 h-11"]}>
                        {img(r) ? <img src={img(r)} alt={`${r.brand} ${r.name}`} class="w-[84%] h-[84%] object-contain" loading="lazy" data-err="hide" /> : null}
                      </span>
                      <span class="min-w-0 flex-1">
                        <span class:list={["text-[11px] text-neutral-500 truncate", k === 0 ? "block" : "hidden sm:block"]}>{r.brand}</span>
                        <span class:list={["block text-[13px] leading-snug group-hover:text-rose transition-colors", k === 0 ? "line-clamp-2" : "truncate sm:whitespace-normal sm:line-clamp-2"]}>{k > 0 && <span class="sm:hidden text-neutral-500">{r.brand} </span>}{r.name}</span>
                      </span>
                    </a>
                  </li>
                ))}
              </ol>
              <div class="px-4 md:px-5 pb-3 sm:pb-4 md:pb-5 pt-1 sm:pt-2">
                {isParent && (
                  <ul class="flex sm:flex-wrap gap-1.5 mb-3 -mx-4 px-4 sm:mx-0 sm:px-0 overflow-x-auto sm:overflow-visible [scrollbar-width:none] [&::-webkit-scrollbar]:hidden" aria-label={`${it.name}の種類別ランキング`}>
                    {it.children.map((c) => (
                      <li class="shrink-0">
                        <a href={categoryUrl(c.name)} class="whitespace-nowrap inline-flex items-baseline gap-1 rounded-full border border-ink/12 px-2.5 py-1 text-xs hover:border-rose hover:text-rose transition-colors">
                          {c.name}<span class="num-display text-[10px] text-neutral-400">{c.count}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
                <a href={categoryUrl(it.name)} class="rk-more hidden sm:flex items-center justify-center gap-2 rounded-full py-2 text-xs tracking-wide hover:bg-ink hover:text-paper transition-colors duration-300">
                  {it.name}のTOP{Math.min(50, it.count)}を見る<span aria-hidden="true">→</span>
                </a>
              </div>
            </li>
          );
        })}
      </ul>
    </section>
  ))}
</Layout>

<style>
  .rk-overall {
    background:
      radial-gradient(80% 60% at 0% 0%, color-mix(in srgb, var(--color-pink-100), transparent 30%) 0%, transparent 70%),
      var(--c-panel);
  }
  .rk-first {
    background: linear-gradient(160deg, color-mix(in srgb, var(--color-pink-100), white 35%) 0%, var(--c-well) 100%);
  }
  /* ジャンルの目次：ヘッダーの下に貼り付く帯 */
  .rk-genre {
    background: color-mix(in srgb, var(--color-paper), transparent 12%);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  /* 大分類の番号：輪郭だけの大きな数字 */
  .rk-num {
    color: transparent;
    -webkit-text-stroke: 1px color-mix(in srgb, var(--color-rose), transparent 40%);
  }
  .rk-card {
    box-shadow: 0 0 0 1px rgb(29 21 23 / 0.08);
    transition: box-shadow 0.5s;
  }
  .rk-card:hover {
    box-shadow: 0 0 0 1px rgb(29 21 23 / 0.22), 0 16px 32px -22px rgb(29 21 23 / 0.3);
  }
  .rk-more { background: var(--c-well); }
</style>

{/* 旧URL（/ranking#カテゴリ名）へのリンクを、カテゴリごとのページへ転送する */}
<script is:inline define:vars={{ tags: allTags, base: withBase("/ranking/") }}>
  var h = decodeURIComponent(location.hash.slice(1));
  if (h && tags.indexOf(h) !== -1) location.replace(base + encodeURIComponent(h) + "/");
</script>
