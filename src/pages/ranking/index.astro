---
import Layout from "../../layouts/Layout.astro";
import {
  getRankingPages,
  getRankingNav,
  getCosmeticRankings,
  getCosmeticListEntry,
  productImageSrc,
  categoryUrl,
  cosmeticSlug,
  withBase,
  type CosmeticRanking,
} from "../../lib/data";

const pages = getRankingPages();
const nav = getRankingNav();
const allTags = Array.from(pages.keys());

const img = (r: CosmeticRanking) => productImageSrc(getCosmeticListEntry(r.brand_id, r.name_id), r.rakuten_image_link);
const productHref = (r: CosmeticRanking) => withBase(`/cosmetics/${cosmeticSlug(r.brand_id, r.name_id)}`);

// 各カテゴリの上位の画像を3枚。画像の無い商品は飛ばし、次の順位の画像で埋める
// （「つけまつげ」で3枠のうち2枠が空の白い枠になっていた。195章）。足りない分は空の枠
function topImages(tag: string): { src: string; alt: string }[] {
  const imgs = (pages.get(tag)?.list || [])
    .map((r) => ({ src: img(r), alt: `${r.brand} ${r.name}` }))
    .filter((t) => t.src)
    .slice(0, 3);
  while (imgs.length < 3) imgs.push({ src: "", alt: "" });
  return imgs;
}

// 大分類の英字の小見出し
const GROUP_EN: Record<string, string> = {
  ベースメイク: "Base",
  アイブロウ: "Brow",
  アイメイク: "Eye",
  "チーク・陰影": "Cheek & Contour",
  リップ: "Lip",
  "メイク小物・その他": "Tools",
  スキンケア: "Skincare",
  ヘアケア: "Hair",
  ボディケア: "Body",
  ネイル: "Nail",
  フレグランス: "Fragrance",
};

// 大分類ごとの1位（その大分類のカテゴリに入る商品のうち、人気スコアが最も高いもの。画像のあるものを優先）
const groups = nav.map((g) => {
  const seen = new Map<string, CosmeticRanking>();
  for (const it of g.items) for (const r of pages.get(it.name)?.list || []) seen.set(`${r.brand_id}_${r.name_id}`, r);
  const sorted = Array.from(seen.values()).sort((a, b) => b.score - a.score);
  const champion = sorted.find((r) => img(r)) || sorted[0];
  const pageCount = g.items.reduce((n, it) => n + 1 + (it.kind === "parent" ? it.children.length : 0), 0);
  return { ...g, en: GROUP_EN[g.group] || "Others", champion, productCount: seen.size, pageCount };
});

// 全カテゴリを通した総合の上位3品（ヒーローの表彰台）。画像の無い商品は飛ばす
const overall = getCosmeticRankings()
  .filter((r) => r.tags.some((t) => pages.has(t)))
  .slice()
  .sort((a, b) => b.score - a.score);
const podium = overall.filter((r) => img(r)).slice(0, 3);
const rankedProducts = new Set(allTags.flatMap((t) => pages.get(t)!.list.map((r) => `${r.brand_id}_${r.name_id}`))).size;
// 表彰台の並び（左から2位・1位・3位）
const podiumOrder = [1, 0, 2].filter((i) => podium[i]);
const n2 = (n: number) => String(n).padStart(2, "0");
---

<Layout
  title="コスメ人気ランキング（カテゴリ別）"
  description="YouTubeのコスメ紹介動画での紹介数・再生数・紹介したインフルエンサー数から算出した、カテゴリ別の人気コスメランキング。化粧下地、ファンデーション、アイシャドウ、リップなど、カテゴリを選んで上位50位まで見られます。"
>
  {/* ===== ヒーロー：題と総合トップ3の表彰台 ===== */}
  <header class="grid lg:grid-cols-12 gap-10 lg:gap-12 items-center mb-10 md:mb-16">
    <div class="lg:col-span-6">
      <div class="flex items-center gap-4">
        <p class="eyebrow text-rose">Ranking</p>
        <span class="h-px w-10 bg-ink/25" aria-hidden="true"></span>
        <p class="label-caps text-[11px] text-neutral-500">{groups.length} genres / {allTags.length} rankings</p>
      </div>
      <h1 class="mt-5 font-serif font-semibold text-[34px] leading-[1.25] md:text-[52px] md:leading-[1.18] tracking-[-0.02em] phrase">
        動画が選んだ、<br /><span class="text-rose">いちばん</span>の<br class="md:hidden" />コスメ。
      </h1>
      <p class="mt-6 text-sm leading-[1.95] text-neutral-600 max-w-xl">
        紹介動画の合計再生回数・紹介動画数・紹介したインフルエンサー数から出した人気順です。カテゴリを選ぶと上位50位まで見られます。ファンデーションやアイライナーなどは、まとめた「全般」と種類別のどちらも選べます。PR・提供の紹介は数えていません。
      </p>
      <dl class="mt-8 grid grid-cols-3 max-w-md border-t border-ink/15">
        {[
          { n: groups.length, label: "ジャンル" },
          { n: allTags.length, label: "ランキング" },
          { n: rankedProducts.toLocaleString(), label: "ランクイン", unit: "品" },
        ].map((s, i) => (
          <div class:list={["pt-4 flex flex-col-reverse", i > 0 && "pl-4 sm:pl-5 border-l border-ink/15"]}>
            <dt class="mt-1 text-xs text-neutral-500">{s.label}</dt>
            <dd class="num-display text-[26px] md:text-[32px] leading-none">{s.n}{s.unit && <span class="font-sans font-normal text-xs ml-1 text-neutral-500">{s.unit}</span>}</dd>
          </div>
        ))}
      </dl>
      <div class="mt-8 flex flex-wrap gap-2.5">
        <a href={withBase("/ranking/repeat/")} class="group inline-flex items-center gap-3 rounded-full bg-ink text-paper pl-5 pr-2 py-2 text-sm hover:bg-rose transition-colors duration-500">
          リピートされているコスメ
          <span class="w-7 h-7 rounded-full bg-paper/15 flex items-center justify-center transition-transform duration-500 group-hover:translate-x-0.5" aria-hidden="true">→</span>
        </a>
        <a href={withBase("/feature/")} class="item-2">
          特集：毎日メイク・プチプラ
          <span class="w-7 h-7 rounded-full border border-ink/15 flex items-center justify-center" aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    {podium.length === 3 && (
      <figure class="lg:col-span-6 relative">
        <div class="rk-stage relative rounded-[28px] md:rounded-[36px] overflow-hidden px-3 sm:px-8 pt-10 md:pt-12">
          <figcaption class="relative text-center">
            <p class="label-caps text-[11px] text-rose">Overall top 3</p>
            <p class="mt-1 font-serif text-sm md:text-base font-semibold">全カテゴリ総合</p>
          </figcaption>
          <ol class="relative mt-6 md:mt-8 grid grid-cols-3 items-end gap-2 sm:gap-4">
            {podiumOrder.map((i) => {
              const r = podium[i];
              const first = i === 0;
              return (
                <li class="reveal min-w-0" style={`--d:${first ? 0 : i * 140 + 120}ms`}>
                  <a href={productHref(r)} class="group block">
                    <div class:list={["mx-auto product-well bg-white rounded-full flex items-center justify-center overflow-hidden shadow-[0_18px_40px_-18px_rgb(29_21_23/0.35)] ring-4 ring-white transition-transform duration-700 ease-out-expo group-hover:-translate-y-1.5", first ? "w-[88%] max-w-[190px]" : "w-[76%] max-w-[140px]"]} style="aspect-ratio:1">
                      <img src={img(r)} alt={`${r.brand} ${r.name}`} class="w-[78%] h-[78%] object-contain" data-err="hide" />
                    </div>
                    <div class="mt-3 text-center px-0.5">
                      <p class="text-[10px] sm:text-[11px] tracking-[0.12em] text-neutral-500 truncate">{r.brand}</p>
                      <p class="mt-0.5 text-xs sm:text-[13px] leading-snug line-clamp-2 min-h-[2lh] group-hover:text-rose transition-colors">{r.name}</p>
                    </div>
                    <div class:list={["rk-plinth mt-3 rounded-t-2xl flex flex-col items-center pt-3", first ? "h-[120px] md:h-[150px] is-first" : i === 1 ? "h-[88px] md:h-[110px]" : "h-[66px] md:h-[84px]"]}>
                      <span class:list={["num-display leading-none", first ? "text-[48px] md:text-[60px] text-rose" : "text-[34px] md:text-[42px] text-ink/70"]}>{i + 1}</span>
                      <span class="label-caps text-[10px] text-neutral-500 mt-1">{["st", "nd", "rd"][i]}</span>
                      {first && <span class="hidden sm:block mt-2 text-[11px] text-neutral-500">{r.videoCount}本・{r.channelCount}人が紹介</span>}
                    </div>
                  </a>
                </li>
              );
            })}
          </ol>
        </div>
      </figure>
    )}
  </header>

  {/* ===== 目次：大分類 ===== */}
  <nav aria-label="ジャンル" class="mb-8 md:mb-12 -mx-4 px-4 md:mx-0 md:px-0 overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
    <ol class="flex md:flex-wrap gap-2 w-max md:w-auto">
      {groups.map((g, gi) => (
        <li>
          <a href={`#group-${g.group}`} class="group flex items-center gap-2.5 rounded-full bg-panel pl-1.5 pr-4 py-1.5 shadow-[0_0_0_1px_rgb(29_21_23/0.08)] hover:shadow-[0_0_0_1px_rgb(29_21_23/0.35)] transition-shadow duration-500 whitespace-nowrap">
            <span class="w-8 h-8 rounded-full product-well overflow-hidden flex items-center justify-center shrink-0">
              {g.champion && img(g.champion) ? <img src={img(g.champion)} alt="" class="w-[80%] h-[80%] object-contain" loading="lazy" data-err="hide" /> : null}
            </span>
            <span class="num-display text-xs text-neutral-400">{n2(gi + 1)}</span>
            <span class="text-sm group-hover:text-rose transition-colors">{g.group}</span>
          </a>
        </li>
      ))}
    </ol>
  </nav>

  {/* ===== 大分類ごと：1位の商品と、カテゴリのカード ===== */}
  {groups.map((g, gi) => (
    <section id={`group-${g.group}`} class="panel mb-6 md:mb-8 scroll-mt-28">
      <header class="flex items-end justify-between gap-4 mb-6 md:mb-8">
        <div class="flex items-end gap-4 md:gap-6 min-w-0">
          <span class="rk-num num-display leading-[0.8] text-[56px] md:text-[88px]" aria-hidden="true">{n2(gi + 1)}</span>
          <div class="min-w-0 pb-1">
            <p class="eyebrow text-rose">{g.en}</p>
            <h2 class="mt-1 font-serif h-section font-semibold">{g.group}</h2>
          </div>
        </div>
        <p class="shrink-0 pb-1.5 text-xs text-neutral-500 text-right leading-relaxed">
          <span class="num-display text-sm text-ink">{g.pageCount}</span> ランキング<br class="sm:hidden" /><span class="hidden sm:inline"> ・ </span><span class="num-display text-sm text-ink">{g.productCount.toLocaleString()}</span> 品
        </p>
      </header>

      <div class="grid grid-cols-[minmax(0,1fr)] lg:grid-cols-12 gap-4 md:gap-6">
        {/* この大分類の1位 */}
        {g.champion && (
          <a href={productHref(g.champion)} class="group min-w-0 lg:col-span-4 lg:self-start lg:sticky lg:top-24 rk-champ rounded-2xl p-4 md:p-6 flex lg:flex-col gap-4 lg:gap-0 items-center lg:items-stretch">
            <div class="relative product-well bg-white rounded-xl lg:rounded-2xl overflow-hidden flex items-center justify-center w-24 h-24 sm:w-32 sm:h-32 lg:w-auto lg:h-auto lg:aspect-square shrink-0">
              {img(g.champion) ? <img src={img(g.champion)} alt={`${g.champion.brand} ${g.champion.name}`} class="w-[80%] h-[80%] object-contain transition-transform duration-[1.2s] ease-out-expo group-hover:scale-105" loading="lazy" data-err="hide" /> : null}
              <span class="hidden lg:flex absolute left-0 top-0 items-baseline gap-1 bg-badge rounded-br-2xl pl-4 pr-3.5 pt-2.5 pb-1.5" aria-label="1位">
                <span class="num-display text-rose text-[44px] leading-none">1</span>
                <span class="label-caps text-rose text-[11px]">st</span>
              </span>
            </div>
            <div class="min-w-0 lg:mt-5">
              <p class="label-caps text-[10px] text-rose"><span class="lg:hidden">No.1 ・ </span>{g.group}の1位</p>
              <p class="mt-2 text-xs tracking-[0.12em] text-neutral-500 truncate">{g.champion.brand}</p>
              <p class="mt-0.5 font-serif text-[15px] md:text-lg leading-snug line-clamp-2 group-hover:text-rose transition-colors tighten">{g.champion.name}</p>
              <p class="mt-2 text-xs text-neutral-500"><span class="num-display text-sm text-ink">{g.champion.videoCount}</span>本の動画・<span class="num-display text-sm text-ink">{g.champion.channelCount}</span>人が紹介</p>
            </div>
          </a>
        )}

        {/* カテゴリのカード。「まとめ」は「全般」を開くカードに、種類別のランキングを下に並べる */}
        <ul class:list={["min-w-0 grid grid-cols-2 gap-3 md:gap-4 grid-flow-row-dense content-start", g.champion ? "lg:col-span-8" : "lg:col-span-12", "sm:grid-cols-2", g.items.length >= 3 && "xl:grid-cols-3"]}>
          {g.items.map((it, ii) => {
            const imgs = topImages(it.name);
            const top = pages.get(it.name)?.list[0];
            const isParent = it.kind === "parent";
            return (
              <li class:list={["reveal rk-card rounded-2xl min-w-0", isParent ? "col-span-2 sm:grid sm:grid-cols-2 sm:items-start" : "flex flex-col"]} style={`--d:${(ii % 6) * 70}ms`}>
                <a href={categoryUrl(it.name)} class="group block min-w-0 p-3 md:p-4 flex-1">
                  <div class:list={["grid grid-cols-[1.55fr_1fr] grid-rows-2 gap-1.5", isParent ? "aspect-[2/1] sm:aspect-[16/10]" : "aspect-[16/10]"]}>
                    {imgs.map(({ src, alt }, k) => (
                      <div class:list={["relative product-well rounded-xl overflow-hidden flex items-center justify-center", k === 0 && "row-span-2"]}>
                        {src ? <img src={src} alt={alt} class:list={["object-contain transition-transform duration-[1.2s] ease-out-expo", k === 0 ? "w-[78%] h-[78%] group-hover:scale-105" : "w-[80%] h-[80%]"]} loading="lazy" data-err="hide" /> : null}
                        {src && <span class:list={["absolute left-1.5 top-1 num-display leading-none", k === 0 ? "text-rose text-[20px] md:text-[22px]" : "text-ink/45 text-[13px]"]} aria-hidden="true">{k + 1}</span>}
                      </div>
                    ))}
                  </div>
                  <div class="mt-3 md:mt-4 flex items-start gap-2">
                    <div class="min-w-0 flex-1">
                      <p class="phrase font-serif font-semibold leading-snug text-[15px] md:text-[17px] group-hover:text-rose transition-colors">{it.name}</p>
                      <p class="mt-1 text-xs text-neutral-500">
                        {isParent && <span class="mr-1.5 whitespace-nowrap border border-rose text-rose rounded-full px-1.5 leading-[1.5] text-[10px]">まとめ</span>}
                        <span class="whitespace-nowrap">{it.count}品</span>
                      </p>
                    </div>
                    <span class="u-5 shrink-0 mt-0.5" aria-hidden="true">→</span>
                  </div>
                  {top && <p class="hidden sm:block mt-2 pt-2 border-t border-ink/8 text-[11px] text-neutral-500 truncate"><span class="text-rose font-semibold mr-1">1位</span>{top.brand} {top.name}</p>}
                </a>
                {isParent && (
                  <div class="min-w-0 px-3 md:px-4 pb-3 md:pb-4 sm:pt-4 md:pt-5 sm:pl-1">
                    <p class="label-caps text-[10px] text-neutral-400 mb-2">種類別</p>
                    <ul class="flex flex-wrap gap-1.5">
                      {it.children.map((c) => (
                        <li>
                          <a href={categoryUrl(c.name)} class="inline-flex items-baseline gap-1.5 rounded-full border border-ink/12 px-2.5 py-1 text-xs hover:border-rose hover:text-rose transition-colors">
                            {c.name}<span class="num-display text-[10px] text-neutral-400">{c.count}</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
              </li>
            );
          })}
        </ul>
      </div>
    </section>
  ))}
</Layout>

<style>
  /* 表彰台の背景：薄いピンクの面に、上から光が差すような淡いグラデーション */
  .rk-stage {
    background:
      radial-gradient(120% 70% at 50% 0%, var(--color-pink-100) 0%, transparent 70%),
      linear-gradient(180deg, color-mix(in srgb, var(--color-pink-100), white 55%) 0%, var(--c-panel) 100%);
    box-shadow: var(--panel-shadow);
  }
  .rk-plinth {
    background: linear-gradient(180deg, color-mix(in srgb, var(--c-well), #1d1517 4%) 0%, var(--c-well) 100%);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.9);
  }
  .rk-plinth.is-first {
    background: linear-gradient(180deg, var(--color-pink-100) 0%, color-mix(in srgb, var(--color-pink-100), white 50%) 100%);
  }
  /* 大分類の番号：輪郭だけの大きな数字 */
  .rk-num {
    color: transparent;
    -webkit-text-stroke: 1px color-mix(in srgb, var(--color-rose), transparent 45%);
  }
  .rk-champ {
    background: linear-gradient(160deg, color-mix(in srgb, var(--color-pink-100), white 40%) 0%, var(--c-well) 100%);
  }
  .rk-card {
    box-shadow: 0 0 0 1px rgb(29 21 23 / 0.08);
    transition: box-shadow 0.5s, transform 0.6s var(--ease-out-expo);
  }
  .rk-card:hover {
    box-shadow: 0 0 0 1px rgb(29 21 23 / 0.25), 0 16px 32px -20px rgb(29 21 23 / 0.3);
  }
</style>

{/* 旧URL（/ranking#カテゴリ名）へのリンクを、カテゴリごとのページへ転送する */}
<script is:inline define:vars={{ tags: allTags, base: withBase("/ranking/") }}>
  var h = decodeURIComponent(location.hash.slice(1));
  if (h && tags.indexOf(h) !== -1) location.replace(base + encodeURIComponent(h) + "/");
</script>
