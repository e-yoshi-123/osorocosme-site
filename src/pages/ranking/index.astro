---
import Layout from "../../layouts/Layout.astro";
import { getRankingPages, getRankingNav, getCosmeticListEntry, extractImageSrc, categoryUrl, withBase } from "../../lib/data";

const pages = getRankingPages();
const nav = getRankingNav();
const allTags = Array.from(pages.keys());

// 大分類ごとに、実際の並び順を保ったまま「単独カテゴリの並び」と「まとめ（種類を束ねた枠）」のブロックにする。
// （単独カテゴリをまとめの後ろにまとめて置くと、まとめの中身のように見えてしまうため）
type Item = (typeof nav)[number]["items"][number];
type Block = { kind: "singles"; items: Extract<Item, { kind: "single" }>[] } | { kind: "parent"; item: Extract<Item, { kind: "parent" }> };
function toBlocks(items: Item[]): Block[] {
  const blocks: Block[] = [];
  for (const it of items) {
    if (it.kind === "parent") blocks.push({ kind: "parent", item: it });
    else {
      const last = blocks[blocks.length - 1];
      if (last && last.kind === "singles") last.items.push(it);
      else blocks.push({ kind: "singles", items: [it] });
    }
  }
  return blocks;
}

// 各カテゴリの1〜3位の画像（カテゴリの雰囲気が分かるように）
function topImages(tag: string): string[] {
  return (pages.get(tag)?.list || [])
    .slice(0, 3)
    .map((r) => extractImageSrc(getCosmeticListEntry(r.brand_id, r.name_id)?.rakuten_image_link || r.rakuten_image_link) || "");
}
---

<Layout
  title="コスメ人気ランキング（カテゴリ別）"
  description="YouTubeのコスメ紹介動画での紹介数・再生数・紹介したインフルエンサー数から算出した、カテゴリ別の人気コスメランキング。化粧下地、ファンデーション、アイシャドウ、リップなど、カテゴリを選んで上位50位まで見られます。"
>
  <h1 class="text-xl font-bold mb-2">コスメランキング</h1>
  <p class="text-xs text-neutral-500 mb-6">
    見たいカテゴリを選んでください。ファンデーションやアイライナーなどは、細かい種類をまとめた「全般」のランキングと、種類別のランキングの両方を見られます。紹介動画の合計再生回数・紹介動画数・紹介したインフルエンサー数から算出した人気スコア順で、各カテゴリの上位50位まで見られます。
  </p>

  {
    nav.map((g) => (
      <section class="mb-10">
        <h2 class="text-lg font-bold mb-4 pl-3 border-l-4 border-pink-500">{g.group}</h2>
        <div class="space-y-4">
          {toBlocks(g.items).map((blk) =>
            blk.kind === "singles" ? (
              <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3">
                {blk.items.map((it) => (
                  <a href={categoryUrl(it.name)} class="min-w-0 block bg-white rounded-lg shadow-sm hover:shadow-md transition p-3">
                    <div class="flex gap-1 mb-2">
                      {topImages(it.name).map((src) => (
                        <div class="flex-1 aspect-square bg-neutral-50 rounded overflow-hidden flex items-center justify-center">
                          {src ? <img src={src} alt="" class="max-w-full max-h-full object-contain" loading="lazy" onerror="this.style.visibility='hidden'" /> : null}
                        </div>
                      ))}
                    </div>
                    <p class="font-medium text-sm truncate">{it.name}</p>
                    <p class="text-xs text-neutral-400">{it.count}品</p>
                  </a>
                ))}
              </div>
            ) : (
              <div class="rounded-xl border-2 border-pink-200 bg-pink-50/50 p-3">
                <a href={categoryUrl(blk.item.name)} class="min-w-0 flex items-center gap-3 bg-white rounded-lg shadow-sm hover:shadow-md transition p-3 mb-3">
                  <div class="flex gap-1 w-36 sm:w-44 shrink-0">
                    {topImages(blk.item.name).map((src) => (
                      <div class="flex-1 aspect-square bg-neutral-50 rounded overflow-hidden flex items-center justify-center">
                        {src ? <img src={src} alt="" class="max-w-full max-h-full object-contain" loading="lazy" onerror="this.style.visibility='hidden'" /> : null}
                      </div>
                    ))}
                  </div>
                  <div class="min-w-0">
                    <p class="font-bold">{blk.item.name} <span class="ml-1 text-[11px] font-normal text-white bg-pink-600 rounded px-1.5 py-0.5 align-middle">まとめて見る</span></p>
                    <p class="text-xs text-neutral-500 mt-0.5">{blk.item.count}品 ／ 下の種類をまとめたランキング</p>
                  </div>
                </a>
                <p class="text-[11px] text-neutral-500 mb-2 px-1">種類別のランキング</p>
                <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-2">
                  {blk.item.children.map((c) => (
                    <a href={categoryUrl(c.name)} class="min-w-0 block bg-white rounded-lg shadow-sm hover:shadow-md transition p-2.5">
                      <div class="flex gap-1 mb-1.5">
                        {topImages(c.name).map((src) => (
                          <div class="flex-1 aspect-square bg-neutral-50 rounded overflow-hidden flex items-center justify-center">
                            {src ? <img src={src} alt="" class="max-w-full max-h-full object-contain" loading="lazy" onerror="this.style.visibility='hidden'" /> : null}
                          </div>
                        ))}
                      </div>
                      <p class="font-medium text-sm truncate">{c.name}</p>
                      <p class="text-xs text-neutral-400">{c.count}品</p>
                    </a>
                  ))}
                </div>
              </div>
            )
          )}
        </div>
      </section>
    ))
  }
</Layout>

<!-- 旧URL（/ranking#カテゴリ名）へのリンクを、カテゴリごとのページへ転送する -->
<script is:inline define:vars={{ tags: allTags, base: withBase("/ranking/") }}>
  var h = decodeURIComponent(location.hash.slice(1));
  if (h && tags.indexOf(h) !== -1) location.replace(base + encodeURIComponent(h) + "/");
</script>
