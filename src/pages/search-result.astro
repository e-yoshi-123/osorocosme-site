---
import Layout from "../layouts/Layout.astro";
---

<Layout title="検索結果" noindex>
  <header class="mb-10 pb-8 border-b border-ink/15">
    <p class="eyebrow">Search</p>
    <h1 class="mt-2 font-serif font-semibold text-[26px] md:text-[30px] leading-[1.35]">検索結果：<span id="search-query" class="text-rose"></span></h1>
    <p id="search-count" class="mt-3 text-sm text-neutral-500"></p>
  </header>
  <div id="search-results" class="grid sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-x-6 gap-y-10 [&>*]:min-w-0"></div>
  <p id="search-empty" class="text-neutral-400 hidden">該当する動画が見つかりませんでした。</p>
</Layout>

<script>
  interface SearchItem {
    key: string;
    title: string;
    channel_title: string;
    description: string;
    thumbnail: string;
    published_at: string;
    cosmetics: { brand: string; name: string }[];
  }

  const base = import.meta.env.BASE_URL.endsWith("/")
    ? import.meta.env.BASE_URL.slice(0, -1)
    : import.meta.env.BASE_URL;

  const params = new URLSearchParams(location.search);
  const q = (params.get("q") || "").trim();
  document.getElementById("search-query")!.textContent = q;

  if (q) {
    fetch(`${base}/search-index.json`)
      .then((r) => r.json())
      .then((items: SearchItem[]) => {
        const needle = q.toLowerCase();
        const matched = items.filter((v) => {
          if (v.title.toLowerCase().includes(needle)) return true;
          if (v.channel_title.toLowerCase().includes(needle)) return true;
          if (v.description.toLowerCase().includes(needle)) return true;
          return v.cosmetics.some(
            (c) => c.brand.toLowerCase().includes(needle) || c.name.toLowerCase().includes(needle)
          );
        });

        document.getElementById("search-count")!.textContent = `${matched.length}件見つかりました`;
        const grid = document.getElementById("search-results")!;
        if (matched.length === 0) {
          document.getElementById("search-empty")!.classList.remove("hidden");
        }
        for (const v of matched) {
          const a = document.createElement("a");
          a.href = `${base}/video/${v.key}/`;
          a.className = "group block min-w-0";
          a.innerHTML = `
            <span class="block overflow-hidden rounded-2xl bg-neutral-200"><img src="${v.thumbnail}" alt="" class="w-full aspect-video object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" /></span>
            <span class="block pt-3">
              <span class="block text-xs text-neutral-500 truncate mb-1">${v.channel_title}</span>
              <span class="block text-sm leading-relaxed line-clamp-2 group-hover:text-rose transition-colors">${v.title}</span>
            </span>`;
          grid.appendChild(a);
        }
      });
  } else {
    document.getElementById("search-count")!.textContent = "検索キーワードを入力してください";
  }
</script>
