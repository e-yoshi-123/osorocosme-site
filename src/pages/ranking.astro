---
import Layout from "../layouts/Layout.astro";
import CosmeticCard from "../components/CosmeticCard.astro";
import { getCosmeticRankings, RANKING_CATEGORY_GROUPS } from "../lib/data";

const TOP_N = 5;
const rankings = getCosmeticRankings();

// タグごとにスコア降順で並べる（同点は紹介動画数→名前で安定化）
const rankingByTag = new Map<string, typeof rankings>();
for (const r of rankings) {
  for (const t of r.tags) {
    if (!rankingByTag.has(t)) rankingByTag.set(t, []);
    rankingByTag.get(t)!.push(r);
  }
}
for (const list of rankingByTag.values()) {
  list.sort((a, b) => b.score - a.score || b.videoCount - a.videoCount || a.name.localeCompare(b.name, "ja"));
}

// 大分類 → 肌に載せる順のカテゴリ。定義に無いタグは「その他」へ。
const known = new Set(RANKING_CATEGORY_GROUPS.flatMap((g) => g.tags));
const unknownTags = Array.from(rankingByTag.keys()).filter((t) => !known.has(t));
const groups = [...RANKING_CATEGORY_GROUPS, { group: "その他", tags: unknownTags }]
  .map((g) => ({ group: g.group, tags: g.tags.filter((t) => rankingByTag.has(t)) }))
  .filter((g) => g.tags.length > 0);
const allTags = groups.flatMap((g) => g.tags);
---

<Layout title="ランキング">
  <h1 class="text-xl font-bold mb-2">コスメランキング</h1>
  <p class="text-xs text-neutral-500 mb-6">
    紹介動画の合計再生回数・紹介動画数・紹介したインフルエンサー数から算出した人気スコア順です。
  </p>

  <div class="flex gap-8">
    <aside class="hidden md:block w-56 shrink-0">
      <div class="sticky top-20 max-h-[calc(100vh-6rem)] overflow-y-auto space-y-4 text-sm">
        {
          groups.map((g) => (
            <div>
              <div class="text-xs font-bold text-neutral-500 border-b mb-1 pb-1">{g.group}</div>
              <ul class="space-y-0.5">
                {g.tags.map((tag) => (
                  <li>
                    <button class="tag-select w-full text-left px-2 py-1 rounded hover:bg-pink-50" data-tag={tag}>
                      {tag} <span class="text-neutral-400">({rankingByTag.get(tag)!.length})</span>
                    </button>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </aside>

    <div class="flex-1 min-w-0">
      <select id="tag-select-mobile" class="md:hidden w-full border rounded px-3 py-2 mb-6">
        {
          groups.map((g) => (
            <optgroup label={g.group}>
              {g.tags.map((tag) => <option value={tag}>{tag}（{rankingByTag.get(tag)!.length}件）</option>)}
            </optgroup>
          ))
        }
      </select>

      {
        allTags.map((tag, i) => (
          <section class="ranking-block" data-tag={tag} style={i === 0 ? "" : "display:none"}>
            <h2 class="font-bold mb-3">{tag} 人気ランキング TOP{TOP_N}</h2>
            <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-4 mb-10">
              {rankingByTag.get(tag)!.slice(0, TOP_N).map((c, idx) => (
                <div class="relative">
                  <span class="absolute top-1 left-1 z-10 bg-pink-600 text-white text-xs font-bold rounded px-2 py-0.5">
                    {idx + 1}位
                  </span>
                  <CosmeticCard
                    brand_id={c.brand_id}
                    brand={c.brand}
                    name_id={c.name_id}
                    name={c.name}
                    rakutenImageHtml={c.rakuten_image_link}
                  />
                  <p class="text-xs text-neutral-500 mt-1 px-1">
                    紹介動画 {c.videoCount}本 ／ {c.channelCount}チャンネル
                  </p>
                </div>
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </div>
</Layout>

<script>
  function showTag(tag: string) {
    document.querySelectorAll<HTMLElement>(".ranking-block").forEach((el) => {
      el.style.display = el.dataset.tag === tag ? "" : "none";
    });
    document.querySelectorAll<HTMLElement>(".tag-select").forEach((el) => {
      el.classList.toggle("bg-pink-100", el.dataset.tag === tag);
    });
  }

  document.querySelectorAll<HTMLButtonElement>(".tag-select").forEach((btn) => {
    btn.addEventListener("click", () => showTag(btn.dataset.tag!));
  });

  showTag(document.querySelector<HTMLElement>(".ranking-block")!.dataset.tag!);

  const mobileSelect = document.getElementById("tag-select-mobile") as HTMLSelectElement | null;
  mobileSelect?.addEventListener("change", () => showTag(mobileSelect.value));
</script>
