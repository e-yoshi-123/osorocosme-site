---
import Layout from "../../layouts/Layout.astro";
import BeautyProfile from "../../components/BeautyProfile.astro";
import ShareButtons from "../../components/ShareButtons.astro";
import VideoCard from "../../components/VideoCard.astro";
import CosmeticCard from "../../components/CosmeticCard.astro";
import InfluencerLinks from "../../components/InfluencerLinks.astro";
import SectionHead from "../../components/SectionHead.astro";
import PrBadge from "../../components/PrBadge.astro";
import BrandFlag from "../../components/BrandFlag.astro";
import {
  getAllInfluencers,
  getInfluencerByChannelId,
  getVideosByChannel,
  getSimilarInfluencers,
  getInfluencerHighlights,
  getCosmeticListEntry,
  productOffer,
  amazonSearchUrl,
  cosmeticSlug,
  sortByPublishedDesc,
  groupTagsByCategory,
  withBase,
  formatCount,
  breadcrumbLd,
  type Cosmetic,
  formatJaDate,
  jstDate,
  getPrInfo,
  isPrMention,
  isOwnBrandMention,
  getInfluencerProfile,
  getOwnBrandIds,
  getOwnProducts,
  getBrandName,
  cosmeticCategory,
} from "../../lib/data";

export function getStaticPaths() {
  return getAllInfluencers().map((i) => ({ params: { channel_id: i.channel_id } }));
}

const { channel_id } = Astro.params;
const influencer = getInfluencerByChannelId(channel_id!);
const videos = sortByPublishedDesc(getVideosByChannel(channel_id!));
const similar = getSimilarInfluencers(channel_id!);

// 使用コスメ遍歴を動画（投稿日）単位のタイムラインにする。動画は投稿日降順。
const timeline = videos
  .map((v) => ({
    video: v,
    items: (v.cosmetics || []).filter((c: Cosmetic) => c.brand && c.name),
  }))
  .filter((b) => b.items.length > 0);

const formatDate = formatJaDate;
// PR・提供としての紹介（動画全体がPR、またはブランド・商品の指定。197章）。カードと動画のサムネイルに「PR」の印を付ける（213章）
const prCount = timeline.reduce((n, b) => n + b.items.filter((c) => isPrMention(b.video.key, c.brand_id, c.name_id)).length, 0);
// 本人が言ったパーソナルカラー・肌質と、本人のブランド（ユーザー判断、307章）
const selfProfile = influencer ? getInfluencerProfile(influencer.channel_id) : undefined;
const ownBrands = influencer ? getOwnBrandIds(influencer.channel_id).map((id) => ({ id, name: getBrandName(id) })).filter((b) => b.name) : [];
const ownCount = timeline.reduce((n, b) => n + b.items.filter((c) => isOwnBrandMention(b.video.key, c.brand_id, c.name_id)).length, 0);

// カテゴリごとの紹介コスメ数（同じコスメが複数動画に出ても動画ごとに数える）
const tagCounts = new Map<string, number>();
let totalItems = 0;
for (const b of timeline) {
  for (const c of b.items) {
    totalItems++;
    for (const t of c.related_tags || []) tagCounts.set(t, (tagCounts.get(t) || 0) + 1);
  }
}
const groups = groupTagsByCategory(tagCounts.keys());
// 大分類ごとの紹介数（複数タグを持つコスメを二重に数えないよう、コスメ単位で判定）
const groupCounts = new Map<string, number>();
for (const g of groups) {
  const set = new Set(g.tags);
  let n = 0;
  for (const b of timeline) for (const c of b.items) if ((c.related_tags || []).some((t) => set.has(t))) n++;
  groupCounts.set(g.group, n);
}
// タイトルの品数は、同じコスメを何度紹介しても1品と数える（271章）
const uniqueItems = new Set(timeline.flatMap((b) => b.items.map((c) => `${c.brand_id}_${c.name_id}`))).size;
// よく紹介しているコスメ（301章）：2本以上の動画で紹介した商品を、本数の多い順に10品まで（PR・提供の紹介は数えない。画像のあるものだけ）。
// 検索の「〇〇 愛用コスメ」に対して、遍歴（動画ごと）より先に答えになる節で、価格と購入ボタンもここに置く。3品に届かない人には出さない
const TOP_MIN_VIDEOS = 2;
const TOP_LIMIT = 10;
const topCosmetics = getInfluencerHighlights(channel_id!, 0, TOP_LIMIT)
  .topCosmetics.filter((c) => c.videoCount >= TOP_MIN_VIDEOS)
  .map((c) => {
    const entry = getCosmeticListEntry(c.brand_id, c.name_id);
    const offer = productOffer(entry);
    return { ...c, slug: cosmeticSlug(c.brand_id, c.name_id), price: offer.price, fromYahoo: offer.source === "yahoo", rakutenLink: offer.rakutenLink, yahooLink: entry?.yahoo_text_link || undefined };
  });
const showTop = topCosmetics.length >= 3;
// 本人がプロデュースしたコスメ（ユーザー依頼、321章）。紹介の多い順に、画像・価格・購入先つきで並べる
const OWN_LIMIT = 10;
const ownProducts = influencer
  ? getOwnProducts(influencer.channel_id).slice(0, OWN_LIMIT).map((c) => {
      const entry = getCosmeticListEntry(c.brand_id, c.name_id);
      const offer = productOffer(entry);
      return { ...c, slug: cosmeticSlug(c.brand_id, c.name_id), price: offer.price, fromYahoo: offer.source === "yahoo", rakutenLink: offer.rakutenLink, yahooLink: entry?.yahoo_text_link || undefined };
    })
  : [];
// 節の番号（プロデュースしたコスメ・よく紹介しているコスメは、ある人だけ）
const secNums = (() => {
  let n = 0;
  const next = () => String(++n).padStart(2, "0");
  return { own: ownProducts.length > 0 ? next() : "", top: showTop ? next() : "", history: next(), videos: next() };
})();
const repeatCount = topCosmetics.filter((c) => c.repeat).length;
const description = influencer
  ? `${influencer.channel_title}のコスメ紹介動画${videos.length}本から、使用コスメ${totalItems}品をカテゴリ別・投稿日順にまとめています。` +
    (showTop ? `よく紹介しているのは${topCosmetics.slice(0, 3).map((c) => `${c.brand}「${c.name}」`).join("、")}。` : "") +
    "いつどのコスメを紹介していたか、使用コスメの変遷を確認できます。"
  : undefined;
const jsonLd = influencer
  ? [
      {
        "@context": "https://schema.org",
        "@type": "Person",
        name: influencer.channel_title,
        ...(influencer.channel_icon ? { image: influencer.channel_icon } : {}),
        url: `https://www.youtube.com/channel/${influencer.channel_id}`,
      },
      breadcrumbLd(
        [{ name: "ホーム", path: "/" }, { name: "インフルエンサー一覧", path: "/influencer-list" }, { name: influencer.channel_title, path: `/influencer/${influencer.channel_id}` }],
        Astro.site!
      ),
    ]
  : [];
---

<Layout title={influencer ? `${influencer.channel_title}のメイク・愛用コスメ一覧（${uniqueItems}品）` : "インフルエンサー詳細"} description={description} image={influencer?.channel_icon} jsonLd={jsonLd}>
  {
    !influencer ? (
      <p class="text-neutral-500">インフルエンサーが見つかりませんでした。</p>
    ) : (
      <>
        {/* ===== プロフィール：雑誌の人物紹介のように ===== */}
        <section class="panel grid md:grid-cols-12 gap-8 md:gap-12 items-center">
          <div class="md:col-span-4 lg:col-span-4">
            <div class="relative w-[62%] md:w-full max-w-[300px] mx-auto mt-5 md:mt-0 aspect-square">
              <svg viewBox="0 0 100 100" class="absolute -inset-[9%] w-[118%] h-[118%] overflow-visible" aria-hidden="true">
                <circle cx="50" cy="50" r="49" fill="none" stroke="var(--color-ink)" stroke-opacity="0.15" stroke-width="0.3" />
                <circle cx="50" cy="50" r="49" fill="none" stroke="var(--color-rose)" stroke-width="0.6" stroke-dasharray="40 268" class="origin-center [animation:spin_24s_linear_infinite] motion-reduce:[animation:none]" />
              </svg>
              {influencer.channel_icon ? (
                <img referrerpolicy="no-referrer" src={influencer.channel_icon.replace(/=s\d+-/, "=s400-")} alt={influencer.channel_title} width="300" height="300" class="w-full h-full rounded-full object-cover" />
              ) : <span class="block w-full h-full rounded-full bg-blush" />}
            </div>
          </div>
          <div class="md:col-span-8 lg:col-span-8">
            <p class="eyebrow">Influencer profile</p>
            <h1 class="mt-3 font-serif font-semibold h-page tracking-[-0.02em] text-balance">{influencer.channel_title}</h1>
            {/* 説明文は画面に出さない（すぐ下の数字・よく紹介しているコスメと同じ内容のため）。検索結果の説明（meta description）には残す（320章） */}
            <dl class="mt-8 grid grid-cols-3 max-w-xl border-y border-ink/15 divide-x divide-ink/15">
              <div class="py-4 pr-3"><dt class="u-11">紹介動画</dt><dd class="num-display text-[24px] md:text-[26px] leading-none mt-1">{videos.length}<span class="font-sans text-xs text-neutral-500 ml-1">本</span></dd></div>
              <div class="py-4 px-3 md:px-5"><dt class="u-11">使用コスメ</dt><dd class="num-display text-[24px] md:text-[26px] leading-none mt-1">{totalItems}<span class="font-sans text-xs text-neutral-500 ml-1">品</span></dd></div>
              <div class="py-4 px-3 md:px-5"><dt class="u-11">登録者</dt><dd class="num-display text-[24px] md:text-[26px] leading-none mt-1">{influencer.subscriber_count ? formatCount(Number(influencer.subscriber_count) >= 10000 ? Math.round(Number(influencer.subscriber_count) / 10000) : Number(influencer.subscriber_count)) : "—"}<span class="font-sans text-xs text-neutral-500 ml-1">{Number(influencer.subscriber_count) >= 10000 ? "万人" : "人"}</span></dd></div>
            </dl>
            {/* 本人が言ったパーソナルカラー・肌質・顔タイプと、本人のブランド（307・311章） */}
            <BeautyProfile channel_id={influencer.channel_id} profile={selfProfile} ownBrands={ownBrands} />
            <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
              {/* 投稿者のチャンネルへ送る導線（181章） */}
              <a href={`https://www.youtube.com/channel/${influencer.channel_id}`} target="_blank" rel="noopener" class="group u-13">
                <span class="u-23" aria-hidden="true"></span>YouTubeチャンネルを見る<span class="u-15" aria-hidden="true">→</span>
              </a>
              <ShareButtons text={`${influencer.channel_title}さんの使用コスメ一覧・愛用コスメ遍歴`} />
            </div>
            {/* インフルエンサー本人向けの案内（掲載の停止・訂正。184章） */}
            <p class="mt-6 text-xs text-neutral-500">インフルエンサーの方へ：<a href={withBase("/for-creators")} class="link-u text-ink">掲載の停止・訂正のご依頼はこちら</a></p>
          </div>
        </section>

        {ownProducts.length > 0 && (
          <section class="panel u-14">
            <SectionHead
              num={secNums.own}
              en="Produce"
              title="プロデュースしたコスメ"
              lead={`${influencer.channel_title}がプロデュースしたブランド（${ownBrands.map((b) => b.name).join("・") || "ライン"}）のコスメのうち、動画で紹介されたもの${ownProducts.length}品を、紹介の多い順に並べています（本人による紹介は、ランキングには数えていません）。価格は楽天市場（無ければYahoo!ショッピング）で確認した時点の参考価格です。`}
            />
            <ul class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-x-4 gap-y-8">
              {ownProducts.map((c) => (
                <li class="min-w-0 group">
                  <a href={withBase(`/cosmetics/${c.slug}`)} class="product-well overflow-hidden tile-4" tabindex="-1" aria-hidden="true">
                    {c.imageSrc ? <img src={c.imageSrc} alt="" class="tile-1" loading="lazy" data-err="noimg" /> : <span class="noimg">No image</span>}
                  </a>
                  <a href={withBase(`/cosmetics/${c.slug}`)} class="block">
                    <p class="tile-3"><BrandFlag brand_id={c.brand_id} />{c.brand}</p>
                    <p class="phrase tile-name mt-1">{c.name}</p>
                  </a>
                  <p class="u-2">{c.videoCount}本で紹介</p>
                  <p class="tc-act">
                    {c.price !== undefined && <span class="num-display tc-price" title={c.fromYahoo ? "Yahoo!ショッピングの参考価格" : "楽天市場の参考価格"}>¥{formatCount(c.price)}</span>}
                    <span class="tc-shops">
                      {c.rakutenLink && <a href={c.rakutenLink} target="_blank" rel="nofollow sponsored noopener" title="楽天市場で見る">楽天</a>}
                      {c.yahooLink && <a href={c.yahooLink} target="_blank" rel="nofollow sponsored noopener" title="Yahoo!ショッピングで見る">Yahoo!</a>}
                      <a href={amazonSearchUrl(c.brand, c.name)} target="_blank" rel="nofollow sponsored noopener" title="Amazonで探す（検索結果）">Amazon</a>
                    </span>
                  </p>
                </li>
              ))}
            </ul>
            {ownBrands.length > 0 && (
              <p class="mt-6 text-sm">{ownBrands.map((b, i) => <>{i > 0 && "・"}<a href={withBase(`/brand/${b.id}`)} class="link-u text-ink">{b.name}のコスメをすべて見る</a></>)}</p>
            )}
            <p class="mt-5 text-xs text-neutral-500">PR：リンク先での購入により、当サイトに報酬が支払われることがあります。</p>
          </section>
        )}

        {showTop && (
          <section class="panel u-14">
            <SectionHead
              num={secNums.top}
              en="Most featured"
              title="よく紹介しているコスメ"
              lead={`${TOP_MIN_VIDEOS}本以上の動画で紹介したコスメを、本数の多い順に${topCosmetics.length}品。PR・提供の紹介は数えていません。${repeatCount > 0 ? "「リピート」は、日をあけた別の動画でも使っていたコスメです。" : ""}価格は楽天市場（無ければYahoo!ショッピング）で確認した時点の参考価格です。`}
            />
            <ul class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-x-4 gap-y-8">
              {topCosmetics.map((c) => (
                <li class="min-w-0 group">
                  <a href={withBase(`/cosmetics/${c.slug}`)} class="product-well overflow-hidden tile-4" tabindex="-1" aria-hidden="true">
                    <img src={c.imageSrc} alt="" class="tile-1" loading="lazy" data-err="noimg" />
                  </a>
                  <a href={withBase(`/cosmetics/${c.slug}`)} class="block">
                    <p class="tile-3"><BrandFlag brand_id={c.brand_id} />{c.brand}</p>
                    <p class="phrase tile-name mt-1">{c.name}</p>
                  </a>
                  <p class="u-2 flex flex-wrap items-center gap-x-2 gap-y-1">
                    <span>{c.videoCount}本で紹介</span>
                    {c.repeat && <span class="inline-flex items-center rounded-full border border-rose text-rose px-1.5 py-[2px] leading-none font-semibold">リピート</span>}
                  </p>
                  <p class="tc-act">
                    {c.price !== undefined && <span class="num-display tc-price" title={c.fromYahoo ? "Yahoo!ショッピングの参考価格" : "楽天市場の参考価格"}>¥{formatCount(c.price)}</span>}
                    <span class="tc-shops">
                      {c.rakutenLink && <a href={c.rakutenLink} target="_blank" rel="nofollow sponsored noopener" title="楽天市場で見る">楽天</a>}
                      {c.yahooLink && <a href={c.yahooLink} target="_blank" rel="nofollow sponsored noopener" title="Yahoo!ショッピングで見る">Yahoo!</a>}
                      <a href={amazonSearchUrl(c.brand, c.name)} target="_blank" rel="nofollow sponsored noopener" title="Amazonで探す（検索結果）">Amazon</a>
                    </span>
                  </p>
                </li>
              ))}
            </ul>
            <p class="mt-5 text-xs text-neutral-500">PR：リンク先での購入により、当サイトに報酬が支払われることがあります。</p>
          </section>
        )}

        {timeline.length > 0 && (
          <section class="panel u-14">
            <SectionHead num={secNums.history} en="Cosme history" title="使用コスメ遍歴" lead={`動画ごとに、紹介したコスメを新しい順に並べています。カテゴリで絞り込めます。${prCount > ownCount ? "「PR」の印は、PR・提供として紹介されたコスメです（ランキングには数えていません）。" : ""}${ownCount > 0 ? "「本人のブランド」の印は、本人がプロデュースしたブランドのコスメです（ランキングには数えていません）。" : ""}`} />

            <div class="filter-sentinel" aria-hidden="true"></div>
            <div class="filter-bar sticky top-[var(--hdr-h,97px)] z-20 bg-panel/90 backdrop-blur-md py-3 mb-10 border-b border-ink/10 text-sm -mx-4 px-4 md:mx-0 md:px-0">
              <div class="flex items-start gap-3">
              <div class="min-w-0 flex-1">
              <div class="flex flex-nowrap sm:flex-wrap gap-1.5 overflow-x-auto sm:overflow-visible -ml-4 pl-4 pr-7 sm:ml-0 sm:px-0 pb-1 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden [mask-image:linear-gradient(to_right,#000_calc(100%-28px),transparent)] sm:[mask-image:none]">
                <button class="group-tab tab shrink-0 whitespace-nowrap" data-group="__all__">
                  すべて <span class="tab-n">{totalItems}</span>
                </button>
                {groups.map((g) => (
                  <button class="group-tab tab shrink-0 whitespace-nowrap" data-group={g.group} data-tags={g.tags.join("|")}>
                    {g.group} <span class="tab-n">{groupCounts.get(g.group)}</span>
                  </button>
                ))}
              </div>
              {groups.map((g) => (
                <div class="chip-row inf-1" data-group={g.group} style="display:none">
                  {g.tags.map((t) => (
                    <button class="chip cat-chip u-17" data-tag={t}>
                      {t} <span class="tab-n">{tagCounts.get(t)}</span>
                    </button>
                  ))}
                </div>
              ))}
              </div>
              <button id="order-toggle" class="shrink-0 tab !border-ink/30" data-order="desc">新しい順</button>
              </div>
            </div>

            <div id="timeline" class="u-16">
              {timeline.map(({ video, items }) => (
                <div class="timeline-block inf-3">
                  <div class="md:col-span-3 min-w-0">
                    <div class="md:sticky md:top-[180px]">
                      <p class="num-display text-[22px] md:text-[26px] leading-none">{jstDate(video.published_at).y}<span class="text-rose">.</span>{String(jstDate(video.published_at).m).padStart(2, "0")}<span class="text-rose">.</span>{String(jstDate(video.published_at).d).padStart(2, "0")}</p>
                      <span class="sr-only">{formatDate(video.published_at)}</span>
                      <a href={withBase(`/video/${video.key}`)} class="group mt-4 flex md:block gap-3 items-start">
                        <span class="relative block w-28 md:w-full shrink-0 overflow-hidden rounded-xl">{getPrInfo(video.key) && <PrBadge tone="solid" class="absolute top-1.5 left-1.5 z-[1]" />}<img src={video.thumbnail} alt={video.title} class="u-3" loading="lazy" /></span>
                        <span class="inf-2">{video.title}</span>
                      </a>
                    </div>
                  </div>
                  <div class="inf-4">
                    {items.map((c) => (
                      <div class="history-item" data-tags={(c.related_tags || []).join(",")}>
                        <CosmeticCard brand_id={c.brand_id} brand={c.brand} name_id={c.name_id} name={c.name} rakutenImageHtml={c.rakuten_image_link} pr={isPrMention(video.key, c.brand_id, c.name_id)} own={isOwnBrandMention(video.key, c.brand_id, c.name_id)} category={cosmeticCategory(c)} />
                      </div>
                    ))}
                  </div>
                </div>
              ))}
            </div>
            <p id="timeline-empty" class="text-neutral-500 text-sm" style="display:none">このカテゴリの紹介はありません。</p>
            {/* 動画が多い人は1ページがとても長くなる（880品で画面175枚分）ので、8本ずつ出す */}
            <div class="mt-8 text-center">
              <button id="timeline-more" type="button" class="tab !px-6" style="display:none"></button>
            </div>
          </section>
        )}

        <section class="panel u-14">
          <SectionHead num={secNums.videos} en="Videos" title="紹介動画" lead={`${videos.length}本の動画を、新しい順に並べています。`} />
          <div class="u-20" data-more="12">
            {videos.map((v, i) => (
              <div class:list={["min-w-0", i >= 8 && "hidden"]}><VideoCard video={v} /></div>
            ))}
          </div>
          {videos.length > 8 && (
            <div class="mt-10 text-center"><button type="button" class="tab !px-6" data-more-btn>もっと見る（あと{videos.length - 8}本）</button></div>
          )}
        </section>

        <InfluencerLinks title={`${influencer.channel_title}と同じコスメを使っている人`} items={similar} unit="共通のコスメ" />
      </>
    )
  }
</Layout>

<script>
  const groupTabs = document.querySelectorAll<HTMLButtonElement>(".group-tab");
  const chipRows = document.querySelectorAll<HTMLElement>(".chip-row");
  const chips = document.querySelectorAll<HTMLButtonElement>(".cat-chip");
  const timelineEl = document.getElementById("timeline");
  const emptyEl = document.getElementById("timeline-empty");

  const moreBtn = document.getElementById("timeline-more") as HTMLButtonElement | null;
  const STEP = 8;
  let shown = STEP;
  let activeGroup = "__all__";
  let activeTag: string | null = null; // null = 大分類全体

  function render() {
    groupTabs.forEach((t) => t.classList.toggle("is-active", t.dataset.group === activeGroup));
    chipRows.forEach((r) => (r.style.display = r.dataset.group === activeGroup ? "flex" : "none"));
    chips.forEach((c) => c.classList.toggle("is-active", c.dataset.tag === activeTag));

    const groupBtn = Array.from(groupTabs).find((t) => t.dataset.group === activeGroup);
    const allowed = new Set(
      activeGroup === "__all__" ? [] : activeTag ? [activeTag] : (groupBtn?.dataset.tags || "").split("|")
    );

    let visibleBlocks = 0;
    document.querySelectorAll<HTMLElement>(".timeline-block").forEach((block) => {
      let visible = 0;
      block.querySelectorAll<HTMLElement>(".history-item").forEach((el) => {
        const show = activeGroup === "__all__" || (el.dataset.tags || "").split(",").some((t) => allowed.has(t));
        el.style.display = show ? "" : "none";
        if (show) visible++;
      });
      if (visible > 0) visibleBlocks++;
      block.style.display = visible > 0 && visibleBlocks <= shown ? "" : "none";
    });
    if (emptyEl) emptyEl.style.display = visibleBlocks > 0 ? "none" : "";
    if (moreBtn) {
      const rest = visibleBlocks - shown;
      moreBtn.style.display = rest > 0 ? "" : "none";
      moreBtn.textContent = `もっと見る（あと${rest}本の動画）`;
    }
  }
  moreBtn?.addEventListener("click", () => {
    shown += STEP;
    render();
  });

  groupTabs.forEach((t) =>
    t.addEventListener("click", () => {
      activeGroup = t.dataset.group!;
      activeTag = null;
      shown = STEP;
      render();
    })
  );
  // 選択中のカテゴリをもう一度押すと大分類全体に戻る
  chips.forEach((c) =>
    c.addEventListener("click", () => {
      activeTag = activeTag === c.dataset.tag ? null : c.dataset.tag!;
      shown = STEP;
      render();
    })
  );
  if (timelineEl) render();

  // 帯が上に貼り付いて下へスクロールしている間は、スマホではカテゴリのチップの段をたたむ（上へ戻すと開く）。絞り込みを変えたら一覧の頭へ戻す
  const bar = document.querySelector<HTMLElement>(".filter-bar");
  const sentinel = document.querySelector<HTMLElement>(".filter-sentinel");
  const isStuck = () => !!sentinel && sentinel.getBoundingClientRect().top < (bar?.getBoundingClientRect().top ?? 0) - 1;
  let lastY = window.scrollY;
  let holdUntil = 0; // 絞り込みの直後は、一覧の長さが変わってスクロール位置が動くので、たたまない
  function fold() {
    const y = window.scrollY;
    if (Date.now() < holdUntil) { lastY = y; return; }
    if (Math.abs(y - lastY) < 6) return;
    setFolded(isStuck() && y > lastY);
    lastY = y;
  }
  // たたんだ分の高さは下の余白で埋め、一覧が跳ねないようにする（mb-10＝2.5rem）
  function setFolded(on: boolean) {
    if (!bar || bar.classList.contains("is-folded") === on) return;
    const h = bar.offsetHeight;
    bar.classList.toggle("is-folded", on);
    const d = h - bar.offsetHeight;
    bar.style.marginBottom = on && d > 0 ? `calc(2.5rem + ${d}px)` : "";
  }
  const toListTop = () => {
    if (isStuck()) sentinel!.scrollIntoView({ block: "start" });
    lastY = window.scrollY;
    holdUntil = Date.now() + 500;
    setFolded(false);
  };
  groupTabs.forEach((t) => t.addEventListener("click", toListTop));
  chips.forEach((c) => c.addEventListener("click", toListTop));
  window.addEventListener("scroll", fold, { passive: true });

  const toggle = document.getElementById("order-toggle") as HTMLButtonElement | null;
  toggle?.addEventListener("click", () => {
    const asc = toggle.dataset.order === "desc";
    toggle.dataset.order = asc ? "asc" : "desc";
    toggle.textContent = asc ? "古い順" : "新しい順";
    // 「もっと見る」が先頭から数えられるよう、見た目でなく並びそのものを逆にする
    if (timelineEl) {
      Array.from(timelineEl.children).reverse().forEach((el) => timelineEl.appendChild(el));
      shown = STEP;
      render();
      toListTop();
    }
  });
</script>

<style>
  @media (max-width: 639px) {
    .filter-bar.is-folded .chip-row { display: none !important; }
  }
  /* よく紹介しているコスメ：価格と店のボタン（動画ページの rs-shops と同じ見た目。301章） */
  .tc-act { margin-top: 6px; display: flex; flex-wrap: wrap; align-items: center; gap: 4px 8px; }
  .tc-price { font-size: 14px; }
  .tc-shops { display: inline-flex; flex-wrap: wrap; gap: 4px; }
  .tc-shops a { white-space: nowrap; font-size: 11px; padding: 2px 8px; border-radius: 999px; border: 1px solid color-mix(in srgb, var(--color-ink) 15%, transparent); transition: border-color .3s; }
  .tc-shops a:hover { border-color: var(--color-ink); }
  @media (pointer: coarse) { .tc-shops a { min-height: 36px; display: inline-flex; align-items: center; } }
</style>
