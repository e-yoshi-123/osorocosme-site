---
import Layout from "../../layouts/Layout.astro";
import ShareButtons from "../../components/ShareButtons.astro";
import VideoCard from "../../components/VideoCard.astro";
import CosmeticCard from "../../components/CosmeticCard.astro";
import InfluencerLinks from "../../components/InfluencerLinks.astro";
import SectionHead from "../../components/SectionHead.astro";
import {
  getAllInfluencers,
  getInfluencerByChannelId,
  getVideosByChannel,
  getSimilarInfluencers,
  sortByPublishedDesc,
  groupTagsByCategory,
  withBase,
  formatCount,
  breadcrumbLd,
  type Cosmetic,
} from "../../lib/data";

export function getStaticPaths() {
  return getAllInfluencers().map((i) => ({ params: { channel_id: i.channel_id } }));
}

const { channel_id } = Astro.params;
const influencer = getInfluencerByChannelId(channel_id!);
const videos = sortByPublishedDesc(getVideosByChannel(channel_id!));
const similar = getSimilarInfluencers(channel_id!);

// 使用コスメ遍歴を動画（投稿日）単位のタイムラインにする。動画は投稿日降順。
const timeline = videos
  .map((v) => ({
    video: v,
    items: (v.cosmetics || []).filter((c: Cosmetic) => c.brand && c.name),
  }))
  .filter((b) => b.items.length > 0);

function formatDate(iso: string): string {
  const d = new Date(iso);
  return `${d.getUTCFullYear()}年${d.getUTCMonth() + 1}月${d.getUTCDate()}日`;
}

// カテゴリごとの紹介コスメ数（同じコスメが複数動画に出ても動画ごとに数える）
const tagCounts = new Map<string, number>();
let totalItems = 0;
for (const b of timeline) {
  for (const c of b.items) {
    totalItems++;
    for (const t of c.related_tags || []) tagCounts.set(t, (tagCounts.get(t) || 0) + 1);
  }
}
const groups = groupTagsByCategory(tagCounts.keys());
// 大分類ごとの紹介数（複数タグを持つコスメを二重に数えないよう、コスメ単位で判定）
const groupCounts = new Map<string, number>();
for (const g of groups) {
  const set = new Set(g.tags);
  let n = 0;
  for (const b of timeline) for (const c of b.items) if ((c.related_tags || []).some((t) => set.has(t))) n++;
  groupCounts.set(g.group, n);
}
const description = influencer
  ? `${influencer.channel_title}のコスメ紹介動画${videos.length}本から、使用コスメ${totalItems}品をカテゴリ別・投稿日順にまとめています。いつどのコスメを紹介していたか、使用コスメの変遷を確認できます。`
  : undefined;
const jsonLd = influencer
  ? [
      {
        "@context": "https://schema.org",
        "@type": "Person",
        name: influencer.channel_title,
        ...(influencer.channel_icon ? { image: influencer.channel_icon } : {}),
        url: `https://www.youtube.com/channel/${influencer.channel_id}`,
      },
      breadcrumbLd(
        [{ name: "ホーム", path: "/" }, { name: "インフルエンサー一覧", path: "/influencer-list" }, { name: influencer.channel_title, path: `/influencer/${influencer.channel_id}` }],
        Astro.site!
      ),
    ]
  : [];
---

<Layout title={influencer ? `${influencer.channel_title}の使用コスメ一覧・愛用コスメ遍歴` : "インフルエンサー詳細"} description={description} image={influencer?.channel_icon} jsonLd={jsonLd}>
  {
    !influencer ? (
      <p class="text-neutral-400">インフルエンサーが見つかりませんでした。</p>
    ) : (
      <>
        <!-- ===== プロフィール：雑誌の人物紹介のように ===== -->
        <section class="grid md:grid-cols-12 gap-8 md:gap-12 items-center pt-2 md:pt-6">
          <div class="md:col-span-4 lg:col-span-4">
            <div class="relative w-[62%] md:w-full max-w-[300px] mx-auto aspect-square">
              <svg viewBox="0 0 100 100" class="absolute -inset-[9%] w-[118%] h-[118%] overflow-visible" aria-hidden="true">
                <circle cx="50" cy="50" r="49" fill="none" stroke="var(--color-ink)" stroke-opacity="0.15" stroke-width="0.3" />
                <circle cx="50" cy="50" r="49" fill="none" stroke="var(--color-rose)" stroke-width="0.6" stroke-dasharray="40 268" class="origin-center [animation:spin_24s_linear_infinite] motion-reduce:[animation:none]" />
              </svg>
              {influencer.channel_icon ? (
                <img src={influencer.channel_icon.replace(/=s\d+-/, "=s400-")} alt={influencer.channel_title} width="300" height="300" class="w-full h-full rounded-full object-cover" />
              ) : <span class="block w-full h-full rounded-full bg-blush" />}
            </div>
          </div>
          <div class="md:col-span-8 lg:col-span-8">
            <p class="eyebrow">Influencer profile</p>
            <h1 class="mt-3 font-serif font-semibold text-[34px] md:text-[56px] leading-[1.2] tracking-[-0.02em] text-balance">{influencer.channel_title}</h1>
            <p class="mt-5 text-sm leading-[1.9] text-neutral-600 max-w-2xl">{description}</p>
            <dl class="mt-8 grid grid-cols-3 max-w-xl border-y border-ink/15 divide-x divide-ink/15">
              <div class="py-4 pr-3"><dt class="text-[11px] text-neutral-500">紹介動画</dt><dd class="num-display text-[34px] md:text-[44px] leading-none mt-1">{videos.length}<span class="font-sans text-xs text-neutral-500 ml-1">本</span></dd></div>
              <div class="py-4 px-3 md:px-5"><dt class="text-[11px] text-neutral-500">使用コスメ</dt><dd class="num-display text-[34px] md:text-[44px] leading-none mt-1">{totalItems}<span class="font-sans text-xs text-neutral-500 ml-1">品</span></dd></div>
              <div class="py-4 px-3 md:px-5"><dt class="text-[11px] text-neutral-500">登録者</dt><dd class="num-display text-[34px] md:text-[44px] leading-none mt-1">{influencer.subscriber_count ? formatCount(Number(influencer.subscriber_count) >= 10000 ? Math.round(Number(influencer.subscriber_count) / 10000) : Number(influencer.subscriber_count)) : "—"}<span class="font-sans text-xs text-neutral-500 ml-1">{Number(influencer.subscriber_count) >= 10000 ? "万人" : "人"}</span></dd></div>
            </dl>
            <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
              {/* 投稿者のチャンネルへ送る導線（181章） */}
              <a href={`https://www.youtube.com/channel/${influencer.channel_id}`} target="_blank" rel="noopener" class="group inline-flex items-center gap-3 bg-ink text-paper text-sm pl-5 pr-2 py-2 rounded-full hover:bg-[#FF0000] transition-colors duration-500">
                <span class="w-2 h-2 rounded-full bg-[#FF0000] group-hover:bg-paper" aria-hidden="true"></span>YouTubeチャンネルを見る<span class="w-8 h-8 rounded-full bg-paper/15 flex items-center justify-center transition-transform duration-500 group-hover:rotate-[-45deg]" aria-hidden="true">→</span>
              </a>
              <ShareButtons text={`${influencer.channel_title}さんの使用コスメ一覧・愛用コスメ遍歴`} />
            </div>
            {/* インフルエンサー本人向けの案内（掲載の停止・訂正。184章） */}
            <p class="mt-6 text-xs text-neutral-500">インフルエンサーの方へ：<a href={withBase("/for-creators")} class="link-u text-ink">掲載の停止・訂正のご依頼はこちら</a></p>
          </div>
        </section>

        {timeline.length > 0 && (
          <section class="pt-20 md:pt-28">
            <SectionHead num="01" en="Cosme history" title="使用コスメ遍歴" lead="動画ごとに、紹介したコスメを新しい順に並べています。カテゴリで絞り込めます。" />

            <div class="md:sticky md:top-[72px] z-20 bg-paper/90 backdrop-blur-md py-3 mb-10 border-b border-ink/10 text-sm -mx-4 px-4 md:mx-0 md:px-0">
              <div class="flex items-start gap-3">
              <div class="min-w-0 flex-1">
              <div class="flex flex-nowrap sm:flex-wrap gap-1.5 overflow-x-auto sm:overflow-visible -mx-4 px-4 sm:mx-0 sm:px-0 pb-1">
                <button class="group-tab tab shrink-0 whitespace-nowrap" data-group="__all__">
                  すべて <span class="tab-n">{totalItems}</span>
                </button>
                {groups.map((g) => (
                  <button class="group-tab tab shrink-0 whitespace-nowrap" data-group={g.group} data-tags={g.tags.join("|")}>
                    {g.group} <span class="tab-n">{groupCounts.get(g.group)}</span>
                  </button>
                ))}
              </div>
              {groups.map((g) => (
                <div class="chip-row flex-nowrap sm:flex-wrap gap-1.5 mt-3 pt-3 border-t border-ink/10 sm:max-h-28 overflow-x-auto sm:overflow-x-visible sm:overflow-y-auto -mx-4 px-4 sm:mx-0 sm:px-0 pb-1" data-group={g.group} style="display:none">
                  {g.tags.map((t) => (
                    <button class="cat-chip chip shrink-0 whitespace-nowrap" data-tag={t}>
                      {t} <span class="tab-n">{tagCounts.get(t)}</span>
                    </button>
                  ))}
                </div>
              ))}
              </div>
              <button id="order-toggle" class="shrink-0 tab !border-ink/30" data-order="desc">新しい順</button>
              </div>
            </div>

            <div id="timeline" class="flex flex-col">
              {timeline.map(({ video, items }) => (
                <div class="timeline-block grid md:grid-cols-12 gap-x-10 gap-y-5 py-10 border-b border-ink/10 first:pt-0">
                  <div class="md:col-span-3 min-w-0">
                    <div class="md:sticky md:top-[180px]">
                      <p class="num-display text-[30px] md:text-[40px] leading-none">{new Date(video.published_at).getUTCFullYear()}<span class="text-rose">.</span>{String(new Date(video.published_at).getUTCMonth() + 1).padStart(2, "0")}<span class="text-rose">.</span>{String(new Date(video.published_at).getUTCDate()).padStart(2, "0")}</p>
                      <span class="sr-only">{formatDate(video.published_at)}</span>
                      <a href={withBase(`/video/${video.key}`)} class="group mt-4 flex md:block gap-3 items-start">
                        <span class="block w-28 md:w-full shrink-0 overflow-hidden rounded-xl"><img src={video.thumbnail} alt="" class="w-full aspect-video object-cover transition-transform duration-700 ease-out-expo group-hover:scale-105" loading="lazy" /></span>
                        <span class="block md:mt-3 text-[12px] leading-relaxed text-neutral-600 group-hover:text-rose transition-colors line-clamp-3">{video.title}</span>
                      </a>
                    </div>
                  </div>
                  <div class="md:col-span-9 min-w-0 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-x-4 gap-y-8">
                    {items.map((c) => (
                      <div class="history-item" data-tags={(c.related_tags || []).join(",")}>
                        <CosmeticCard brand_id={c.brand_id} brand={c.brand} name_id={c.name_id} name={c.name} rakutenImageHtml={c.rakuten_image_link} />
                      </div>
                    ))}
                  </div>
                </div>
              ))}
            </div>
            <p id="timeline-empty" class="text-neutral-400 text-sm" style="display:none">このカテゴリの紹介はありません。</p>
          </section>
        )}

        <section class="pt-20 md:pt-28">
          <SectionHead num="02" en="Videos" title="紹介動画" lead={`${videos.length}本の動画を、新しい順に並べています。`} />
          <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-x-6 gap-y-10">
            {videos.map((v) => (
              <div class="min-w-0"><VideoCard video={v} /></div>
            ))}
          </div>
        </section>

        <InfluencerLinks title={`${influencer.channel_title}と同じコスメを使っている人`} items={similar} unit="共通のコスメ" />
      </>
    )
  }
</Layout>

<script>
  const groupTabs = document.querySelectorAll<HTMLButtonElement>(".group-tab");
  const chipRows = document.querySelectorAll<HTMLElement>(".chip-row");
  const chips = document.querySelectorAll<HTMLButtonElement>(".cat-chip");
  const timelineEl = document.getElementById("timeline");
  const emptyEl = document.getElementById("timeline-empty");

  let activeGroup = "__all__";
  let activeTag: string | null = null; // null = 大分類全体

  function render() {
    groupTabs.forEach((t) => t.classList.toggle("is-active", t.dataset.group === activeGroup));
    chipRows.forEach((r) => (r.style.display = r.dataset.group === activeGroup ? "flex" : "none"));
    chips.forEach((c) => c.classList.toggle("is-active", c.dataset.tag === activeTag));

    const groupBtn = Array.from(groupTabs).find((t) => t.dataset.group === activeGroup);
    const allowed = new Set(
      activeGroup === "__all__" ? [] : activeTag ? [activeTag] : (groupBtn?.dataset.tags || "").split("|")
    );

    let visibleBlocks = 0;
    document.querySelectorAll<HTMLElement>(".timeline-block").forEach((block) => {
      let visible = 0;
      block.querySelectorAll<HTMLElement>(".history-item").forEach((el) => {
        const show = activeGroup === "__all__" || (el.dataset.tags || "").split(",").some((t) => allowed.has(t));
        el.style.display = show ? "" : "none";
        if (show) visible++;
      });
      block.style.display = visible > 0 ? "" : "none";
      if (visible > 0) visibleBlocks++;
    });
    if (emptyEl) emptyEl.style.display = visibleBlocks > 0 ? "none" : "";
  }

  groupTabs.forEach((t) =>
    t.addEventListener("click", () => {
      activeGroup = t.dataset.group!;
      activeTag = null;
      render();
    })
  );
  // 選択中のカテゴリをもう一度押すと大分類全体に戻る
  chips.forEach((c) =>
    c.addEventListener("click", () => {
      activeTag = activeTag === c.dataset.tag ? null : c.dataset.tag!;
      render();
    })
  );
  if (groupTabs.length > 0) render();

  const toggle = document.getElementById("order-toggle") as HTMLButtonElement | null;
  toggle?.addEventListener("click", () => {
    const asc = toggle.dataset.order === "desc";
    toggle.dataset.order = asc ? "asc" : "desc";
    toggle.textContent = asc ? "古い順" : "新しい順";
    if (timelineEl) timelineEl.style.flexDirection = asc ? "column-reverse" : "column";
  });
</script>
