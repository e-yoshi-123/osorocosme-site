---
import Layout from "../../layouts/Layout.astro";
import VideoCard from "../../components/VideoCard.astro";
import CosmeticCard from "../../components/CosmeticCard.astro";
import {
  getAllInfluencers,
  getInfluencerByChannelId,
  getVideosByChannel,
  sortByPublishedDesc,
  groupTagsByCategory,
  withBase,
  breadcrumbLd,
  type Cosmetic,
} from "../../lib/data";

export function getStaticPaths() {
  return getAllInfluencers().map((i) => ({ params: { channel_id: i.channel_id } }));
}

const { channel_id } = Astro.params;
const influencer = getInfluencerByChannelId(channel_id!);
const videos = sortByPublishedDesc(getVideosByChannel(channel_id!));

// 使用コスメ遍歴を動画（投稿日）単位のタイムラインにする。動画は投稿日降順。
const timeline = videos
  .map((v) => ({
    video: v,
    items: (v.cosmetics || []).filter((c: Cosmetic) => c.brand && c.name),
  }))
  .filter((b) => b.items.length > 0);

function formatDate(iso: string): string {
  const d = new Date(iso);
  return `${d.getUTCFullYear()}年${d.getUTCMonth() + 1}月${d.getUTCDate()}日`;
}

// カテゴリごとの紹介コスメ数（同じコスメが複数動画に出ても動画ごとに数える）
const tagCounts = new Map<string, number>();
let totalItems = 0;
for (const b of timeline) {
  for (const c of b.items) {
    totalItems++;
    for (const t of c.related_tags || []) tagCounts.set(t, (tagCounts.get(t) || 0) + 1);
  }
}
const groups = groupTagsByCategory(tagCounts.keys());
// 大分類ごとの紹介数（複数タグを持つコスメを二重に数えないよう、コスメ単位で判定）
const groupCounts = new Map<string, number>();
for (const g of groups) {
  const set = new Set(g.tags);
  let n = 0;
  for (const b of timeline) for (const c of b.items) if ((c.related_tags || []).some((t) => set.has(t))) n++;
  groupCounts.set(g.group, n);
}
const description = influencer
  ? `${influencer.channel_title}のコスメ紹介動画${videos.length}本から、使用コスメ${totalItems}品をカテゴリ別・投稿日順にまとめています。いつどのコスメを紹介していたか、使用コスメの変遷を確認できます。`
  : undefined;
const jsonLd = influencer
  ? [
      {
        "@context": "https://schema.org",
        "@type": "Person",
        name: influencer.channel_title,
        ...(influencer.channel_icon ? { image: influencer.channel_icon } : {}),
        url: `https://www.youtube.com/channel/${influencer.channel_id}`,
      },
      breadcrumbLd(
        [{ name: "ホーム", path: "/" }, { name: "インフルエンサー一覧", path: "/influencer-list" }, { name: influencer.channel_title, path: `/influencer/${influencer.channel_id}` }],
        Astro.site!
      ),
    ]
  : [];
---

<Layout title={influencer?.channel_title ?? "インフルエンサー詳細"} description={description} image={influencer?.channel_icon} jsonLd={jsonLd}>
  {
    !influencer ? (
      <p class="text-neutral-400">インフルエンサーが見つかりませんでした。</p>
    ) : (
      <>
        <div class="flex items-center gap-4 mb-8">
          {influencer.channel_icon && <img src={influencer.channel_icon} alt="" class="w-16 h-16 rounded-full" />}
          <div>
            <h1 class="text-xl font-bold">{influencer.channel_title}</h1>
            <p class="text-sm text-neutral-500 mt-1">{description}</p>
          </div>
        </div>

        {timeline.length > 0 && (
          <section class="mb-12">
            <div class="flex items-center justify-between mb-3">
              <h2 class="font-bold">使用コスメ遍歴</h2>
              <button id="order-toggle" class="text-xs border rounded px-2 py-1 hover:bg-pink-50" data-order="desc">
                新しい順
              </button>
            </div>

            <div class="md:sticky md:top-14 z-20 bg-white/95 backdrop-blur py-2 mb-6 border-b text-sm">
              <div class="flex flex-wrap gap-1.5">
                <button class="group-tab px-3 py-1 rounded-full border" data-group="__all__">
                  すべて <span class="text-neutral-400">({totalItems})</span>
                </button>
                {groups.map((g) => (
                  <button class="group-tab px-3 py-1 rounded-full border" data-group={g.group} data-tags={g.tags.join("|")}>
                    {g.group} <span class="text-neutral-400">({groupCounts.get(g.group)})</span>
                  </button>
                ))}
              </div>
              {groups.map((g) => (
                <div class="chip-row flex-wrap gap-1.5 mt-2 pt-2 border-t border-dashed max-h-28 overflow-y-auto" data-group={g.group} style="display:none">
                  {g.tags.map((t) => (
                    <button class="cat-chip px-2.5 py-0.5 rounded-full border text-xs" data-tag={t}>
                      {t} <span class="text-neutral-400">({tagCounts.get(t)})</span>
                    </button>
                  ))}
                </div>
              ))}
            </div>

            <div id="timeline" class="flex flex-col gap-8">
              {timeline.map(({ video, items }) => (
                <div class="timeline-block">
                  <div class="flex flex-wrap items-baseline gap-x-3 mb-2 border-l-4 border-pink-300 pl-3">
                    <span class="font-bold">{formatDate(video.published_at)}</span>
                    <a href={withBase(`/video/${video.key}`)} class="text-sm text-neutral-600 hover:text-pink-600 line-clamp-1">
                      {video.title}
                    </a>
                  </div>
                  <div class="grid sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
                    {items.map((c) => (
                      <div class="history-item" data-tags={(c.related_tags || []).join(",")}>
                        <CosmeticCard brand_id={c.brand_id} brand={c.brand} name_id={c.name_id} name={c.name} rakutenImageHtml={c.rakuten_image_link} />
                      </div>
                    ))}
                  </div>
                </div>
              ))}
            </div>
            <p id="timeline-empty" class="text-neutral-400 text-sm" style="display:none">このカテゴリの紹介はありません。</p>
          </section>
        )}

        <section>
          <h2 class="font-bold mb-3">動画一覧（{videos.length}件）</h2>
          <div class="grid sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
            {videos.map((v) => (
              <VideoCard video={v} />
            ))}
          </div>
        </section>
      </>
    )
  }
</Layout>

<script>
  const groupTabs = document.querySelectorAll<HTMLButtonElement>(".group-tab");
  const chipRows = document.querySelectorAll<HTMLElement>(".chip-row");
  const chips = document.querySelectorAll<HTMLButtonElement>(".cat-chip");
  const timelineEl = document.getElementById("timeline");
  const emptyEl = document.getElementById("timeline-empty");

  let activeGroup = "__all__";
  let activeTag: string | null = null; // null = 大分類全体

  function render() {
    groupTabs.forEach((t) => t.classList.toggle("bg-pink-100", t.dataset.group === activeGroup));
    chipRows.forEach((r) => (r.style.display = r.dataset.group === activeGroup ? "flex" : "none"));
    chips.forEach((c) => c.classList.toggle("bg-pink-100", c.dataset.tag === activeTag));

    const groupBtn = Array.from(groupTabs).find((t) => t.dataset.group === activeGroup);
    const allowed = new Set(
      activeGroup === "__all__" ? [] : activeTag ? [activeTag] : (groupBtn?.dataset.tags || "").split("|")
    );

    let visibleBlocks = 0;
    document.querySelectorAll<HTMLElement>(".timeline-block").forEach((block) => {
      let visible = 0;
      block.querySelectorAll<HTMLElement>(".history-item").forEach((el) => {
        const show = activeGroup === "__all__" || (el.dataset.tags || "").split(",").some((t) => allowed.has(t));
        el.style.display = show ? "" : "none";
        if (show) visible++;
      });
      block.style.display = visible > 0 ? "" : "none";
      if (visible > 0) visibleBlocks++;
    });
    if (emptyEl) emptyEl.style.display = visibleBlocks > 0 ? "none" : "";
  }

  groupTabs.forEach((t) =>
    t.addEventListener("click", () => {
      activeGroup = t.dataset.group!;
      activeTag = null;
      render();
    })
  );
  // 選択中のカテゴリをもう一度押すと大分類全体に戻る
  chips.forEach((c) =>
    c.addEventListener("click", () => {
      activeTag = activeTag === c.dataset.tag ? null : c.dataset.tag!;
      render();
    })
  );
  if (groupTabs.length > 0) render();

  const toggle = document.getElementById("order-toggle") as HTMLButtonElement | null;
  toggle?.addEventListener("click", () => {
    const asc = toggle.dataset.order === "desc";
    toggle.dataset.order = asc ? "asc" : "desc";
    toggle.textContent = asc ? "古い順" : "新しい順";
    if (timelineEl) timelineEl.style.flexDirection = asc ? "column-reverse" : "column";
  });
</script>
