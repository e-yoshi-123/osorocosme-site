---
import HowWeCount from "../../components/HowWeCount.astro";
import PageHead from "../../components/PageHead.astro";
import Layout from "../../layouts/Layout.astro";
import ShareButtons from "../../components/ShareButtons.astro";
import RankingRow from "../../components/RankingRow.astro";
import {
  getPublishedConcerns,
  getConcern,
  getPublishedConcernIngredients,
  FEATURE_MIN_CHANNELS,
  CONCERN_PER_GROUP,
  getCosmeticListEntry,
  productOffer,
  cosmeticSlug,
  categoryUrl,
  hasRankingPage,
  withBase,
  breadcrumbLd,
} from "../../lib/data";

export function getStaticPaths() {
  return getPublishedConcerns().map((c) => ({ params: { slug: c.slug }, props: { slug: c.slug } }));
}

const { slug } = Astro.props;
const c = getConcern(slug)!;
const others = getPublishedConcerns().filter((x) => x.slug !== slug);
const withIngredients = getPublishedConcernIngredients().filter((x) => x.concern.slug === slug);
const total = c.groups.reduce((n, g) => n + g.items.length, 0);

// 表示用データ。価格・楽天とYahoo!のリンク・画像は cosmetics_list.json を正とする（特集・ランキングと同じ）
const groups = c.groups.map((g) => ({
  group: g.group,
  rows: g.items.map((it, i) => {
    const entry = getCosmeticListEntry(it.brand_id, it.name_id);
    const offer = productOffer(entry);
    return {
      it,
      rank: i + 1,
      imageSrc: offer.imageSrc,
      price: offer.price,
      link: offer.rakutenLink,
      fromYahoo: offer.source === "yahoo",
      yahooLink: entry?.yahoo_text_link || undefined,
    };
  }),
}));

const title = `${c.def.name}が気になる人に。インフルエンサーが使うコスメ（カテゴリ別）`;
const first = groups[0]?.rows[0]?.it;
const description =
  `YouTubeのコスメ紹介で「${c.def.name}」に触れて紹介されたコスメを、カテゴリ別に集計（${c.videoCount}本の動画・${c.channelCount}チャンネル）。` +
  `${FEATURE_MIN_CHANNELS}人以上が紹介したものだけを、実際の発言とあわせて載せています。` +
  (first ? `${first.tag}では${first.brand}「${first.name}」などが上位です。` : "");
const topImage = groups.flatMap((g) => g.rows).find((r) => r.imageSrc)?.imageSrc;
const crumbs = [
  { name: "ホーム", path: "/" },
  { name: "肌悩みから探す", path: "/concern/" },
  { name: c.def.name, path: `/concern/${slug}/` },
];
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: title,
    numberOfItems: total,
    itemListElement: groups
      .flatMap((g) => g.rows)
      .slice(0, 10)
      .map((r, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: `${r.it.brand} ${r.it.name}`,
        url: new URL(withBase(`/cosmetics/${cosmeticSlug(r.it.brand_id, r.it.name_id)}`), Astro.site!).href,
      })),
  },
  breadcrumbLd(crumbs, Astro.site!),
];
---

<Layout title={title} description={description} image={topImage} jsonLd={jsonLd}>
  <nav class="text-xs text-neutral-500 mb-8 flex flex-wrap gap-2" aria-label="パンくず">
    <a href={withBase("/")} class="link-u">Home</a><span aria-hidden="true">/</span>
    <a href={withBase("/concern/")} class="link-u">肌悩みから探す</a><span aria-hidden="true">/</span>
    <span>{c.def.name}</span>
  </nav>

  <PageHead en="Skin concerns" title={`${c.def.name}が気になる人に`} lead={c.def.lead}>
    <ShareButtons text={`${c.def.name}が気になる人に。インフルエンサーが使うコスメ`} class="mt-5" />
  </PageHead>

  <HowWeCount>
    <ul class="list-disc pl-5 space-y-1">
      <li>対象：動画の中で「{c.def.name}」に触れて紹介されたコスメ（<b>{c.videoCount}本</b>の動画・<b>{c.channelCount}チャンネル</b>）。「{c.def.name}には向かない」のような評価は数えていません</li>
      <li>掲載条件：<b>{FEATURE_MIN_CHANNELS}チャンネル以上</b>が紹介したコスメのみ</li>
      <li>並び順：紹介したチャンネル数 → 紹介動画数 → 合計再生回数。各カテゴリ上位{CONCERN_PER_GROUP}品まで</li>
      <li>「」内は、再生回数の多い動画での紹介のされ方です（動画の発言を要約したもの）</li>
    </ul>
  </HowWeCount>

  {
    withIngredients.length > 0 && (
      <section class="mb-12" aria-labelledby="ci-band">
        <h2 id="ci-band" class="font-serif h-section font-semibold mb-2">よく一緒に語られる成分</h2>
        <p class="text-xs text-neutral-500 mb-4">動画の1つの発言の中で「{c.def.name}」と一緒に語られた回数の多い成分です。成分の効果を示すものではありません。</p>
        <div class="flex flex-wrap gap-2">
          {withIngredients.map((o) => (
            <a href={withBase(`/concern/${o.concern.slug}/${o.ingredient.slug}/`)} class="rounded-full border border-ink/15 bg-white/70 px-4 py-2 text-sm text-ink hover:border-ink/40">
              {o.ingredient.name}<span class="ml-2 text-xs text-neutral-500">{o.mentionCount}件</span>
            </a>
          ))}
        </div>
      </section>
    )
  }

  {
    groups.map((g) => (
      <section class="panel mb-6 md:mb-8">
        <h2 class="font-serif h-section font-semibold mb-4">{g.group}</h2>
        <div class="@container">
          <ol class="divide-y divide-ink/10">
            {g.rows.map((r) => (
              <RankingRow
                rank={r.rank}
                base={r.rank}
                brand_id={r.it.brand_id}
                brand={r.it.brand}
                name_id={r.it.name_id}
                name={r.it.name}
                imageSrc={r.imageSrc}
                videoCount={r.it.videoCount}
                channelCount={r.it.channelCount}
                price={r.price}
                fromYahoo={r.fromYahoo}
                link={r.link}
                yahooLink={r.yahooLink}
                subLabel={r.it.tag}
                quote={r.it.quote}
                quoteBy={r.it.quoteChannel}
              />
            ))}
          </ol>
        </div>
        <p class="mt-2 text-xs text-neutral-500">
          {g.rows
            .map((r) => r.it.tag)
            .filter((v, i, a) => a.indexOf(v) === i)
            .map((t, i) => (
              <>
                {i > 0 && " / "}
                {hasRankingPage(t) ? <a href={categoryUrl(t)} class="link-u text-ink">{t}のランキング</a> : t}
              </>
            ))}
        </p>
      </section>
    ))
  }

  <p class="text-xs text-neutral-500 mb-8">価格は楽天市場で確認した時点の参考価格です。最新の価格・在庫は楽天市場でご確認ください。肌に合うかどうかには個人差があります。</p>

  <ShareButtons text={`${c.def.name}が気になる人に。インフルエンサーが使うコスメ`} label="このページをシェア" class="mb-10" />

  <p class="text-sm">
    {
      others.map((o) => (
        <>
          <a href={withBase(`/concern/${o.slug}/`)} class="link-u text-ink">{o.name} →</a>{" "}
        </>
      ))
    }
    <a href={withBase("/ranking/")} class="link-u text-ink">カテゴリ別ランキング →</a>
  </p>
</Layout>
