---
import HowWeCount from "../../components/HowWeCount.astro";
import RecipeCard from "../../components/RecipeCard.astro";
import Layout from "../../layouts/Layout.astro";
import { getRecipes, getRecipeTastes, RECIPE_MIN_TIMED } from "../../lib/recipe";
import { withBase } from "../../lib/data";

// メイクレシピの一覧（試作、283章）。試作のあいだは noindex で、メニュー・サイトマップにも載せない
const recipes = getRecipes();
const tastes = getRecipeTastes();
const channelCount = new Set(recipes.map((r) => r.video.channel_id)).size;
const itemCount = new Set(recipes.flatMap((r) => r.steps.flat().map((x) => x.slug))).size;
const [featured, ...rest] = recipes;
const PAGE = 12;

const title = "YouTuberのメイクレシピ（動画で実際に使ったコスメを手順順に）";
const description = `YouTuberが動画で実際にしたメイクを、ベース・眉・アイ・チーク・リップの手順ごとに、使ったコスメと場面の時刻でまとめたメイクレシピ（${recipes.length}件）。`;
---

<Layout title={title} description={description} noindex>
  <nav class="text-xs text-neutral-500 mb-8 flex flex-wrap gap-2" aria-label="パンくず">
    <a href={withBase("/")} class="link-u">Home</a><span aria-hidden="true">/</span>
    <span>メイクレシピ（試作）</span>
  </nav>

  <section class="rx-hero">
    <div class="rx-hero-text">
      <p class="eyebrow">Make Recipe</p>
      <h1 class="rx-h1">動画で見たあのメイクを、<br />レシピにしました。</h1>
      <p class="rx-lead">YouTuberが動画で実際にしたメイクを、顔のどこに・どの順で・何を使ったかの1枚にまとめました。手順の時刻を押せば、その場面から動画で確かめられます。</p>
      <ol class="rx-how">
        <li><span class="num-display">01</span><b>顔の図で、全体をつかむ</b>ベース・眉・アイ・チーク・リップの5か所に、使ったコスメを留めています</li>
        <li><span class="num-display">02</span><b>手順を、動画の場面で見る</b>使った順に並べ、押すとその場面から再生します</li>
        <li><span class="num-display">03</span><b>そのままそろえる</b>そろえたときの参考の合計額と、各ショップへのリンク付き</li>
      </ol>
      <dl class="rx-stats">
        <div><dt>レシピ</dt><dd class="num-display">{recipes.length}</dd></div>
        <div><dt>YouTuber</dt><dd class="num-display">{channelCount}</dd></div>
        <div><dt>コスメ</dt><dd class="num-display">{itemCount}</dd></div>
      </dl>
    </div>
    {featured && (
      <div class="rx-hero-card">
        <p class="label-caps rx-new">Latest recipe</p>
        <RecipeCard recipe={featured} draw />
      </div>
    )}
  </section>

  <div class="rx-filter" role="group" aria-label="テイストで絞り込む">
    <span class="label-caps text-neutral-500 shrink-0">Taste</span>
    <div class="rx-chips">
      <button type="button" class="taste-btn chip is-active" data-taste="">すべて <span class="tab-n">{recipes.length}</span></button>
      {tastes.map((t) => (
        <button type="button" class="taste-btn chip" data-taste={t.key}>{t.label} <span class="tab-n">{t.count}</span></button>
      ))}
    </div>
    <p id="recipe-count" class="rx-count" aria-live="polite"></p>
  </div>

  <div id="recipes" class="rx-grid">
    {featured && <RecipeCard recipe={featured} class="rx-dup" hidden />}
    {rest.map((r, i) => <RecipeCard recipe={r} hidden={i >= PAGE} />)}
  </div>
  <p id="recipe-empty" class="text-sm text-neutral-500 mt-6" hidden>このテイストのレシピはまだありません。</p>
  <div class="mt-10 text-center">
    <button type="button" id="recipe-more" class="tab">もっと見る</button>
  </div>

  <div class="mt-14">
    <HowWeCount>
      <ul class="list-disc pl-5 space-y-1">
        <li>元にしたもの：動画の字幕から抽出した紹介コスメと、字幕の文字の一致で決めた「その商品を紹介した場面」の時刻です。レシピ画像の転載や、AIが推測した手順はありません</li>
        <li>載せる動画：ベース・アイ・リップがそろい、場面の時刻が分かる商品が{RECIPE_MIN_TIMED}品以上あるもの</li>
        <li>載せない動画：新作紹介・購入品・比較・ベスコスなど、紹介することが目的の動画と、動画全体がPR・提供のもの。一部の商品だけが提供の場合は、その商品に「PR」を付けています</li>
        <li>部位の振り分けは商品のカテゴリによります。手順の中の並びは動画で使った順（時刻が分からない商品は後ろ）。テイストは動画のタイトルにある語で付けています</li>
        <li>合計額は、楽天市場（無ければYahoo!ショッピング）で確認した時点の参考価格を足したものです</li>
      </ul>
    </HowWeCount>
  </div>
  <p class="text-xs text-neutral-500 mt-2">メイクの方法・仕上がりは動画の投稿者によるものです。肌に合うかどうかには個人差があります。</p>

  <script define:vars={{ PAGE }}>
    // 絞り込み：「すべて」のときは先頭のカード（上の Latest と同じ）を一覧に出さず、テイストで絞ったときは一覧にも入れる
    const cards = Array.from(document.querySelectorAll("#recipes .rcard"));
    const btns = document.querySelectorAll(".taste-btn");
    const more = document.getElementById("recipe-more");
    const empty = document.getElementById("recipe-empty");
    const count = document.getElementById("recipe-count");
    let taste = "";
    let shown = PAGE;
    const render = () => {
      const hit = cards.filter((c) => (taste ? c.dataset.tastes.split(" ").includes(taste) : !c.classList.contains("rx-dup")));
      cards.forEach((c) => (c.hidden = true));
      hit.slice(0, shown).forEach((c) => (c.hidden = false));
      more.hidden = hit.length <= shown;
      empty.hidden = hit.length > 0;
      count.textContent = taste ? `${hit.length}件` : "";
    };
    btns.forEach((b) =>
      b.addEventListener("click", () => {
        taste = b.dataset.taste;
        shown = PAGE;
        btns.forEach((x) => x.classList.toggle("is-active", x === b));
        render();
      })
    );
    more.addEventListener("click", () => {
      shown += PAGE;
      render();
    });
    render();
  </script>
</Layout>

<style is:global>
  .rx-hero { display: grid; gap: 40px; align-items: center; margin-bottom: 56px; }
  @media (min-width: 1024px) { .rx-hero { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 64px; margin-bottom: 80px; } }
  .rx-h1 { margin-top: 10px; font-weight: 700; font-size: 28px; line-height: 1.4; letter-spacing: -0.01em; word-break: auto-phrase; }
  @media (min-width: 768px) { .rx-h1 { font-size: 40px; } }
  .rx-lead { margin-top: 18px; max-width: 36em; font-size: 14px; line-height: 2; color: var(--color-neutral-600); }
  .rx-how { margin-top: 28px; display: grid; gap: 14px; max-width: 36em; }
  .rx-how li { display: grid; grid-template-columns: 2.6rem minmax(0, 1fr); column-gap: 8px; font-size: 13px; line-height: 1.7; color: var(--color-neutral-600); }
  .rx-how li span { grid-row: span 2; font-size: 22px; line-height: 1.1; color: var(--color-rose); }
  .rx-how li b { color: var(--color-ink); font-size: 14px; }
  .rx-stats { margin-top: 32px; display: flex; gap: 0; }
  .rx-stats div { padding: 0 22px; border-left: 1px solid color-mix(in srgb, var(--color-ink) 14%, transparent); display: flex; flex-direction: column-reverse; }
  .rx-stats div:first-child { padding-left: 0; border-left: 0; }
  .rx-stats dt { font-size: 12px; color: var(--color-neutral-500); }
  .rx-stats dd { font-size: 30px; line-height: 1.1; }
  .rx-hero-card { position: relative; max-width: 440px; width: 100%; justify-self: center; }
  .rx-hero-card::before { content: ""; position: absolute; inset: -26px -26px 34% -26px; border-radius: 999px 999px 40px 40px; background: var(--c-accent); z-index: -1; }
  .rx-new { position: relative; margin-bottom: 10px; text-align: center; color: var(--color-rose); }
  .rx-filter { position: sticky; top: calc(var(--hdr-h, 64px) + 8px); z-index: 5; display: flex; flex-wrap: wrap; align-items: center; gap: 10px 14px; margin-bottom: 28px; padding: 12px 16px; border-radius: 22px; background: color-mix(in srgb, var(--c-panel) 88%, transparent); backdrop-filter: blur(10px); box-shadow: var(--panel-shadow); }
  .rx-chips { display: flex; gap: 8px; overflow-x: auto; scrollbar-width: none; min-width: 0; flex: 1; }
  .rx-chips .chip { flex-shrink: 0; white-space: nowrap; }
  .rx-count { font-size: 12px; color: var(--color-neutral-500); white-space: nowrap; }
  .rx-grid { display: grid; gap: 24px; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 640px) { .rx-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .rx-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; } }
  @media (pointer: coarse) { .rx-chips .chip { min-height: 36px; } }
</style>
