---
// パーソナルカラーの自己診断（314章、315章で作り直し）。1問ずつ答えて、①イエベかブルベか ②季節 を出す。回答はブラウザの中だけで、どこにも送らない。
// 結果は、その季節のパレット・似合いやすい色・同じパーソナルカラーのインフルエンサー（本人が話している人）と、その人たちに人気のコスメ。
// 質問は一般的な見分け方をもとにした自前の文。あくまで目安。
// 見た目はこのページの中のCSS（ck-）で書く（スクリプトが作る部分も同じクラスを使う。開発中、スクリプトの中だけのTailwindのクラスが効かなかったため。314章）
import Layout from "../../layouts/Layout.astro";
import { getPublishedPersonalColors, selfCheckExtras, withBase, breadcrumbLd } from "../../lib/data";

type Opt = { label: string; v?: "Y" | "B" | "S" | "A" | "U" | "W"; sw?: string[]; style?: "metal" | "line" | "eye" | "gloss" | "matte" };
const BASE_Q: { q: string; hint: string; opts: Opt[] }[] = [
  { q: "手首の内側の血管は、何色に見えますか？", hint: "自然光の下で、手のひらを上に向けて", opts: [{ label: "緑っぽい", v: "Y", sw: ["#6E9A5B"], style: "line" }, { label: "青・紫っぽい", v: "B", sw: ["#5B6FB3"], style: "line" }, { label: "わからない" }] },
  { q: "似合うと言われるのは、どちらのアクセサリー？", hint: "顔のそばで比べると分かりやすい", opts: [{ label: "ゴールド", v: "Y", sw: ["#F6E27A", "#C9A227", "#8A6A12"], style: "metal" }, { label: "シルバー", v: "B", sw: ["#FFFFFF", "#C5CAD3", "#7D8592"], style: "metal" }, { label: "どちらとも言えない" }] },
  { q: "日焼けをすると、肌はどうなりやすい？", hint: "夏のあとを思い出して", opts: [{ label: "小麦色になりやすい", v: "Y", sw: ["#E7C3A0", "#C08A5C"] }, { label: "赤くなって、すぐ白に戻る", v: "B", sw: ["#F6D6D3", "#E79A97"] }, { label: "わからない" }] },
  { q: "白い紙を顔の横に当てると、肌の色は？", hint: "すっぴんに近い状態で", opts: [{ label: "黄み・オレンジみがある", v: "Y", sw: ["#F3D3B0", "#E8B98C"] }, { label: "ピンクみ・青白さがある", v: "B", sw: ["#F4D9DC", "#E9C6CF"] }, { label: "わからない" }] },
  { q: "顔色がよく見えるのは、どちらの口紅？", hint: "いつもの口紅を思い浮かべて", opts: [{ label: "コーラル・オレンジ系", v: "Y", sw: ["#F2836B", "#E8603C"] }, { label: "ローズ・青みピンク系", v: "B", sw: ["#D8577E", "#B7306A"] }, { label: "どちらとも言えない" }] },
];
const SEASON_Q: Record<"Y" | "B", { q: string; hint: string; opts: Opt[] }[]> = {
  Y: [
    { q: "瞳の色は？", hint: "鏡で光に当てて", opts: [{ label: "明るい茶色で、ガラス玉のよう", v: "S", sw: ["#B9773C"], style: "eye" }, { label: "深いこげ茶で、落ち着いている", v: "A", sw: ["#4A2E1C"], style: "eye" }, { label: "わからない" }] },
    { q: "似合うと言われる質感は？", hint: "ハイライトやリップの仕上がり", opts: [{ label: "ツヤ・みずみずしさ", v: "S", sw: ["#F7C9A8"], style: "gloss" }, { label: "マット・深み", v: "A", sw: ["#B9764A"], style: "matte" }, { label: "どちらとも言えない" }] },
    { q: "身につけて顔色がよく見えるのは？", hint: "服やストールの色", opts: [{ label: "明るく鮮やかな色", v: "S", sw: ["#F7A08A", "#FCD9A8", "#F6E27A", "#9FD8B8"] }, { label: "くすみのある深い色", v: "A", sw: ["#C8763D", "#8E5B3A", "#B9A24F", "#6E7B4A"] }, { label: "どちらとも言えない" }] },
  ],
  B: [
    { q: "瞳の色は？", hint: "白目とのコントラストも見て", opts: [{ label: "やわらかい茶色・グレーっぽい", v: "U", sw: ["#7C6A5F"], style: "eye" }, { label: "黒く、白目とのコントラストがはっきり", v: "W", sw: ["#141214"], style: "eye" }, { label: "わからない" }] },
    { q: "身につけて顔色がよく見えるのは？", hint: "服やストールの色", opts: [{ label: "やわらかいパステル・スモーキーな色", v: "U", sw: ["#E8B4C8", "#C7B8E0", "#A7C7E7", "#B9C4C9"] }, { label: "鮮やかな色・真っ黒と真っ白", v: "W", sw: ["#1F2A6B", "#C2185B", "#111111", "#FFFFFF"] }, { label: "どちらとも言えない" }] },
    { q: "初めて会う人から言われやすい印象は？", hint: "雰囲気の第一印象", opts: [{ label: "やさしい・上品", v: "U", sw: ["#E8C7D4"] }, { label: "クール・はっきりしている", v: "W", sw: ["#2B2D5C"] }, { label: "どちらとも言えない" }] },
  ],
};
type Season = { key: string; base: string; en: string; mood: string[]; text: string; palette: [string, string][] };
const SEASONS: Season[] = [
  { key: "イエベ春", base: "イエベ", en: "Spring", mood: ["明るい", "澄んだ", "軽やか"], text: "黄みのある、明るく澄んだ色が得意とされるタイプ。つやのある肌、明るい瞳が持ち味です。", palette: [["コーラル", "#F48C6A"], ["ピーチ", "#FCD5B5"], ["サーモンピンク", "#F7A08A"], ["レモン", "#F9E07F"], ["ミント", "#A8D8B9"]] },
  { key: "イエベ秋", base: "イエベ", en: "Autumn", mood: ["深い", "大人っぽい", "あたたか"], text: "黄みのある、深くくすみのある色が得意とされるタイプ。落ち着いた深みのある印象が持ち味です。", palette: [["テラコッタ", "#C8763D"], ["ブラウン", "#8E5B3A"], ["マスタード", "#B9A24F"], ["カーキ", "#6E7B4A"], ["キャメル", "#D9A066"]] },
  { key: "ブルベ夏", base: "ブルベ", en: "Summer", mood: ["やわらか", "上品", "涼やか"], text: "青みのある、やわらかく明るい色が得意とされるタイプ。透明感と上品さが持ち味です。", palette: [["ローズピンク", "#E8A0BA"], ["ラベンダー", "#C7B8E0"], ["パウダーブルー", "#A7C7E7"], ["スモーキーローズ", "#D98FA8"], ["ブルーグレー", "#B9C4C9"]] },
  { key: "ブルベ冬", base: "ブルベ", en: "Winter", mood: ["鮮やか", "クール", "シャープ"], text: "青みのある、鮮やかでコントラストの強い色が得意とされるタイプ。はっきりした印象が持ち味です。", palette: [["ネイビー", "#1F2A6B"], ["マゼンタ", "#C2185B"], ["ブラック", "#141214"], ["ピュアホワイト", "#FFFFFF"], ["エメラルド", "#1F8A5B"]] },
  { key: "イエベ", base: "イエベ", en: "Yellow base", mood: ["あたたか", "なじむ", "健康的"], text: "黄みのある色が得意とされるタイプ（季節までは分かれませんでした）。", palette: [["コーラル", "#F48C6A"], ["ピーチ", "#FCD5B5"], ["キャメル", "#D9A066"], ["テラコッタ", "#C8763D"], ["マスタード", "#B9A24F"]] },
  { key: "ブルベ", base: "ブルベ", en: "Blue base", mood: ["涼やか", "透明感", "クリア"], text: "青みのある色が得意とされるタイプ（季節までは分かれませんでした）。", palette: [["ローズピンク", "#E8A0BA"], ["ラベンダー", "#C7B8E0"], ["パウダーブルー", "#A7C7E7"], ["マゼンタ", "#C2185B"], ["ネイビー", "#1F2A6B"]] },
];
const pub = getPublishedPersonalColors();
const results = SEASONS.map((t) => {
  const page = pub.find((d) => d.slug === t.key) ?? pub.find((d) => d.slug === t.base);
  const ex = page ? selfCheckExtras("pc", page.slug) : { people: [], items: [], total: 0 };
  return { ...t, href: page ? withBase(`/personal-color/${encodeURIComponent(page.slug)}/`) : withBase("/personal-color/"), pageName: page?.name ?? "パーソナルカラー", mySlug: page?.slug ?? "", ...ex };
});
const four = results.slice(0, 4);
const title = "パーソナルカラー自己診断（イエベ・ブルベ・4シーズン）";
const description = "8問に答えて、イエベかブルベか、春・夏・秋・冬のどれに近いかを自己診断。結果では、その季節のパレットと、同じパーソナルカラーだと本人が話しているYouTuber・インフルエンサー、その人たちに人気のコスメが見られます。";
const crumbs = [
  { name: "ホーム", path: "/" },
  { name: "パーソナルカラーから探す", path: "/personal-color/" },
  { name: "パーソナルカラー自己診断", path: "/personal-color/check/" },
];
const pageUrl = new URL(withBase("/personal-color/check/"), Astro.site!).href;
---

<Layout title={title} description={description} jsonLd={[breadcrumbLd(crumbs, Astro.site!)]}>
  <nav class="text-xs text-neutral-500 mb-6 flex flex-wrap gap-2" aria-label="パンくず">
    <a href={withBase("/")} class="link-u">Home</a><span aria-hidden="true">/</span>
    <a href={withBase("/personal-color/")} class="link-u">パーソナルカラーから探す</a><span aria-hidden="true">/</span>
    <span>自己診断</span>
  </nav>

  <section class="ck-hero" aria-labelledby="ck-title">
    <div class="ck-blobs" aria-hidden="true">
      <span style="--c:#F7A08A;--x:8%;--y:18%;--d:0s"></span>
      <span style="--c:#C8763D;--x:72%;--y:8%;--d:-4s"></span>
      <span style="--c:#C7B8E0;--x:18%;--y:70%;--d:-8s"></span>
      <span style="--c:#1F2A6B;--x:80%;--y:64%;--d:-12s"></span>
      <span style="--c:#F9E07F;--x:46%;--y:40%;--d:-6s"></span>
    </div>
    <div class="ck-hero-in">
      <p class="ck-eyebrow">Personal color self check</p>
      <h1 id="ck-title" class="ck-h1">あなたの色は、<br />どの季節？</h1>
      <p class="ck-lead">8つの質問で、イエベかブルベか、春・夏・秋・冬のどれに近いかが分かります。結果では、同じパーソナルカラーのインフルエンサーと、その人たちに人気のコスメも。</p>
      <p class="ck-meta"><span>8 questions</span><span>約1分</span><span>回答は送信されません</span></p>
    </div>

    <div id="pc-check" class="ck-card" data-base-q={JSON.stringify(BASE_Q)} data-season-q={JSON.stringify(SEASON_Q)} data-results={JSON.stringify(results)} data-page-url={pageUrl}>
      <noscript><p class="ck-note">診断にはJavaScriptが必要です。下の「4つのシーズン」を参考にしてください。</p></noscript>
      <div data-stage class="ck-stage"></div>
    </div>
  </section>

  <section class="ck-guide" aria-labelledby="ck-seasons">
    <p class="ck-eyebrow">The four seasons</p>
    <h2 id="ck-seasons" class="ck-h2">4つのシーズン</h2>
    <p class="ck-sub">イエベを明るく澄んだ「春」と深みのある「秋」、ブルベをやわらかい「夏」と鮮やかな「冬」に分けたものです。</p>
    <ul class="ck-seasons">
      {four.map((s) => (
        <li>
          <a href={s.href} class="ck-season" style={`--a:${s.palette[0][1]};--b:${s.palette[1][1]}`}>
            <span class="ck-season-sw" aria-hidden="true">{s.palette.map(([, c]) => <i style={`background:${c}`} />)}</span>
            <span class="ck-season-en">{s.en}</span>
            <span class="ck-season-name">{s.key}</span>
            <span class="ck-season-mood">{s.mood.join("・")}</span>
            <span class="ck-season-text">{s.text}</span>
            {s.total > 0 && <span class="ck-season-more">{s.pageName}のインフルエンサー {s.total}人 →</span>}
          </a>
        </li>
      ))}
    </ul>
    <p class="ck-note mt">この診断は目安です。照明や日焼け、髪色で見え方は変わります。はっきり知りたいときは、プロのパーソナルカラー診断がおすすめです。回答はこの端末の中だけで使い、どこにも送りません。</p>
    <p class="ck-cross"><a href={withBase("/skin-type/check/")}>肌質の自己診断もする →</a></p>
  </section>
</Layout>

<style is:global>
  .ck-hero { position: relative; overflow: hidden; border-radius: 2rem; padding: clamp(1.5rem, 4vw, 3.5rem); background: linear-gradient(140deg, #fff7f2 0%, #fdf1f6 50%, #f3f1fb 100%); display: grid; gap: clamp(1.5rem, 4vw, 3rem); }
  @media (min-width: 1024px) { .ck-hero { grid-template-columns: 5fr 7fr; align-items: start; } .ck-hero-in { padding-top: 2.5rem; } }
  .ck-blobs { position: absolute; inset: 0; filter: blur(46px); opacity: .55; pointer-events: none; }
  .ck-blobs span { position: absolute; left: var(--x); top: var(--y); width: 34vmax; height: 34vmax; max-width: 420px; max-height: 420px; border-radius: 50%; background: var(--c); animation: ck-float 22s ease-in-out infinite; animation-delay: var(--d); }
  @keyframes ck-float { 0%, 100% { transform: translate(0, 0) scale(1); } 33% { transform: translate(6%, -8%) scale(1.08); } 66% { transform: translate(-7%, 6%) scale(.94); } }
  @media (prefers-reduced-motion: reduce) { .ck-blobs span { animation: none; } }
  .ck-hero-in, .ck-card { position: relative; }
  .ck-eyebrow { font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: var(--color-rose); font-weight: 600; }
  .ck-h1 { margin-top: .75rem; font-family: var(--font-serif, serif); font-weight: 600; font-size: clamp(2.1rem, 5.4vw, 3.6rem); line-height: 1.12; letter-spacing: -.02em; color: var(--color-ink); }
  .ck-lead { margin-top: 1.25rem; font-size: .9rem; line-height: 1.95; color: #4b4547; max-width: 30rem; }
  .ck-meta { margin-top: 1.25rem; display: flex; flex-wrap: wrap; gap: .5rem; }
  .ck-meta span { font-size: 11px; padding: .3rem .75rem; border-radius: 999px; background: rgba(255,255,255,.7); border: 1px solid rgba(0,0,0,.06); color: #555; }
  .ck-card { border-radius: 1.75rem; background: rgba(255,255,255,.78); backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px); border: 1px solid rgba(255,255,255,.9); box-shadow: 0 30px 60px -30px rgba(80, 40, 60, .35); padding: clamp(1.25rem, 3.5vw, 2.25rem); }
  .ck-stage { min-height: 24rem; }
  .ck-in { animation: ck-in .45s cubic-bezier(.2,.7,.2,1) both; }
  @keyframes ck-in { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .ck-in { animation: none; } }
  .ck-progress { display: flex; gap: 6px; }
  .ck-progress i { flex: 1; height: 4px; border-radius: 4px; background: rgba(0,0,0,.08); overflow: hidden; position: relative; }
  .ck-progress i.on::after { content: ""; position: absolute; inset: 0; background: linear-gradient(90deg, #F7A08A, var(--color-rose)); }
  .ck-step { margin-top: 1rem; display: flex; justify-content: space-between; font-size: 11px; color: #8a8285; letter-spacing: .08em; }
  .ck-qno { margin-top: 1.5rem; font-family: var(--font-serif, serif); font-size: 2.6rem; line-height: 1; color: var(--color-rose); opacity: .9; }
  .ck-q { margin-top: .5rem; font-family: var(--font-serif, serif); font-weight: 600; font-size: clamp(1.25rem, 2.6vw, 1.6rem); line-height: 1.45; color: var(--color-ink); }
  .ck-hint { margin-top: .4rem; font-size: 12px; color: #8a8285; }
  .ck-opts { margin-top: 1.5rem; display: grid; gap: .75rem; }
  @media (min-width: 640px) { .ck-opts.two { grid-template-columns: 1fr 1fr; } .ck-opts.two .ck-opt.plain { grid-column: 1 / -1; } }
  .ck-opt { display: flex; align-items: center; gap: 1rem; width: 100%; text-align: left; padding: 1rem 1.1rem; border-radius: 1.1rem; border: 1px solid rgba(0,0,0,.09); background: #fff; font-size: .9rem; color: var(--color-ink); cursor: pointer; transition: transform .2s, border-color .2s, box-shadow .2s; }
  .ck-opt:hover, .ck-opt:focus-visible { transform: translateY(-2px); border-color: var(--color-rose); box-shadow: 0 12px 24px -16px rgba(200, 60, 110, .55); outline: none; }
  .ck-opt.plain { justify-content: center; background: transparent; color: #7a7275; border-style: dashed; padding: .75rem; font-size: .8rem; }
  .ck-vis { flex-shrink: 0; width: 52px; height: 52px; border-radius: 50%; display: grid; place-items: center; position: relative; box-shadow: inset 0 0 0 1px rgba(0,0,0,.06); }
  .ck-vis.multi { border-radius: 14px; overflow: hidden; display: grid; grid-auto-flow: column; }
  .ck-vis.multi i { display: block; width: 100%; height: 100%; }
  .ck-back { margin-top: 1.5rem; font-size: 12px; color: #8a8285; cursor: pointer; background: none; border: 0; }
  .ck-back:hover { color: var(--color-ink); }
  /* 結果 */
  .ck-res-top { display: grid; gap: 1.25rem; align-items: center; }
  @media (min-width: 640px) { .ck-res-top { grid-template-columns: auto 1fr; } }
  .ck-orb { position: relative; width: 150px; height: 150px; margin: 0 auto; }
  .ck-orb i { position: absolute; width: 74px; height: 74px; border-radius: 50%; box-shadow: 0 10px 22px -10px rgba(0,0,0,.45), inset 0 0 0 2px rgba(255,255,255,.7), 0 0 0 1px rgba(0,0,0,.08); animation: ck-pop .6s cubic-bezier(.2,1.4,.4,1) both; }
  .ck-orb i:nth-child(1) { left: 38px; top: 0; animation-delay: .05s; }
  .ck-orb i:nth-child(2) { left: 76px; top: 30px; animation-delay: .12s; }
  .ck-orb i:nth-child(3) { left: 62px; top: 74px; animation-delay: .19s; }
  .ck-orb i:nth-child(4) { left: 14px; top: 74px; animation-delay: .26s; }
  .ck-orb i:nth-child(5) { left: 0; top: 30px; animation-delay: .33s; }
  @keyframes ck-pop { from { opacity: 0; transform: scale(.4); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .ck-orb i { animation: none; } }
  .ck-res-en { font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: var(--color-rose); font-weight: 600; }
  .ck-res-name { margin-top: .25rem; font-family: var(--font-serif, serif); font-weight: 600; font-size: clamp(2.4rem, 6vw, 3.4rem); line-height: 1.05; color: var(--color-ink); }
  .ck-res-name small { font-size: .95rem; font-weight: 400; color: #8a8285; margin-left: .4rem; }
  @media (max-width: 520px) { .ck-res-name small { display: block; margin: .3rem 0 0; } }
  .ck-mood { margin-top: .75rem; display: flex; flex-wrap: wrap; gap: .4rem; }
  .ck-mood span { font-size: 11px; padding: .25rem .7rem; border-radius: 999px; background: #fff; border: 1px solid rgba(0,0,0,.08); }
  .ck-res-text { margin-top: 1.25rem; font-size: .9rem; line-height: 1.9; color: #4b4547; }
  .ck-block { margin-top: 1.75rem; }
  .ck-block h3 { font-size: 11px; letter-spacing: .16em; text-transform: uppercase; color: #8a8285; font-weight: 600; margin-bottom: .75rem; }
  .ck-pal { display: grid; grid-template-columns: repeat(5, 1fr); gap: .5rem; }
  .ck-pal div { text-align: center; font-size: 10px; color: #6b6366; }
  .ck-pal i { display: block; aspect-ratio: 1; border-radius: 14px; margin-bottom: .35rem; box-shadow: inset 0 0 0 1px rgba(0,0,0,.08); }
  .ck-people { display: flex; flex-wrap: wrap; gap: .25rem; align-items: center; }
  .ck-people a img { width: 44px; height: 44px; border-radius: 50%; object-fit: cover; border: 3px solid #fff; box-shadow: 0 6px 14px -8px rgba(0,0,0,.5); transition: transform .2s; }
  .ck-people a:hover img { transform: translateY(-3px); }
  .ck-people span { font-size: 12px; color: #6b6366; margin-left: .5rem; }
  .ck-items { display: grid; grid-template-columns: repeat(3, 1fr); gap: .75rem; }
  .ck-item { display: block; border-radius: 1rem; background: #fff; border: 1px solid rgba(0,0,0,.06); padding: .6rem; transition: transform .2s, box-shadow .2s; }
  .ck-item:hover { transform: translateY(-3px); box-shadow: 0 14px 26px -18px rgba(0,0,0,.5); }
  .ck-item img { width: 100%; aspect-ratio: 1; object-fit: contain; border-radius: .7rem; background: #faf6f4; }
  .ck-item b { display: block; margin-top: .45rem; font-size: 10px; color: var(--color-rose); font-weight: 600; }
  .ck-item span { display: block; font-size: 11px; line-height: 1.4; color: var(--color-ink); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .ck-item em { display: block; margin-top: .2rem; font-style: normal; font-size: 10px; color: #8a8285; }
  .ck-cta { margin-top: 1.75rem; display: grid; gap: .6rem; }
  @media (min-width: 640px) { .ck-cta { grid-template-columns: 1fr 1fr; } }
  .ck-btn { display: block; text-align: left; border-radius: 1.1rem; padding: 1rem 1.15rem; font-size: .88rem; cursor: pointer; transition: background .2s, color .2s, border-color .2s; }
  .ck-btn small { display: block; margin-top: .2rem; font-size: 11px; opacity: .7; }
  .ck-btn.dark { background: var(--color-ink); color: #fff; border: 0; }
  .ck-btn.dark:hover { background: var(--color-rose); }
  .ck-btn.line { background: #fff; border: 1px solid rgba(0,0,0,.14); color: var(--color-ink); }
  .ck-btn.line:hover { border-color: var(--color-rose); color: var(--color-rose); }
  .ck-share { margin-top: 1.25rem; display: flex; flex-wrap: wrap; align-items: center; gap: .5rem; font-size: 12px; color: #8a8285; }
  .ck-share a, .ck-share button { font-size: 12px; padding: .35rem .85rem; border-radius: 999px; border: 1px solid rgba(0,0,0,.12); background: #fff; color: var(--color-ink); cursor: pointer; }
  .ck-share a:hover, .ck-share button:hover { border-color: var(--color-rose); color: var(--color-rose); }
  .ck-note { font-size: 11px; line-height: 1.8; color: #8a8285; }
  .ck-note.mt { margin-top: 1.5rem; }
  /* 4つのシーズン */
  .ck-guide { margin-top: clamp(3rem, 7vw, 5rem); }
  .ck-h2 { margin-top: .5rem; font-family: var(--font-serif, serif); font-weight: 600; font-size: clamp(1.5rem, 3vw, 2rem); }
  .ck-sub { margin-top: .6rem; font-size: .88rem; color: #5b5457; line-height: 1.9; }
  .ck-seasons { margin-top: 1.5rem; display: grid; gap: 1rem; }
  @media (min-width: 640px) { .ck-seasons { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1100px) { .ck-seasons { grid-template-columns: repeat(4, 1fr); } }
  .ck-season { display: flex; flex-direction: column; height: 100%; border-radius: 1.5rem; padding: 1.25rem; background: linear-gradient(160deg, color-mix(in srgb, var(--a) 18%, white), color-mix(in srgb, var(--b) 12%, white)); border: 1px solid rgba(0,0,0,.05); transition: transform .25s, box-shadow .25s; }
  .ck-season:hover { transform: translateY(-4px); box-shadow: 0 22px 40px -26px rgba(0,0,0,.45); }
  .ck-season-sw { display: flex; }
  .ck-season-sw i { width: 30px; height: 30px; border-radius: 50%; margin-right: -8px; border: 2px solid #fff; box-shadow: 0 4px 10px -6px rgba(0,0,0,.5); }
  .ck-season-en { margin-top: 1rem; font-size: 10px; letter-spacing: .22em; text-transform: uppercase; color: #8a8285; }
  .ck-season-name { font-family: var(--font-serif, serif); font-weight: 600; font-size: 1.5rem; color: var(--color-ink); }
  .ck-season-mood { margin-top: .2rem; font-size: 11px; color: var(--color-rose); }
  .ck-season-text { margin-top: .7rem; font-size: 12px; line-height: 1.8; color: #4b4547; flex: 1; }
  .ck-season-more { margin-top: .9rem; font-size: 12px; color: var(--color-ink); }
  .ck-cross { margin-top: 1rem; font-size: .9rem; }
  .ck-cross a { color: var(--color-ink); text-decoration: underline; text-underline-offset: 4px; }
</style>

<script>
  import { add, load, remove } from "../../scripts/my-cosme-store";
  type Opt = { label: string; v?: string; sw?: string[]; style?: string };
  type Q = { q: string; hint: string; opts: Opt[] };
  type R = { key: string; base: string; en: string; mood: string[]; text: string; palette: [string, string][]; href: string; pageName: string; mySlug: string; people: { href: string; icon: string; name: string }[]; items: { href: string; img: string; brand: string; name: string; cat: string; users: number }[]; total: number };
  const root = document.getElementById("pc-check")!;
  const stage = root.querySelector<HTMLElement>("[data-stage]")!;
  const BASE_Q = JSON.parse(root.dataset.baseQ!) as Q[];
  const SEASON_Q = JSON.parse(root.dataset.seasonQ!) as Record<"Y" | "B", Q[]>;
  const RESULTS = JSON.parse(root.dataset.results!) as R[];
  const PAGE_URL = root.dataset.pageUrl!;
  const BASE = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL.slice(0, -1) : import.meta.env.BASE_URL;
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);
  const track = (action: string) => {
    const g = (window as unknown as { gtag?: (...a: unknown[]) => void }).gtag;
    if (typeof g === "function") g("event", "self_check", { kind: "personal_color", action }); // どの結果かは送らない
  };
  const TOTAL = BASE_Q.length + 3;
  let answers: (string | undefined)[] = [];
  let questions: Q[] = [...BASE_Q];
  let base: "Y" | "B" | "" = "";

  /** 選択肢の絵：金属の光沢・血管の線・瞳・ツヤとマット・色の並び */
  function vis(o: Opt): string {
    const sw = o.sw || [];
    if (!sw.length) return "";
    if (o.style === "metal") return `<span class="ck-vis" style="background:radial-gradient(circle at 32% 28%, ${sw[0]} 0 18%, ${sw[1]} 46%, ${sw[2]} 100%)"></span>`;
    if (o.style === "line") return `<span class="ck-vis" style="background:#F3DCCB"><svg viewBox="0 0 52 52" width="52" height="52" aria-hidden="true"><path d="M10 40 C 18 30, 22 26, 26 22 S 36 12, 42 10" stroke="${sw[0]}" stroke-width="3.2" fill="none" stroke-linecap="round"/><path d="M26 22 C 30 26, 34 32, 36 42" stroke="${sw[0]}" stroke-width="2.2" fill="none" stroke-linecap="round" opacity=".7"/></svg></span>`;
    if (o.style === "eye") return `<span class="ck-vis" style="background:#fff"><svg viewBox="0 0 52 52" width="52" height="52" aria-hidden="true"><path d="M6 26 Q26 8 46 26 Q26 44 6 26Z" fill="#fff" stroke="#d9cfcb"/><circle cx="26" cy="26" r="10" fill="${sw[0]}"/><circle cx="26" cy="26" r="4.2" fill="#0d0b0b"/><circle cx="29.5" cy="22.5" r="2.4" fill="#fff" opacity=".9"/></svg></span>`;
    if (o.style === "gloss") return `<span class="ck-vis" style="background:radial-gradient(circle at 30% 25%, #fff 0 14%, ${sw[0]} 42%, color-mix(in srgb, ${sw[0]} 70%, #000) 100%)"></span>`;
    if (o.style === "matte") return `<span class="ck-vis" style="background:${sw[0]};box-shadow:inset 0 -8px 14px rgba(0,0,0,.12)"></span>`;
    if (sw.length > 1) return `<span class="ck-vis multi">${sw.map((c) => `<i style="background:${c}"></i>`).join("")}</span>`;
    return `<span class="ck-vis" style="background:${sw[0]}"></span>`;
  }
  const count = (from: number, a: string, b: string) => {
    let x = 0, y = 0;
    answers.slice(from).forEach((v) => { if (v === a) x++; if (v === b) y++; });
    return [x, y];
  };
  function start() {
    answers = [];
    questions = [...BASE_Q];
    base = "";
    show();
  }
  function show() {
    const i = answers.length;
    if (i === BASE_Q.length && !base) {
      const [y, b] = count(0, "Y", "B");
      if (y === b) return result("");
      base = y > b ? "Y" : "B";
      questions = [...BASE_Q, ...SEASON_Q[base]];
    }
    if (i >= questions.length) {
      const [p, q] = base === "Y" ? count(BASE_Q.length, "S", "A") : count(BASE_Q.length, "U", "W");
      const key = p === q ? (base === "Y" ? "イエベ" : "ブルベ") : base === "Y" ? (p > q ? "イエベ春" : "イエベ秋") : p > q ? "ブルベ夏" : "ブルベ冬";
      return result(key);
    }
    const q = questions[i];
    const plain = q.opts.filter((o) => !o.sw);
    const rich = q.opts.filter((o) => o.sw);
    stage.innerHTML = `<div class="ck-in">
      <div class="ck-progress" aria-hidden="true">${Array.from({ length: TOTAL }, (_, k) => `<i class="${k < i ? "on" : ""}"></i>`).join("")}</div>
      <p class="ck-step"><span>${i < BASE_Q.length ? "STEP 1 ・ イエベ？ブルベ？" : `STEP 2 ・ ${base === "Y" ? "イエベ" : "ブルベ"}のどのタイプ？`}</span><span>${i + 1} / ${TOTAL}</span></p>
      <p class="ck-qno" aria-hidden="true">Q${i + 1}</p>
      <h2 class="ck-q">${esc(q.q)}</h2>
      <p class="ck-hint">${esc(q.hint)}</p>
      <div class="ck-opts ${rich.length === 2 ? "two" : ""}">
        ${rich.map((o) => `<button type="button" class="ck-opt" data-opt="${q.opts.indexOf(o)}">${vis(o)}<span>${esc(o.label)}</span></button>`).join("")}
        ${plain.map((o) => `<button type="button" class="ck-opt plain" data-opt="${q.opts.indexOf(o)}">${esc(o.label)}</button>`).join("")}
      </div>
      ${i > 0 ? `<button type="button" data-back class="ck-back">← 1つ前に戻る</button>` : ""}
    </div>`;
  }
  function result(key: string) {
    track("done");
    const r = RESULTS.find((x) => x.key === key);
    if (!r) {
      const both = RESULTS.filter((x) => x.key === "イエベ" || x.key === "ブルベ");
      stage.innerHTML = `<div class="ck-in">
        <p class="ck-res-en">Result</p>
        <h2 class="ck-q" style="margin-top:.5rem">イエベ・ブルベが決めきれませんでした</h2>
        <p class="ck-res-text">答えがちょうど半分に分かれました。両方の特徴を持つ人もいます。自然光の下でもう一度試すか、両方のページを見比べてみてください。</p>
        <div class="ck-cta">${both.map((x) => `<a href="${x.href}" class="ck-btn line">${esc(x.pageName)}のインフルエンサーと愛用コスメ →</a>`).join("")}</div>
        <button type="button" data-restart class="ck-back">もう一度診断する</button>
      </div>`;
      return;
    }
    const set = r.mySlug ? !!load().pc[r.mySlug] : false;
    const share = `パーソナルカラー自己診断の結果は「${r.key}」タイプでした。同じ${r.pageName}のインフルエンサーの愛用コスメもチェック #OsoroCosme`;
    stage.innerHTML = `<div class="ck-in">
      <div class="ck-res-top">
        <div class="ck-orb" aria-hidden="true">${r.palette.map(([, c]) => `<i style="background:${c}"></i>`).join("")}</div>
        <div>
          <p class="ck-res-en">Your season ・ ${esc(r.en)}</p>
          <h2 class="ck-res-name">${esc(r.key)}<small>タイプに近いかも</small></h2>
          <div class="ck-mood">${r.mood.map((m) => `<span>${esc(m)}</span>`).join("")}</div>
        </div>
      </div>
      <p class="ck-res-text">${esc(r.text)}</p>
      <div class="ck-block"><h3>Your palette ・ 似合いやすいとされる色</h3>
        <div class="ck-pal">${r.palette.map(([n, c]) => `<div><i style="background:${c}"></i>${esc(n)}</div>`).join("")}</div>
      </div>
      ${r.people.length ? `<div class="ck-block"><h3>同じ${esc(r.pageName)}のインフルエンサー</h3>
        <div class="ck-people">${r.people.map((p) => `<a href="${p.href}" title="${esc(p.name)}"><img src="${esc(p.icon)}" alt="${esc(p.name)}" width="44" height="44" loading="lazy" referrerpolicy="no-referrer"></a>`).join("")}<span>${r.total}人</span></div>
      </div>` : ""}
      ${r.items.length ? `<div class="ck-block"><h3>${esc(r.pageName)}の人に人気のコスメ</h3>
        <div class="ck-items">${r.items.map((it) => `<a class="ck-item" href="${it.href}"><img src="${esc(it.img)}" alt="" loading="lazy" onerror="this.style.visibility='hidden'"><b>${esc(it.cat)}</b><span>${esc(it.brand)} ${esc(it.name)}</span><em>同じ${esc(r.pageName)}の${it.users}人が使用</em></a>`).join("")}</div>
      </div>` : ""}
      <div class="ck-cta">
        <a href="${r.href}" class="ck-btn dark">${esc(r.pageName)}のインフルエンサーと愛用コスメを見る →<small>${r.total ? `${r.total}人のインフルエンサー` : ""}</small></a>
        ${r.mySlug ? `<button type="button" data-set="${esc(r.mySlug)}" class="ck-btn line">${set ? "✓ 登録済み・マイコスメでおすすめを見る →" : `「${esc(r.pageName)}」をマイコスメに登録して、おすすめを見る →`}<small>この端末のマイコスメに保存し、そのままマイコスメを開きます</small></button>` : ""}
      </div>
      <div class="ck-share">結果をシェア
        <a href="https://twitter.com/intent/tweet?text=${encodeURIComponent(share)}&url=${encodeURIComponent(PAGE_URL)}" target="_blank" rel="noopener">X</a>
        <a href="https://social-plugins.line.me/lineit/share?url=${encodeURIComponent(PAGE_URL)}" target="_blank" rel="noopener">LINE</a>
        <button type="button" data-copy>リンクをコピー</button>
      </div>
      <p class="ck-note mt">自己診断の目安です。照明や日焼け、髪色で見え方は変わります。</p>
      <button type="button" data-restart class="ck-back">もう一度診断する</button>
    </div>`;
  }
  root.addEventListener("click", async (e) => {
    const t = e.target as HTMLElement;
    const opt = t.closest<HTMLElement>("[data-opt]");
    if (opt) {
      const q = questions[answers.length];
      answers.push(q.opts[Number(opt.dataset.opt)].v);
      if (answers.length === 1) track("start");
      return show();
    }
    if (t.closest("[data-back]")) {
      answers.pop();
      if (answers.length < BASE_Q.length) { base = ""; questions = [...BASE_Q]; }
      return show();
    }
    if (t.closest("[data-restart]")) { start(); root.scrollIntoView({ behavior: "smooth", block: "start" }); return; }
    const cp = t.closest<HTMLElement>("[data-copy]");
    if (cp) {
      try { await navigator.clipboard.writeText(PAGE_URL); cp.textContent = "コピーしました"; } catch { cp.textContent = PAGE_URL; }
      return;
    }
    const s = t.closest<HTMLElement>("[data-set]");
    if (s) {
      const slug = s.dataset.set!;
      for (const x of Object.keys(load().pc)) if (x !== slug) remove(x, "pc");
      add(slug, undefined, "pc");
      track("set_my_cosme");
      // 登録したらマイコスメを開き、おすすめの欄を見せる（マイコスメ側で「登録しました」と出す。316章）
      location.href = `${BASE}/my-cosme/?registered=pc#foryou`;
    }
  });
  start();
</script>
