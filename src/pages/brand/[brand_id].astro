---
import BrandFlag from "../../components/BrandFlag.astro";
import PageHead from "../../components/PageHead.astro";
import Layout from "../../layouts/Layout.astro";
import ShareButtons from "../../components/ShareButtons.astro";
import CosmeticCard from "../../components/CosmeticCard.astro";
import { GROUP_EN, categoryUrl, getRankingPages, getBrandProducers, getBrandsWithVideos, getAliasRedirects, getBrandName, getCosmeticsForBrand, breadcrumbLd, getBrandMeta, getBrandGroups, getBrandCosmeticsByCategory, getBrandTopCosmetics, getCosmeticVideoCounts, COUNTRY_NAMES, withBase, cosmeticSlug, formatCount } from "../../lib/data";

export function getStaticPaths() {
  return [
    ...getBrandsWithVideos().map((b) => ({ params: { brand_id: b.brand_id }, props: { redirectTo: "" } })),
    // 二重登録ブランドの統合前のURLは、統合先のブランドページへ転送する
    ...getAliasRedirects().brands.map((r) => ({ params: { brand_id: r.from }, props: { redirectTo: r.to } })),
  ];
}

const { brand_id } = Astro.params;
const { redirectTo } = Astro.props;
if (redirectTo) return Astro.redirect(withBase(`/brand/${redirectTo}`), 301);
const brandName = getBrandName(brand_id!) ?? "不明なブランド";
const cosmetics = getCosmeticsForBrand(brand_id!);
// カテゴリの中は、紹介動画の多い順に並べる（以前は動画に出てきた順で、どれが人気か分からなかった。195章）
const videoCounts = getCosmeticVideoCounts();
const countOf = (c: { brand_id: string; name_id: string }) => videoCounts.get(`${c.brand_id}_${c.name_id}`) ?? 0;
const sections = getBrandCosmeticsByCategory(brand_id!).map((s) => ({ ...s, items: [...s.items].sort((a, b) => countOf(b) - countOf(a)) }));
// ランキングと同じ大分類（ベースメイク・アイメイク…）ごとにまとめ、中は紹介動画の多い順（ユーザー依頼、322章）
const brandGroups = Array.from(new Set(sections.map((s) => s.group))).map((group) => {
  const secs = sections.filter((s) => s.group === group);
  return {
    group,
    en: GROUP_EN[group] || "Others",
    // 区切りは、ランキングと同じカテゴリの順（getBrandCosmeticsByCategory の順）。中は紹介動画の多い順
    secs,
    items: secs.flatMap((s) => s.items),
  };
});
const n2 = (n: number) => String(n).padStart(2, "0");
// 細かいカテゴリのランキングでの順位（ランキングのページと同じ表。PR・提供だけの商品は載らないので順位なし。ユーザー依頼、322章）
const rankingPages = getRankingPages();
const rankIn = (tag: string, c: { brand_id: string; name_id: string }) => {
  const list = rankingPages.get(tag)?.list;
  return list ? list.findIndex((x) => x.brand_id === c.brand_id && x.name_id === c.name_id) + 1 : 0;
};
// 区切りの幅（PCの5列の格子で何列ぶんか）と、中の商品の列数。Tailwindが拾えるよう、クラス名をそのまま書く
const SPAN: Record<number, string> = { 1: "lg:col-span-1", 2: "lg:col-span-2", 3: "lg:col-span-3", 4: "lg:col-span-4", 5: "lg:col-span-5" };
const COLS: Record<number, string> = { 1: "lg:grid-cols-1", 2: "lg:grid-cols-2", 3: "lg:grid-cols-3", 4: "lg:grid-cols-4", 5: "lg:grid-cols-5" };
const stats = getBrandsWithVideos().find((b) => b.brand_id === brand_id);
const meta = getBrandMeta(brand_id!);
// プロデュースしたインフルエンサー（本人のブランド。ユーザー依頼、321章）
const producers = getBrandProducers(brand_id!);
const countryName = meta.country ? COUNTRY_NAMES[meta.country] ?? meta.country : undefined;
const sisters = meta.group
  ? (getBrandGroups().find((g) => g.group === meta.group)?.brands ?? []).filter((b) => b.brand_id !== brand_id)
  : [];
// 同じ系列のブランド（下の節にカードで。画像はそのブランドで紹介の多い商品。最初は SISTER_SHOW 件、残りは「ほか〇ブランドを見る」で開く。ユーザー依頼、324章）
const SISTER_SHOW = 8;
const sisterCards = sisters.map((b) => ({ ...b, imageSrc: getBrandTopCosmetics(b.brand_id, "", 1)[0]?.imageSrc ?? "" }));
const profile = [countryName ? `${countryName}のブランド` : null, meta.group ? `${meta.group}系列` : null].filter(Boolean).join("・");
// 検索結果の説明（meta description）。画面には出さない（国・数字は見出しのまわりに出ているため。322章）
const description = `${brandName}${profile ? `（${profile}）` : ""}は、YouTubeのコスメ紹介動画${stats?.videoCount ?? 0}本で${cosmetics.length}品が紹介されています。紹介された商品とその紹介動画を一覧できます。`;
// OGP画像：このブランドで紹介動画が最も多い商品（画像があるもの）
const ogImage = getBrandTopCosmetics(brand_id!, "", 1)[0]?.imageSrc || undefined;
const jsonLd = [
  ...(cosmetics.length > 0
    ? [
        {
          "@context": "https://schema.org",
          "@type": "ItemList",
          name: `${brandName}の紹介されたコスメ`,
          numberOfItems: cosmetics.length,
          itemListElement: sections
            .flatMap((s) => s.items)
            .slice(0, 10)
            .map((it: any, i: number) => ({
              "@type": "ListItem",
              position: i + 1,
              name: `${brandName} ${it.name}`,
              url: new URL(withBase(`/cosmetics/${cosmeticSlug(brand_id!, it.name_id)}`), Astro.site!).href,
            })),
        },
      ]
    : []),
  breadcrumbLd([{ name: "ホーム", path: "/" }, { name: "ブランド一覧", path: "/brand-list" }, { name: brandName, path: `/brand/${brand_id}` }], Astro.site!),
];
---

<Layout title={`${brandName}のおすすめ人気コスメ（YouTuberの紹介数順）`} description={description} image={ogImage} jsonLd={jsonLd}>
  <PageHead en="Brand" title={brandName} stats={[{ n: formatCount(stats?.videoCount ?? 0), label: "紹介動画", unit: "本" }, { n: formatCount(cosmetics.length), label: "コスメ", unit: "品" }]}>
    {countryName && <p class="mt-4 text-sm text-neutral-600"><BrandFlag brand_id={brand_id!} />{countryName}のブランド</p>}
    {producers.length > 0 && (
      <div class="mt-4 flex flex-wrap items-center gap-2">
        <span class="text-[10px] tracking-[0.14em] uppercase text-rose mr-1">Produced by</span>
        {producers.map(({ inf: p, part }) => (
          <a href={withBase(`/influencer/${p.channel_id}`)} class="group inline-flex items-center gap-2 rounded-full border border-ink/15 bg-white/80 pl-1 pr-3.5 py-1 hover:border-rose transition-colors" title={`${p.channel_title}が${part ? "一部の商品を" : ""}プロデュース`}>
            {p.channel_icon ? (
              <img src={p.channel_icon} alt="" width="32" height="32" class="w-8 h-8 rounded-full object-cover ring-2 ring-white" loading="lazy" referrerpolicy="no-referrer" />
            ) : (
              <span class="w-8 h-8 rounded-full bg-blush flex items-center justify-center text-xs text-rose font-semibold" aria-hidden="true">{p.channel_title.slice(0, 1)}</span>
            )}
            <span class="text-sm text-ink group-hover:text-rose transition-colors">{p.channel_title}<span class="text-xs text-neutral-500 ml-1.5">{part ? "一部の商品をプロデュース" : "プロデュース"}</span></span>
          </a>
        ))}
      </div>
    )}
    <ShareButtons text={`${brandName}の人気コスメ・YouTubeの紹介動画`} class="mt-5" />
    {
      sisters.length > 0 && (
        <p class="mt-4">
          <a href="#sisters" class="inline-flex items-center gap-1.5 rounded-full border border-ink/15 bg-white/80 px-3.5 py-1 text-sm hover:border-rose hover:text-rose transition-colors">
            <span class="text-neutral-500">同じ系列</span>{meta.group}系列・{sisters.length}ブランド<span aria-hidden="true">→</span>
          </a>
        </p>
      )
    }
  </PageHead>

  {
    cosmetics.length === 0 ? (
      <p class="text-neutral-500">このブランドの商品紹介動画はまだありません。</p>
    ) : (
      <>
        {brandGroups.length > 1 && (
          <nav aria-label="カテゴリ" class="sticky top-[57px] md:top-[73px] z-30 -mx-4 md:-mx-8 px-4 md:px-8 py-2.5 mb-4 md:mb-6 bg-paper/90 backdrop-blur-md">
            <ol class="flex gap-1.5 overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
              {brandGroups.map((g, gi) => (
                <li class="shrink-0">
                  <a href={`#group-${g.group}`} class="flex items-baseline gap-1.5 rounded-full bg-panel px-3.5 py-1.5 text-sm shadow-[0_0_0_1px_rgb(29_21_23/0.1)] hover:text-rose hover:shadow-[0_0_0_1px_var(--color-rose)] transition-shadow duration-300 whitespace-nowrap">
                    <span class="num-display text-[10px] text-neutral-400">{n2(gi + 1)}</span>{g.group}<span class="text-xs text-neutral-500">{g.items.length}</span>
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        )}
        {brandGroups.map((g, gi) => (
          <section id={`group-${g.group}`} class="panel mb-6 md:mb-8 scroll-mt-32 md:scroll-mt-40">
            <header class="flex items-end justify-between gap-4 mb-4 md:mb-5">
              <div class="flex items-end gap-3 md:gap-5 min-w-0">
                <span class="num-display leading-[0.8] text-[44px] md:text-[64px] text-rose/25" aria-hidden="true">{n2(gi + 1)}</span>
                <div class="min-w-0">
                  <p class="eyebrow text-rose text-xs">{g.en}</p>
                  <h2 class="mt-0.5 font-serif h-section font-semibold">{g.group}</h2>
                </div>
              </div>
              <p class="shrink-0 pb-1 text-xs text-neutral-500"><span class="num-display text-sm text-ink">{g.items.length}</span> 品</p>
            </header>
            {/* 大分類の中を、ランキングと同じ細かいカテゴリ（化粧下地・コンシーラー…）ごとの区切りに。PCでは品数の少ない区切りを横に並べる（5列の格子で、区切りの幅を品数に合わせる） */}
            <div class="grid lg:grid-cols-5 gap-4 md:gap-5 lg:grid-flow-dense">
              {g.secs.map((sec) => (
                <div class:list={["rounded-2xl border border-ink/10 bg-paper/60 p-4 md:p-5", SPAN[Math.min(5, sec.items.length)]]}>
                  {/* 見出しはどの枠も2行の同じ高さ（1行目にカテゴリ名、長ければ…で切る。2行目に品数とランキング）。横に並んだ枠の画像の段がそろうように（322章） */}
                  <h3 class="mb-4 min-w-0">
                    <span class="block truncate font-serif font-semibold leading-snug text-base md:text-[17px]" title={sec.tag}>{sec.tag}</span>
                    <span class="mt-0.5 flex items-baseline gap-3 text-xs font-normal text-neutral-500">
                      <span>{sec.items.length}品</span>
                      {rankingPages.has(sec.tag) && <a href={categoryUrl(sec.tag)} class="text-[11px] hover:text-rose transition-colors">ランキング →</a>}
                    </span>
                  </h3>
                  <div class:list={["grid grid-cols-2 md:grid-cols-4 gap-x-4 gap-y-8", COLS[Math.min(5, sec.items.length)]]}>
                    {sec.items.map((c) => (
                      <CosmeticCard
                        brand_id={c.brand_id}
                        brand={c.brand}
                        name_id={c.name_id}
                        name={c.name}
                        rakutenImageHtml={c.rakuten_image_link}
                        showBrand={false}
                        rank={rankIn(sec.tag, c)}
                        rankLabel={`${sec.tag}ランキング`}
                        rankHref={`${categoryUrl(sec.tag)}#item-${c.brand_id}-${c.name_id}`}
                        caption={`${countOf(c)}本の動画で紹介`}
                      />
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </section>
        ))}
      </>
    )
  }

  {sisterCards.length > 0 && (
    <section id="sisters" class="panel mt-6 md:mt-8 scroll-mt-32">
      <header class="flex items-end justify-between gap-4 mb-5 md:mb-6">
        <div class="min-w-0">
          <p class="eyebrow text-rose text-xs">Same group</p>
          <h2 class="mt-0.5 font-serif h-section font-semibold">{meta.group}系列のブランド</h2>
        </div>
        <p class="shrink-0 pb-1 text-xs text-neutral-500"><span class="num-display text-sm text-ink">{sisterCards.length}</span> ブランド</p>
      </header>
      <ul class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3 md:gap-4">
        {sisterCards.map((b, i) => (
          <li class:list={[i >= SISTER_SHOW && "hidden sister-more"]}>
            <a href={withBase(`/brand/${b.brand_id}`)} class="group h-full flex flex-col sm:flex-row items-start sm:items-center gap-2.5 sm:gap-3 rounded-2xl border border-ink/10 bg-paper/60 p-3 hover:border-rose/50 hover:-translate-y-0.5 hover:shadow-[0_10px_24px_-14px_rgba(0,0,0,0.35)] transition-all">
              <span class="product-well brand-i">
                {b.imageSrc ? <img src={b.imageSrc} alt="" class="w-[70%] h-[84%] sm:w-[84%] object-contain" loading="lazy" data-err="hide" /> : <span class="text-[9px] text-neutral-400">No image</span>}
              </span>
              <span class="min-w-0 w-full">
                <span class="brand-n"><BrandFlag brand_id={b.brand_id} />{b.name}</span>
                <span class="block mt-0.5 text-[11px] text-neutral-500 whitespace-nowrap">紹介動画 {b.videoCount}本</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
      <div class="mt-5 flex flex-wrap items-center gap-x-6 gap-y-3 text-sm">
        {sisterCards.length > SISTER_SHOW && (
          <button type="button" id="sister-toggle" class="rounded-full border border-ink/15 px-4 py-1.5 hover:border-rose hover:text-rose transition-colors" data-more={`ほか${sisterCards.length - SISTER_SHOW}ブランドを見る`} data-less="閉じる">ほか{sisterCards.length - SISTER_SHOW}ブランドを見る</button>
        )}
        <a href={withBase("/brand-list/#group-map")} class="link-u text-rose">ブランド一覧の系列マップで見る →</a>
      </div>
    </section>
  )}
</Layout>

<script>
  // 同じ系列のブランドの「ほか〇ブランドを見る」（324章）
  const sisterBtn = document.getElementById("sister-toggle");
  sisterBtn?.addEventListener("click", () => {
    const open = sisterBtn.getAttribute("aria-expanded") === "true";
    document.querySelectorAll(".sister-more").forEach((el) => el.classList.toggle("hidden", open));
    sisterBtn.setAttribute("aria-expanded", String(!open));
    sisterBtn.textContent = open ? sisterBtn.dataset.more! : sisterBtn.dataset.less!;
  });
</script>


<style>
  @media (max-width: 639px) {
    .filter-bar.is-folded .chip-row { display: none !important; }
  }
</style>
