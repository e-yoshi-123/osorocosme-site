---
import Layout from "../../layouts/Layout.astro";
import CosmeticCard from "../../components/CosmeticCard.astro";
import { getBrandsWithVideos, getBrandName, getCosmeticsForBrand, breadcrumbLd, getBrandMeta, getBrandGroups, getBrandCosmeticsByCategory, getBrandTopCosmetics, COUNTRY_NAMES, withBase, cosmeticSlug } from "../../lib/data";

export function getStaticPaths() {
  return getBrandsWithVideos().map((b) => ({ params: { brand_id: b.brand_id } }));
}

const { brand_id } = Astro.params;
const brandName = getBrandName(brand_id!) ?? "不明なブランド";
const cosmetics = getCosmeticsForBrand(brand_id!);
const sections = getBrandCosmeticsByCategory(brand_id!);
const brandGroups = Array.from(new Set(sections.map((s) => s.group))).map((group) => ({
  group,
  tags: sections.filter((s) => s.group === group).map((s) => s.tag),
  count: sections.filter((s) => s.group === group).reduce((n, s) => n + s.items.length, 0),
}));
const stats = getBrandsWithVideos().find((b) => b.brand_id === brand_id);
const meta = getBrandMeta(brand_id!);
const countryName = meta.country ? COUNTRY_NAMES[meta.country] ?? meta.country : undefined;
const sisters = meta.group
  ? (getBrandGroups().find((g) => g.group === meta.group)?.brands ?? []).filter((b) => b.brand_id !== brand_id)
  : [];
const profile = [countryName ? `${countryName}のブランド` : null, meta.group ? `${meta.group}系列` : null].filter(Boolean).join("・");
const description = `${brandName}${profile ? `（${profile}）` : ""}は、YouTubeのコスメ紹介動画${stats?.videoCount ?? 0}本で${cosmetics.length}品が紹介されています。紹介された商品とその紹介動画を一覧できます。`;
// OGP画像：このブランドで紹介動画が最も多い商品（画像があるもの）
const ogImage = getBrandTopCosmetics(brand_id!, "", 1)[0]?.imageSrc || undefined;
const jsonLd = [
  ...(cosmetics.length > 0
    ? [
        {
          "@context": "https://schema.org",
          "@type": "ItemList",
          name: `${brandName}の紹介されたコスメ`,
          numberOfItems: cosmetics.length,
          itemListElement: sections
            .flatMap((s) => s.items)
            .slice(0, 10)
            .map((it: any, i: number) => ({
              "@type": "ListItem",
              position: i + 1,
              name: `${brandName} ${it.name}`,
              url: new URL(withBase(`/cosmetics/${cosmeticSlug(brand_id!, it.name_id)}`), Astro.site!).href,
            })),
        },
      ]
    : []),
  breadcrumbLd([{ name: "ホーム", path: "/" }, { name: "ブランド一覧", path: "/brand-list" }, { name: brandName, path: `/brand/${brand_id}` }], Astro.site!),
];
---

<Layout title={`${brandName}の人気コスメ・紹介動画`} description={description} image={ogImage} jsonLd={jsonLd}>
  <h1 class="text-xl font-bold mb-2">{brandName}</h1>
  <p class="text-sm text-neutral-500 mb-3">{description}</p>
  {
    sisters.length > 0 && (
      <p class="text-sm mb-6">
        <span class="text-neutral-500">同じ{meta.group}系列:</span>{" "}
        {sisters.map((b, i) => (
          <>
            {i > 0 && "、"}
            <a href={withBase(`/brand/${b.brand_id}`)} class="text-pink-600 hover:underline">{b.name}</a>
          </>
        ))}
      </p>
    )
  }

  {
    cosmetics.length === 0 ? (
      <p class="text-neutral-400">このブランドの商品紹介動画はまだありません。</p>
    ) : (
      <>
        {sections.length > 1 && (
          <div class="md:sticky md:top-14 z-20 bg-neutral-50/95 backdrop-blur py-2 mb-6 border-b text-sm">
            <div class="flex flex-nowrap sm:flex-wrap gap-1.5 overflow-x-auto sm:overflow-visible -mx-4 px-4 sm:mx-0 sm:px-0 pb-1">
              <button class="group-tab shrink-0 whitespace-nowrap px-3 py-1.5 sm:py-1 rounded-full border bg-white" data-group="__all__">
                すべて <span class="text-neutral-400">({cosmetics.length})</span>
              </button>
              {brandGroups.map((g) => (
                <button class="group-tab shrink-0 whitespace-nowrap px-3 py-1.5 sm:py-1 rounded-full border bg-white" data-group={g.group}>
                  {g.group} <span class="text-neutral-400">({g.count})</span>
                </button>
              ))}
            </div>
            {brandGroups.map((g) => (
              <div class="chip-row flex-nowrap sm:flex-wrap gap-1.5 mt-2 pt-2 border-t border-dashed sm:max-h-28 overflow-x-auto sm:overflow-x-visible sm:overflow-y-auto -mx-4 px-4 sm:mx-0 sm:px-0 pb-1" data-group={g.group} style="display:none">
                {sections.filter((sec) => sec.group === g.group).map((sec) => (
                  <button class="cat-chip shrink-0 whitespace-nowrap px-3 py-1 sm:px-2.5 sm:py-0.5 rounded-full border text-xs bg-white" data-tag={sec.tag}>
                    {sec.tag} <span class="text-neutral-400">({sec.items.length})</span>
                  </button>
                ))}
              </div>
            ))}
          </div>
        )}
        {sections.map((sec) => (
          <section class="cat-section mb-10" data-group={sec.group} data-tag={sec.tag}>
            <h2 class="font-bold mb-3 border-b border-pink-200 pb-1">
              {sec.tag} <span class="text-sm font-normal text-neutral-400">{sec.group !== sec.tag && sec.group !== "その他" ? `${sec.group}・` : ""}{sec.items.length}品</span>
            </h2>
            <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3 sm:gap-4">
              {sec.items.map((c) => (
                <CosmeticCard
                  brand_id={c.brand_id}
                  brand={c.brand}
                  name_id={c.name_id}
                  name={c.name}
                  rakutenImageHtml={c.rakuten_image_link}
                />
              ))}
            </div>
          </section>
        ))}
      </>
    )
  }
</Layout>

<script>
  const groupTabs = document.querySelectorAll<HTMLButtonElement>(".group-tab");
  const chipRows = document.querySelectorAll<HTMLElement>(".chip-row");
  const chips = document.querySelectorAll<HTMLButtonElement>(".cat-chip");
  let activeGroup = "__all__";
  let activeTag: string | null = null;

  function render() {
    groupTabs.forEach((t) => t.classList.toggle("bg-pink-100", t.dataset.group === activeGroup));
    chipRows.forEach((r) => (r.style.display = r.dataset.group === activeGroup ? "flex" : "none"));
    chips.forEach((c) => c.classList.toggle("bg-pink-100", c.dataset.tag === activeTag));
    document.querySelectorAll<HTMLElement>(".cat-section").forEach((sec) => {
      const show =
        activeGroup === "__all__" ||
        (sec.dataset.group === activeGroup && (activeTag === null || sec.dataset.tag === activeTag));
      sec.style.display = show ? "" : "none";
    });
  }

  groupTabs.forEach((t) =>
    t.addEventListener("click", () => {
      activeGroup = t.dataset.group!;
      activeTag = null;
      render();
    })
  );
  // 選択中のカテゴリをもう一度押すと大分類全体に戻る
  chips.forEach((c) =>
    c.addEventListener("click", () => {
      activeTag = activeTag === c.dataset.tag ? null : c.dataset.tag!;
      render();
    })
  );
  if (groupTabs.length > 0) render();
</script>
