---
import PageHead from "../../components/PageHead.astro";
import Layout from "../../layouts/Layout.astro";
import ShareButtons from "../../components/ShareButtons.astro";
import CosmeticCard from "../../components/CosmeticCard.astro";
import { getBrandsWithVideos, getAliasRedirects, getBrandName, getCosmeticsForBrand, breadcrumbLd, getBrandMeta, getBrandGroups, getBrandCosmeticsByCategory, getBrandTopCosmetics, getCosmeticVideoCounts, COUNTRY_NAMES, withBase, cosmeticSlug, formatCount } from "../../lib/data";

export function getStaticPaths() {
  return [
    ...getBrandsWithVideos().map((b) => ({ params: { brand_id: b.brand_id }, props: { redirectTo: "" } })),
    // 二重登録ブランドの統合前のURLは、統合先のブランドページへ転送する
    ...getAliasRedirects().brands.map((r) => ({ params: { brand_id: r.from }, props: { redirectTo: r.to } })),
  ];
}

const { brand_id } = Astro.params;
const { redirectTo } = Astro.props;
if (redirectTo) return Astro.redirect(withBase(`/brand/${redirectTo}`), 301);
const brandName = getBrandName(brand_id!) ?? "不明なブランド";
const cosmetics = getCosmeticsForBrand(brand_id!);
// カテゴリの中は、紹介動画の多い順に並べる（以前は動画に出てきた順で、どれが人気か分からなかった。195章）
const videoCounts = getCosmeticVideoCounts();
const countOf = (c: { brand_id: string; name_id: string }) => videoCounts.get(`${c.brand_id}_${c.name_id}`) ?? 0;
const sections = getBrandCosmeticsByCategory(brand_id!).map((s) => ({ ...s, items: [...s.items].sort((a, b) => countOf(b) - countOf(a)) }));
const brandGroups = Array.from(new Set(sections.map((s) => s.group))).map((group) => ({
  group,
  tags: sections.filter((s) => s.group === group).map((s) => s.tag),
  count: sections.filter((s) => s.group === group).reduce((n, s) => n + s.items.length, 0),
}));
const stats = getBrandsWithVideos().find((b) => b.brand_id === brand_id);
const meta = getBrandMeta(brand_id!);
const countryName = meta.country ? COUNTRY_NAMES[meta.country] ?? meta.country : undefined;
const sisters = meta.group
  ? (getBrandGroups().find((g) => g.group === meta.group)?.brands ?? []).filter((b) => b.brand_id !== brand_id)
  : [];
const profile = [countryName ? `${countryName}のブランド` : null, meta.group ? `${meta.group}系列` : null].filter(Boolean).join("・");
const description = `${brandName}${profile ? `（${profile}）` : ""}は、YouTubeのコスメ紹介動画${stats?.videoCount ?? 0}本で${cosmetics.length}品が紹介されています。紹介された商品とその紹介動画を一覧できます。`;
// OGP画像：このブランドで紹介動画が最も多い商品（画像があるもの）
const ogImage = getBrandTopCosmetics(brand_id!, "", 1)[0]?.imageSrc || undefined;
const jsonLd = [
  ...(cosmetics.length > 0
    ? [
        {
          "@context": "https://schema.org",
          "@type": "ItemList",
          name: `${brandName}の紹介されたコスメ`,
          numberOfItems: cosmetics.length,
          itemListElement: sections
            .flatMap((s) => s.items)
            .slice(0, 10)
            .map((it: any, i: number) => ({
              "@type": "ListItem",
              position: i + 1,
              name: `${brandName} ${it.name}`,
              url: new URL(withBase(`/cosmetics/${cosmeticSlug(brand_id!, it.name_id)}`), Astro.site!).href,
            })),
        },
      ]
    : []),
  breadcrumbLd([{ name: "ホーム", path: "/" }, { name: "ブランド一覧", path: "/brand-list" }, { name: brandName, path: `/brand/${brand_id}` }], Astro.site!),
];
// カテゴリのカードの幅（PCの5列の格子で何列ぶんか）と、中の商品の列数。Tailwindが拾えるよう、クラス名をそのまま書く
const SPAN: Record<number, string> = { 1: "lg:col-span-1", 2: "lg:col-span-2", 3: "lg:col-span-3", 4: "lg:col-span-4", 5: "lg:col-span-5" };
const COLS: Record<number, string> = { 1: "lg:grid-cols-1", 2: "lg:grid-cols-2", 3: "lg:grid-cols-3", 4: "lg:grid-cols-4", 5: "lg:grid-cols-5" };
---

<Layout title={`${brandName}の人気コスメ・紹介動画`} description={description} image={ogImage} jsonLd={jsonLd}>
  <PageHead en="Brand" title={brandName} lead={description} stats={[{ n: formatCount(stats?.videoCount ?? 0), label: "紹介動画", unit: "本" }, { n: formatCount(cosmetics.length), label: "コスメ", unit: "品" }]}>
    <ShareButtons text={`${brandName}の人気コスメ・YouTubeの紹介動画`} class="mt-5" />
    {
      sisters.length > 0 && (
        <p class="mt-4 text-sm">
          <span class="text-neutral-500">同じ{meta.group}系列：</span>{" "}
          {sisters.map((b, i) => (
            <>
              {i > 0 && "、"}
              <a href={withBase(`/brand/${b.brand_id}`)} class="link-u">{b.name}</a>
            </>
          ))}
        </p>
      )
    }
  </PageHead>

  {
    cosmetics.length === 0 ? (
      <p class="text-neutral-400">このブランドの商品紹介動画はまだありません。</p>
    ) : (
      <>
        {sections.length > 1 && (
          <div class="md:sticky md:top-[72px] z-20 bg-paper/90 backdrop-blur-md py-3 mb-10 border-b border-ink/10 text-sm">
            <div class="flex flex-nowrap sm:flex-wrap gap-1.5 overflow-x-auto sm:overflow-visible -mx-4 px-4 sm:mx-0 sm:px-0 pb-1">
              <button class="group-tab tab shrink-0 whitespace-nowrap" data-group="__all__">
                すべて <span class="tab-n">{cosmetics.length}</span>
              </button>
              {brandGroups.map((g) => (
                <button class="group-tab tab shrink-0 whitespace-nowrap" data-group={g.group}>
                  {g.group} <span class="tab-n">{g.count}</span>
                </button>
              ))}
            </div>
            {brandGroups.map((g) => (
              <div class="chip-row flex-nowrap sm:flex-wrap gap-1.5 mt-2 pt-2 border-t border-ink/10 sm:max-h-28 overflow-x-auto sm:overflow-x-visible sm:overflow-y-auto -mx-4 px-4 sm:mx-0 sm:px-0 pb-1" data-group={g.group} style="display:none">
                {sections.filter((sec) => sec.group === g.group).map((sec) => (
                  <button class="cat-chip chip shrink-0 whitespace-nowrap" data-tag={sec.tag}>
                    {sec.tag} <span class="tab-n">{sec.items.length}</span>
                  </button>
                ))}
              </div>
            ))}
          </div>
        )}
        {/* PCでは、品数の少ないカテゴリのカードを横に並べる（全幅のカードに1〜2品だと右が空くため）。5列の格子で、カードの幅を品数に合わせる */}
        <div class="grid lg:grid-cols-5 gap-6 md:gap-8 lg:grid-flow-dense">
        {sections.map((sec) => (
          <section class:list={["cat-section panel", SPAN[Math.min(5, sec.items.length)], sec.items.length <= 2 && "lg:!px-6"]} data-group={sec.group} data-tag={sec.tag}>
            <h2 class:list={["font-serif font-semibold mb-5", sec.items.length === 1 ? "text-lg lg:text-[15px] lg:leading-snug" : "text-lg"]}>
              {sec.tag} <span class:list={["text-xs font-normal text-neutral-500", sec.items.length === 1 ? "ml-1 lg:ml-0 lg:block lg:mt-1" : "ml-1"]}>{sec.group !== sec.tag && sec.group !== "その他" ? `${sec.group}・` : ""}{sec.items.length}品</span>
            </h2>
            <div class:list={["grid grid-cols-2 md:grid-cols-4 gap-x-4 gap-y-8", COLS[Math.min(5, sec.items.length)]]}>
              {sec.items.map((c) => (
                <CosmeticCard
                  brand_id={c.brand_id}
                  brand={c.brand}
                  name_id={c.name_id}
                  name={c.name}
                  rakutenImageHtml={c.rakuten_image_link}
                  showBrand={false}
                  caption={`${countOf(c)}本の動画で紹介`}
                />
              ))}
            </div>
          </section>
        ))}
        </div>
      </>
    )
  }
</Layout>

<script>
  const groupTabs = document.querySelectorAll<HTMLButtonElement>(".group-tab");
  const chipRows = document.querySelectorAll<HTMLElement>(".chip-row");
  const chips = document.querySelectorAll<HTMLButtonElement>(".cat-chip");
  let activeGroup = "__all__";
  let activeTag: string | null = null;

  function render() {
    groupTabs.forEach((t) => t.classList.toggle("is-active", t.dataset.group === activeGroup));
    chipRows.forEach((r) => (r.style.display = r.dataset.group === activeGroup ? "flex" : "none"));
    chips.forEach((c) => c.classList.toggle("is-active", c.dataset.tag === activeTag));
    document.querySelectorAll<HTMLElement>(".cat-section").forEach((sec) => {
      const show =
        activeGroup === "__all__" ||
        (sec.dataset.group === activeGroup && (activeTag === null || sec.dataset.tag === activeTag));
      sec.style.display = show ? "" : "none";
    });
  }

  groupTabs.forEach((t) =>
    t.addEventListener("click", () => {
      activeGroup = t.dataset.group!;
      activeTag = null;
      render();
    })
  );
  // 選択中のカテゴリをもう一度押すと大分類全体に戻る
  chips.forEach((c) =>
    c.addEventListener("click", () => {
      activeTag = activeTag === c.dataset.tag ? null : c.dataset.tag!;
      render();
    })
  );
  if (groupTabs.length > 0) render();
</script>
