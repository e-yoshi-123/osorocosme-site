---
import Layout from "../layouts/Layout.astro";
import PageHead from "../components/PageHead.astro";
import InfluencerFeatureCard from "../components/InfluencerFeatureCard.astro";
import { getInfluencerRanking, formatCount, withBase } from "../lib/data";

const influencers = getInfluencerRanking();
// 上位ほど情報を厚く見せる：TOP3は大きなカード、4〜12位は中サイズ、それ以降はコンパクトな一覧
const LARGE = 3;
const MEDIUM_UNTIL = 12;
const large = influencers.slice(0, LARGE);
const medium = influencers.slice(LARGE, MEDIUM_UNTIL);
const rest = influencers.slice(MEDIUM_UNTIL);
---

<Layout
  title="インフルエンサー一覧"
  description="コスメを紹介しているYouTuberの一覧。登録者数・掲載動画数・紹介コスメ数から算出した人気順で、各人の使用コスメ遍歴を確認できます。"
>
  <PageHead en="Influencers" title="インフルエンサー一覧" lead="登録者数・掲載動画数・紹介コスメ数から算出した人気順です。上位の方は、最新の動画とよく紹介するコスメも見られます。" stats={[{ n: formatCount(influencers.length), label: "インフルエンサー", unit: "人" }]} />

  <section class="panel mb-6 md:mb-8">
    <h2 class="font-serif h-section font-semibold mb-6">注目のインフルエンサー <span class="num-display text-rose ml-1">TOP{LARGE}</span></h2>
    <div class="grid gap-x-6 gap-y-0 lg:grid-cols-3">
      {large.map((inf, i) => <InfluencerFeatureCard influencer={inf} rank={i + 1} size="large" />)}
    </div>
  </section>

  <section class="panel mb-6 md:mb-8">
    <h2 class="font-serif h-section font-semibold mb-6">人気のインフルエンサー <span class="num-display text-neutral-500 ml-1">{LARGE + 1}–{LARGE + medium.length}</span></h2>
    <div class="grid gap-x-6 gap-y-0 md:grid-cols-2 lg:grid-cols-3">
      {medium.map((inf, i) => <InfluencerFeatureCard influencer={inf} rank={LARGE + i + 1} size="medium" />)}
    </div>
  </section>

  <section class="panel">
    <h2 class="font-serif h-section font-semibold mb-6">そのほかのインフルエンサー <span class="num-display text-neutral-500 ml-1">{rest.length}</span></h2>
    <!-- 名簿のように、細い罫線で区切った行で並べる -->
    <ul class="grid sm:grid-cols-2 lg:grid-cols-3 gap-x-10">
      {
        rest.map((inf, i) => (
          <li class="min-w-0 border-b border-ink/10">
            <a href={withBase(`/influencer/${inf.channel_id}`)} class="group flex items-center gap-3 py-3">
              <span class="w-8 shrink-0 text-xs text-neutral-400 tabular-nums">{LARGE + medium.length + i + 1}</span>
              {inf.channel_icon ? <img referrerpolicy="no-referrer" src={inf.channel_icon} alt={inf.channel_title} data-name={inf.channel_title} width="40" height="40" class="w-10 h-10 rounded-full shrink-0 ring-1 ring-ink/5" loading="lazy" /> : <span class="w-10 h-10 rounded-full bg-blush shrink-0" />}
              <span class="min-w-0 flex-1">
                <span class="block text-sm font-medium truncate group-hover:text-rose transition-colors">{inf.channel_title}</span>
                <span class="block text-xs text-neutral-500 truncate">登録者 {formatCount(inf.subscriber_count)}人・動画 {inf.videoCount}本・コスメ {inf.cosmeticCount}品</span>
              </span>
              <span class="text-rose opacity-0 -translate-x-1 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300" aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>
