---
import Layout from "../layouts/Layout.astro";
import PageHead from "../components/PageHead.astro";
import InfluencerFeatureCard from "../components/InfluencerFeatureCard.astro";
import InfluencerListRow from "../components/InfluencerListRow.astro";
import { getInfluencerRanking, formatCount, withBase, INFLUENCER_LIST_HEAD, INFLUENCER_LIST_IN_PAGE } from "../lib/data";

const influencers = getInfluencerRanking();
// 上位ほど情報を厚く見せる：TOP3は大きなカード、4〜12位は中サイズ、それ以降はコンパクトな一覧
const LARGE = 3;
const MEDIUM_UNTIL = INFLUENCER_LIST_HEAD;
const large = influencers.slice(0, LARGE);
const medium = influencers.slice(LARGE, MEDIUM_UNTIL);
const rest = influencers.slice(MEDIUM_UNTIL);
// 「そのほか」は先頭だけをページに入れ、残りは「もっと見る」で /influencer-list/rest/ から読む（279章）
const restInPage = rest.slice(0, INFLUENCER_LIST_IN_PAGE);
const restLater = rest.length - restInPage.length;
---

<Layout
  title="インフルエンサー一覧"
  description="コスメを紹介しているYouTuberの一覧。登録者数・掲載動画数・紹介コスメ数から算出した人気順で、各人の使用コスメ遍歴を確認できます。"
>
  <PageHead en="Influencers" title="インフルエンサー一覧" lead="登録者数・掲載動画数・紹介コスメ数から算出した発信力スコアの順です。上位の方は、最新の動画とよく紹介するコスメも見られます。" stats={[{ n: formatCount(influencers.length), label: "インフルエンサー", unit: "人" }]} />

  <section class="panel mb-6 md:mb-8">
    <h2 class="font-serif h-section font-semibold mb-6">発信力 <span class="num-display text-rose ml-1">TOP{LARGE}</span></h2>
    <div class="grid gap-x-6 gap-y-0 lg:grid-cols-3">
      {large.map((inf, i) => <InfluencerFeatureCard influencer={inf} rank={i + 1} size="large" />)}
    </div>
  </section>

  <section class="panel mb-6 md:mb-8">
    <h2 class="font-serif h-section font-semibold mb-6">発信力 <span class="num-display text-neutral-500 ml-1">{LARGE + 1}–{LARGE + medium.length}</span><span class="text-base ml-0.5">位</span></h2>
    <div class="grid gap-x-6 gap-y-0 md:grid-cols-2 lg:grid-cols-3">
      {medium.map((inf, i) => <InfluencerFeatureCard influencer={inf} rank={LARGE + i + 1} size="medium" />)}
    </div>
  </section>

  <section class="panel">
    <h2 class="font-serif h-section font-semibold mb-6">そのほかのインフルエンサー <span class="num-display text-neutral-500 ml-1">{rest.length}</span></h2>
    {/* 名簿のように、細い罫線で区切った行で並べる */}
    <ul id="inf-rest" class="grid sm:grid-cols-2 lg:grid-cols-3 gap-x-10">
      {restInPage.map((inf, i) => <InfluencerListRow inf={inf} rank={LARGE + medium.length + i + 1} />)}
    </ul>
    {restLater > 0 && (
      <button type="button" id="inf-more" data-src={withBase("/influencer-list/rest/")} class="w-full flex items-center justify-center gap-3 py-5 text-xs tracking-[0.1em] cursor-pointer select-none hover:text-rose">
        <span>残り{restLater}人を表示</span><span class="w-7 h-7 rounded-full border border-ink/20 flex items-center justify-center" aria-hidden="true">↓</span>
      </button>
    )}
  </section>
</Layout>

<script>
  // 「そのほかのインフルエンサー」の残りを読んで差し込む（279章）
  const more = document.getElementById("inf-more");
  const list = document.getElementById("inf-rest");
  more?.addEventListener("click", async () => {
    if (!list || more.getAttribute("aria-busy")) return;
    more.setAttribute("aria-busy", "true");
    try {
      const r = await fetch(more.dataset.src!);
      if (!r.ok) throw new Error(String(r.status));
      const doc = new DOMParser().parseFromString(await r.text(), "text/html");
      doc.querySelectorAll("ul > li").forEach((li) => list.appendChild(document.importNode(li, true)));
      more.remove();
    } catch {
      more.removeAttribute("aria-busy");
    }
  });
</script>
