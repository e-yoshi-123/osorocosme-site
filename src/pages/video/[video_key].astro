---
import Layout from "../../layouts/Layout.astro";
import ShareButtons from "../../components/ShareButtons.astro";
import SectionHead from "../../components/SectionHead.astro";
import VideoCard from "../../components/VideoCard.astro";
import PrBadge from "../../components/PrBadge.astro";
import VideoCosmetics from "../../components/VideoCosmetics.astro";
import {
  getAllVideoEntries,
  getVideoByKey,
  getVideosByChannel,
  getVideosUsingCosmetic,
  isVisible,
  sortByPublishedDesc,
  categoryUrl,
  formatCount,
  withBase,
  formatJaDate,
  breadcrumbLd,
  formatDateDot,
  getPrInfo,
  isPrMention,
  ytThumb,
  ytThumbLarge,
  getBrandName,
  getCosmeticListEntry,
  productImageSrc,
  cosmeticSlug,
  hasCosmeticPage,
} from "../../lib/data";

export function getStaticPaths() {
  return getAllVideoEntries().map((v) => ({ params: { video_key: v.key } }));
}

const { video_key } = Astro.params;
const video = getVideoByKey(video_key!);
const validCosmetics = (video?.cosmetics || []).filter((c) => c.brand && c.name);
const cosmeticNames = validCosmetics.slice(0, 5).map((c) => `${c.brand} ${c.name}`).join("、");
const description = video
  ? `${video.channel_title}が${formatJaDate(video.published_at)}に投稿した動画。紹介コスメ${validCosmetics.length}品` + (cosmeticNames ? `（${cosmeticNames}${validCosmetics.length > 5 ? "ほか" : ""}）` : "") + "。"
  : undefined;
// YouTubeと同じタイトルでは検索結果で並ぶだけなので、このページの中身（紹介コスメの一覧）を先頭に出す（動画タイトルは長く、後ろに付けると切れるため。271章）
const pageTitle = video ? (validCosmetics.length ? `【紹介コスメ${validCosmetics.length}品】${video.title}` : video.title) : "動画詳細";
// 非掲載（check_status未確認・削除済み）の動画はsitemapに載せておらず、内容も未確認なので検索に出さない
const noindex = !!video && !isVisible(video);

// PR・提供の動画（197章）。提供を受けた商品はランキング等の数に入れていないので、その旨を添える
const pr = video ? getPrInfo(video.key) : undefined;
const isPr = (c: { brand_id: string; name_id: string }) => !!video && isPrMention(video.key, c.brand_id, c.name_id);
const prBrands = (pr?.brands || []).map((b) => getBrandName(b)).filter(Boolean);
const prNote = pr
  ? (pr.kind === "gift" ? "この動画には、ブランドから提供された商品が含まれます" : "この動画はPR・提供を含みます") +
    (prBrands.length ? `（提供：${prBrands.join("・")}）` : "") + "。" +
    (validCosmetics.some(isPr)
      ? pr.whole ? "この動画で紹介された商品は、ランキング・最近話題の数に入れていません。" : "提供を受けた商品は、ランキング・最近話題の数に入れていません。"
      : "")
  : "";
// 最初の画面に出す紹介コスメの入口（233章）。検索から来た人がすぐ離れていたので、題の下に画像つきで数品を並べる
const QUICK = 4;
const quickSeen = new Set<string>();
const quickCosmetics = validCosmetics
  .map((c) => ({ c, slug: cosmeticSlug(c.brand_id, c.name_id), img: productImageSrc(getCosmeticListEntry(c.brand_id, c.name_id), c.rakuten_image_link) }))
  .filter((x) => x.img && !quickSeen.has(x.slug) && quickSeen.add(x.slug))
  .slice(0, QUICK);

// 関連動画：同じチャンネルの他の動画／紹介コスメが重なる他の動画（掲載中のものだけ、新しい順）
const RELATED = 4;
const sameChannel = video
  ? sortByPublishedDesc(getVideosByChannel(video.channel_id)).filter((v) => v.key !== video.key).slice(0, RELATED)
  : [];
const sameChannelKeys = new Set(sameChannel.map((v) => v.key));
const overlap = new Map<string, { v: ReturnType<typeof getVideoByKey> & {}; n: number }>();
for (const c of validCosmetics) {
  for (const v of getVideosUsingCosmetic(c.brand_id, c.name_id)) {
    if (v.key === video!.key || sameChannelKeys.has(v.key)) continue;
    const cur = overlap.get(v.key);
    if (cur) cur.n += 1;
    else overlap.set(v.key, { v, n: 1 });
  }
}
const sameCosmetics = Array.from(overlap.values())
  .sort((a, b) => b.n - a.n || new Date(b.v.published_at).getTime() - new Date(a.v.published_at).getTime())
  .slice(0, RELATED)
  .map((x) => x.v);


// 見出しの番号は、出る節だけで01から振る
const nums: Record<string, string> = {};
[["grid", validCosmetics.length > 0], ["same", sameChannel.length > 0], ["related", sameCosmetics.length > 0]]
  .filter(([, on]) => on)
  .forEach(([k], i) => (nums[k as string] = String(i + 1).padStart(2, "0")));

const viewCountNum = video?.view_count !== undefined ? Number(video.view_count) : NaN;
const jsonLd = video
  ? [
      {
        "@context": "https://schema.org",
        "@type": "VideoObject",
        name: video.title,
        description: description,
        thumbnailUrl: ytThumbLarge(video.thumbnail),
        uploadDate: video.published_at,
        embedUrl: `https://www.youtube.com/embed/${video.video_id}`,
        contentUrl: video.url,
        ...(video.duration ? { duration: video.duration } : {}),
        ...(Number.isFinite(viewCountNum)
          ? {
              interactionStatistic: {
                "@type": "InteractionCounter",
                interactionType: { "@type": "WatchAction" },
                userInteractionCount: viewCountNum,
              },
            }
          : {}),
      },
      breadcrumbLd([{ name: "ホーム", path: "/" }, { name: "動画一覧", path: "/video-list" }, { name: video.title, path: `/video/${video.key}` }], Astro.site!),
    ]
  : [];
---

<Layout title={pageTitle} description={description} image={video ? ytThumbLarge(video.thumbnail) : undefined} ogType="video.other" jsonLd={jsonLd} noindex={noindex}>
  {
    !video ? (
      <p class="text-neutral-500">動画が見つかりませんでした。</p>
    ) : (
      <>
        {/* ===== 動画：左に埋め込み、右に題・投稿者・数字・YouTubeへの導線 ===== */}
        <div class="panel">
        <div class="grid lg:grid-cols-12 gap-8 lg:gap-12 items-start">
          <div class="lg:col-span-8">
            {/* 埋め込みは押されてから読む（276章）。YouTubeのiframeは1MB近いスクリプトを読むので、最初はサムネイルと再生ボタンだけを出す */}
            <div class="overflow-hidden vid-8 relative" id="video-box" data-video-id={video.video_id} data-title={video.title}>
              <button type="button" class="vid-play group absolute inset-0 w-full h-full cursor-pointer" aria-label={`再生：${video.title}`}>
                <img
                  src={ytThumb(video.thumbnail).src}
                  srcset={ytThumb(video.thumbnail).srcset}
                  sizes="(min-width: 1024px) 60vw, 100vw"
                  alt=""
                  width="640"
                  height="360"
                  class="vid-th"
                  loading="eager"
                  fetchpriority="high"
                  decoding="async"
                />
                <span class="absolute inset-0 flex items-center justify-center">
                  <span class="vid-pb">
                    <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor" /></svg>
                  </span>
                </span>
              </button>
              <noscript>
                <a href={video.url} target="_blank" rel="noopener" class="absolute bottom-3 left-3 bg-paper text-ink text-sm px-4 py-2 rounded-full">YouTubeで見る</a>
              </noscript>
            </div>
            {/* PCでは、YouTube・チャンネルへの導線とシェアを動画のすぐ下に置く（旧AI要約を出さなくなって、動画の下が空いていたため。338章）。スマホは右の列（題の下）のまま */}
            <div class="hidden lg:flex flex-wrap items-center justify-between gap-x-6 gap-y-4 mt-6">
              <div class="flex flex-wrap gap-3">
                <a href={`https://www.youtube.com/watch?v=${video.video_id}`} target="_blank" rel="noopener" class="group u-13">
                  <span class="u-23" aria-hidden="true"></span>YouTubeで見る<span class="u-15" aria-hidden="true">→</span>
                </a>
                <a href={`https://www.youtube.com/channel/${video.channel_id}`} target="_blank" rel="noopener" class="vid-3">チャンネルを見る</a>
              </div>
              <ShareButtons text={`${video.channel_title}「${video.title}」で紹介されたコスメ`} />
            </div>
          </div>
          {/* PCでは右の列を2段ぶんにし、説明文を動画のすぐ下（左の列）に置く。以前は右の列のほうが長く、動画の下が空いていた（279章） */}
          <div class="lg:col-span-4 lg:row-span-2 lg:pt-2">
            <p class="eyebrow">Video</p>
            <h1 class="font-serif vid-9">{video.title}</h1>
            {quickCosmetics.length > 0 && (
              <div class="mt-5 rounded-2xl bg-blush/60 p-3 md:p-4">
                <div class="flex items-center justify-between gap-3">
                  <p class="text-[13px] font-semibold">この動画の紹介コスメ<span class="num-display text-rose text-[18px] mx-1">{validCosmetics.length}</span>品</p>
                  <a href="#cosmetics" class="text-rose vid-10">すべて見る<span aria-hidden="true">↓</span></a>
                </div>
                <ul class="mt-2.5 grid grid-cols-4 gap-2">
                  {quickCosmetics.map((x) => (
                    <li class="min-w-0">
                      <a href={hasCosmeticPage(x.c.brand_id, x.c.name_id) ? withBase(`/cosmetics/${x.slug}/`) : "#cosmetics"} class="group block">
                        <span class="vid-q">
                          <img src={x.img} alt={`${x.c.brand} ${x.c.name}`} class="u-19" loading="eager" />
                        </span>
                        <span class="vid-2">{x.c.name}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
            {pr && <p class="mt-3 flex items-start gap-2 text-xs leading-relaxed text-neutral-600"><PrBadge class="mt-px" /><span>{prNote}</span></p>}
            <a href={withBase(`/influencer/${video.channel_id}`)} class="group mt-6 flex items-center gap-3 w-fit">
              {video.channel_icon && <img referrerpolicy="no-referrer" src={video.channel_icon} alt={video.channel_title} data-name={video.channel_title} width="44" height="44" class="w-11 h-11 rounded-full ring-1 ring-ink/10" />}
              <span><span class="block label-caps lcn">Influencer</span><span class="block text-sm link-u group-hover:text-rose">{video.channel_title}</span></span>
            </a>
            <dl class="vid-7">
              <div class="py-4 pr-3"><dt class="u-11">投稿日</dt><dd class="num-display text-[20px] mt-1">{formatDateDot(video.published_at)}</dd></div>
              <div class="py-4 pl-4"><dt class="u-11">再生回数</dt><dd class="num-display text-[20px] mt-1">{formatCount(video.view_count)}</dd></div>
            </dl>
            {/* 投稿者のチャンネルへ送る導線（181章）。PCは動画の下に出す */}
            <div class="u-21 lg:!hidden">
              <a href={`https://www.youtube.com/watch?v=${video.video_id}`} target="_blank" rel="noopener" class="group u-13">
                <span class="u-23" aria-hidden="true"></span>YouTubeで見る<span class="u-15" aria-hidden="true">→</span>
              </a>
              <a href={`https://www.youtube.com/channel/${video.channel_id}`} target="_blank" rel="noopener" class="vid-3">チャンネルを見る</a>
            </div>
            <div class="lg:hidden"><ShareButtons text={`${video.channel_title}「${video.title}」で紹介されたコスメ`} class="mt-6" /></div>
          </div>
        </div>
        </div>

        {/* 旧AI要約(video.summary)は、生成元・品質が不確かなため非表示にしている。
            データ自体は保持しており、Claudeでの作り直し後に復活させる想定 */}

        {validCosmetics.length > 0 && (
          <section id="cosmetics" class="panel mt-8 md:mt-10 scroll-mt-24">
            <SectionHead num={nums.grid} en="In this video" title="紹介されたコスメ" lead={`この動画で紹介された${validCosmetics.length}品を、部位・カテゴリごとに使った順で並べました。時刻を押すと、その場面から再生します。`} />
            <VideoCosmetics video={video} />
            <p class="mt-6 text-xs text-neutral-500">部位は商品のカテゴリで振り分け、まとまりの中は動画で使った順（時刻が分からない品は後ろ）。価格は楽天市場（無ければYahoo!ショッピング）で確認した時点の参考価格です。</p>
          </section>
        )}

        {sameChannel.length > 0 && (
          <section class="panel u-14">
            <SectionHead num={nums.same} en="More from the channel" title={`${video.channel_title}の他の動画`} href={withBase(`/influencer/${video.channel_id}`)} cta="Profile" />
            <div class="u-20">
              {sameChannel.map((v) => <div class="min-w-0"><VideoCard video={v} /></div>)}
            </div>
          </section>
        )}

        {sameCosmetics.length > 0 && (
          <section class="panel u-14">
            <SectionHead num={nums.related} en="Related videos" title="同じコスメを紹介している他の動画" lead="この動画で紹介されているコスメが登場する、他のインフルエンサーの動画です。" />
            <div class="u-20">
              {sameCosmetics.map((v) => <div class="min-w-0"><VideoCard video={v} /></div>)}
            </div>
          </section>
        )}
      </>
    )
  }
  {/* 再生ボタンが押されたときに埋め込み（iframe）を作る。「◯:◯◯の場面から再生」も同じ仕組みで、その時刻から再生して動画の位置まで戻す（JSが無ければYouTubeの該当時刻へ） */}
  <script>
    const box = document.getElementById("video-box");
    const mountPlayer = (start?: string) => {
      if (!box) return null;
      let player = document.getElementById("video-player") as HTMLIFrameElement | null;
      const id = box.dataset.videoId;
      if (!player) {
        player = document.createElement("iframe");
        player.id = "video-player";
        player.className = "absolute inset-0 w-full h-full";
        player.title = box.dataset.title || "";
        player.allow = "autoplay; encrypted-media; picture-in-picture";
        player.allowFullscreen = true;
        player.src = `https://www.youtube.com/embed/${id}?autoplay=1${start ? `&start=${start}` : ""}`;
        box.replaceChildren(player);
      } else if (start) {
        player.src = `${player.src.split("?")[0]}?start=${start}&autoplay=1`;
      }
      return player;
    };
    box?.querySelector(".vid-play")?.addEventListener("click", () => mountPlayer());
    document.addEventListener("click", (e) => {
      const a = (e.target as HTMLElement).closest?.("a.scene-seek") as HTMLAnchorElement | null;
      if (!a || !box) return;
      e.preventDefault();
      box.scrollIntoView({ behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth", block: "center" });
      mountPlayer(a.dataset.seek);
    });
  </script>
</Layout>
