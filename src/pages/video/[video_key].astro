---
import Layout from "../../layouts/Layout.astro";
import ShareButtons from "../../components/ShareButtons.astro";
import CosmeticCard from "../../components/CosmeticCard.astro";
import SectionHead from "../../components/SectionHead.astro";
import VideoCard from "../../components/VideoCard.astro";
import PrBadge from "../../components/PrBadge.astro";
import {
  getAllVideoEntries,
  getVideoByKey,
  getVideosByChannel,
  getVideosUsingCosmetic,
  getCosmeticFacts,
  isVisible,
  sortByPublishedDesc,
  categoryUrl,
  formatCount,
  withBase,
  formatJaDate,
  breadcrumbLd,
  formatDateDot,
  getPrInfo,
  isPrMention,
  ytThumbLarge,
  sortByMakeupOrder,
  cosmeticCategory,
  getBrandName,
} from "../../lib/data";

export function getStaticPaths() {
  return getAllVideoEntries().map((v) => ({ params: { video_key: v.key } }));
}

const { video_key } = Astro.params;
const video = getVideoByKey(video_key!);
// メイクで使う順（スキンケア→下地→ファンデ→…→リップ→道具）に並べる。同じカテゴリの中は動画で出てきた順（213章）
const validCosmetics = sortByMakeupOrder((video?.cosmetics || []).filter((c) => c.brand && c.name));
const cosmeticNames = validCosmetics.slice(0, 5).map((c) => `${c.brand} ${c.name}`).join("、");
const description = video
  ? `${video.channel_title}が${formatJaDate(video.published_at)}に投稿した動画。紹介コスメ${validCosmetics.length}品` + (cosmeticNames ? `（${cosmeticNames}${validCosmetics.length > 5 ? "ほか" : ""}）` : "") + "。"
  : undefined;
// 非掲載（check_status未確認・削除済み）の動画はsitemapに載せておらず、内容も未確認なので検索に出さない
const noindex = !!video && !isVisible(video);

// 概要（AI要約が無い動画でも、ページに固有の文章が残るように、掲載データから作る）
const cosmeticFacts = validCosmetics.map((c) => ({ c, f: getCosmeticFacts(c.brand_id, c.name_id) }));
// PR・提供の動画（197章）。提供を受けた商品はランキング等の数に入れていないので、その旨を添える
const pr = video ? getPrInfo(video.key) : undefined;
const isPr = (c: { brand_id: string; name_id: string }) => !!video && isPrMention(video.key, c.brand_id, c.name_id);
const prBrands = (pr?.brands || []).map((b) => getBrandName(b)).filter(Boolean);
const prNote = pr
  ? (pr.kind === "gift" ? "この動画には、ブランドから提供された商品が含まれます" : "この動画はPR・提供を含みます") +
    (prBrands.length ? `（提供：${prBrands.join("・")}）` : "") + "。" +
    (validCosmetics.some(isPr)
      ? pr.whole ? "この動画で紹介された商品は、ランキング・最近話題の数に入れていません。" : "提供を受けた商品は、ランキング・最近話題の数に入れていません。"
      : "")
  : "";
const ranked = cosmeticFacts.filter((x) => x.f.rank && !isPr(x.c)).sort((a, b) => a.f.rank! - b.f.rank!)[0];
const overview = video
  ? `${video.channel_title}が${formatJaDate(video.published_at)}に投稿したコスメ紹介動画です。` +
    (validCosmetics.length > 0 ? `この動画では${validCosmetics.length}品のコスメが紹介されています。` : "") +
    (ranked ? `そのうち「${ranked.c.brand} ${ranked.c.name}」は、「${ranked.f.mainTag}」カテゴリの人気ランキングで${ranked.f.rankTotal}品中${ranked.f.rank}位です。` : "")
  : "";

// 関連動画：同じチャンネルの他の動画／紹介コスメが重なる他の動画（掲載中のものだけ、新しい順）
const RELATED = 4;
const sameChannel = video
  ? sortByPublishedDesc(getVideosByChannel(video.channel_id)).filter((v) => v.key !== video.key).slice(0, RELATED)
  : [];
const sameChannelKeys = new Set(sameChannel.map((v) => v.key));
const overlap = new Map<string, { v: ReturnType<typeof getVideoByKey> & {}; n: number }>();
for (const c of validCosmetics) {
  for (const v of getVideosUsingCosmetic(c.brand_id, c.name_id)) {
    if (v.key === video!.key || sameChannelKeys.has(v.key)) continue;
    const cur = overlap.get(v.key);
    if (cur) cur.n += 1;
    else overlap.set(v.key, { v, n: 1 });
  }
}
const sameCosmetics = Array.from(overlap.values())
  .sort((a, b) => b.n - a.n || new Date(b.v.published_at).getTime() - new Date(a.v.published_at).getTime())
  .slice(0, RELATED)
  .map((x) => x.v);

const viewCountNum = video?.view_count !== undefined ? Number(video.view_count) : NaN;
const jsonLd = video
  ? [
      {
        "@context": "https://schema.org",
        "@type": "VideoObject",
        name: video.title,
        description: description,
        thumbnailUrl: ytThumbLarge(video.thumbnail),
        uploadDate: video.published_at,
        embedUrl: `https://www.youtube.com/embed/${video.video_id}`,
        contentUrl: video.url,
        ...(video.duration ? { duration: video.duration } : {}),
        ...(Number.isFinite(viewCountNum)
          ? {
              interactionStatistic: {
                "@type": "InteractionCounter",
                interactionType: { "@type": "WatchAction" },
                userInteractionCount: viewCountNum,
              },
            }
          : {}),
      },
      breadcrumbLd([{ name: "ホーム", path: "/" }, { name: "動画一覧", path: "/video-list" }, { name: video.title, path: `/video/${video.key}` }], Astro.site!),
    ]
  : [];
---

<Layout title={video?.title ?? "動画詳細"} description={description} image={video ? ytThumbLarge(video.thumbnail) : undefined} ogType="video.other" jsonLd={jsonLd} noindex={noindex}>
  {
    !video ? (
      <p class="text-neutral-400">動画が見つかりませんでした。</p>
    ) : (
      <>
        <!-- ===== 動画：左に埋め込み、右に題・投稿者・数字・YouTubeへの導線 ===== -->
        <div class="panel">
        <div class="grid lg:grid-cols-12 gap-8 lg:gap-12 items-start">
          <div class="lg:col-span-8">
            <div class="aspect-video rounded-[24px] overflow-hidden bg-ink shadow-[0_40px_80px_-40px_rgba(29,21,23,0.55)]">
              <iframe
                class="w-full h-full"
                src={`https://www.youtube.com/embed/${video.video_id}`}
                title={video.title}
                allowfullscreen
              />
            </div>
          </div>
          <div class="lg:col-span-4 lg:pt-2">
            <p class="eyebrow">Video</p>
            <h1 class="mt-3 font-serif font-semibold text-[20px] md:text-[22px] leading-[1.5] tracking-[-0.02em]">{video.title}</h1>
            {pr && <p class="mt-3 flex items-start gap-2 text-xs leading-relaxed text-neutral-600"><PrBadge class="mt-px" /><span>{prNote}</span></p>}
            <a href={withBase(`/influencer/${video.channel_id}`)} class="group mt-6 flex items-center gap-3 w-fit">
              {video.channel_icon && <img referrerpolicy="no-referrer" src={video.channel_icon} alt={video.channel_title} data-name={video.channel_title} width="44" height="44" class="w-11 h-11 rounded-full ring-1 ring-ink/10" />}
              <span><span class="block label-caps text-neutral-500">Influencer</span><span class="block text-sm link-u group-hover:text-rose">{video.channel_title}</span></span>
            </a>
            <dl class="mt-6 grid grid-cols-2 border-y border-ink/15 divide-x divide-ink/15">
              <div class="py-4 pr-3"><dt class="text-xs text-neutral-500">投稿日</dt><dd class="num-display text-[20px] mt-1">{formatDateDot(video.published_at)}</dd></div>
              <div class="py-4 pl-4"><dt class="text-xs text-neutral-500">再生回数</dt><dd class="num-display text-[20px] mt-1">{formatCount(video.view_count)}</dd></div>
            </dl>
            {/* 投稿者のチャンネルへ送る導線（181章） */}
            <div class="mt-6 flex flex-wrap gap-3">
              <a href={`https://www.youtube.com/watch?v=${video.video_id}`} target="_blank" rel="noopener" class="group inline-flex items-center gap-3 bg-ink text-paper text-sm pl-5 pr-2 py-2 rounded-full hover:bg-[#FF0000] transition-colors duration-500">
                <span class="w-2 h-2 rounded-full bg-[#FF0000] group-hover:bg-paper" aria-hidden="true"></span>YouTubeで見る<span class="w-8 h-8 rounded-full bg-paper/15 flex items-center justify-center transition-transform duration-500 group-hover:rotate-[-45deg]" aria-hidden="true">→</span>
              </a>
              <a href={`https://www.youtube.com/channel/${video.channel_id}`} target="_blank" rel="noopener" class="inline-flex items-center border border-ink/25 text-sm px-5 py-2 rounded-full hover:border-ink transition-colors">チャンネルを見る</a>
            </div>
            <ShareButtons text={`${video.channel_title}「${video.title}」で紹介されたコスメ`} class="mt-6" />
          </div>
        </div>

        <p class="mt-8 max-w-3xl text-sm leading-[1.9] text-neutral-600">{overview}</p>
        </div>

        {/* 旧AI要約(video.summary)は、生成元・品質が不確かなため非表示にしている。
            データ自体は保持しており、Claudeでの作り直し後に復活させる想定 */}

        {validCosmetics.length > 0 && (
          <section class="panel mt-8 md:mt-10">
            <SectionHead num="01" en="In this video" title="紹介されたコスメ" lead={`この動画で紹介された${validCosmetics.length}品を、スキンケア・ベースメイク・アイメイク・リップの順に、使う順番に並べています。`} />
            <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-x-4 gap-y-8">
              {validCosmetics.map((c) => (
                <CosmeticCard brand_id={c.brand_id} brand={c.brand} name_id={c.name_id} name={c.name} rakutenImageHtml={c.rakuten_image_link} category={cosmeticCategory(c)} caption={isPr(c) ? "PR・提供（ランキングに数えていません）" : undefined} />
              ))}
            </div>
          </section>
        )}

        {sameChannel.length > 0 && (
          <section class="panel mt-8 md:mt-10">
            <SectionHead num="02" en="More from the channel" title={`${video.channel_title}の他の動画`} href={withBase(`/influencer/${video.channel_id}`)} cta="Profile" />
            <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-x-6 gap-y-10">
              {sameChannel.map((v) => <div class="min-w-0"><VideoCard video={v} /></div>)}
            </div>
          </section>
        )}

        {sameCosmetics.length > 0 && (
          <section class="panel mt-8 md:mt-10">
            <SectionHead num="03" en="Same cosmetics" title="同じコスメを紹介している他の動画" lead="この動画で紹介されているコスメが登場する、他のインフルエンサーの動画です。" />
            <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-x-6 gap-y-10">
              {sameCosmetics.map((v) => <div class="min-w-0"><VideoCard video={v} /></div>)}
            </div>
          </section>
        )}
      </>
    )
  }
</Layout>
