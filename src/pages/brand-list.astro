---
import BrandFlag from "../components/BrandFlag.astro";
import PageHead from "../components/PageHead.astro";
import PageNav from "../components/PageNav.astro";
import Layout from "../layouts/Layout.astro";
import {
  getBrandsWithVideos,
  getProducedBrands,
  getBrandGroups,
  getBrandMeta,
  getBrandReading,
  getCountryRegion,
  groupByKana,
  withBase,
} from "../lib/data";

const brands = getBrandsWithVideos().sort((a, b) =>
  (getBrandReading(a.brand_id) ?? a.name).localeCompare(getBrandReading(b.brand_id) ?? b.name, "ja"),
);
// インフルエンサーがプロデュースしたブランド（ユーザー依頼、323章）
const produced = getProducedBrands();

const grouped = groupByKana(brands);
// 五十音の見出し（ア・イ・ウ…）を行（ア行・カ行…）にまとめ、目次の帯から行の頭へ飛べるようにする
const KANA_ROWS: [string, string][] = [
  ["ア", "アァイィウゥヴエェオォ"], ["カ", "カガキギクグケゲコゴヵヶ"], ["サ", "サザシジスズセゼソゾ"], ["タ", "タダチヂツヅッテデトド"],
  ["ナ", "ナニヌネノ"], ["ハ", "ハバパヒビピフブプヘベペホボポ"], ["マ", "マミムメモ"], ["ヤ", "ヤャユュヨョ"], ["ラ", "ラリルレロ"], ["ワ", "ワヮヰヱヲン"],
];
const rowOf = (kana: string) => KANA_ROWS.find(([, cs]) => cs.includes(kana))?.[0] ?? "他";
const usedRows = new Set(Array.from(grouped.keys(), rowOf));
const firstOfRow = new Set<string>();
for (const kana of grouped.keys()) if (![...firstOfRow].some((k) => rowOf(k) === rowOf(kana))) firstOfRow.add(kana);
const navItems = [
  { label: "系列マップ", target: "#group-map" },
  ...(produced.length > 0 ? [{ label: "インフルエンサーのブランド", target: "#produced" }] : []),
  ...[...KANA_ROWS.map(([r]) => r), "他"].filter((r) => usedRows.has(r)).map((r) => ({ label: r === "他" ? "英数・他" : r, target: `[data-row="${r}"]`, href: `#row-${r}` })),
];

const REGIONS = [
  { key: "ALL", label: "すべて" },
  { key: "JP", label: "日本" },
  { key: "KR", label: "韓国" },
  { key: "OTHER", label: "その他" },
];
const regionCounts = new Map<string, number>([["ALL", brands.length]]);
for (const b of brands) {
  const r = getCountryRegion(b.brand_id);
  regionCounts.set(r, (regionCounts.get(r) || 0) + 1);
}

// 系列マップ：ブランドが2つ以上ある系列を、紹介動画数の合計が多い順に。
const groups = getBrandGroups().filter((g) => g.brands.length >= 2);
const maxVideos = Math.max(...groups.map((g) => g.videoCount), 1);
---

<Layout
  title="ブランド一覧"
  description="YouTubeのコスメ紹介動画で紹介されたブランドの一覧。国（日本・韓国・その他）や親会社の系列ごとに探せ、系列ごとの紹介動画数も比べられます。"
>
  <PageHead en="Brands" title="ブランド一覧" lead="動画で紹介されたブランドを、親会社の系列ごとのマップ、インフルエンサーのブランド、五十音順の一覧で探せます。" stats={[{ n: brands.length, label: "掲載ブランド" }]} />

  <PageNav items={navItems} label="ブランド一覧の目次" class="mb-6 md:mb-8" />

  <section id="group-map" class="panel mb-6 md:mb-8">
    <h2 class="font-serif h-section font-semibold mb-2 flex items-baseline gap-3"><span class="num-display text-sm text-neutral-500">01</span>系列マップ</h2>
    <p class="text-xs text-neutral-500 mb-4">
      同じ親会社・系列のブランドを、紹介動画数に応じた面積の長方形で示しています。系列の中は「メイク系／両方／スキンケア系」に分け、
      名前が収まるブロックには名前を表示し、小さいものは「ほかNブランド」にまとめました（押すと一覧が開きます）。ブロックを押すとブランドのページへ移動します。
      区画の大きさは目安で、系列どうしや区分どうしの面積は正確な比例ではありません。
    </p>
    <div class="space-y-4">
      {
        groups.map((g) => (
          <div class="flex flex-col sm:flex-row gap-1 sm:gap-3 gmap" data-json={JSON.stringify({
            height: Math.round(90 + 200 * Math.sqrt(g.videoCount / maxVideos)),
            brands: g.brands.map((b) => ({ name: b.name, v: b.videoCount, kind: b.kind, href: withBase(`/brand/${b.brand_id}`) })),
          })}>
            <div class="sm:w-40 shrink-0 sm:text-right sm:pt-1 flex items-baseline gap-2 sm:block">
              <div class="text-sm font-semibold truncate">{g.group}</div>
              <div class="text-xs text-neutral-500">{g.brands.length}ブランド ／ {g.videoCount}本</div>
            </div>
            <div class="flex-1 min-w-0">
              <div class="gmap-canvas relative hidden"></div>
              {/* JS無効時の一覧（JS有効時は非表示） */}
              <div class="gmap-legend flex flex-wrap gap-x-3 gap-y-0.5 text-xs text-neutral-600">
                {g.brands.map((b) => (
                  <a href={withBase(`/brand/${b.brand_id}`)} class="hover:text-rose">
                    {b.name}<span class="text-neutral-500">{b.videoCount}</span>
                  </a>
                ))}
              </div>
              <div class="gmap-rest hidden mt-2 text-xs text-neutral-700 bg-well border border-ink/10 rounded-2xl p-4 space-y-1"></div>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  {produced.length > 0 && (
    <section id="produced" class="panel mb-6 md:mb-8 scroll-mt-32">
      <h2 class="font-serif h-section font-semibold mb-2 flex items-baseline gap-3"><span class="num-display text-sm text-neutral-500">02</span>インフルエンサーのブランド</h2>
      <p class="text-sm text-neutral-600 mb-6 max-w-2xl">YouTuber・インフルエンサー本人がプロデュースしているブランドです（{produced.length}ブランド）。本人の動画での紹介は、ランキングには数えていません。</p>
      <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {produced.map((b) => (
          <li class="rounded-2xl border border-ink/10 bg-paper/60 p-4 flex gap-4 items-start">
            <a href={withBase(`/brand/${b.brand_id}`)} class="product-well w-20 h-20 shrink-0 rounded-xl overflow-hidden flex items-center justify-center" tabindex="-1" aria-hidden="true">
              {b.imageSrc ? <img src={b.imageSrc} alt="" class="w-[84%] h-[84%] object-contain" loading="lazy" data-err="hide" /> : <span class="text-[10px] text-neutral-400">No image</span>}
            </a>
            <div class="min-w-0 flex-1">
              <a href={withBase(`/brand/${b.brand_id}`)} class="block font-serif font-semibold text-[17px] leading-snug hover:text-rose transition-colors truncate"><BrandFlag brand_id={b.brand_id} />{b.name}</a>
              <p class="mt-0.5 text-xs text-neutral-500">紹介動画 {b.videoCount}本・{b.cosmeticCount}品</p>
              <div class="mt-2.5 flex flex-wrap gap-1.5">
                {b.producers.map(({ inf: p, part }) => (
                  <a href={withBase(`/influencer/${p.channel_id}`)} class="group inline-flex items-center gap-1.5 rounded-full border border-ink/15 bg-white/80 pl-0.5 pr-2.5 py-0.5 hover:border-rose transition-colors max-w-full" title={`${p.channel_title}が${part ? "一部の商品を" : ""}プロデュース`}>
                    {p.channel_icon ? (
                      <img src={p.channel_icon} alt="" width="24" height="24" class="w-6 h-6 rounded-full object-cover shrink-0" loading="lazy" referrerpolicy="no-referrer" />
                    ) : (
                      <span class="w-6 h-6 rounded-full bg-blush text-[10px] text-rose flex items-center justify-center shrink-0" aria-hidden="true">{p.channel_title.slice(0, 1)}</span>
                    )}
                    <span class="text-xs text-ink group-hover:text-rose transition-colors truncate">{p.channel_title}{part && <span class="text-neutral-500 ml-1">（一部の商品）</span>}</span>
                  </a>
                ))}
              </div>
            </div>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="panel">
  <h2 class="font-serif h-section font-semibold mb-4 flex items-baseline gap-3"><span class="num-display text-sm text-neutral-500">{produced.length > 0 ? "03" : "02"}</span>五十音順</h2>
  <div class="flex flex-wrap items-center gap-2 mb-8 text-sm">
    <span class="label-caps lcn mr-1">Country</span>
    {
      REGIONS.map((r) => (
        <button class="region-chip chip" data-region={r.key}>
          {r.label} <span class="tab-n">{regionCounts.get(r.key) || 0}</span>
        </button>
      ))
    }
    {regionCounts.get("UNKNOWN") ? <span class="text-xs text-neutral-500 ml-1">※国不明 {regionCounts.get("UNKNOWN")}件は「すべて」のみに表示</span> : null}
  </div>

  {
    Array.from(grouped.entries()).map(([kana, items]) => (
      <section class="kana-section mb-10" data-row={rowOf(kana)} id={firstOfRow.has(kana) ? `row-${rowOf(kana)}` : undefined}>
        <h3 class="font-serif text-lg font-semibold text-rose border-b border-ink/15 mb-4 pb-2">{kana}</h3>
        <div class="grid sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-x-8 gap-y-3">
          {items.map((b) => {
            const meta = getBrandMeta(b.brand_id);
            return (
              <a href={withBase(`/brand/${b.brand_id}`)} class="brand-item text-sm hover:text-rose transition-colors min-w-0" data-region={getCountryRegion(b.brand_id)}>
                <span class="block truncate"><BrandFlag brand_id={b.brand_id} />{b.name}</span>
                {meta.group && <span class="block text-xs text-neutral-500 truncate">{meta.group}</span>}
              </a>
            );
          })}
        </div>
      </section>
    ))
  }
  </section>
</Layout>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>(".region-chip");
  function show(region: string) {
    chips.forEach((c) => c.classList.toggle("is-active", c.dataset.region === region));
    document.querySelectorAll<HTMLElement>(".brand-item").forEach((el) => {
      el.style.display = region === "ALL" || el.dataset.region === region ? "" : "none";
    });
    document.querySelectorAll<HTMLElement>(".kana-section").forEach((sec) => {
      const any = Array.from(sec.querySelectorAll<HTMLElement>(".brand-item")).some((el) => el.style.display !== "none");
      sec.style.display = any ? "" : "none";
    });
    window.dispatchEvent(new Event("pagenav:refresh"));
  }
  chips.forEach((c) => c.addEventListener("click", () => show(c.dataset.region!)));
  show("ALL");
</script>

<script>
  // 系列マップ（ツリーマップ）：系列ごとに「メイク系／両方／スキンケア系」の区画へ分け、
  // 各区画をsquarified法でブランドの長方形に分割する。名前が収まらない小さな長方形は
  // 区画ごとに1つの「ほかNブランド」にまとめ、押すと一覧を開閉する。
  type Brand = { name: string; v: number; kind: "MAKE" | "BOTH" | "SKIN"; href: string };
  type R = { x: number; y: number; w: number; h: number };
  const SECTIONS = [
    { kind: "MAKE", label: "メイク系", short: "メイク", hue: 342 },
    { kind: "BOTH", label: "両方", short: "両方", hue: 25 },
    { kind: "SKIN", label: "スキンケア系", short: "スキンケア", hue: 160 },
  ] as const;
  const HEADER = 16;
  const MIN_SECTION_W = 96;
  // 左右の余白（px-1.5で12px）＋css()で幅から引く1px＋丸めの余裕。以前は10pxで、収まる判定の名前が「The Ordin…」と切れていた（279章）
  const PAD = 15;
  // 括弧の読みがなは長方形の中では出さない（「CNP Laboratory(シーエヌピーラボラトリー)」→「CNP Laboratory」）。title・「ほか」の一覧は元の名前
  const shortName = (n: string) => n.replace(/\s*[（(][^（）()]*[）)]\s*$/, "") || n;

  const ctx = document.createElement("canvas").getContext("2d")!;
  // 実際の表示（text-xs＝13px）と同じ大きさで測る。以前は11pxで測っていて、収まる判定の名前が「クリニ…」と切れていた（195章）
  const FONT = `13px ${getComputedStyle(document.body).fontFamily}`;
  ctx.font = FONT;
  const textW = (t: string) => ctx.measureText(t).width;
  const boldW = (t: string) => { ctx.font = `bold ${FONT}`; const w = ctx.measureText(t).width; ctx.font = FONT; return w; };

  function squarify(values: number[], rect: R): R[] {
    const total = values.reduce((a, b) => a + b, 0);
    const scale = (rect.w * rect.h) / total;
    const areas = values.map((v) => v * scale);
    const out: R[] = [];
    let r = { ...rect };
    const worst = (row: number[], side: number) => {
      const s = row.reduce((a, b) => a + b, 0);
      return Math.max((side * side * Math.max(...row)) / (s * s), (s * s) / (side * side * Math.min(...row)));
    };
    let i = 0;
    while (i < areas.length) {
      const side = Math.min(r.w, r.h);
      const row = [areas[i]];
      let j = i + 1;
      while (j < areas.length && worst([...row, areas[j]], side) <= worst(row, side)) row.push(areas[j++]);
      const s = row.reduce((a, b) => a + b, 0);
      if (r.w >= r.h) {
        const cw = s / r.h;
        let yy = r.y;
        for (const a of row) { out.push({ x: r.x, y: yy, w: cw, h: a / cw }); yy += a / cw; }
        r = { x: r.x + cw, y: r.y, w: r.w - cw, h: r.h };
      } else {
        const rh = s / r.w;
        let xx = r.x;
        for (const a of row) { out.push({ x: xx, y: r.y, w: a / rh, h: rh }); xx += a / rh; }
        r = { x: r.x, y: r.y + rh, w: r.w, h: r.h - rh };
      }
      i = j;
    }
    return out;
  }

  // 1行に収まるか（「ほか」のボタン用）
  const fits1 = (label: string, r: R) => textW(label) + PAD <= r.w && r.h >= 18;
  // ブランド名は、高さがあれば語の切れ目（空白）で3行まで折り返す。狭い列（スマホ）では「メイベリン ニューヨーク」のような長い名前が
  // 1行に入らず、全部「ほか」にまとめられて大きな灰色の面になっていた（279章）。実際と同じ指定の要素に入れて測る
  const meas = document.createElement("div");
  meas.style.cssText = `position:absolute;visibility:hidden;left:-9999px;top:0;box-sizing:border-box;padding:0 6px;font:${FONT};line-height:1.25;white-space:normal;word-break:keep-all;overflow-wrap:normal;line-break:strict`;
  const measIn = document.createElement("span");
  measIn.style.display = "inline-block";
  meas.append(measIn);
  document.body.append(meas);
  const LINE = 13 * 1.25;
  // 0：収まらない 1：1行・空白で折り返して収まる 2：文字の途中でも折り返せば収まる（「イヴ・サンロー／ラン」。空白の無いカタカナの長い名前）。
  // 2は6文字以上の名前を2行までに限る（短い名前を「エテュ／セ」と折ると読みにくい）
  const fitMode = (name: string, r: R): 0 | 1 | 2 => {
    if (r.h < 18) return 0;
    if (fits1(shortName(name), r)) return 1;
    meas.style.width = `${Math.max(r.w - 2, 0)}px`; // 実際は r.w - 1。1pxの余裕
    measIn.textContent = shortName(name);
    for (const mode of [1, 2] as const) {
      meas.style.wordBreak = mode === 1 ? "keep-all" : "normal";
      // 右の余白はscrollWidthに入らないので、中の文字の幅で比べる（折り返すと入れ物の幅いっぱい、はみ出すといちばん長い語の幅になる）
      const h = measIn.offsetHeight;
      const maxLines = mode === 1 ? 3 : shortName(name).replace(/\s/g, "").length >= 6 ? 2 : 0;
      if (measIn.offsetWidth <= meas.clientWidth - 12 && h <= LINE * maxLines + 1 && h + 4 <= r.h - 1) return mode;
    }
    return 0;
  };
  const fits = (name: string, r: R) => fitMode(name, r) > 0;

  function css(el: HTMLElement, r: R) {
    el.style.left = `${r.x}px`;
    el.style.top = `${r.y}px`;
    el.style.width = `${Math.max(r.w - 1, 0)}px`;
    el.style.height = `${Math.max(r.h - 1, 0)}px`;
  }

  function layout(gmap: HTMLElement) {
    const data = JSON.parse(gmap.dataset.json!) as { height: number; brands: Brand[] };
    const canvas = gmap.querySelector<HTMLElement>(".gmap-canvas")!;
    const rest = gmap.querySelector<HTMLElement>(".gmap-rest")!;
    canvas.classList.remove("hidden");
    canvas.textContent = "";
    rest.textContent = "";
    const W = canvas.clientWidth;
    const H = data.height;
    canvas.style.height = `${H}px`;

    const secs = SECTIONS.map((sec) => {
      const brands = data.brands.filter((b) => b.kind === sec.kind).sort((a, b) => b.v - a.v);
      return { ...sec, brands, total: brands.reduce((n, b) => n + b.v, 0) };
    }).filter((sec) => sec.brands.length > 0);

    // 区画の幅：最低幅を確保し、残りを紹介動画数の比で配分する
    const grand = secs.reduce((n, s) => n + s.total, 0);
    const free = Math.max(W - MIN_SECTION_W * secs.length, 0);
    let x = 0;
    let moreOpen = rest.dataset.open === "1";
    let anyMore = false;

    for (const sec of secs) {
      const w = MIN_SECTION_W + free * (sec.total / grand);
      const area: R = { x, y: HEADER, w, h: H - HEADER };
      x += w;

      const head = document.createElement("div");
      head.className = "absolute text-xs font-bold whitespace-nowrap overflow-hidden";
      head.style.color = `hsl(${sec.hue} 45% 32%)`;
      css(head, { x: area.x, y: 0, w, h: HEADER });
      // 区画が狭いとき（スマホ）は短い書き方にする。以前は「スキンケア系・18」のように右が切れていた
      head.textContent = [`${sec.label}・${sec.total}本`, `${sec.short}・${sec.total}本`, `${sec.short} ${sec.total}`, sec.short].find((t) => boldW(t) + 4 <= w) ?? sec.short;
      canvas.append(head);

      // 名前が収まらない長方形を1つの「ほか」にまとめ、全部が収まるまでやり直す。
      // 以前は収まらないのが1つだけのときと、3回で打ち切ったときに、名前が切れたまま残っていた（279章）。
      // 一度に全部まとめると、並べ直しの途中で一時的に細長くなった大きいブランド（メイベリン ニューヨーク）まで「ほか」に入るので、
      // 収まらないもののうち紹介動画数の最も少ないものを1つずつまとめる
      let items = sec.brands.map((b, i) => ({ b, i }));
      let merged: { b: Brand; i: number }[] = [];
      let rects: R[] = [];
      let order: { b?: Brand; i?: number; more?: boolean; v: number }[] = [];
      const MAX_ITER = sec.brands.length + 1;
      for (let iter = 0; iter < MAX_ITER; iter++) {
        order = [...items.map((it) => ({ b: it.b, i: it.i, v: it.b.v }))];
        if (merged.length > 0) order.push({ more: true, v: merged.reduce((n, m) => n + m.b.v, 0) });
        // 「ほか」は合計が個々のブランドより大きくても常に最後に置く（並びは個別ブランドの多い順）
        order.sort((a, b) => (a.more ? 1 : 0) - (b.more ? 1 : 0) || b.v - a.v);
        rects = squarify(order.map((o) => o.v), area);
        if (iter === MAX_ITER - 1) break;
        const nonfit = order.map((o, k) => ({ o, r: rects[k] })).filter(({ o, r }) => !o.more && !fits(o.b!.name, r));
        if (nonfit.length === 0) break;
        const smallest = nonfit.reduce((a, b) => (b.o.v < a.o.v ? b : a));
        const ids = new Set([smallest.o.i]);
        merged = [...merged, ...items.filter((it) => ids.has(it.i))];
        items = items.filter((it) => !ids.has(it.i));
        if (items.length === 0) { order = [{ more: true, v: merged.reduce((n, m) => n + m.b.v, 0) }]; rects = [area]; break; }
      }

      order.forEach((o, k) => {
        const r = rects[k];
        if (o.more) {
          anyMore = true;
          const btn = document.createElement("button");
          btn.type = "button";
          btn.className = "absolute overflow-hidden whitespace-nowrap text-xs leading-tight px-1.5 text-left text-neutral-600 hover:brightness-95";
          btn.style.background = "hsl(0 0% 88%)";
          css(btn, r);
          const n = merged.length;
          const label = [`ほか${n}ブランド ▾`, `+${n}`].find((t) => fits1(t, r)) ?? "";
          btn.textContent = label;
          btn.title = `ほか${n}ブランド（クリックで一覧）`;
          btn.addEventListener("click", () => {
            const open = rest.classList.contains("hidden");
            rest.classList.toggle("hidden", !open);
            rest.dataset.open = open ? "1" : "0";
          });
          canvas.append(btn);
        } else {
          const a = document.createElement("a");
          a.href = o.b!.href;
          a.title = `${o.b!.name}（紹介動画${o.b!.v}本）`;
          a.className = "absolute overflow-hidden text-xs px-1.5 flex items-center hover:brightness-95";
          a.style.background = `hsl(${sec.hue} 32% ${91 - (o.i! % 3) * 5}%)`;
          a.style.color = `hsl(${sec.hue} 30% 24%)`;
          css(a, r);
          const span = document.createElement("span");
          const mode = fitMode(o.b!.name, r);
          span.className = "leading-tight [line-break:strict]";
          span.style.wordBreak = mode === 2 ? "normal" : "keep-all";
          // それでも収まらないもの（やり直しの打ち切り）は、切れた名前を出さず色の面だけにする
          span.textContent = mode > 0 ? shortName(o.b!.name) : "";
          a.append(span);
          canvas.append(a);
        }
      });

      if (merged.length > 0) {
        const row = document.createElement("div");
        const title = document.createElement("span");
        title.className = "font-bold mr-2";
        title.style.color = `hsl(${sec.hue} 45% 32%)`;
        title.textContent = `${sec.label}:`;
        row.append(title);
        merged.forEach((m, k) => {
          const a = document.createElement("a");
          a.href = m.b.href;
          a.className = "hover:text-pink-600 mr-3 inline-block";
          a.innerHTML = "";
          a.textContent = m.b.name;
          const n = document.createElement("span");
          n.className = "text-neutral-500 ml-0.5";
          n.textContent = String(m.b.v);
          a.append(n);
          row.append(a);
        });
        rest.append(row);
      }
    }
    if (!anyMore) rest.classList.add("hidden");
    else rest.classList.toggle("hidden", !moreOpen);
  }

  function layoutAll() {
    document.querySelectorAll<HTMLElement>(".gmap").forEach(layout);
  }

  document.querySelectorAll<HTMLElement>(".gmap").forEach((g) => g.querySelector(".gmap-legend")?.classList.add("hidden"));
  layoutAll();
  let t: number | undefined;
  window.addEventListener("resize", () => {
    clearTimeout(t);
    t = window.setTimeout(layoutAll, 100);
  });
</script>
