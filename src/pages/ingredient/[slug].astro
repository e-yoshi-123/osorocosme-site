---
import HowWeCount from "../../components/HowWeCount.astro";
import PageHead from "../../components/PageHead.astro";
import Layout from "../../layouts/Layout.astro";
import ShareButtons from "../../components/ShareButtons.astro";
import RankingRow from "../../components/RankingRow.astro";
import {
  getPublishedIngredients,
  getIngredient,
  getPublishedConcernIngredients,
  ingredientSourceLabel,
  INGREDIENT_MIN_CHANNELS,
  INGREDIENT_PER_SECTION,
  getCosmeticListEntry,
  productOffer,
  cosmeticSlug,
  withBase,
  breadcrumbLd,
} from "../../lib/data";

export function getStaticPaths() {
  return getPublishedIngredients().map((d) => ({ params: { slug: d.slug }, props: { slug: d.slug } }));
}

const { slug } = Astro.props;
const g = getIngredient(slug)!;
const name = g.def.name;
const withConcerns = getPublishedConcernIngredients().filter((x) => x.ingredient.slug === slug);
const others = getPublishedIngredients().filter((x) => x.slug !== slug);

// 表示用データ。価格・楽天とYahoo!のリンク・画像は cosmetics_list.json を正とする（肌悩み・ランキングと同じ）
const sections = g.sections.map((s) => ({
  ...s,
  rows: s.items.map((it, i) => {
    const entry = getCosmeticListEntry(it.brand_id, it.name_id);
    const offer = productOffer(entry);
    const labels = it.labels.map((l) => (it.active.includes(l) ? `${l}（有効成分）` : l)).join("、");
    return {
      it,
      rank: i + 1,
      imageSrc: offer.imageSrc,
      price: offer.price,
      link: offer.rakutenLink,
      fromYahoo: offer.source === "yahoo",
      yahooLink: entry?.yahoo_text_link || undefined,
      note: `全成分の表示：${labels}（出典：${ingredientSourceLabel(it.info)}）`,
    };
  }),
}));

const title = `${name}が入ったスキンケア。インフルエンサーが使うコスメ（全成分から）`;
const first = sections[0]?.rows[0]?.it;
const description =
  `公式サイトなどの全成分に${name}（${g.labels.slice(0, 3).join("・")}など）があるスキンケア${g.itemCount}品を、` +
  `YouTubeで${INGREDIENT_MIN_CHANNELS}人以上のインフルエンサーが使っているものから集めました。` +
  (first ? `${first.brand}「${first.name}」などを、${name}に触れた発言とあわせて載せています。` : "");
const topImage = sections.flatMap((s) => s.rows).find((r) => r.imageSrc)?.imageSrc;
const crumbs = [
  { name: "ホーム", path: "/" },
  { name: "成分から探す", path: "/ingredient/" },
  { name, path: `/ingredient/${slug}/` },
];
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: title,
    numberOfItems: g.itemCount,
    itemListElement: sections
      .flatMap((s) => s.rows)
      .slice(0, 10)
      .map((r, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: `${r.it.brand} ${r.it.name}`,
        url: new URL(withBase(`/cosmetics/${cosmeticSlug(r.it.brand_id, r.it.name_id)}`), Astro.site!).href,
      })),
  },
  breadcrumbLd(crumbs, Astro.site!),
];
const lead = `全成分に${name}が入っているスキンケアのうち、YouTubeで${INGREDIENT_MIN_CHANNELS}人以上のインフルエンサーが使っているものです。動画の中で${name}に触れて紹介された商品は、その発言とあわせて先に載せています。`;
---

<Layout title={title} description={description} image={topImage} jsonLd={jsonLd}>
  <nav class="text-xs text-neutral-500 mb-8 flex flex-wrap gap-2" aria-label="パンくず">
    <a href={withBase("/")} class="link-u">Home</a><span aria-hidden="true">/</span>
    <a href={withBase("/ingredient/")} class="link-u">成分から探す</a><span aria-hidden="true">/</span>
    <span>{name}</span>
  </nav>

  <PageHead en="Ingredients" title={`${name}が入ったスキンケア`} lead={lead}>
    <ShareButtons text={`${name}が入ったスキンケア。インフルエンサーが使うコスメ`} class="mt-5" />
  </PageHead>

  <HowWeCount>
    <ul class="list-disc pl-5 space-y-1 [overflow-wrap:anywhere]">
      <li>対象：各ブランドの公式サイトに掲載されている全成分（掲載が無い商品は楽天市場のメーカー公式ショップの表示）に、次の表示名があるスキンケア<b>{g.itemCount}品</b>（うち公式サイトから{g.officialCount}品）</li>
      <li>数えた表示名：{g.labels.join("、")}</li>
      <li>掲載条件：<b>{INGREDIENT_MIN_CHANNELS}チャンネル以上</b>が紹介したコスメのみ（PR・提供の紹介は数えていません）</li>
      <li>並び順：動画の中で{name}に触れて紹介された商品（{g.quotedCount}品）を先にし、紹介したチャンネル数 → 紹介動画数 → 合計再生回数の順。区分ごとに上位{INGREDIENT_PER_SECTION}品まで</li>
      <li>「」内は、再生回数の多い動画での紹介のされ方です（動画の発言を要約したもの）</li>
    </ul>
  </HowWeCount>

  {
    withConcerns.length > 0 && (
      <section class="mb-12" aria-labelledby="ci-band">
        <h2 id="ci-band" class="font-serif h-section font-semibold mb-2">一緒に語られる肌悩み</h2>
        <p class="text-xs text-neutral-500 mb-4">動画の1つの発言の中で「{name}」と一緒に語られた回数の多い肌悩みです。成分の効果を示すものではありません。</p>
        <div class="flex flex-wrap gap-2">
          {withConcerns.map((o) => (
            <a href={withBase(`/concern/${o.concern.slug}/${o.ingredient.slug}/`)} class="rounded-full border border-ink/15 bg-white/70 px-4 py-2 text-sm text-ink hover:border-ink/40">
              {o.concern.name}<span class="ml-2 text-xs text-neutral-500">{o.mentionCount}件</span>
            </a>
          ))}
        </div>
      </section>
    )
  }

  {
    sections.map((s) => (
      <section class="panel mb-6 md:mb-8">
        <h2 class="font-serif h-section font-semibold mb-4">{s.name}</h2>
        <div class="@container">
          <ol class="divide-y divide-ink/10">
            {s.rows.map((r) => (
              <RankingRow
                rank={r.rank}
                base={r.rank}
                brand_id={r.it.brand_id}
                brand={r.it.brand}
                name_id={r.it.name_id}
                name={r.it.name}
                imageSrc={r.imageSrc}
                videoCount={r.it.videoCount}
                channelCount={r.it.channelCount}
                price={r.price}
                fromYahoo={r.fromYahoo}
                link={r.link}
                yahooLink={r.yahooLink}
                subLabel={r.it.tag || undefined}
                quote={r.it.quote}
                quoteBy={r.it.quoteChannel}
                note={r.note}
              />
            ))}
          </ol>
        </div>
        {s.rest > 0 && <p class="mt-2 text-xs text-neutral-500">ほかに{s.rest}品あります（紹介したチャンネル数の少ないもの）。</p>}
      </section>
    ))
  }

  <p class="text-xs text-neutral-500 mb-8 leading-relaxed">
    全成分は、各ブランドの公式サイト（掲載が無い商品は楽天市場のメーカー公式ショップ）の表示を写したものです。改良などで変わることがあるため、購入の際は商品の表示をご確認ください。このページは成分の効果・効能を示すものではありません。肌に合うかどうかには個人差があります。価格は楽天市場で確認した時点の参考価格です。
  </p>

  <ShareButtons text={`${name}が入ったスキンケア。インフルエンサーが使うコスメ`} label="このページをシェア" class="mb-10" />

  <p class="text-sm">
    {
      others.map((o) => (
        <>
          <a href={withBase(`/ingredient/${o.slug}/`)} class="link-u text-ink">{o.name} →</a>{" "}
        </>
      ))
    }
    <a href={withBase("/concern/")} class="link-u text-ink">肌悩みから探す →</a>
  </p>
</Layout>
