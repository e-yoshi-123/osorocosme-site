  }
  const dist = de;
  const nearWord = (d: number) => (d < 3 ? "ほぼ同じ色" : d < 6 ? "近い色" : d < 10 ? "やや近い" : "似た系統");
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);

  // 地図の位置：横＝色相（Labの a*・b* の角度）、縦＝明るさ L* か鮮やかさ C*（上が薄い・鮮やか）。幅は表示する色が全部入る範囲に合わせる。
  // 背景は無地。色は3つの軸（色相・明るさ・鮮やかさ）なので、平面の背景に色を塗ると、残りの軸の分だけ点の色と合わない（362章）
  let H0 = -150, H1 = 210, Y0 = 10, Y1 = 100;
  const W = 1000, Hh = 440, PAD = { l: 46, r: 12, t: 14, b: 34 };
  const hueOf = (l: number[]) => { const h = (Math.atan2(l[2], l[1]) * 180) / Math.PI; return h < -150 ? h + 360 : h; };
  const chromaOf = (l: number[]) => Math.hypot(l[1], l[2]);
  const yVal = (l: number[]) => (view === "L" ? l[0] : chromaOf(l));
  // 横の目盛りは、色相に比例する目盛りと色の多さの順位の目盛りの中間（XR の割合で順位）。色の多いピンク〜赤を広げ、少ないグレー・緑も範囲に入れる（363章）
  const XR = 0.6;
