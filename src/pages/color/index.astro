  }
  const xFrac = (h: number) => (1 - XR) * ((h - H0) / (H1 - H0)) + XR * rankOf(Math.max(hs[0] ?? H0, Math.min(hs[hs.length - 1] ?? H1, h)));
  const xOf = (h: number) => PAD.l + xFrac(h) * (W - PAD.l - PAD.r);
  const yOf = (v: number) => PAD.t + ((Y1 - v) / (Y1 - Y0)) * (Hh - PAD.t - PAD.b);
  function hOfX(x: number): number {
    const f = (x - PAD.l) / (W - PAD.l - PAD.r);
