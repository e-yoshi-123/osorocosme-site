    const baseName = baseI !== null ? `${data.p[data.c[baseI][0]][1]}（${data.c[baseI][1]}）` : "";
    const what = baseName ? `基準の ${baseName}` : `選んだ色 ${target.toUpperCase()}`, order = sort === "near" ? "近い順" : sort === "dark" ? "濃い順" : "薄い順";
    statusEl.textContent = plainW() ? `${best.size}品の中から、${what} に近い${rows.length}品を${order}に`
      : best.size ? `範囲に入るのは${best.size}品。${what} に近い${rows.length}品を${order}に` : `範囲に入るコスメがありません。つまみを「遠い」のほうへ動かすと広がります`;
    listEl.innerHTML = rows.map(({ d, i }) => {
      const [pi, label, hex, top, href] = data!.c[i];
