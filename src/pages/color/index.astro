  const toHex = (rgb: [number, number, number]) => "#" + rgb.map((v) => Math.round(Math.max(0, Math.min(1, v)) * 255).toString(16).padStart(2, "0")).join("");
  /** 地図のその位置（色相・明るさ）の色。彩度は C（近くの色の彩度。無ければ BG_C）、範囲の外なら下げる */
  const BG_C = 34;
  function colorAt(h: number, L: number, C = BG_C): [number, number, number] {
    const rad = (h * Math.PI) / 180;
    for (let c = Math.round(C); c >= 0; c -= 2) { const r = rgbOf(L, c * Math.cos(rad), c * Math.sin(rad)); if (r) return r; }
