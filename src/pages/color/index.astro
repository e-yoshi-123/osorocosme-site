  function rankOf(h: number): number {
    const n = hs.length;
    if (n < 2) return (h - H0) / (H1 - H0);
    if (h <= hs[0]) return 0;
    if (h >= hs[n - 1]) return 1;
    let lo = 0, hi = n - 1;
    while (hi - lo > 1) { const m = (lo + hi) >> 1; if (hs[m] <= h) lo = m; else hi = m; }
    const f = hs[hi] === hs[lo] ? 0 : (h - hs[lo]) / (hs[hi] - hs[lo]);
