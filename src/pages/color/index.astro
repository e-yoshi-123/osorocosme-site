  const pos = (l: Lab): [number, number] => [xOf(Math.max(H0, Math.min(H1, hueOf(l)))), yOf(Math.max(Y0, Math.min(Y1, yVal(l))))];
  function fitRange(ls: Lab[]) {
    hs = ls.map(hueOf).sort((a, b) => a - b);
