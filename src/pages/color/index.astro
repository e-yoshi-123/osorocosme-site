    if (!hs.length) return;
    let lo = hs[0] - 6, hi = hs[hs.length - 1] + 6;  // 全部の色が入る幅（両端2%を除くと、外の色が端に張りついて見えた。363章）
    if (hi - lo < 60) { const m = (lo + hi) / 2; lo = m - 30; hi = m + 30; }
    H0 = lo; H1 = hi;
    Y0 = Math.max(0, Math.floor(vs[0] - 3)); Y1 = Math.min(view === "L" ? 100 : 130, Math.ceil(vs[vs.length - 1] + 3));
  }
  const HUE_TICKS: [number, string][] = [[-110, "青"], [-70, "紫"], [-25, "赤紫"], [5, "ピンク"], [28, "赤"], [45, "コーラル"], [62, "オレンジ"], [78, "ベージュ・黄み"], [95, "黄"], [130, "緑"]];
  /** 点の無いところの色：色相と縦の軸の値は位置から、残りの軸（鮮やかさか明るさ）は近くの点の重み付き平均（無ければ鮮やかさ34・明るさ70） */
