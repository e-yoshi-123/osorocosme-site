---
// 色から探す（362章）。リップ・チーク・アイシャドウ・ベースメイクを、選んだ色に近い順に並べる。
// 色の値は、各ブランドの公式の色見本の画像から測ったもの（花王は真上から撮った商品写真の中央から。決定事項 2026-10-17）。
// 近さはLabの色差（CIE76のΔE）。計算はブラウザの中で、品と色の一覧は /color/colors.json（data.ts の getColorSearchData）。
// 見た目はこのページの中のCSS（cs-）で書く（スクリプトが作る部分も同じクラスを使う。パーソナルカラー自己診断と同じ。314章）
import PageHead from "../../components/PageHead.astro";
import Layout from "../../layouts/Layout.astro";
import { COLOR_KINDS, getColorSearchData, withBase, breadcrumbLd } from "../../lib/data";

const data = getColorSearchData();
const kinds = COLOR_KINDS.map((k, i) => ({ key: k.key, label: k.label, items: data.p.filter((p) => p[2] === i).length, colors: data.c.filter((c) => data.p[c[0]][2] === i).length })).filter((k) => k.items > 0);
const total = { items: data.p.length, colors: data.c.length };
// 選びやすい色（種類ごと）。名前は一般的な色の呼び方
const PRESETS: Record<string, [string, string][]> = {
  all: [["ベージュ", "#DDB89A"], ["ピーチ", "#F7B08E"], ["コーラル", "#EE7F6B"], ["オレンジ", "#E8603C"], ["レッド", "#C41E3A"], ["ピンク", "#EE8AA6"], ["ローズ", "#C25A7C"], ["ブラウン", "#8E5B3A"], ["ボルドー", "#6E1E2E"], ["パープル", "#9C7FB3"], ["ゴールド", "#C9A24F"]],
  lip: [["ヌードベージュ", "#C99482"], ["コーラル", "#EE7F6B"], ["オレンジ", "#E8603C"], ["レッド", "#C41E3A"], ["ローズ", "#C25A7C"], ["ピンク", "#EE8AA6"], ["ローズブラウン", "#9E5A55"], ["テラコッタ", "#B5563A"], ["プラム", "#7B2D4A"], ["ボルドー", "#6E1E2E"]],
  cheek: [["ピーチ", "#F7B08E"], ["コーラル", "#F08A76"], ["オレンジ", "#EE8D52"], ["ピンク", "#F29AB0"], ["ローズ", "#D07390"], ["ラベンダー", "#C9A9D6"], ["テラコッタ", "#C06A4E"], ["ベージュ", "#DDAE95"]],
  eye: [["ベージュ", "#DDB89A"], ["ブラウン", "#8E5B3A"], ["オレンジ", "#E08A4E"], ["ピンク", "#E8A0B0"], ["ボルドー", "#7B2D3A"], ["ゴールド", "#C9A24F"], ["カーキ", "#7B7A4A"], ["グレー", "#8A8686"], ["パープル", "#9C7FB3"], ["ブルー", "#6F8FBF"], ["グリーン", "#7FA88A"]],
  concealer: [["明るいベージュ", "#F6D6BC"], ["オークル", "#E6BC96"], ["ピーチ", "#F8C8A8"], ["オレンジ", "#F3A57E"], ["イエロー", "#F3DDA6"], ["ピンク", "#F6C9C6"], ["グリーン", "#CFE0C2"]],
  foundation: [["明るいピンク寄り", "#F4D4C2"], ["明るい標準", "#F1CFB3"], ["標準のオークル", "#E5BD99"], ["黄み寄り", "#E8C49A"], ["濃いめ", "#C99A74"]],
  base: [["ピンク", "#F8D2D6"], ["ラベンダー", "#DED3EE"], ["ブルー", "#D3E0F4"], ["グリーン", "#D3E6CC"], ["イエロー", "#F7E7B8"], ["オレンジ", "#F9CFAE"], ["ベージュ", "#F1D6BE"]],
};
const title = "色から探す（リップ・チーク・アイシャドウを色の近さで）";
const description = `好きな色を選ぶと、リップ・チーク・アイシャドウ・コンシーラー・ファンデーションの中から、公式の色見本が近い色を順に並べます。${total.items}品・${total.colors}色。YouTubeでインフルエンサーが紹介したコスメから。`;
const crumbs = [
  { name: "ホーム", path: "/" },
  { name: "色から探す", path: "/color/" },
];
---

<Layout title={title} description={description} jsonLd={[breadcrumbLd(crumbs, Astro.site!)]}>
  <PageHead
    en="Colors"
    title="色から探す"
    lead="好きな色を選ぶと、その色に近いコスメを順に並べます。色は、各ブランドの公式サイトの色見本の画像から測ったものです。YouTubeでインフルエンサーが紹介したコスメだけを載せています。"
    stats={[{ n: total.items, label: "品", unit: "品" }, { n: total.colors, label: "色", unit: "色" }]}
  />

  <div id="cs" class="cs" data-src={withBase("/color/colors.json")} data-presets={JSON.stringify(PRESETS)} data-kinds={JSON.stringify(COLOR_KINDS.map((k) => k.label))}>
    <div class="cs-kinds" role="tablist" aria-label="種類">
      <button type="button" class="tab" role="tab" aria-selected="false" data-key="all">すべて<span class="tab-n">{total.colors}</span></button>
      {kinds.map((k, i) => (
        <button type="button" class:list={["tab", i === 0 && "is-active"]} role="tab" aria-selected={i === 0 ? "true" : "false"} data-kind={COLOR_KINDS.findIndex((x) => x.key === k.key)} data-key={k.key}>
          {k.label}<span class="tab-n">{k.colors}</span>
        </button>
      ))}
    </div>
    <div class="cs-filter" id="cs-filter" hidden>
      <span class="cs-h">表示するジャンル</span>
      {kinds.map((k) => (
        <button type="button" class="chip is-active" aria-pressed="true" data-filter={COLOR_KINDS.findIndex((x) => x.key === k.key)}>{k.label}</button>
      ))}
    </div>

    <div class="cs-pick">
      <p class="cs-h">探したい色を選ぶ</p>
      <div class="cs-presets" id="cs-presets"></div>
      <div class="cs-find">
        <input type="search" id="cs-q" placeholder="コスメ名・ブランド・色名で探す（例：リップモンスター、NARS、ローズ）" autocomplete="off" aria-label="コスメ名で、基準にするコスメの色を探す" />
        <ul id="cs-sug" class="cs-sug" hidden></ul>
        <p id="cs-base" class="cs-base" hidden></p>
      </div>
      <label class="cs-own">
        <span class="cs-own-h">選択中の色</span>
        <input type="color" id="cs-input" value="#C25A7C" aria-label="選択中の色（押すと自分で選べます）" />
        <code id="cs-hex">#C25A7C</code>
        <span class="cs-own-note">（四角を押すと自分で選べます）</span>
      </label>
      <div class="cs-weights">
        <span class="cs-h">近さに含める範囲（0＝かなり近い色だけ、9＝制限なし）</span>
        <label><span>濃さ</span><span class="cs-end">近い</span><input type="range" id="cs-wl" min="0" max="9" step="1" value="9" aria-label="濃さの違いをどこまで含めるか" /><span class="cs-end">遠い</span><output id="cs-wl-v">9</output></label>
        <label><span>鮮やかさ</span><span class="cs-end">近い</span><input type="range" id="cs-wc" min="0" max="9" step="1" value="9" aria-label="鮮やかさの違いをどこまで含めるか" /><span class="cs-end">遠い</span><output id="cs-wc-v">9</output></label>
        <label><span>色み</span><span class="cs-end">近い</span><input type="range" id="cs-wh" min="0" max="9" step="1" value="9" aria-label="色みの違いをどこまで含めるか" /><span class="cs-end">遠い</span><output id="cs-wh-v">9</output></label>
        <button type="button" id="cs-wreset" class="cs-wreset" hidden>制限を外す</button>
      </div>
    </div>

    <section class="cs-mapbox" aria-labelledby="cs-map-h">
      <div class="cs-maphead">
        <p class="cs-h" id="cs-map-h">色のパレット</p>
        <p class="cs-legend"><span class="cs-lg cs-lg-t"></span>選択中の色 <span class="cs-lg cs-lg-m"></span>マイコスメ（使っている） <span class="cs-lg cs-lg-w"></span>マイコスメ（気になる） <span class="cs-lg cs-lg-n"></span>近い色（一覧に出ている色）</p>
      </div>
      <div class="cs-mapwrap" id="cs-mapwrap">
        <svg id="cs-map" class="cs-map" viewBox="0 0 1000 440" role="img" aria-label="色のパレット。鮮やかさの段ごとに、隣どうしが近い色になるように並べた表示"></svg>
        <div class="cs-pop" id="cs-pop" hidden></div>
      </div>
      <p class="cs-note">鮮やかさの段（鮮やか〜くすみ・グレー寄り）ごとに、色を隙間なく並べ、隣どうしが近い色になるように入れ替えています。大まかに、左から右へ色み（紫・ピンク→赤→オレンジ・ベージュ→黄・緑）、上ほど薄く下ほど濃い色です（位置は目盛りではありません）。マスに近づけるとコスメが出て、押すと詳しく出ます（「この色を基準に探す」で、そのコスメに近い色を探せます）。</p>
      <div id="cs-mine" class="cs-mine"></div>
    </section>

    <div class="cs-bar">
      <p class="cs-status" id="cs-status" aria-live="polite">読み込んでいます…</p>
      <div class="cs-sort" role="group" aria-label="並べ方">
        <button type="button" class="chip is-active" data-sort="near">近い順</button>
        <button type="button" class="chip" data-sort="dark">濃い順</button>
        <button type="button" class="chip" data-sort="light">薄い順</button>
      </div>
    </div>
    <ol class="cs-list" id="cs-list"></ol>
  </div>

  <p class="text-xs text-neutral-500 mt-10 leading-relaxed max-w-3xl">
    色は、各ブランドの公式サイトの色見本の画像から測った目安です（色見本の画像が無い花王のブランドは、真上から撮った商品写真の中央から測り、「商品写真から」と書いています）。画面や光、塗る量・肌の色で見え方は変わります。近さは色の差（ΔE）で、2〜3なら見分けにくく、10を超えると別の色に見える程度です。「近さに含める範囲」のつまみで、濃さ（明るさ）・鮮やかさ・色みのそれぞれの違いをどこまで含めるかを選べます（0はかなり近い色だけ、9は制限なし。3つとも範囲に入る色だけを出し、パレットでは範囲の外の色を薄くします）。1つの商品からは一番近い色だけを出しています。濃さは色の明るさ（L*）で比べています。マイコスメの商品は、マイコスメで選んだ色を、選んでいなければその商品の全部の色をパレットに出します（「使っている」はピンク、「気になる」は青の印）。近さの範囲の外でも、一覧に「範囲外」として出します。マイコスメは、この端末のブラウザに保存したものだけを読み、どこにも送りません。
  </p>
</Layout>

<style is:global>
  .cs { display: grid; gap: 1.5rem; }
  .cs-kinds { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .cs-pick { display: grid; gap: 0.75rem; padding: 1.25rem; border: 1px solid rgb(29 21 23 / 0.1); border-radius: 1rem; background: #fff; }
  .cs-h { font-size: 12px; letter-spacing: 0.12em; color: rgb(29 21 23 / 0.6); }
  .cs-presets { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .cs-chip { display: inline-flex; align-items: center; gap: 0.45rem; padding: 0.3rem 0.8rem 0.3rem 0.35rem; border: 1px solid rgb(29 21 23 / 0.15); border-radius: 999px; font-size: 13px; background: #fff; cursor: pointer; transition: border-color 0.3s; }
  .cs-chip:hover { border-color: var(--color-ink); }
  .cs-chip[aria-pressed="true"] { border-color: var(--color-ink); box-shadow: 0 0 0 1px var(--color-ink) inset; }
  .cs-dot { width: 1.4rem; height: 1.4rem; border-radius: 999px; border: 1px solid rgb(29 21 23 / 0.12); flex: none; }
  .cs-find { position: relative; display: grid; gap: 0.4rem; }
  .cs-find input { width: 100%; padding: 0.55rem 0.9rem; border: 1px solid rgb(29 21 23 / 0.18); border-radius: 999px; font-size: 14px; background: #fff; }
  .cs-sug { position: absolute; z-index: 6; top: 2.6rem; left: 0; right: 0; max-height: 22rem; overflow-y: auto; background: #fff; border: 1px solid rgb(29 21 23 / 0.15); border-radius: 0.8rem; box-shadow: 0 8px 24px rgb(29 21 23 / 0.12); padding: 0.3rem; }
  .cs-sug li button { display: flex; gap: 0.6rem; align-items: center; width: 100%; padding: 0.4rem 0.5rem; border-radius: 0.5rem; text-align: left; font-size: 13px; line-height: 1.4; }
  .cs-sug li button:hover, .cs-sug li button.is-on { background: rgb(29 21 23 / 0.05); }
  .cs-sug .cs-sw { width: 1.8rem; height: 1.8rem; }
  .cs-sug .cs-img { width: 2rem; height: 2rem; }
  .cs-sug-none { padding: 0.5rem; font-size: 12px; color: rgb(29 21 23 / 0.55); }
  .cs-base { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem; font-size: 13px; }
  .cs-base .cs-dot { display: inline-block; }
  .cs-base button { font-size: 12px; text-decoration: underline; color: rgb(29 21 23 / 0.6); }
  .cs-weights { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1.4rem; font-size: 12px; }
  .cs-weights label { display: inline-flex; align-items: center; gap: 0.5rem; }
  .cs-weights input { width: 7.5rem; accent-color: var(--color-ink); }
  .cs-weights output { min-width: 1.2em; font-weight: 600; }
  .cs-weights .cs-h { flex-basis: 100%; }
  .cs-end { font-size: 10px; color: rgb(29 21 23 / 0.5); }
  .cs-wreset { font-size: 12px; text-decoration: underline; color: rgb(29 21 23 / 0.6); }
  .cs-own { display: inline-flex; align-items: center; gap: 0.6rem; font-size: 13px; cursor: pointer; }
  .cs-own input { width: 2.4rem; height: 2.4rem; padding: 0; border: none; background: none; cursor: pointer; }
  .cs-own code { font-size: 13px; font-weight: 600; }
  .cs-own-h { font-size: 12px; letter-spacing: 0.12em; color: rgb(29 21 23 / 0.6); }
  .cs-own-note { font-size: 11px; color: rgb(29 21 23 / 0.5); }
  .cs-status { font-size: 13px; color: rgb(29 21 23 / 0.6); }
  .cs-bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.75rem; }
  .cs-sort { display: flex; gap: 0.4rem; }
  .cs-mapbox { display: grid; gap: 0.6rem; padding: 1.25rem; border: 1px solid rgb(29 21 23 / 0.1); border-radius: 1rem; background: #fff; }
  .cs-maphead { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.5rem; }
  .cs-legend { font-size: 11px; color: rgb(29 21 23 / 0.6); display: flex; flex-wrap: wrap; align-items: center; gap: 0.35rem 0.6rem; }
  .cs-lg { display: inline-block; width: 0.8rem; height: 0.8rem; border-radius: 999px; vertical-align: -0.1rem; margin-right: -0.25rem; }
  .cs-lg-t { border: 2px solid var(--color-ink); }
  .cs-lg-m { background: #fff; border: 2.5px solid var(--color-rose); }
  /* 「気になる」は青（363章、ユーザー「気になるに登録したコスメもマイコスメと別の色で」） */
  .cs { --wish: #2f6fdb; }
  .cs-lg-w { background: #fff; border: 2.5px solid var(--wish); }
  .cs-map .mn.w { fill: var(--wish); }
  .cs-mytag.w { border-color: var(--wish); color: var(--wish); }
  .cs-item.is-wish { border-color: rgb(47 111 219 / 0.45); }
  .cs-mine b.w { color: var(--wish); }
  .cs-lg-n { background: #d9a0a8; border: 1.5px solid var(--color-ink); }
  .cs-mapwrap { position: relative; overflow-x: auto; }
  .cs-filter { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem; }
  .cs-filter .cs-h { margin-right: 0.3rem; }
  .cs-pop { position: absolute; z-index: 5; width: 16rem; max-width: calc(100% - 1rem); padding: 0.75rem; border-radius: 0.8rem; background: #fff; border: 1px solid rgb(29 21 23 / 0.15); box-shadow: 0 8px 24px rgb(29 21 23 / 0.15); font-size: 12px; line-height: 1.5; display: grid; gap: 0.35rem; }
  .cs-pop.is-hover { pointer-events: none; width: 15rem; }
  .cs-pop-top { display: flex; gap: 0.6rem; align-items: center; }
  .cs-pop .cs-sw { width: 2.4rem; height: 2.4rem; }
  .cs-pop .cs-img { width: 2.6rem; height: 2.6rem; }
  .cs-pop-x { position: absolute; top: 0.25rem; right: 0.4rem; font-size: 16px; color: rgb(29 21 23 / 0.5); }
  .cs-pop-btns { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 0.2rem; }
  .cs-pop-btns .cs-go { padding: 0.3rem 0.8rem; border-radius: 999px; background: var(--color-ink); color: var(--color-paper); font-size: 12px; }
  .cs-pop-btns a { padding: 0.3rem 0.8rem; border-radius: 999px; border: 1px solid rgb(29 21 23 / 0.2); font-size: 12px; }
  .cs-kindtag { display: inline-block; margin-right: 0.3rem; padding: 0 0.4rem; border-radius: 999px; background: rgb(29 21 23 / 0.06); font-size: 10px; }
  .cs-map { display: block; width: 100%; min-width: 34rem; height: auto; background: #faf8f7; border-radius: 0.6rem; }
  .cs-map { cursor: crosshair; }
  .cs-map .ax { font-size: 13px; fill: rgb(29 21 23 / 0.5); }
  .cs-map .band { font-size: 13px; font-weight: 700; fill: rgb(29 21 23 / 0.7); }
  .cs-map .mn { font-size: 13px; font-weight: 700; fill: var(--color-rose); paint-order: stroke; stroke: #fff; stroke-width: 3px; pointer-events: none; }
  .cs-note { font-size: 11px; color: rgb(29 21 23 / 0.55); }
  .cs-mine { display: flex; flex-wrap: wrap; gap: 0.4rem 0.9rem; font-size: 12px; }
  .cs-mine b { color: var(--color-rose); margin-right: 0.2rem; }
  .cs-mine button { text-align: left; }
  .cs-mine button:hover { color: var(--color-rose); }
  .cs-mine .cs-dot { width: 0.9rem; height: 0.9rem; display: inline-block; vertical-align: -0.12rem; margin-left: 0.15rem; }
  .cs-mytag { display: inline-block; margin-left: 0.3rem; padding: 0 0.4rem; border-radius: 999px; border: 1px solid var(--color-rose); color: var(--color-rose); font-size: 10px; }
  .cs-item.is-mine { border-color: rgb(230 0 118 / 0.45); }
  .cs-list { display: grid; gap: 0.75rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr)); }
  .cs-item { display: flex; gap: 0.9rem; align-items: center; padding: 0.8rem; border: 1px solid rgb(29 21 23 / 0.08); border-radius: 0.9rem; background: #fff; min-width: 0; }
  .cs-sw { position: relative; flex: none; width: 3.4rem; height: 3.4rem; border-radius: 999px; border: 1px solid rgb(29 21 23 / 0.12); }
  .cs-sw-go { cursor: pointer; transition: box-shadow 0.2s; }
  .cs-sw-go:hover, .cs-sw-go:focus-visible { box-shadow: 0 0 0 2px #fff, 0 0 0 4px var(--color-ink); outline: none; }
  .cs-ping { animation: cs-ping 0.9s ease-out 3; transform-box: fill-box; transform-origin: center; }
  @keyframes cs-ping { from { transform: scale(0.6); opacity: 1; } to { transform: scale(2.2); opacity: 0; } }
  .cs-img { flex: none; width: 3.4rem; height: 3.4rem; object-fit: contain; border-radius: 0.5rem; background: #faf7f5; }
  .cs-body { min-width: 0; display: grid; gap: 0.15rem; font-size: 13px; line-height: 1.45; }
  .cs-brand { font-size: 11px; color: rgb(29 21 23 / 0.55); }
  .cs-name { font-weight: 600; overflow-wrap: anywhere; }
  .cs-name:hover { color: var(--color-rose); }
  .cs-shade { color: rgb(29 21 23 / 0.75); overflow-wrap: anywhere; }
  .cs-shade a { text-decoration: underline; text-underline-offset: 2px; }
  .cs-meta { font-size: 11px; color: rgb(29 21 23 / 0.55); }
  .cs-near { display: inline-block; margin-right: 0.4rem; padding: 0 0.45rem; border-radius: 999px; background: rgb(230 0 118 / 0.08); color: var(--color-rose); }
</style>

<script>
  import { load as loadMyCosme, onChange as onMyCosmeChange, renameSlugs } from "../../scripts/my-cosme-store";
  import { colorBaseLabel } from "../../lib/color-label";
  type Data = { p: [string, string, number, string, string, number, string][]; c: [number, string, string, number, string][]; r?: Record<string, string> };
  type Lab = [number, number, number];
  const $ = (id: string) => document.getElementById(id)!;
  const root = $("cs");
  const presets = JSON.parse(root.dataset.presets || "{}") as Record<string, [string, string][]>;
  const kindLabels = JSON.parse(root.dataset.kinds || "[]") as string[];
  const listEl = $("cs-list"), statusEl = $("cs-status"), presetEl = $("cs-presets"), mineEl = $("cs-mine"), hexEl = $("cs-hex");
  const mapEl = $("cs-map") as unknown as SVGSVGElement, wrapEl = $("cs-mapwrap"), popEl = $("cs-pop"), filterEl = $("cs-filter");
  const input = $("cs-input") as HTMLInputElement;
  const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>(".cs-kinds [data-key]"));
  const sorts = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-sort]"));
  const filters = Array.from(filterEl.querySelectorAll<HTMLButtonElement>("[data-filter]"));
  // 表示の状態：mode は "all"（すべて）か種類の番号。filter は「すべて」のときに出すジャンル
  let mode: "all" | number = Number(tabs.find((t) => t.classList.contains("is-active"))?.dataset.kind ?? 0);
  const filter = new Set(filters.map((b) => Number(b.dataset.filter)));
  let target = input.value;
  let sort = "near";
  let data: Data | null = null;
  let labs: Lab[] = [];
  let mine = new Map<string, "items" | "wish">();
  // マイコスメで選んだ色（商品 slug → 色の表示名）。選んでいない商品は全部の色をマイコスメの色として出す（363章）
  let mineColors = new Map<string, Set<string>>();
  const baseLabel = colorBaseLabel;
  /** その色が「マイコスメの色」か（使っている・気になるに入っていて、色を選んでいればその色） */
  function isMineShade(i: number): boolean {
    const slug = data!.p[data!.c[i][0]][6];
    if (!mine.has(slug)) return false;
    const sel = mineColors.get(slug);
    return !sel || sel.has(baseLabel(data!.c[i][1]));
  }
  let dots: { x: number; y: number; i: number }[] = [];
  let pinned = false;
  // 基準にしたコスメの色（検索で選んだもの。data.c の番号）。その商品は一覧から外し、地図に印を付ける
  let baseI: number | null = null;
  const SHOW = 48;
  const active = () => (mode === "all" ? filter : new Set([mode]));
  const modeKey = () => (mode === "all" ? "all" : tabs.find((t) => Number(t.dataset.kind) === mode)?.dataset.key || "lip");

  // sRGB ⇔ Lab（D65）
  function lab(hex: string): Lab {
    const n = parseInt(hex.slice(1), 16);
    const lin = (v: number) => { v /= 255; return v > 0.04045 ? Math.pow((v + 0.055) / 1.055, 2.4) : v / 12.92; };
    const r = lin((n >> 16) & 255), g = lin((n >> 8) & 255), b = lin(n & 255);
    const x = (r * 0.4124 + g * 0.3576 + b * 0.1805) / 0.95047, y = r * 0.2126 + g * 0.7152 + b * 0.0722, z = (r * 0.0193 + g * 0.1192 + b * 0.9505) / 1.08883;
    const f = (t: number) => (t > 0.008856 ? Math.cbrt(t) : 7.787 * t + 16 / 116);
    return [116 * f(y) - 16, 500 * (f(x) - f(y)), 200 * (f(y) - f(z))];
  }
  const de = (a: number[], b: number[]) => Math.hypot(a[0] - b[0], a[1] - b[1], a[2] - b[2]);
  // 近さはΔE（CIE76）。つまみで、色の差の濃さ（明るさ）ΔL・鮮やかさ ΔC・色み ΔH のそれぞれを、どこまで含めるかを0〜9で決める（9＝制限なし）。
  // 段階ごとの上限はΔEの目安（2〜3で見分けにくい、10超で別の色）に合わせた。363章、ユーザー「近い↔遠いで0〜9とかで、かなり近いやつだけから幅広くまで」
  const LIMITS = [2, 3, 4.5, 6, 8, 10, 13, 17, 23, Infinity];
  let lvL = 9, lvC = 9, lvH = 9;
  const plainW = () => lvL === 9 && lvC === 9 && lvH === 9;
  function within(a: number[], b: number[]): boolean {
    if (plainW()) return true;
    const dL = Math.abs(a[0] - b[0]), ca = Math.hypot(a[1], a[2]), cb = Math.hypot(b[1], b[2]), dC = Math.abs(ca - cb);
    const dH = Math.sqrt(Math.max(0, (a[1] - b[1]) ** 2 + (a[2] - b[2]) ** 2 - dC * dC));
    return dL <= LIMITS[lvL] && dC <= LIMITS[lvC] && dH <= LIMITS[lvH];
  }
  const dist = de;
  const nearWord = (d: number) => (d < 3 ? "ほぼ同じ色" : d < 6 ? "近い色" : d < 10 ? "やや近い" : "似た系統");
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);

  // 色の地図は、色みと明るさ・鮮やかさの目盛りのある散布図から、隣どうしが近い色になるように隙間なく並べるパレットだけにした。
  // 散布図は、色の3つの軸を平面に置くので、残りの軸が違う色（鮮やかな赤とくすんだ茶色、白と黒）が隣り合った（388〜390章）
  const W = 1000, PAD = { l: 46, r: 12, t: 6 }, SLAB = 24;
  let Hh = 440;
  const BANDS = [{ name: "鮮やか", lo: 50, hi: Infinity }, { name: "やや鮮やか", lo: 30, hi: 50 }, { name: "落ち着いた", lo: 15, hi: 30 }, { name: "くすみ・グレー寄り", lo: -1, hi: 15 }];
  const hueOf = (l: number[]) => { const h = (Math.atan2(l[2], l[1]) * 180) / Math.PI; return h < -150 ? h + 360 : h; };
  const chromaOf = (l: number[]) => Math.hypot(l[1], l[2]);
  // ---- パレット（389章、ユーザー「綺麗にカラーパッドみたいには並ばないもの？」）----
  // 鮮やかさの段ごとに、色みの順に縦の列へ詰め（列の中は明るい順）、隣どうしの色の差の合計が減る入れ替えだけを繰り返す。
  // 試算（リップ）：隣どうしの色の差の平均は、詰めただけでΔE 9〜11、入れ替え後に5〜6。段に分けずに1枚で並べると、まだらになって向きが読めなかった
  let cell = 16;
  let padStrips: { name: string; top: number; h: number }[] = [];
  let padAt = new Map<number, [number, number]>();
  const padCache = new Map<string, { cell: number; strips: typeof padStrips; at: typeof padAt; hh: number }>();
  function padLayout(idx: number[]) {
    const key = idx.join(","), hit = padCache.get(key);
    if (hit) { cell = hit.cell; padStrips = hit.strips; padAt = hit.at; Hh = hit.hh; return; }
    const aw = W - PAD.l - PAD.r;
    cell = Math.max(8, Math.min(20, Math.sqrt((aw * 600) / Math.max(1, idx.length))));
    const cols = Math.floor(aw / cell);
    cell = aw / cols;
    padStrips = []; padAt = new Map();
    let top = PAD.t;
    for (const b of BANDS) {
      const its = idx.filter((i) => chromaOf(labs[i]) >= b.lo && chromaOf(labs[i]) < b.hi).sort((x, y) => hueOf(labs[x]) - hueOf(labs[y]));
      if (!its.length) continue;
      const rows = Math.ceil(its.length / cols), nc = Math.ceil(its.length / rows);
      // 格子は1次元の配列（g[x * rows + y]、空きは -1）。色は Lab を平たい配列に（Math.hypot は遅いので sqrt で）
      const g = new Int32Array(nc * rows).fill(-1);
      for (let x = 0; x < nc; x++) its.slice(x * rows, (x + 1) * rows).sort((p, q) => labs[q][0] - labs[p][0]).forEach((v, y) => { g[x * rows + y] = v; });
      const lf = new Float64Array(labs.length * 3);
      for (const v of its) { lf[v * 3] = labs[v][0]; lf[v * 3 + 1] = labs[v][1]; lf[v * 3 + 2] = labs[v][2]; }
      const dd = (v: number, u: number) => { const p = v * 3, q = u * 3, a = lf[p] - lf[q], c = lf[p + 1] - lf[q + 1], f = lf[p + 2] - lf[q + 2]; return Math.sqrt(a * a + c * c + f * f); };
      const e = (x: number, y: number, v: number) => {
        let sum = 0, u: number;
        if (x + 1 < nc && (u = g[(x + 1) * rows + y]) >= 0) sum += dd(v, u);
        if (x > 0 && (u = g[(x - 1) * rows + y]) >= 0) sum += dd(v, u);
        if (y + 1 < rows && (u = g[x * rows + y + 1]) >= 0) sum += dd(v, u);
        if (y > 0 && (u = g[x * rows + y - 1]) >= 0) sum += dd(v, u);
        return sum;
      };
      let seed = 1;
      const rnd = () => (seed = (seed * 1103515245 + 12345) & 0x7fffffff) / 0x80000000;
      const N = its.length * 120;
      for (let k = 0; k < N; k++) {
        const r = Math.max(1, Math.round(6 * (1 - k / N)));
        const x1 = Math.floor(rnd() * nc), y1 = Math.floor(rnd() * rows);
        const x2 = Math.min(nc - 1, Math.max(0, x1 + Math.floor(rnd() * (2 * r + 1)) - r)), y2 = Math.min(rows - 1, Math.max(0, y1 + Math.floor(rnd() * (2 * r + 1)) - r));
        const i1 = x1 * rows + y1, i2 = x2 * rows + y2, a = g[i1], c = g[i2];
        if (a < 0 || c < 0 || i1 === i2) continue;
        const before = e(x1, y1, a) + e(x2, y2, c);
        g[i1] = c; g[i2] = a;
        if (e(x1, y1, c) + e(x2, y2, a) > before) { g[i1] = a; g[i2] = c; }
      }
      const st = top + SLAB;
      g.forEach((v, k) => { if (v >= 0) padAt.set(v, [PAD.l + (Math.floor(k / rows) + 0.5) * cell, st + ((k % rows) + 0.5) * cell]); });
      padStrips.push({ name: b.name, top: st, h: rows * cell });
      top = st + rows * cell;
    }
    Hh = top + 12;
    padCache.set(key, { cell, strips: padStrips, at: padAt, hh: Hh });
  }
  function drawPad(idx: number[], shown: Set<number>, t: Lab, myNo: Map<number, number>): string {
    const d = data!;
    padLayout(idx);
    const out: string[] = [], hi: string[] = [], my: string[] = [];
    for (const s of padStrips) out.push(`<text class="band" x="${PAD.l + 4}" y="${s.top - 7}">${s.name}</text><text class="ax" x="2" y="${s.top + 12}">薄い</text><text class="ax" x="2" y="${s.top + s.h - 2}">濃い</text>`);
    dots = [];
    const c2 = cell / 2;
    for (const i of idx) {
      const [pi, , hex] = d.c[i], at = padAt.get(i);
      if (!at) continue;
      const [x, y] = at;
      dots.push({ x, y, i });
      out.push(`<rect x="${x - c2}" y="${y - c2}" width="${cell + 0.3}" height="${cell + 0.3}" fill="${hex}"${!isMineShade(i) && !shown.has(i) && !within(t, labs[i]) ? ` opacity="0.15"` : ""}/>`);
      if (isMineShade(i)) {
        if (!myNo.has(pi)) myNo.set(pi, myNo.size + 1);
        const w = mine.get(d.p[pi][6]) === "wish";
        my.push(`<circle cx="${x}" cy="${y}" r="${c2 + 2}" fill="none" stroke="#fff" stroke-width="2"/><circle cx="${x}" cy="${y}" r="${c2 + 3.5}" fill="none" stroke="${w ? "var(--wish)" : "var(--color-rose)"}" stroke-width="2.5"/><text class="mn${w ? " w" : ""}" x="${x + c2 + 4}" y="${y - c2}">${myNo.get(pi)}</text>`);
      } else if (shown.has(i)) hi.push(`<rect x="${x - c2 + 1}" y="${y - c2 + 1}" width="${cell - 2}" height="${cell - 2}" fill="none" stroke="#1d1517" stroke-width="1.8"/>`);
    }
    // 選択中の色の印：基準のコスメの色、無ければ一番近い色のところ
    let ti = baseI !== null && padAt.has(baseI) ? baseI : -1;
    if (ti < 0) { let bd = Infinity; for (const i of idx) { const dd = de(t, labs[i]); if (dd < bd) { bd = dd; ti = i; } } }
    const tp = padAt.get(ti);
    const cross = tp ? `<circle cx="${tp[0]}" cy="${tp[1]}" r="${Math.max(9, c2 + 4)}" fill="${target}" stroke="#1d1517" stroke-width="2.5"/>` : "";
    return out.join("") + `<g pointer-events="none">${hi.join("")}${my.join("")}${cross}</g>`;
  }

  function readMine() {
    const d = loadMyCosme();
    mine = new Map(); mineColors = new Map();
    // 統合した商品に古い番号で登録していれば、寄せ先の番号に読み替える
    const to = (k: string) => data?.r?.[k] ?? k;
    for (const [kind, list] of [["items", d.items], ["wish", d.wish]] as const) {
      for (const [k, it] of Object.entries(list)) {
        const s = to(k);
        if (mine.has(s)) continue;
        mine.set(s, kind);
        if (it.c?.length) mineColors.set(s, new Set(it.c));
      }
    }
  }
  function drawPresets() {
    presetEl.innerHTML = (presets[modeKey()] || []).map(([name, hex]) =>
      `<button type="button" class="cs-chip" data-hex="${hex}" aria-pressed="${hex.toLowerCase() === target.toLowerCase()}"><span class="cs-dot" style="background:${hex}"></span>${esc(name)}</button>`).join("");
  }
  function setTarget(hex: string, base: number | null = null) {
    target = hex.toLowerCase(); input.value = target;
    baseI = base;
    drawBase();
    render();
  }
  // ---- コスメ名で探す ----
  const qEl = $("cs-q") as HTMLInputElement, sugEl = $("cs-sug"), baseEl = $("cs-base");
  const norm = (s: string) => s.normalize("NFKC").toLowerCase().replace(/[\s　・／/（）()「」【】\-ー－]/g, "");
  let sugRows: number[] = [], sugOn = -1;
  function drawBase() {
    if (baseI === null || !data) { baseEl.hidden = true; return; }
    const [pi, label, hex] = data.c[baseI];
    const [brand, name, kind] = data.p[pi];
    baseEl.hidden = false;
    baseEl.innerHTML = `基準：<span class="cs-dot" style="background:${hex}"></span><span class="cs-kindtag">${esc(kindLabels[kind])}</span>${esc(brand)} ${esc(name)}｜${esc(label)}（${hex}）<button type="button" data-clear>基準を外す</button>`;
  }
  function suggest() {
    const q = norm(qEl.value);
    if (!data || q.length < 1) { sugEl.hidden = true; return; }
    const words = qEl.value.normalize("NFKC").toLowerCase().split(/[\s　]+/).map(norm).filter(Boolean);
    const hits: number[] = [];
    data.c.forEach((c, i) => {
      const [brand, name, kind] = data!.p[c[0]];
      const text = norm(`${brand}${name}${c[1]}${kindLabels[kind]}`);
      if (words.every((w) => text.includes(w))) hits.push(i);
    });
    // 商品名・ブランドが前から合うものを先に、同じ商品の色は公式の並び順で
    const head = (i: number) => { const [b, n] = data!.p[data!.c[i][0]]; return norm(n).startsWith(words[0]) || norm(b).startsWith(words[0]) ? 0 : 1; };
    hits.sort((a, b) => head(a) - head(b) || data!.c[a][0] - data!.c[b][0] || a - b);
    sugRows = hits.slice(0, 30); sugOn = -1;
    sugEl.hidden = false;
    sugEl.innerHTML = sugRows.length ? sugRows.map((i, n) => {
      const [pi, label, hex] = data!.c[i];
      const [brand, name, kind, , img] = data!.p[pi];
      return `<li><button type="button" data-sug="${i}" id="cs-sug-${n}"><span class="cs-sw" style="background:${hex}"></span>${img ? `<img class="cs-img" src="${esc(img)}" alt="" loading="lazy" width="32" height="32">` : ""}<span class="cs-body"><span class="cs-brand"><span class="cs-kindtag">${esc(kindLabels[kind])}</span>${esc(brand)}</span><span class="cs-name">${esc(name)}</span><span class="cs-shade">${esc(label)}</span></span></button></li>`;
    }).join("") + (hits.length > sugRows.length ? `<li class="cs-sug-none">ほか${hits.length - sugRows.length}色。言葉を足すと絞れます</li>` : "")
      : `<li class="cs-sug-none">色の分かっているコスメに見つかりませんでした（色見本の画像が公式に無い商品は載っていません）</li>`;
  }
  function chooseBase(i: number) {
    if (!data) return;
    const kind = data.p[data.c[i][0]][2];
    // 今の表示に入っていないジャンルなら、「すべて」に切り替えて出す
    if (!active().has(kind)) {
      const tab = tabs.find((t) => Number(t.dataset.kind) === kind);
      if (tab) selectTab(tab, false);
    }
    sugEl.hidden = true; qEl.value = "";
    setTarget(data.c[i][2], i);
  }
  qEl.addEventListener("input", suggest);
  qEl.addEventListener("focus", suggest);
  qEl.addEventListener("keydown", (e) => {
    if (sugEl.hidden || !sugRows.length) return;
    if (e.key === "ArrowDown" || e.key === "ArrowUp") {
      e.preventDefault();
      sugOn = (sugOn + (e.key === "ArrowDown" ? 1 : -1) + sugRows.length) % sugRows.length;
      sugEl.querySelectorAll("[data-sug]").forEach((b, n) => b.classList.toggle("is-on", n === sugOn));
      document.getElementById(`cs-sug-${sugOn}`)?.scrollIntoView({ block: "nearest" });
    } else if (e.key === "Enter") {
      e.preventDefault();
      chooseBase(sugRows[Math.max(0, sugOn)]);
    } else if (e.key === "Escape") sugEl.hidden = true;
  });
  sugEl.addEventListener("click", (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>("[data-sug]");
    if (b) chooseBase(Number(b.dataset.sug));
  });
  baseEl.addEventListener("click", (e) => { if ((e.target as HTMLElement).closest("[data-clear]")) setTarget(target); });
  document.addEventListener("click", (e) => { if (!(e.target as HTMLElement).closest(".cs-find")) sugEl.hidden = true; });

  function render() {
    hexEl.textContent = target.toUpperCase();
    presetEl.querySelectorAll<HTMLButtonElement>(".cs-chip").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.hex!.toLowerCase() === target.toLowerCase())));
    if (!data) return;
    const t = lab(target), ks = active();
    const best = new Map<number, { d: number; i: number }>();
    // マイコスメ（使っている・気になる）の品は、近さの範囲の外でも一覧に入れる（363章、ユーザー「範囲外でも表示するように」）。選んだ色があればその中で一番近い色
    const myBest = new Map<number, { d: number; i: number; out: boolean }>();
    const shownKinds: number[] = [];
    data.c.forEach((c, i) => {
      if (!ks.has(data!.p[c[0]][2])) return;
      shownKinds.push(i);
      if (baseI !== null && c[0] === data!.c[baseI][0]) return;
      const d = dist(t, labs[i]);
      if (isMineShade(i)) {
        const cur = myBest.get(c[0]);
        if (!cur || d < cur.d) myBest.set(c[0], { d, i, out: !within(t, labs[i]) });
        return;  // マイコスメの色は下の候補には入れない（持っている商品の、選んでいない色はふつうの候補として出す）
      }
      if (!within(t, labs[i])) return;
      const cur = best.get(c[0]);
      if (!cur || d < cur.d) best.set(c[0], { d, i });
    });
    const near: { d: number; i: number; out?: boolean }[] = [...best.values()].sort((a, b) => a.d - b.d).slice(0, SHOW);
    near.push(...myBest.values());
    near.sort((a, b) => a.d - b.d);
    const rows = sort === "near" ? near : near.slice().sort((a, b) => (sort === "dark" ? 1 : -1) * (labs[a.i][0] - labs[b.i][0]));
    const baseName = baseI !== null ? `${data.p[data.c[baseI][0]][1]}（${data.c[baseI][1]}）` : "";
    const what = baseName ? `基準の ${baseName}` : `選んだ色 ${target.toUpperCase()}`, order = sort === "near" ? "近い順" : sort === "dark" ? "濃い順" : "薄い順";
    const myN = myBest.size ? `（マイコスメの${myBest.size}品は範囲の外でも出しています）` : "";
    statusEl.textContent = (plainW() ? `${best.size}品の中から、${what} に近い順の${rows.length}品を${order}に`
      : best.size ? `範囲に入るのは${best.size}品。${what} に近い${rows.length}品を${order}に` : `範囲に入るコスメがありません。つまみを「遠い」のほうへ動かすと広がります`) + myN;
    listEl.innerHTML = rows.map(({ d, i, out }) => {
      const [pi, label, hex, top, href] = data!.c[i];
      const [brand, name, kind, url, img, videos, slug] = data!.p[pi];
      const my = isMineShade(i) ? mine.get(slug) : undefined;  // 印は、マイコスメで選んだ色（選んでいなければその商品の全部の色）にだけ
      const shade = href ? `<a href="${href}">${esc(label)}</a>` : esc(label);
      return `<li class="cs-item${my === "items" ? " is-mine" : my === "wish" ? " is-wish" : ""}"><button type="button" class="cs-sw cs-sw-go" style="background:${hex}" data-go="${i}" title="パレットでこの色の位置を見る" aria-label="パレットでこの色の位置を見る"></button>${img ? `<img class="cs-img" src="${esc(img)}" alt="" loading="lazy" width="54" height="54">` : ""}<span class="cs-body"><span class="cs-brand">${mode === "all" ? `<span class="cs-kindtag">${esc(kindLabels[kind])}</span>` : ""}${esc(brand)}${my ? `<span class="cs-mytag${my === "wish" ? " w" : ""}">${my === "wish" ? "気になる" : "マイコスメ"}</span>` : ""}</span><a class="cs-name" href="${url}">${esc(name)}</a><span class="cs-shade">${shade}</span><span class="cs-meta"><span class="cs-near">${out ? "範囲外" : nearWord(d)}（ΔE ${d.toFixed(1)}）</span>${hex}・明るさ ${labs[i][0].toFixed(0)}${top ? "・商品写真から" : ""}・紹介${videos}本</span></span></li>`;
    }).join("");
    drawMap(shownKinds, new Set(near.map((r) => r.i)), t);
  }

  function drawMap(idx: number[], shown: Set<number>, t: Lab) {
    const myNo = new Map<number, number>();
    const svg = drawPad(idx, shown, t, myNo);
    mapEl.setAttribute("viewBox", `0 0 ${W} ${Hh}`);
    mapEl.innerHTML = svg;
    drawMine(myNo);
  }
  function drawMine(myNo: Map<number, number>) {
    const d = data!;
    if (!mine.size) mineEl.innerHTML = `<span class="cs-note">マイコスメに登録した商品があると、その商品の色がパレットのどこにあるかを番号で示します。</span>`;
    else if (!myNo.size) mineEl.innerHTML = `<span class="cs-note">マイコスメに登録した商品のうち、表示中のジャンルで色が分かっている商品はまだありません。</span>`;
    else mineEl.innerHTML = [...myNo.entries()].map(([pi, no]) => {
      const [brand, name, , , , , slug] = d.p[pi];
      const sw = d.c.map((c, i) => [c, i] as const).filter(([c, i]) => c[0] === pi && isMineShade(i)).map(([c]) => `<span class="cs-dot" style="background:${c[2]}" title="${esc(c[1])}"></span>`).join("");
      const w = mine.get(slug) === "wish";
      return `<span><b${w ? ' class="w"' : ""}>${no}</b>${esc(brand)} ${esc(name)}${w ? "（気になる）" : ""}${sw}</span>`;
    }).join("");
    if (pinned) hidePop();
  }

  // ---- 地図のポップアップ ----
  function svgPoint(e: MouseEvent): [number, number] {
    const m = mapEl.getScreenCTM();
    if (!m) return [0, 0];
    const pt = new DOMPoint(e.clientX, e.clientY).matrixTransform(m.inverse());
    return [pt.x, pt.y];
  }
  function nearest(x: number, y: number, within = cell * 0.75) {
    let best: { x: number; y: number; i: number } | null = null, bd = within;
    for (const p of dots) { const dd = Math.hypot(p.x - x, p.y - y); if (dd < bd) { bd = dd; best = p; } }
    return best;
  }
  function placePop(x: number, y: number) {
    const sr = mapEl.getBoundingClientRect(), wr = wrapEl.getBoundingClientRect();
    const px = sr.left - wr.left + wrapEl.scrollLeft + (x / W) * sr.width, py = sr.top - wr.top + (y / Hh) * sr.height;
    popEl.hidden = false;
    const w = popEl.offsetWidth, h = popEl.offsetHeight;
    const left = Math.max(wrapEl.scrollLeft + 4, Math.min(px - w / 2, wrapEl.scrollLeft + wrapEl.clientWidth - w - 4));
    const top = py - h - 14 >= 0 ? py - h - 14 : py + 14;
    popEl.style.left = `${left}px`; popEl.style.top = `${top}px`;
  }
  function shadeCard(i: number, full: boolean): string {
    const d = data!;
    const [pi, label, hex, top, href] = d.c[i];
    const [brand, name, kind, url, img, videos, slug] = d.p[pi];
    const my = isMineShade(i) ? mine.get(slug) : undefined;
    // 固定のポップアップ（full）では、商品画像とコスメ名からも商品ページへ
    const link = (inner: string, cls = "") => (full ? `<a href="${url}"${cls ? ` class="${cls}"` : ""}>${inner}</a>` : cls ? `<span class="${cls}">${inner}</span>` : inner);
    const head = `<div class="cs-pop-top"><span class="cs-sw" style="background:${hex}"></span>${img ? link(`<img class="cs-img" src="${esc(img)}" alt="" width="42" height="42">`) : ""}<span class="cs-body"><span class="cs-brand"><span class="cs-kindtag">${esc(kindLabels[kind])}</span>${esc(brand)}${my ? `<span class="cs-mytag${my === "wish" ? " w" : ""}">${my === "wish" ? "気になる" : "マイコスメ"}</span>` : ""}</span>${link(esc(name), "cs-name")}<span class="cs-shade">${esc(label)}</span></span></div>`;
    if (!full) return head;
    const dt = dist(lab(target), labs[i]);
    return `<button type="button" class="cs-pop-x" aria-label="閉じる" data-close>×</button>${head}<span class="cs-meta">${hex}・明るさ ${labs[i][0].toFixed(0)}・鮮やかさ ${chromaOf(labs[i]).toFixed(0)}・選んだ色との差 ΔE ${dt.toFixed(1)}${top ? "・商品写真から" : ""}・紹介${videos}本</span><div class="cs-pop-btns"><button type="button" class="cs-go" data-pick="${hex}" data-base="${i}">この色を基準に探す</button><a href="${href || url}">${href ? "この色の紹介を見る" : "商品ページへ"}</a></div>`;
  }
  function hidePop() { popEl.hidden = true; pinned = false; popEl.classList.remove("is-hover"); }

  mapEl.addEventListener("pointermove", (e) => {
    if (pinned || !data || e.pointerType === "touch") return;
    const [x, y] = svgPoint(e), p = nearest(x, y);
    if (!p) { popEl.hidden = true; return; }
    popEl.classList.add("is-hover");
    popEl.innerHTML = shadeCard(p.i, false);
    placePop(p.x, p.y);
  });
  mapEl.addEventListener("pointerleave", () => { if (!pinned) popEl.hidden = true; });
  mapEl.addEventListener("click", (e) => {
    if (!data) return;
    const [x, y] = svgPoint(e), p = nearest(x, y);
    popEl.classList.remove("is-hover");
    if (!p) { hidePop(); return; }
    popEl.innerHTML = shadeCard(p.i, true);
    placePop(p.x, p.y);
    pinned = true;
  });
  popEl.addEventListener("click", (e) => {
    const el = e.target as HTMLElement;
    if (el.closest("[data-close]")) { hidePop(); return; }
    const pb = el.closest<HTMLElement>("[data-pick]");
    if (pb) { hidePop(); setTarget(pb.dataset.pick!, pb.dataset.base ? Number(pb.dataset.base) : null); }
  });
  // 一覧の色の丸：地図のその色の位置へ移り、点を光らせて固定のポップアップを開く
  listEl.addEventListener("click", (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>("[data-go]");
    if (!b || !data) return;
    e.stopPropagation();  // 下の「地図の外を押したら閉じる」に掛からないように
    const i = Number(b.dataset.go), p = dots.find((q) => q.i === i);
    if (!p) return;
    const sr = mapEl.getBoundingClientRect();
    wrapEl.scrollLeft = Math.max(0, (p.x / W) * sr.width - wrapEl.clientWidth / 2);  // スマホで地図が横に広いとき
    wrapEl.scrollIntoView({ behavior: "smooth", block: "center" });
    mapEl.querySelector(".cs-ping")?.remove();
    const ring = document.createElementNS("http://www.w3.org/2000/svg", "circle");
    ring.setAttribute("class", "cs-ping");
    Object.entries({ cx: p.x, cy: p.y, r: 12, fill: "none", stroke: "#1d1517", "stroke-width": 2.5, "pointer-events": "none" }).forEach(([k, v]) => ring.setAttribute(k, String(v)));
    mapEl.appendChild(ring);
    setTimeout(() => ring.remove(), 2800);
    popEl.classList.remove("is-hover");
    popEl.innerHTML = shadeCard(i, true);
    placePop(p.x, p.y);
    pinned = true;
  });
  document.addEventListener("click", (e) => { if (pinned && !wrapEl.contains(e.target as Node)) hidePop(); });
  document.addEventListener("keydown", (e) => { if (e.key === "Escape") hidePop(); });

  // ---- 切り替え ----
  function selectTab(b: HTMLButtonElement, resetColor = true) {
    mode = b.dataset.key === "all" ? "all" : Number(b.dataset.kind);
    tabs.forEach((x) => { x.classList.toggle("is-active", x === b); x.setAttribute("aria-selected", String(x === b)); });
    filterEl.hidden = mode !== "all";
    const first = presets[modeKey()]?.[0]?.[1];
    // 検索で選んだ基準のコスメがあれば、その色のまま引き継ぐ（363章、ユーザー「カテゴリを変えたときに検索したコスメが消えちゃう」）
    if (resetColor && first && baseI === null) { target = first.toLowerCase(); input.value = target; }
    hidePop(); drawPresets(); render();
  }
  tabs.forEach((b) => b.addEventListener("click", () => selectTab(b)));
  filters.forEach((b) => b.addEventListener("click", () => {
    const k = Number(b.dataset.filter);
    if (filter.has(k) && filter.size > 1) filter.delete(k); else filter.add(k);
    filters.forEach((x) => { const on = filter.has(Number(x.dataset.filter)); x.classList.toggle("is-active", on); x.setAttribute("aria-pressed", String(on)); });
    hidePop(); render();
  }));
  sorts.forEach((b) => b.addEventListener("click", () => {
    sort = b.dataset.sort!;
    sorts.forEach((x) => x.classList.toggle("is-active", x === b));
    render();
  }));
  presetEl.addEventListener("click", (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>(".cs-chip");
    if (b) setTarget(b.dataset.hex!);
  });
  const wlEl = $("cs-wl") as HTMLInputElement, wcEl = $("cs-wc") as HTMLInputElement, whEl = $("cs-wh") as HTMLInputElement, wResetEl = $("cs-wreset");
  function onWeight() {
    lvL = Number(wlEl.value); lvC = Number(wcEl.value); lvH = Number(whEl.value);
    $("cs-wl-v").textContent = String(lvL); $("cs-wc-v").textContent = String(lvC); $("cs-wh-v").textContent = String(lvH);
    wResetEl.hidden = plainW();
    render();
  }
  [wlEl, wcEl, whEl].forEach((el) => el.addEventListener("input", onWeight));
  wResetEl.addEventListener("click", () => { wlEl.value = "9"; wcEl.value = "9"; whEl.value = "9"; onWeight(); });
  input.addEventListener("input", () => { target = input.value; baseI = null; drawBase(); render(); });

  readMine();
  onMyCosmeChange(() => { readMine(); render(); });
  // 種類を #lip・#all のようにリンクで選べるようにする
  const fromHash = () => tabs.find((t) => t.dataset.key === location.hash.slice(1));
  if (fromHash()) selectTab(fromHash()!); else { target = (presets[modeKey()]?.[4]?.[1] || target).toLowerCase(); input.value = target; drawPresets(); }
  window.addEventListener("hashchange", () => { const t = fromHash(); if (t) selectTab(t); });

  // ---- 状態の保存：商品ページへ行って戻ったときに元どおりにする（この端末のブラウザのタブの中だけ。363章、ユーザー「戻った時全てリセットされちゃっている」）----
  const STATE_KEY = "osorocosme.color.state";
  function saveState() {
    if (!data) return;
    const base = baseI !== null ? { slug: data.p[data.c[baseI][0]][6], label: data.c[baseI][1] } : null;
    const st = { mode: modeKey(), filter: [...filter], target, base, sort, lv: [lvL, lvC, lvH], y: window.scrollY };
    try { sessionStorage.setItem(STATE_KEY, JSON.stringify(st)); } catch { /* 保存できない設定なら諦める */ }
  }
  function restoreState(): boolean {
    let st: any = null;
    try { st = JSON.parse(sessionStorage.getItem(STATE_KEY) || "null"); } catch { st = null; }
    if (!st || !data) return false;
    const h = location.hash.slice(1);
    if (h && tabs.some((t) => t.dataset.key === h) && st.mode !== h) return false;  // 別の種類へのリンクで来たときは、そちらを優先
    const tab = tabs.find((t) => t.dataset.key === st.mode);
    if (tab) selectTab(tab, false);
    if (Array.isArray(st.filter) && st.filter.length) {
      filter.clear(); st.filter.forEach((k: number) => filter.add(k));
      filters.forEach((x) => { const on = filter.has(Number(x.dataset.filter)); x.classList.toggle("is-active", on); x.setAttribute("aria-pressed", String(on)); });
    }
    if (typeof st.sort === "string") { sort = st.sort; sorts.forEach((x) => x.classList.toggle("is-active", x.dataset.sort === sort)); }
    if (Array.isArray(st.lv) && st.lv.length === 3) { wlEl.value = String(st.lv[0]); wcEl.value = String(st.lv[1]); whEl.value = String(st.lv[2]); }
    let bi: number | null = null;
    if (st.base) bi = data.c.findIndex((c) => data!.p[c[0]][6] === st.base.slug && c[1] === st.base.label);
    target = typeof st.target === "string" ? st.target : target; input.value = target;
    baseI = bi !== null && bi >= 0 ? bi : null;
    drawPresets(); drawBase(); onWeight();
    if (typeof st.y === "number") requestAnimationFrame(() => window.scrollTo(0, st.y));
    return true;
  }
  window.addEventListener("pagehide", saveState);
  document.addEventListener("visibilitychange", () => { if (document.visibilityState === "hidden") saveState(); });
  listEl.addEventListener("click", (e) => { if ((e.target as HTMLElement).closest("a")) saveState(); });
  popEl.addEventListener("click", (e) => { if ((e.target as HTMLElement).closest("a")) saveState(); }, true);

  fetch(root.dataset.src!).then((r) => r.json()).then((d: Data) => {
    data = d;
    labs = d.c.map((c) => lab(c[2]));
    if (d.r) renameSlugs(d.r);  // 統合した商品に古い番号で登録していれば、寄せ先の番号に移す（363章）
    readMine();  // 転送の表を読んでから、マイコスメを読み直す
    if (!restoreState()) render();
  }).catch(() => { statusEl.textContent = "色の一覧を読み込めませんでした。ページを読み込み直してください。"; });
</script>
