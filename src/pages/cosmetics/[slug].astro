---
import BrandFlag from "../../components/BrandFlag.astro";
import Layout from "../../layouts/Layout.astro";
import ShareButtons from "../../components/ShareButtons.astro";
import CosmeticTile from "../../components/CosmeticTile.astro";
import IntroRow from "../../components/IntroRow.astro";
import SectionHead from "../../components/SectionHead.astro";
import PageNav from "../../components/PageNav.astro";
import {
  getProducersOf,
  getUsedCosmeticKeys,
  getAliasRedirects,
  getProductRedirects,
  canonicalBrandId,
  getCosmeticListEntry,
  getVideosUsingCosmetic,
  isCosmeticIndexed,
  getCoMentionedCosmetics,
  getCategoryTop,
  getBrandTopCosmetics,
  categoryUrl,
  cosmeticSlug,
  sortByPublishedDesc,
  formatCount,
  withBase,
  getCosmeticFacts,
  formatJaDate,
  extractImageSrc,
  parseRakutenImage,
  breadcrumbLd,
  productCategoryPath,
  amazonSearchUrl,
  matsukiyoSearchUrl,
  getPublishedConcerns,
  hasRankingPage,
  CONCERNS,
  getIngredientInfo,
  getIngredientsOfCosmetic,
  ingredientSourceLabel,
  getRepeatUsers,
  jstDate,
  INTRO_IN_PAGE,
  INTRO_SPLIT_OVER,
  introProfileSummary,
} from "../../lib/data";
import titleOverrides from "../../data/title-overrides.json";

export function getStaticPaths() {
  return [
    ...getUsedCosmeticKeys().map(({ brand_id, name_id }) => ({
      params: { slug: cosmeticSlug(brand_id, name_id) },
      props: { brand_id, name_id, redirectTo: "" },
    })),
    // 二重登録ブランドの統合で、統合先の商品に寄せた商品の統合前のURLは、統合先の商品ページへ転送する
    ...getAliasRedirects().products.map((r) => ({
      params: { slug: r.from },
      props: { brand_id: "", name_id: "", redirectTo: r.to },
    })),
    // 表記揺れの統合で寄せた商品（今は使われていない側）の旧URLは、寄せ先の商品ページへ転送する（251章）
    ...getProductRedirects().map((r) => ({
      params: { slug: r.from },
      props: { brand_id: "", name_id: "", redirectTo: r.to },
    })),
  ];
}

const { brand_id, name_id, redirectTo } = Astro.props;
if (redirectTo) return Astro.redirect(withBase(`/cosmetics/${redirectTo}`), 301);

// cosmetics_list.json を正データとする（現行WordPressは動画反復順で最後に処理した値が勝つ
// 不安定な実装だったため、単一の正規ソースに統一）
const entry = getCosmeticListEntry(brand_id, name_id);
const videosUsing = sortByPublishedDesc(getVideosUsingCosmetic(brand_id, name_id));
const noindex = !isCosmeticIndexed(videosUsing); // 2本以上、または直近90日の動画で紹介（301章）

const facts = getCosmeticFacts(brand_id, name_id);
const producers = getProducersOf(brand_id, name_id);
// 同じ人が日をあけて繰り返し使っているか（PR・提供と新作紹介などの動画は除く。273章）
const repeatUsers = getRepeatUsers(brand_id, name_id);
const repeatSpan = (u: { first: string; last: string }) => {
  const a = jstDate(u.first).y, b = jstDate(u.last).y;
  return a === b ? `${a}年` : `${a}〜${b}年`;
};
// 画像の無い商品（＝楽天側に出品が無い・画像が消えている）は、購入できないリンクの可能性が高いので、価格・購入ボタンを出さない
const buyable = !!extractImageSrc(entry?.rakuten_image_link);
// 楽天の画像が無い商品で、Yahoo!ショッピングのリンクと画像があれば、Yahoo!の画像・価格を出す（115章）
const yahooFallback = !buyable && !!entry?.yahoo_text_link && !!entry?.yahoo_image_url;
// 楽天の画像はあるが実際には読み込めなかったとき、下のスクリプトがYahoo!の画像に差し替えるための値
const yahooSwap = buyable && entry?.yahoo_text_link && entry?.yahoo_image_url ? entry : undefined;
const rakutenImage = parseRakutenImage(entry?.rakuten_image_link, 500);
// ページ下部の「次に見たくなる」3要素：一緒に紹介されているコスメ／同じカテゴリの人気ランキング／同じブランドの人気商品
const coMentioned = getCoMentionedCosmetics(brand_id, name_id, 6);
const categoryTop = facts.mainTag ? getCategoryTop(facts.mainTag, 6) : [];
const brandTop = getBrandTopCosmetics(brand_id, name_id, 6);

const INTRO_SHOWN = INTRO_IN_PAGE;
// 紹介の多い商品は、ページに入れる行を先頭だけにし、残りは別のファイルから読む（279章）
const introSplit = facts.introductions.length > INTRO_SPLIT_OVER;
const introRows = introSplit ? facts.introductions.slice(0, INTRO_IN_PAGE) : facts.introductions;
// 全成分（公式サイト、無ければ楽天市場のメーカー公式ショップの表示。246章）と、その全成分に当たる成分のページ
const ingredientInfo = getIngredientInfo(brand_id, name_id);
const ingredientPages = ingredientInfo ? getIngredientsOfCosmetic(brand_id, name_id) : [];
const otherItems = ingredientInfo ? ingredientInfo.items.filter((x) => !ingredientInfo.active.includes(x)) : [];
const concernPages = new Set(getPublishedConcerns().map((c) => c.slug));
// 紹介した人のパーソナルカラー・肌質の内訳（311章）
const profileSummary = introProfileSummary(facts.introductions.map((x) => x.channel_id));
const concernIntroCount = facts.introductions.filter((i) => i.concerns.length > 0).length;
// 名前の下に、この商品が載っている探し方のページ（カテゴリのランキング・肌悩み・成分）を並べる。
// Googleから商品ページに着地した人が、同じカテゴリ・悩み・成分の別の商品へ移れるようにする（248章）
const concernLinks = CONCERNS.filter((d) => concernPages.has(d.slug) && facts.introductions.some((i) => i.concerns.some((c) => c.slug === d.slug)));
const findLinks = [
  ...(entry?.category && hasRankingPage(entry.category) ? [{ label: `${entry.category}のランキング`, path: `/ranking/${encodeURIComponent(entry.category)}/` }] : []),
  ...concernLinks.map((d) => ({ label: `肌悩み：${d.name}`, path: `/concern/${d.slug}/` })),
  ...ingredientPages.map((p) => ({ label: `成分：${p.def.name}`, path: `/ingredient/${p.def.slug}/` })),
];
const matsukiyoLink = entry ? matsukiyoSearchUrl(entry.brand_id, entry.brand, entry.name) : undefined;
const factSentence = entry
  ? `${entry.brand}「${entry.name}」は、YouTubeのコスメ紹介動画${facts.videoCount}本・インフルエンサー${facts.channelCount}人に紹介されています` +
    (facts.rank ? `。「${facts.mainTag}」カテゴリの人気ランキングでは${facts.rankTotal}品中${facts.rank}位です。` : "。")
  : "";
const firstIntro = facts.introductions[facts.introductions.length - 1];
const lastIntro = facts.introductions[0];
// Search Consoleの検索語に合わせたページごとのtitle（274章）
const titleOverride = (titleOverrides as Record<string, { title?: string; lead?: string }>)[`cosmetics/${cosmeticSlug(brand_id, name_id)}`];
const description = entry
  ? (titleOverride?.lead ?? "") + factSentence + (firstIntro ? `最初の紹介は${formatJaDate(firstIntro.published_at)}、直近は${formatJaDate(lastIntro.published_at)}です。` : "")
  : undefined;
const imageSrc = extractImageSrc(entry?.rakuten_image_link) || (yahooFallback ? entry?.yahoo_image_url : undefined);
// Googleの「商品スニペット」は、Productに offers / review / aggregateRating のいずれかが無いと重大な問題として扱われる（Search Consoleの指摘）。
// このサイトには、根拠のある口コミ・評価は無い（YouTubeの紹介は口コミではない）ので、偽って付けない。
// 同様に、offers.availability（在庫）・hasMerchantReturnPolicy（返品）・shippingDetails（配送）も、
// 実際の販売者は楽天市場の各ショップでありこのサイトは把握していないため、不正確な値を出さず付けない（いずれもGoogle側も任意項目）。
// 価格をページに出している商品（＝buyable かつ参考価格あり。ページの表示と一致させる）にだけ offers を付け、それ以外は Product を出さない。
const offerPrice = buyable
  ? (entry?.rakuten_text_link ? entry?.now_price : undefined)
  : yahooFallback ? entry?.yahoo_price : undefined;
const hasOffer = typeof offerPrice === "number" && offerPrice > 0;
const productLd =
  entry && hasOffer
    ? {
        "@context": "https://schema.org",
        "@type": "Product",
        name: entry.name,
        brand: { "@type": "Brand", name: entry.brand },
        // category はカテゴリ名単体だと「値が無効」と判定された（Search Consoleの指摘）ため、
        // 大分類を含む階層テキストにする（productCategoryPath）。
        ...(entry.category ? { category: productCategoryPath(entry.category) } : {}),
        ...(imageSrc ? { image: imageSrc } : {}),
        description,
        offers: { "@type": "Offer", price: offerPrice, priceCurrency: "JPY" },
      }
    : null;
const jsonLd = entry
  ? [
      ...(productLd ? [productLd] : []),
      breadcrumbLd(
        [
          { name: "ホーム", path: "/" },
          { name: entry.brand, path: `/brand/${canonicalBrandId(entry.brand_id)}` },
          { name: entry.name, path: `/cosmetics/${cosmeticSlug(brand_id, name_id)}` },
        ],
        Astro.site!
      ),
    ]
  : [];
---

<Layout title={entry ? (titleOverride?.title ?? `${entry.brand} ${entry.name}の紹介動画・使っている人`) : "商品詳細"} description={description} image={imageSrc} jsonLd={jsonLd} noindex={noindex}>
  {
    !entry ? (
      <p class="text-neutral-500">商品情報が見つかりませんでした。</p>
    ) : (
      <>
        {/* ===== 商品の表紙：左に額装した画像、右に名前・価格・購入ボタン ===== */}
        <nav class="item-15" aria-label="パンくず">
          <a href={withBase("/")} class="link-u">Home</a><span aria-hidden="true">/</span>
          {facts.mainTag ? <a href={categoryUrl(facts.mainTag)} class="link-u">{facts.mainTag}</a> : <span>{entry.category}</span>}
          <span aria-hidden="true">/</span><span class="truncate text-ink">{entry.name}</span>
        </nav>
        <div class="panel item-16">
          {/* 右の列（値段・購入・数字・紹介者）のほうがずっと長いので、PCでは画像を画面に追従させて左の下が空いて見えないようにする（279章） */}
          <div class="md:col-span-5 relative md:sticky md:top-24">
            <div class="product-well overflow-hidden item-23">
              {rakutenImage ? (
                <div
                  data-item-image
                  data-yahoo-link={yahooSwap?.yahoo_text_link}
                  data-yahoo-image={yahooSwap?.yahoo_image_url}
                  class="item-7"
                >
                  {/* 楽天のHTMLはそのまま差し込まず、リンク先・画像・altだけを自前のタグで出す（276章）。ページの主役の画像なので先に読む */}
                  <a href={rakutenImage.href} target="_blank" rel="nofollow sponsored noopener">
                    <img src={rakutenImage.src} alt={rakutenImage.alt || `${entry.brand} ${entry.name}`} width="500" height="500" loading="eager" fetchpriority="high" decoding="async" />
                  </a>
                </div>
              ) : yahooFallback ? (
                <a href={entry.yahoo_text_link} target="_blank" rel="nofollow sponsored noopener" class="w-[82%] h-[82%] flex items-center justify-center">
                  <img src={entry.yahoo_image_url} alt={`${entry.brand} ${entry.name}`} width="240" height="240" class="max-w-full max-h-full w-auto h-auto rounded-md object-contain" />
                </a>
              ) : (
                <span class="noimg">No image</span>
              )}
            </div>
            {facts.rank && facts.rank <= 10 && (
              <a href={categoryUrl(facts.mainTag!)} class="absolute -top-4 right-2 md:-right-5 w-20 h-20 md:w-24 md:h-24 rounded-full bg-ink text-paper flex flex-col items-center justify-center rotate-[8deg] shadow-xl hover:bg-rose transition-colors">
                <span class="label-caps text-[11px] text-paper/60">Ranking</span>
                <span class="num-display text-[22px] md:text-[26px] leading-none">No.{facts.rank}</span>
              </a>
            )}
          </div>

          <div class="md:col-span-7 md:pt-4">
            <a href={withBase(`/brand/${canonicalBrandId(entry.brand_id)}`)} class="link-u text-xs font-bold tracking-[0.14em] text-rose"><BrandFlag brand_id={entry.brand_id} />{entry.brand}</a>
            <h1 class="font-serif phrase item-22">{entry.name}</h1>
            {/* プロデュースしたインフルエンサー（本人のブランド。ユーザー依頼、321章） */}
            {producers.length > 0 && (
              <div class="mt-4 flex flex-wrap items-center gap-2">
                <span class="text-[10px] tracking-[0.14em] uppercase text-rose mr-1">Produced by</span>
                {producers.map((p) => (
                  <a href={withBase(`/influencer/${p.channel_id}`)} class="group inline-flex items-center gap-2 rounded-full border border-ink/15 bg-white/80 pl-1 pr-3.5 py-1 hover:border-rose transition-colors" title={`${p.channel_title}がプロデュースしたブランド`}>
                    {p.channel_icon ? (
                      <img src={p.channel_icon} alt="" width="32" height="32" class="w-8 h-8 rounded-full object-cover ring-2 ring-white" loading="lazy" referrerpolicy="no-referrer" />
                    ) : (
                      <span class="w-8 h-8 rounded-full bg-blush flex items-center justify-center text-xs text-rose font-semibold" aria-hidden="true">{p.channel_title.slice(0, 1)}</span>
                    )}
                    <span class="text-sm text-ink group-hover:text-rose transition-colors">{p.channel_title}<span class="text-xs text-neutral-500 ml-1.5">プロデュース</span></span>
                  </a>
                ))}
              </div>
            )}
            {findLinks.length > 0 ? (
              <p class="mt-4 flex flex-wrap gap-1.5">
                {findLinks.map((l) => <a href={withBase(l.path)} class="item-4">{l.label}</a>)}
              </p>
            ) : (
              entry.category && <p class="mt-4 inline-flex items-center gap-2 text-xs text-neutral-600 border border-ink/15 rounded-full px-3 py-1">{entry.category}</p>
            )}

            <div class="u-22">
              {buyable && entry.now_price !== undefined && (
                <p data-buy class="item-21"><span class="label-caps text-neutral-500">Price</span><span class="num-display text-[24px] leading-none">¥{formatCount(entry.now_price)}</span><span class="u-11"><span class="inline-block">楽天市場の参考価格</span>{entry.price_updated && <span class="inline-block">・{formatJaDate(entry.price_updated)}時点</span>}</span></p>
              )}
              {yahooFallback && entry.yahoo_price !== undefined && (
                <p class="item-21"><span class="label-caps text-neutral-500">Price</span><span class="num-display text-[24px] leading-none">¥{formatCount(entry.yahoo_price)}</span><span class="u-11"><span class="inline-block">Yahoo!ショッピングの参考価格</span>{entry.yahoo_price_updated && <span class="inline-block">・{formatJaDate(entry.yahoo_price_updated)}時点</span>}</span></p>
              )}
              {yahooSwap?.yahoo_price !== undefined && (
                <p data-yahoo-price hidden class="item-21"><span class="label-caps text-neutral-500">Price</span><span class="num-display text-[24px] leading-none">¥{formatCount(yahooSwap.yahoo_price)}</span><span class="u-11"><span class="inline-block">Yahoo!ショッピングの参考価格</span>{yahooSwap.yahoo_price_updated && <span class="inline-block">・{formatJaDate(yahooSwap.yahoo_price_updated)}時点</span>}</span></p>
              )}
              {/* 楽天・Yahoo!ショッピング・Amazonのボタン（data-buy の扱いは従来どおり）。Amazonは検索結果へのリンクで、全商品に出す。3つとも同じ白い枠（206章） */}
              <div class="u-21">
                {buyable && entry.rakuten_text_link && (
                  <a data-buy href={entry.rakuten_text_link} target="_blank" rel="nofollow sponsored noopener" class="group item-2">
                    楽天市場で見る<span class="item-3" aria-hidden="true">→</span>
                  </a>
                )}
                {entry.yahoo_text_link && (
                  <a href={entry.yahoo_text_link} target="_blank" rel="nofollow sponsored noopener" class="group item-2">
                    Yahoo!ショッピングで見る<span class="item-3" aria-hidden="true">→</span>
                  </a>
                )}
                <a href={amazonSearchUrl(entry.brand, entry.name)} target="_blank" rel="nofollow sponsored noopener" class="group item-2">
                  Amazonで探す<span class="item-3" aria-hidden="true">→</span>
                </a>
                {/* マツキヨココカラはドラッグストアのブランドの商品だけ。検索結果へのリンク（271章） */}
                {matsukiyoLink && (
                  <a href={matsukiyoLink} target="_blank" rel="nofollow sponsored noopener" class="group item-2">
                    マツキヨココカラで探す<span class="item-3" aria-hidden="true">→</span>
                  </a>
                )}
              </div>
              <p class="mt-3 text-xs text-neutral-500">PR：リンク先での購入により、当サイトに報酬が支払われることがあります。</p>
            </div>

            {/* 紹介の実績：動画数・インフルエンサー数・ランキング。文章版は検索エンジン・読み上げ用に残す（sr-only） */}
            <p class="sr-only">{factSentence}</p>
            <dl class:list={["mt-8 grid border-y border-ink/15 divide-x divide-ink/15 [&>*]:flex [&>*]:flex-col [&>*]:justify-between", facts.rank ? "grid-cols-3" : "grid-cols-2"]}>
              <div class="py-5 pr-3">
                <dt class="u-11">紹介動画</dt>
                <dd class="num-display item-8">{facts.videoCount}<span class="item-10">本</span></dd>
              </div>
              <div class="py-5 px-3 md:px-5">
                <dt class="u-11">紹介した人</dt>
                <dd class="num-display item-8">{facts.channelCount}<span class="item-10">人</span></dd>
              </div>
              {facts.rank && (
                <a href={categoryUrl(facts.mainTag!)} class="group py-5 px-3 md:px-5">
                  <dt class="item-18">{facts.mainTag}</dt>
                  <dd class="num-display item-12"><span class="text-rose">{facts.rank}</span><span class="item-10">位<span class="text-neutral-500"> / {facts.rankTotal}品</span></span></dd>
                </a>
              )}
            </dl>
            {facts.prCount > 0 && <p class="mt-3 text-xs leading-relaxed text-neutral-500">うち{facts.prCount}本は{facts.ownCount === 0 ? "PR・提供" : facts.ownCount === facts.prCount ? "本人がプロデュースしたブランドとして" : "PR・提供、または本人がプロデュースしたブランドとして"}の紹介のため、ランキングには数えていません。</p>}
            {repeatUsers.length > 0 && (
              <p class="mt-3 text-xs leading-relaxed text-neutral-600">
                <span class="inline-flex items-center rounded-full border border-rose text-rose px-2 py-[3px] mr-1.5 leading-none font-semibold">{repeatUsers.length}人がリピート</span>
                {repeatUsers.slice(0, 3).map((u, i) => (
                  <>{i > 0 && "・"}<a href={withBase(`/influencer/${u.channel_id}`)} class="link-u">{u.channel_title}</a>（{u.videoCount}本・{repeatSpan(u)}）</>
                ))}
                {repeatUsers.length > 3 && `ほか${repeatUsers.length - 3}人`}
                <a href={withBase("/ranking/repeat/")} class="link-u text-neutral-500 ml-1.5 whitespace-nowrap">リピートされているコスメ →</a>
              </p>
            )}
            {(() => {
              const seen = new Set<string>();
              const faces = facts.introductions.filter((i) => i.channel_icon && !seen.has(i.channel_id) && seen.add(i.channel_id)).slice(0, 8);
              return faces.length > 0 && (
                <div class="item-14">
                  <div class="flex -space-x-3">
                    {faces.map((f) => (
                      <a href={withBase(`/influencer/${f.channel_id}`)} title={f.channel_title} class="item-5">
                        <img referrerpolicy="no-referrer" src={f.channel_icon} alt={f.channel_title} width="40" height="40" class="item-11" loading="lazy" />
                      </a>
                    ))}
                  </div>
                  <p class="item-19">{faces[0].channel_title}さんほか、{facts.channelCount}人が紹介</p>
                </div>
              );
            })()}
            {/* マイコスメ（5-4）：使っているコスメ・気になるコスメとして、この端末のブラウザに登録する（同じ商品は片方にだけ入る。259章）。表示はスクリプトで切り替える（スクリプトなしでは出さない） */}
            <div data-mycosme hidden class="item-17" data-slug={cosmeticSlug(brand_id, name_id)} data-name={`${entry.brand} ${entry.name}`}>
              <button type="button" data-mycosme-toggle="items" aria-pressed="false" class="group rounded-full border item-mc">
                <svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path class="group-aria-pressed:hidden" d="M12 5v14M5 12h14" /><path class="hidden group-aria-pressed:block" d="m5 12.5 4.5 4.5L19 7" /></svg>
                <span data-label>使っている</span>
              </button>
              <button type="button" data-mycosme-toggle="wish" aria-pressed="false" class="group rounded-full border item-mc">
                <svg viewBox="0 0 24 24" class="item-20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10Z" /></svg>
                <span data-label>気になる</span>
              </button>
              <a href={withBase("/my-cosme/")} class="link-u text-xs text-neutral-600">マイコスメでおすすめを見る →</a>
            </div>
            <ShareButtons text={`${entry.brand}「${entry.name}」を紹介しているYouTube動画${facts.videoCount}本・インフルエンサー${facts.channelCount}人`} class="mt-6" />
          </div>
        </div>

        {/* スマホで縦に長くなるので、各セクションへ飛べる目次の帯を固定で出す */}
        <PageNav
          class="mt-6 md:mt-8"
          items={[
            { label: `紹介した人 ${facts.introductions.length}`, target: "#who" },
            ...(ingredientInfo ? [{ label: "全成分", target: "#ingredients" }] : []),
            ...(coMentioned.length > 0 ? [{ label: "一緒に紹介", target: "#paired" }] : []),
            ...(facts.mainTag && categoryTop.length > 0 ? [{ label: "ランキング", target: "#ranking" }] : []),
            ...(brandTop.length > 0 ? [{ label: "同じブランド", target: "#brand-top" }] : []),
          ]}
        />

        {/* ===== 01 いつ・誰が紹介したか ===== */}
        <section id="who" class="panel mt-6 md:mt-8">
          <SectionHead
            num="01"
            en="Featured by"
            title="いつ・誰が紹介したか"
            lead={`${facts.introductions.length}件の紹介${concernIntroCount > 0 ? `（うち肌悩みに触れた紹介${concernIntroCount}件）` : ""}。●の数は投稿者の発信力（登録者数・掲載動画数・紹介コスメ数から算出したスコアの順位。上位5％・20％・40％・70％で5段階）です。`}
          />
          {/* 紹介した人のパーソナルカラー・肌質で、下の一覧を絞り込む（本人が言ったもの。311・312章）。スクリプトなしでは各ページへのリンク */}
          {profileSummary.length > 0 && (
            <div class="mb-4" data-prof-filter>
              <p class="flex flex-wrap items-center gap-2 text-xs" role="group" aria-label="パーソナルカラー・肌質で絞り込む">
                <span class="label-caps text-neutral-500 mr-1">Who uses</span>
                {profileSummary.map((x) => (
                  <a href={withBase(x.href)} data-prof-key={x.key} data-prof-name={x.name} data-prof-href={withBase(x.href)} aria-pressed="false" class="prof-chip inline-flex items-center gap-1.5 rounded-full border border-ink/15 bg-white/80 px-2.5 py-1 text-neutral-700 hover:border-rose hover:text-rose transition-colors aria-pressed:bg-ink aria-pressed:text-paper aria-pressed:border-ink">
                    {x.kind === "pc" && x.swatch && <span class="inline-block w-3 h-3 rounded-full ring-1 ring-white/60" style={`background:conic-gradient(${x.swatch.map((c, i) => `${c} ${(i * 360) / x.swatch!.length}deg ${((i + 1) * 360) / x.swatch!.length}deg`).join(", ")})`} aria-hidden="true" />}
                    {x.kind === "skin" && <svg viewBox="0 0 12 12" class="w-3 h-3 text-rose" aria-hidden="true"><path d="M6 1.2C6 1.2 2.6 5 2.6 7.3A3.4 3.4 0 0 0 9.4 7.3C9.4 5 6 1.2 6 1.2Z" fill="currentColor" opacity=".75" /></svg>}
                    {x.name}<span class="opacity-70">{x.count}人</span>
                  </a>
                ))}
              </p>
              <p class="mt-2 text-xs text-neutral-500" data-prof-status>押すと、その人たちの紹介だけに絞り込めます（本人がパーソナルカラー・肌質を話している人）。</p>
            </div>
          )}
          {/* 並び替え（スクリプトで行う。スクリプトなしでは新しい順の先頭20件だけ） */}
          {facts.introductions.length > 1 && (
            <div class="flex flex-wrap items-center gap-2 text-xs mb-2" role="group" aria-label="並び替え">
              <span class="label-caps text-neutral-500 mr-1">Sort</span>
              <button type="button" class="intro-sort chip is-active" data-sort="date">新しい順</button>
              <button type="button" class="intro-sort chip" data-sort="views">再生数順</button>
              <button type="button" class="intro-sort chip" data-sort="subs">発信力順</button>
            </div>
          )}
          {/* 日付・チャンネル・動画タイトルを固定の列にする。件数が多い商品は、先頭20件だけ表示して残りは「残りを表示」で出す */}
          <div class="text-sm">
            <ul id="intro-list" data-initial={INTRO_SHOWN} data-rest={introSplit ? withBase(`/cosmetics/${cosmeticSlug(brand_id, name_id)}/intros/`) : undefined}>
              {introRows.map((i, k) => <IntroRow i={i} pos={k} concernPages={concernPages} extra={k >= INTRO_SHOWN} />)}
            </ul>
            {facts.introductions.length > INTRO_SHOWN && (
              <button type="button" id="intro-more" class="w-full flex items-center justify-center gap-3 py-5 text-xs tracking-[0.1em] cursor-pointer select-none hover:text-rose">
                <span>残り{facts.introductions.length - INTRO_SHOWN}件を表示</span><span class="w-7 h-7 rounded-full border border-ink/20 flex items-center justify-center" aria-hidden="true">↓</span>
              </button>
            )}
          </div>
        </section>

        {ingredientInfo && (
          <section id="ingredients" class="panel u-14">
            <SectionHead en="Ingredients" title="全成分" lead={`${ingredientSourceLabel(ingredientInfo)}に掲載されている全成分の表示です。改良などで変わることがあるため、購入の際は商品の表示をご確認ください。`} />
            <div class="text-sm leading-relaxed text-neutral-700 space-y-2 [overflow-wrap:anywhere]">
              {ingredientInfo.active.length > 0 ? (
                <>
                  <p><span class="label-caps text-neutral-500 mr-2">有効成分</span>{ingredientInfo.active.join("、")}</p>
                  <p><span class="label-caps text-neutral-500 mr-2">その他の成分</span>{otherItems.join("、")}</p>
                </>
              ) : (
                <p>{ingredientInfo.items.join("、")}</p>
              )}
              <p class="u-11">
                出典：<a href={ingredientInfo.url} target="_blank" rel="nofollow noopener" class="link-u">{ingredientSourceLabel(ingredientInfo)}</a>
              </p>
            </div>
            {ingredientPages.length > 0 && (
              <p class="mt-5 flex flex-wrap gap-2 text-xs">
                <span class="text-neutral-500 mr-1 self-center">成分から探す：</span>
                {ingredientPages.map((p) => (
                  <a href={withBase(`/ingredient/${p.def.slug}/`)} class="text-rose border border-rose/40 rounded-full px-2 py-0.5 hover:bg-rose hover:text-white transition-colors">{p.def.name}</a>
                ))}
              </p>
            )}
          </section>
        )}

        {coMentioned.length > 0 && (
          <section id="paired" class="panel u-14">
            <SectionHead num="02" en="Featured together" title="一緒に紹介されているコスメ" lead={`${entry.name}を紹介した動画で、あわせて紹介されているコスメです。`} />
            <div class="item-6">
              {coMentioned.map((t) => <CosmeticTile tile={t} caption={`${t.together}本の動画で一緒に紹介`} />)}
            </div>
          </section>
        )}

        {facts.mainTag && categoryTop.length > 0 && (
          <section id="ranking" class="panel u-14">
            <SectionHead num="03" en="Ranking" title={`「${facts.mainTag}」の人気ランキング`} lead={`${facts.rankTotal}品中、この商品は${facts.rank}位です。`} href={categoryUrl(facts.mainTag)} cta={`All ${facts.rankTotal}`} />
            <div class="item-6">
              {categoryTop.map(({ rank, tile }) => (
                <CosmeticTile tile={tile} rank={rank} caption={`${tile.videoCount}本の動画で紹介`} current={tile.brand_id === brand_id && tile.name_id === name_id} />
              ))}
            </div>
          </section>
        )}

        {brandTop.length > 0 && (
          <section id="brand-top" class="panel u-14">
            <SectionHead num="04" en="From the brand" title={`${entry.brand}の人気商品`} lead={`${entry.brand}の商品のうち、紹介されている動画が多いものです。`} href={withBase(`/brand/${canonicalBrandId(entry.brand_id)}`)} />
            <div class="item-6">
              {brandTop.map((t) => <CosmeticTile tile={t} showBrand={false} caption={`${t.videoCount}本の動画で紹介`} />)}
            </div>
          </section>
        )}
      </>
    )
  }
</Layout>

<script>
  // マイコスメの「使っている」「気になる」に入れる・外す（5-4。保存はこの端末のブラウザだけ。同じ商品は片方にだけ入る）
  import { has, add, remove, onChange, type ListKind } from "../../scripts/my-cosme-store";
  const myBox = document.querySelector<HTMLElement>("[data-mycosme]");
  if (myBox) {
    const slug = myBox.dataset.slug!;
    const btns = Array.from(myBox.querySelectorAll<HTMLButtonElement>("[data-mycosme-toggle]"));
    const LABEL: Record<ListKind, [string, string]> = { items: ["使っている", "使っている（登録済み）"], wish: ["気になる", "気になる（登録済み）"] };
    const paint = () => {
      for (const b of btns) {
        const kind = b.dataset.mycosmeToggle as ListKind;
        const on = has(slug, kind);
        b.setAttribute("aria-pressed", String(on));
        b.querySelector("[data-label]")!.textContent = LABEL[kind][on ? 1 : 0];
      }
    };
    for (const b of btns) {
      b.addEventListener("click", () => {
        const kind = b.dataset.mycosmeToggle as ListKind;
        const on = has(slug, kind);
        const ok = on ? remove(slug, kind) : add(slug, myBox.dataset.name, kind);
        if (!ok) b.querySelector("[data-label]")!.textContent = "このブラウザでは保存できません";
        else paint();
        const g = (window as unknown as { gtag?: (...a: unknown[]) => void }).gtag;
        if (typeof g === "function") g("event", "my_cosme", { action: `${kind === "wish" ? "wish_" : ""}${on ? "remove" : "add"}` }); // どの商品かは送らない
      });
    }
    onChange(paint);
    paint();
    myBox.hidden = false;
  }

  // 「いつ・誰が紹介したか」の並び替え（新しい順・再生数順・発信力順）と「残りを表示」（228章）。
  // 紹介の多い商品は、ページには先頭の行だけがあり、残りは data-rest のファイルにある。押したときに一度だけ読んで差し込む（279章）
  const introList = document.getElementById("intro-list");
  if (introList) {
    const rows = Array.from(introList.querySelectorAll<HTMLLIElement>(".intro-row"));
    const INITIAL = Number(introList.dataset.initial);
    const restUrl = introList.dataset.rest;
    const more = document.getElementById("intro-more");
    let all = false;
    let key = "date";
    let loading: Promise<void> | undefined;
    const loadRest = () =>
      (loading ??= restUrl
        ? fetch(restUrl)
            .then((r) => (r.ok ? r.text() : Promise.reject(r.status)))
            .then((html) => {
              const doc = new DOMParser().parseFromString(html, "text/html");
              doc.querySelectorAll<HTMLLIElement>(".intro-row").forEach((li) => rows.push(document.importNode(li, true)));
            })
            .catch(() => { loading = undefined; })
        : Promise.resolve());
    const n = (li: HTMLLIElement, k: string) => Number(li.dataset[k]);
    const cmp: Record<string, (a: HTMLLIElement, b: HTMLLIElement) => number> = {
      date: (a, b) => n(a, "pos") - n(b, "pos"),
      views: (a, b) => n(b, "views") - n(a, "views") || n(a, "pos") - n(b, "pos"),
      subs: (a, b) => n(b, "score") - n(a, "score") || n(b, "views") - n(a, "views") || n(a, "pos") - n(b, "pos"),
    };
    // パーソナルカラー・肌質の絞り込み（312章）。絞り込み中は、当てはまる行を全部出す（残りも読んでから）
    let prof = "";
    const status = document.querySelector<HTMLElement>("[data-prof-status]");
    const statusDefault = status?.textContent || "";
    const render = () => {
      let shown = 0;
      rows.sort(cmp[key]).forEach((li) => {
        introList.appendChild(li);
        const match = !prof || (li.dataset.prof || "").split(" ").includes(prof);
        li.hidden = !match || (!prof && !all && shown >= INITIAL);
        if (match) shown++;
      });
      document.querySelectorAll<HTMLButtonElement>(".intro-sort").forEach((b) => b.classList.toggle("is-active", b.dataset.sort === key));
      more?.classList.toggle("hidden", all || !!prof);
      document.querySelectorAll<HTMLElement>("[data-prof-key]").forEach((c) => c.setAttribute("aria-pressed", String(c.dataset.profKey === prof)));
      if (status) {
        const chip = document.querySelector<HTMLElement>(`[data-prof-key="${prof}"]`);
        if (prof && chip) {
          status.replaceChildren(`${chip.dataset.profName}の人の紹介 ${shown}件。もう一度押すと元に戻ります。`);
          const a = document.createElement("a");
          a.href = chip.dataset.profHref || "#";
          a.className = "link-u text-ink ml-2";
          a.textContent = `${chip.dataset.profName}のページを見る →`;
          status.append(a);
        } else status.textContent = statusDefault;
      }
    };
    document.querySelectorAll<HTMLAnchorElement>("[data-prof-key]").forEach((c) =>
      c.addEventListener("click", async (e) => {
        e.preventDefault();
        prof = prof === c.dataset.profKey ? "" : c.dataset.profKey || "";
        if (prof) await loadRest();
        render();
      })
    );
    document.querySelectorAll<HTMLButtonElement>(".intro-sort").forEach((b) =>
      b.addEventListener("click", async () => {
        key = b.dataset.sort || "date";
        // 再生数順・発信力順は全件で並べる必要があるので、残りを読んでから並べる
        if (key !== "date") await loadRest();
        render();
      })
    );
    more?.addEventListener("click", async () => {
      more.setAttribute("aria-busy", "true");
      await loadRest();
      more.removeAttribute("aria-busy");
      all = true;
      render();
    });
  }
</script>


<script>
  // 画像のURLはあっても実際に読み込めない場合（楽天側で画像が消えている）は、購入できないリンクの可能性が高いので、価格・購入ボタンを取り除く。
  // Yahoo!ショッピングの画像があれば、そちらの画像と価格に差し替える（115章）
  (function () {
    var box = document.querySelector("[data-item-image]");
    var img = box && box.querySelector("img");
    if (!img) return;
    function drop() {
      document.querySelectorAll("[data-buy]").forEach(function (e) { e.remove(); });
      var link = box.getAttribute("data-yahoo-link");
      var src = box.getAttribute("data-yahoo-image");
      if (!link || !src) return;
      var a = document.createElement("a");
      a.href = link; a.target = "_blank"; a.rel = "nofollow sponsored noopener";
      var y = document.createElement("img");
      y.src = src; y.alt = img.alt; y.width = 240; y.height = 240; y.className = "rounded object-contain";
      a.appendChild(y); box.replaceChildren(a);
      var p = document.querySelector("[data-yahoo-price]");
      if (p) p.hidden = false;
    }
    if (img.complete && img.naturalWidth === 0) drop();
    else img.addEventListener("error", drop);
  })();
</script>
