---
import Layout from "../../layouts/Layout.astro";
import VideoCard from "../../components/VideoCard.astro";
import CosmeticCard from "../../components/CosmeticCard.astro";
import IntroRow from "../../components/IntroRow.astro";
import {
  getUsedCosmeticKeys,
  getCosmeticListEntry,
  getVideosUsingCosmetic,
  getRelatedCosmetics,
  cosmeticSlug,
  sortByPublishedDesc,
  formatCount,
  withBase,
  getCosmeticFacts,
  formatJaDate,
  extractImageSrc,
  breadcrumbLd,
} from "../../lib/data";

export function getStaticPaths() {
  return getUsedCosmeticKeys().map(({ brand_id, name_id }) => ({
    params: { slug: cosmeticSlug(brand_id, name_id) },
    props: { brand_id, name_id },
  }));
}

const { brand_id, name_id } = Astro.props;

// cosmetics_list.json を正データとする（現行WordPressは動画反復順で最後に処理した値が勝つ
// 不安定な実装だったため、単一の正規ソースに統一）
const entry = getCosmeticListEntry(brand_id, name_id);
const videosUsing = sortByPublishedDesc(getVideosUsingCosmetic(brand_id, name_id));

const relatedTags = new Set<string>();
for (const v of videosUsing) {
  for (const c of v.cosmetics || []) {
    if (c.brand_id === brand_id && c.name_id === name_id) {
      for (const t of c.related_tags || []) relatedTags.add(t);
    }
  }
}
const facts = getCosmeticFacts(brand_id, name_id);
const related = getRelatedCosmetics(brand_id, name_id, Array.from(relatedTags)).slice(0, 8);

const INTRO_SHOWN = 10;
const introFirst = facts.introductions.slice(0, INTRO_SHOWN);
const introRest = facts.introductions.slice(INTRO_SHOWN);
const factSentence = entry
  ? `${entry.brand}「${entry.name}」は、YouTubeのコスメ紹介動画${facts.videoCount}本・インフルエンサー${facts.channelCount}人に紹介されています` +
    (facts.rank ? `。「${facts.mainTag}」カテゴリの人気ランキングでは${facts.rankTotal}品中${facts.rank}位です。` : "。")
  : "";
const firstIntro = facts.introductions[facts.introductions.length - 1];
const lastIntro = facts.introductions[0];
const description = entry
  ? factSentence + (firstIntro ? `最初の紹介は${formatJaDate(firstIntro.published_at)}、直近は${formatJaDate(lastIntro.published_at)}です。` : "")
  : undefined;
const imageSrc = extractImageSrc(entry?.rakuten_image_link);
const productLd = entry && {
  "@context": "https://schema.org",
  "@type": "Product",
  name: entry.name,
  brand: { "@type": "Brand", name: entry.brand },
  ...(entry.category ? { category: entry.category } : {}),
  ...(imageSrc ? { image: imageSrc } : {}),
  description,
};
const jsonLd = entry
  ? [
      productLd!,
      breadcrumbLd(
        [
          { name: "ホーム", path: "/" },
          { name: entry.brand, path: `/brand/${entry.brand_id}` },
          { name: entry.name, path: `/cosmetics/${cosmeticSlug(brand_id, name_id)}` },
        ],
        Astro.site!
      ),
    ]
  : [];
---

<Layout title={entry ? `${entry.brand} ${entry.name}` : "商品詳細"} description={description} image={imageSrc} jsonLd={jsonLd}>
  {
    !entry ? (
      <p class="text-neutral-400">商品情報が見つかりませんでした。</p>
    ) : (
      <>
        <div class="bg-white rounded-lg shadow-sm p-6 mb-8 flex flex-col md:flex-row gap-6">
          {entry.rakuten_image_link && (
            <div class="shrink-0 [&_img]:rounded" set:html={entry.rakuten_image_link} />
          )}
          <div>
            <a href={withBase(`/brand/${entry.brand_id}`)} class="text-sm text-pink-600 hover:underline">
              {entry.brand}
            </a>
            <h1 class="text-xl font-bold mt-1 mb-2">{entry.name}</h1>
            {entry.category && <p class="text-sm text-neutral-500 mb-1">カテゴリ: {entry.category}</p>}
            {entry.now_price !== undefined && (
              <p class="text-sm text-neutral-500 mb-3">参考価格: ¥{formatCount(entry.now_price)}</p>
            )}
            {entry.rakuten_text_link && (
              <a
                href={entry.rakuten_text_link}
                target="_blank"
                rel="nofollow sponsored noopener"
                class="inline-block bg-red-600 text-white text-sm px-4 py-2 rounded hover:bg-red-700"
              >
                楽天市場で見る
              </a>
            )}
          </div>
        </div>

        <!-- 紹介の実績：動画数・インフルエンサー数・ランキングの3要素。文章版は検索エンジン・読み上げ用に残す（sr-only） -->
        <p class="sr-only">{factSentence}</p>
        <div class:list={["grid gap-3 mb-8", facts.rank ? "grid-cols-3" : "grid-cols-2"]}>
          <div class="bg-white rounded-lg shadow-sm p-3 sm:p-4 text-center min-w-0">
            <p class="text-[11px] sm:text-xs text-neutral-500 whitespace-nowrap">紹介動画</p>
            <p class="mt-1 text-pink-600 font-bold leading-none"><span class="text-2xl sm:text-4xl">{facts.videoCount}</span><span class="text-xs sm:text-sm ml-0.5">本</span></p>
          </div>
          <div class="bg-white rounded-lg shadow-sm p-3 sm:p-4 text-center min-w-0">
            <p class="text-[11px] sm:text-xs text-neutral-500 whitespace-nowrap"><span class="sm:hidden">インフルエンサー</span><span class="hidden sm:inline">紹介インフルエンサー</span></p>
            <p class="mt-1 text-pink-600 font-bold leading-none"><span class="text-2xl sm:text-4xl">{facts.channelCount}</span><span class="text-xs sm:text-sm ml-0.5">人</span></p>
          </div>
          {facts.rank && (
            <a href={withBase(`/ranking#${encodeURIComponent(facts.mainTag!)}`)} class="bg-white rounded-lg shadow-sm p-3 sm:p-4 text-center min-w-0 hover:shadow-md block">
              <p class="text-[11px] sm:text-xs text-neutral-500 whitespace-nowrap">人気ランキング</p>
              <p class="mt-1 text-pink-600 font-bold leading-none"><span class="text-2xl sm:text-4xl">{facts.rank}</span><span class="text-xs sm:text-sm ml-0.5">位</span></p>
              <p class="mt-1.5 text-[10px] sm:text-xs text-neutral-500 truncate">{facts.mainTag} {facts.rankTotal}品中</p>
            </a>
          )}
        </div>

        <h2 class="font-bold mb-3">いつ・誰が紹介したか（{facts.introductions.length}件）</h2>
        <!-- 日付・チャンネル・動画タイトルを固定の列にして、長い名前やタイトルは1行で省略する（折り返しで見づらくならないように）。
             スマホは「日付＋チャンネル」の1行と、その下にタイトル（最大2行）。件数が多い商品は、先頭10件だけ表示して残りを折りたたむ -->
        <div class="mb-10 bg-white rounded-lg shadow-sm text-sm">
          <div class="hidden md:grid grid-cols-[8rem_14rem_minmax(0,1fr)] gap-x-4 px-4 py-2 text-xs text-neutral-400 border-b border-neutral-200">
            <span>紹介日</span><span>チャンネル</span><span>動画</span>
          </div>
          <ul class="divide-y divide-neutral-100">
            {introFirst.map((i) => <IntroRow i={i} />)}
          </ul>
          {introRest.length > 0 && (
            <details class="border-t border-neutral-200">
              <summary class="px-4 py-2.5 text-xs text-pink-600 cursor-pointer hover:bg-pink-50 select-none">残り{introRest.length}件を表示</summary>
              <ul class="divide-y divide-neutral-100 border-t border-neutral-200">
                {introRest.map((i) => <IntroRow i={i} />)}
              </ul>
            </details>
          )}
        </div>

        <h2 class="font-bold mb-3">この商品が紹介されている動画（{videosUsing.length}件）</h2>
        <div class="grid sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 mb-10">
          {videosUsing.map((v) => (
            <VideoCard video={v} />
          ))}
        </div>

        {related.length > 0 && (
          <>
            <h2 class="font-bold mb-3">関連商品</h2>
            <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3 sm:gap-4">
              {related.map((c) => (
                <CosmeticCard
                  brand_id={c.brand_id}
                  brand={c.brand}
                  name_id={c.name_id}
                  name={c.name}
                  rakutenImageHtml={c.rakuten_image_link}
                />
              ))}
            </div>
          </>
        )}
      </>
    )
  }
</Layout>
