---
import Layout from "../../layouts/Layout.astro";
import VideoCard from "../../components/VideoCard.astro";
import CosmeticCard from "../../components/CosmeticCard.astro";
import {
  getUsedCosmeticKeys,
  getCosmeticListEntry,
  getVideosUsingCosmetic,
  getRelatedCosmetics,
  cosmeticSlug,
  sortByPublishedDesc,
  formatCount,
  withBase,
  getCosmeticFacts,
  formatJaDate,
  extractImageSrc,
  breadcrumbLd,
} from "../../lib/data";

export function getStaticPaths() {
  return getUsedCosmeticKeys().map(({ brand_id, name_id }) => ({
    params: { slug: cosmeticSlug(brand_id, name_id) },
    props: { brand_id, name_id },
  }));
}

const { brand_id, name_id } = Astro.props;

// cosmetics_list.json を正データとする（現行WordPressは動画反復順で最後に処理した値が勝つ
// 不安定な実装だったため、単一の正規ソースに統一）
const entry = getCosmeticListEntry(brand_id, name_id);
const videosUsing = sortByPublishedDesc(getVideosUsingCosmetic(brand_id, name_id));

const relatedTags = new Set<string>();
for (const v of videosUsing) {
  for (const c of v.cosmetics || []) {
    if (c.brand_id === brand_id && c.name_id === name_id) {
      for (const t of c.related_tags || []) relatedTags.add(t);
    }
  }
}
const facts = getCosmeticFacts(brand_id, name_id);
const related = getRelatedCosmetics(brand_id, name_id, Array.from(relatedTags)).slice(0, 8);

const factSentence = entry
  ? `${entry.brand}「${entry.name}」は、YouTubeのコスメ紹介動画${facts.videoCount}本・インフルエンサー${facts.channelCount}人に紹介されています` +
    (facts.rank ? `。「${facts.mainTag}」カテゴリの人気ランキングでは${facts.rankTotal}品中${facts.rank}位です。` : "。")
  : "";
const firstIntro = facts.introductions[facts.introductions.length - 1];
const lastIntro = facts.introductions[0];
const description = entry
  ? factSentence + (firstIntro ? `最初の紹介は${formatJaDate(firstIntro.published_at)}、直近は${formatJaDate(lastIntro.published_at)}です。` : "")
  : undefined;
const imageSrc = extractImageSrc(entry?.rakuten_image_link);
const productLd = entry && {
  "@context": "https://schema.org",
  "@type": "Product",
  name: entry.name,
  brand: { "@type": "Brand", name: entry.brand },
  ...(entry.category ? { category: entry.category } : {}),
  ...(imageSrc ? { image: imageSrc } : {}),
  description,
};
const jsonLd = entry
  ? [
      productLd!,
      breadcrumbLd(
        [
          { name: "ホーム", path: "/" },
          { name: entry.brand, path: `/brand/${entry.brand_id}` },
          { name: entry.name, path: `/cosmetics/${cosmeticSlug(brand_id, name_id)}` },
        ],
        Astro.site!
      ),
    ]
  : [];
---

<Layout title={entry ? `${entry.brand} ${entry.name}` : "商品詳細"} description={description} image={imageSrc} jsonLd={jsonLd}>
  {
    !entry ? (
      <p class="text-neutral-400">商品情報が見つかりませんでした。</p>
    ) : (
      <>
        <div class="bg-white rounded-lg shadow-sm p-6 mb-8 flex flex-col md:flex-row gap-6">
          {entry.rakuten_image_link && (
            <div class="shrink-0 [&_img]:rounded" set:html={entry.rakuten_image_link} />
          )}
          <div>
            <a href={withBase(`/brand/${entry.brand_id}`)} class="text-sm text-pink-600 hover:underline">
              {entry.brand}
            </a>
            <h1 class="text-xl font-bold mt-1 mb-2">{entry.name}</h1>
            {entry.category && <p class="text-sm text-neutral-500 mb-1">カテゴリ: {entry.category}</p>}
            {entry.now_price !== undefined && (
              <p class="text-sm text-neutral-500 mb-3">参考価格: ¥{formatCount(entry.now_price)}</p>
            )}
            {entry.rakuten_text_link && (
              <a
                href={entry.rakuten_text_link}
                target="_blank"
                rel="nofollow sponsored noopener"
                class="inline-block bg-red-600 text-white text-sm px-4 py-2 rounded hover:bg-red-700"
              >
                楽天市場で見る
              </a>
            )}
          </div>
        </div>

        <p class="text-sm text-neutral-700 mb-8 bg-pink-50 rounded-lg p-4">{factSentence}</p>

        <h2 class="font-bold mb-3">いつ・誰が紹介したか</h2>
        <ul class="mb-10 text-sm divide-y bg-white rounded-lg shadow-sm">
          {facts.introductions.map((i) => (
            <li class="px-4 py-2 flex flex-wrap gap-x-4">
              <span class="text-neutral-500 w-32 shrink-0">{formatJaDate(i.published_at)}</span>
              <a href={withBase(`/influencer/${i.channel_id}`)} class="font-medium hover:text-pink-600">{i.channel_title}</a>
              <a href={withBase(`/video/${i.videoKey}`)} class="text-neutral-500 hover:text-pink-600 line-clamp-1">{i.videoTitle}</a>
            </li>
          ))}
        </ul>

        <h2 class="font-bold mb-3">この商品が紹介されている動画（{videosUsing.length}件）</h2>
        <div class="grid sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 mb-10">
          {videosUsing.map((v) => (
            <VideoCard video={v} />
          ))}
        </div>

        {related.length > 0 && (
          <>
            <h2 class="font-bold mb-3">関連商品</h2>
            <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3 sm:gap-4">
              {related.map((c) => (
                <CosmeticCard
                  brand_id={c.brand_id}
                  brand={c.brand}
                  name_id={c.name_id}
                  name={c.name}
                  rakutenImageHtml={c.rakuten_image_link}
                />
              ))}
            </div>
          </>
        )}
      </>
    )
  }
</Layout>
