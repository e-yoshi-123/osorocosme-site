---
import Layout from "../../layouts/Layout.astro";
import ShareButtons from "../../components/ShareButtons.astro";
import CosmeticTile from "../../components/CosmeticTile.astro";
import IntroRow from "../../components/IntroRow.astro";
import SectionHead from "../../components/SectionHead.astro";
import PageNav from "../../components/PageNav.astro";
import {
  getUsedCosmeticKeys,
  getAliasRedirects,
  canonicalBrandId,
  getCosmeticListEntry,
  getVideosUsingCosmetic,
  COSMETIC_INDEX_MIN_VIDEOS,
  getCoMentionedCosmetics,
  getCategoryTop,
  getBrandTopCosmetics,
  categoryUrl,
  cosmeticSlug,
  sortByPublishedDesc,
  formatCount,
  withBase,
  getCosmeticFacts,
  formatJaDate,
  extractImageSrc,
  breadcrumbLd,
  productCategoryPath,
  amazonSearchUrl,
  getPublishedConcerns,
} from "../../lib/data";

export function getStaticPaths() {
  return [
    ...getUsedCosmeticKeys().map(({ brand_id, name_id }) => ({
      params: { slug: cosmeticSlug(brand_id, name_id) },
      props: { brand_id, name_id, redirectTo: "" },
    })),
    // 二重登録ブランドの統合で、統合先の商品に寄せた商品の統合前のURLは、統合先の商品ページへ転送する
    ...getAliasRedirects().products.map((r) => ({
      params: { slug: r.from },
      props: { brand_id: "", name_id: "", redirectTo: r.to },
    })),
  ];
}

const { brand_id, name_id, redirectTo } = Astro.props;
if (redirectTo) return Astro.redirect(withBase(`/cosmetics/${redirectTo}`), 301);

// cosmetics_list.json を正データとする（現行WordPressは動画反復順で最後に処理した値が勝つ
// 不安定な実装だったため、単一の正規ソースに統一）
const entry = getCosmeticListEntry(brand_id, name_id);
const videosUsing = sortByPublishedDesc(getVideosUsingCosmetic(brand_id, name_id));
const noindex = videosUsing.length < COSMETIC_INDEX_MIN_VIDEOS;

const facts = getCosmeticFacts(brand_id, name_id);
// 画像の無い商品（＝楽天側に出品が無い・画像が消えている）は、購入できないリンクの可能性が高いので、価格・購入ボタンを出さない
const buyable = !!extractImageSrc(entry?.rakuten_image_link);
// 楽天の画像が無い商品で、Yahoo!ショッピングのリンクと画像があれば、Yahoo!の画像・価格を出す（115章）
const yahooFallback = !buyable && !!entry?.yahoo_text_link && !!entry?.yahoo_image_url;
// 楽天の画像はあるが実際には読み込めなかったとき、下のスクリプトがYahoo!の画像に差し替えるための値
const yahooSwap = buyable && entry?.yahoo_text_link && entry?.yahoo_image_url ? entry : undefined;
// ページ下部の「次に見たくなる」3要素：一緒に紹介されているコスメ／同じカテゴリの人気ランキング／同じブランドの人気商品
const coMentioned = getCoMentionedCosmetics(brand_id, name_id, 6);
const categoryTop = facts.mainTag ? getCategoryTop(facts.mainTag, 6) : [];
const brandTop = getBrandTopCosmetics(brand_id, name_id, 6);

const INTRO_SHOWN = 10;
const concernPages = new Set(getPublishedConcerns().map((c) => c.slug));
const concernIntroCount = facts.introductions.filter((i) => i.concerns.length > 0).length;
const factSentence = entry
  ? `${entry.brand}「${entry.name}」は、YouTubeのコスメ紹介動画${facts.videoCount}本・インフルエンサー${facts.channelCount}人に紹介されています` +
    (facts.rank ? `。「${facts.mainTag}」カテゴリの人気ランキングでは${facts.rankTotal}品中${facts.rank}位です。` : "。")
  : "";
const firstIntro = facts.introductions[facts.introductions.length - 1];
const lastIntro = facts.introductions[0];
const description = entry
  ? factSentence + (firstIntro ? `最初の紹介は${formatJaDate(firstIntro.published_at)}、直近は${formatJaDate(lastIntro.published_at)}です。` : "")
  : undefined;
const imageSrc = extractImageSrc(entry?.rakuten_image_link) || (yahooFallback ? entry?.yahoo_image_url : undefined);
// Googleの「商品スニペット」は、Productに offers / review / aggregateRating のいずれかが無いと重大な問題として扱われる（Search Consoleの指摘）。
// このサイトには、根拠のある口コミ・評価は無い（YouTubeの紹介は口コミではない）ので、偽って付けない。
// 同様に、offers.availability（在庫）・hasMerchantReturnPolicy（返品）・shippingDetails（配送）も、
// 実際の販売者は楽天市場の各ショップでありこのサイトは把握していないため、不正確な値を出さず付けない（いずれもGoogle側も任意項目）。
// 価格をページに出している商品（＝buyable かつ参考価格あり。ページの表示と一致させる）にだけ offers を付け、それ以外は Product を出さない。
const offerPrice = buyable
  ? (entry?.rakuten_text_link ? entry?.now_price : undefined)
  : yahooFallback ? entry?.yahoo_price : undefined;
const hasOffer = typeof offerPrice === "number" && offerPrice > 0;
const productLd =
  entry && hasOffer
    ? {
        "@context": "https://schema.org",
        "@type": "Product",
        name: entry.name,
        brand: { "@type": "Brand", name: entry.brand },
        // category はカテゴリ名単体だと「値が無効」と判定された（Search Consoleの指摘）ため、
        // 大分類を含む階層テキストにする（productCategoryPath）。
        ...(entry.category ? { category: productCategoryPath(entry.category) } : {}),
        ...(imageSrc ? { image: imageSrc } : {}),
        description,
        offers: { "@type": "Offer", price: offerPrice, priceCurrency: "JPY" },
      }
    : null;
const jsonLd = entry
  ? [
      ...(productLd ? [productLd] : []),
      breadcrumbLd(
        [
          { name: "ホーム", path: "/" },
          { name: entry.brand, path: `/brand/${canonicalBrandId(entry.brand_id)}` },
          { name: entry.name, path: `/cosmetics/${cosmeticSlug(brand_id, name_id)}` },
        ],
        Astro.site!
      ),
    ]
  : [];
---

<Layout title={entry ? `${entry.brand} ${entry.name}の紹介動画・使っている人` : "商品詳細"} description={description} image={imageSrc} jsonLd={jsonLd} noindex={noindex}>
  {
    !entry ? (
      <p class="text-neutral-400">商品情報が見つかりませんでした。</p>
    ) : (
      <>
        <!-- ===== 商品の表紙：左に額装した画像、右に名前・価格・購入ボタン ===== -->
        <nav class="mb-8 md:mb-12 flex items-center gap-2 text-xs text-neutral-500" aria-label="パンくず">
          <a href={withBase("/")} class="link-u">Home</a><span aria-hidden="true">/</span>
          {facts.mainTag ? <a href={categoryUrl(facts.mainTag)} class="link-u">{facts.mainTag}</a> : <span>{entry.category}</span>}
          <span aria-hidden="true">/</span><span class="truncate text-ink">{entry.name}</span>
        </nav>
        <div class="panel grid md:grid-cols-12 gap-8 md:gap-14 items-start">
          <div class="md:col-span-5 relative">
            <div class="product-well aspect-square rounded-[28px] flex items-center justify-center overflow-hidden">
              {entry.rakuten_image_link ? (
                <div
                  data-item-image
                  data-yahoo-link={yahooSwap?.yahoo_text_link}
                  data-yahoo-image={yahooSwap?.yahoo_image_url}
                  class="w-[82%] h-[82%] flex items-center justify-center [&_a]:flex [&_a]:items-center [&_a]:justify-center [&_a]:w-full [&_a]:h-full [&_img]:w-full [&_img]:h-full [&_img]:object-contain [&_img]:rounded-md"
                  set:html={entry.rakuten_image_link.replace(/(_ex=)\d+x\d+/g, "$1500x500")}
                />
              ) : yahooFallback ? (
                <a href={entry.yahoo_text_link} target="_blank" rel="nofollow sponsored noopener" class="w-[82%] h-[82%] flex items-center justify-center">
                  <img src={entry.yahoo_image_url} alt={`${entry.brand} ${entry.name}`} width="240" height="240" class="max-w-full max-h-full w-auto h-auto rounded-md object-contain" />
                </a>
              ) : (
                <span class="noimg">No image</span>
              )}
            </div>
            {facts.rank && facts.rank <= 10 && (
              <a href={categoryUrl(facts.mainTag!)} class="absolute -top-4 right-2 md:-right-5 w-20 h-20 md:w-24 md:h-24 rounded-full bg-ink text-paper flex flex-col items-center justify-center rotate-[8deg] shadow-xl hover:bg-rose transition-colors">
                <span class="label-caps text-[11px] text-paper/60">Ranking</span>
                <span class="num-display text-[22px] md:text-[26px] leading-none">No.{facts.rank}</span>
              </a>
            )}
          </div>

          <div class="md:col-span-7 md:pt-4">
            <a href={withBase(`/brand/${canonicalBrandId(entry.brand_id)}`)} class="link-u text-xs font-bold tracking-[0.14em] text-rose">{entry.brand}</a>
            <h1 class="mt-4 font-serif font-semibold phrase text-[24px] md:text-[26px] lg:text-[30px] leading-[1.3] tracking-[-0.02em] text-balance">{entry.name}</h1>
            {entry.category && <p class="mt-4 inline-flex items-center gap-2 text-xs text-neutral-600 border border-ink/15 rounded-full px-3 py-1">{entry.category}</p>}

            <div class="mt-8 pt-6 border-t border-ink/10">
              {buyable && entry.now_price !== undefined && (
                <p data-buy class="flex items-baseline gap-3"><span class="label-caps text-neutral-500">Price</span><span class="num-display text-[24px] leading-none">¥{formatCount(entry.now_price)}</span><span class="text-xs text-neutral-500"><span class="inline-block">楽天市場の参考価格</span>{entry.price_updated && <span class="inline-block">・{formatJaDate(entry.price_updated)}時点</span>}</span></p>
              )}
              {yahooFallback && entry.yahoo_price !== undefined && (
                <p class="flex items-baseline gap-3"><span class="label-caps text-neutral-500">Price</span><span class="num-display text-[24px] leading-none">¥{formatCount(entry.yahoo_price)}</span><span class="text-xs text-neutral-500"><span class="inline-block">Yahoo!ショッピングの参考価格</span>{entry.yahoo_price_updated && <span class="inline-block">・{formatJaDate(entry.yahoo_price_updated)}時点</span>}</span></p>
              )}
              {yahooSwap?.yahoo_price !== undefined && (
                <p data-yahoo-price hidden class="flex items-baseline gap-3"><span class="label-caps text-neutral-500">Price</span><span class="num-display text-[24px] leading-none">¥{formatCount(yahooSwap.yahoo_price)}</span><span class="text-xs text-neutral-500"><span class="inline-block">Yahoo!ショッピングの参考価格</span>{yahooSwap.yahoo_price_updated && <span class="inline-block">・{formatJaDate(yahooSwap.yahoo_price_updated)}時点</span>}</span></p>
              )}
              <!-- 楽天・Yahoo!ショッピング・Amazonのボタン（data-buy の扱いは従来どおり）。Amazonは検索結果へのリンクで、全商品に出す。3つとも同じ白い枠（206章） -->
              <div class="mt-6 flex flex-wrap gap-3">
                {buyable && entry.rakuten_text_link && (
                  <a data-buy href={entry.rakuten_text_link} target="_blank" rel="nofollow sponsored noopener" class="group inline-flex items-center gap-3 border border-ink/25 text-sm pl-6 pr-2 py-2 rounded-full hover:border-ink transition-colors duration-500">
                    楽天市場で見る<span class="w-8 h-8 rounded-full bg-ink/5 flex items-center justify-center transition-transform duration-500 group-hover:rotate-[-45deg]" aria-hidden="true">→</span>
                  </a>
                )}
                {entry.yahoo_text_link && (
                  <a href={entry.yahoo_text_link} target="_blank" rel="nofollow sponsored noopener" class="group inline-flex items-center gap-3 border border-ink/25 text-sm pl-6 pr-2 py-2 rounded-full hover:border-ink transition-colors duration-500">
                    Yahoo!ショッピングで見る<span class="w-8 h-8 rounded-full bg-ink/5 flex items-center justify-center transition-transform duration-500 group-hover:rotate-[-45deg]" aria-hidden="true">→</span>
                  </a>
                )}
                <a href={amazonSearchUrl(entry.brand, entry.name)} target="_blank" rel="nofollow sponsored noopener" class="group inline-flex items-center gap-3 border border-ink/25 text-sm pl-6 pr-2 py-2 rounded-full hover:border-ink transition-colors duration-500">
                  Amazonで探す<span class="w-8 h-8 rounded-full bg-ink/5 flex items-center justify-center transition-transform duration-500 group-hover:rotate-[-45deg]" aria-hidden="true">→</span>
                </a>
              </div>
              <p class="mt-3 text-xs text-neutral-400">PR：リンク先での購入により、当サイトに報酬が支払われることがあります。</p>
            </div>

            <!-- 紹介の実績：動画数・インフルエンサー数・ランキング。文章版は検索エンジン・読み上げ用に残す（sr-only） -->
            <p class="sr-only">{factSentence}</p>
            <dl class:list={["mt-8 grid border-y border-ink/15 divide-x divide-ink/15 [&>*]:flex [&>*]:flex-col [&>*]:justify-between", facts.rank ? "grid-cols-3" : "grid-cols-2"]}>
              <div class="py-5 pr-3">
                <dt class="text-xs text-neutral-500">紹介動画</dt>
                <dd class="mt-1 num-display text-[26px] lg:text-[30px] leading-none whitespace-nowrap">{facts.videoCount}<span class="font-sans text-xs ml-1 text-neutral-500">本</span></dd>
              </div>
              <div class="py-5 px-3 md:px-5">
                <dt class="text-xs text-neutral-500">紹介した人</dt>
                <dd class="mt-1 num-display text-[26px] lg:text-[30px] leading-none whitespace-nowrap">{facts.channelCount}<span class="font-sans text-xs ml-1 text-neutral-500">人</span></dd>
              </div>
              {facts.rank && (
                <a href={categoryUrl(facts.mainTag!)} class="group py-5 px-3 md:px-5">
                  <dt class="text-xs text-neutral-500 leading-snug line-clamp-2">{facts.mainTag}</dt>
                  <dd class="mt-1 num-display text-[26px] lg:text-[30px] leading-none whitespace-nowrap group-hover:text-rose transition-colors"><span class="text-rose">{facts.rank}</span><span class="font-sans text-xs ml-1 text-neutral-500">位<span class="text-neutral-400"> / {facts.rankTotal}品</span></span></dd>
                </a>
              )}
            </dl>
            {facts.prCount > 0 && <p class="mt-3 text-xs leading-relaxed text-neutral-500">うち{facts.prCount}本はPR・提供の紹介のため、ランキングには数えていません。</p>}
            {(() => {
              const seen = new Set<string>();
              const faces = facts.introductions.filter((i) => i.channel_icon && !seen.has(i.channel_id) && seen.add(i.channel_id)).slice(0, 8);
              return faces.length > 0 && (
                <div class="mt-6 flex flex-col sm:flex-row sm:items-center gap-2.5 sm:gap-4">
                  <div class="flex -space-x-3">
                    {faces.map((f) => (
                      <a href={withBase(`/influencer/${f.channel_id}`)} title={f.channel_title} class="relative hover:z-10 transition-transform duration-500 hover:-translate-y-1">
                        <img referrerpolicy="no-referrer" src={f.channel_icon} alt={f.channel_title} width="40" height="40" class="w-10 h-10 rounded-full ring-[3px] ring-paper" loading="lazy" />
                      </a>
                    ))}
                  </div>
                  <p class="text-xs text-neutral-600 leading-relaxed">{faces[0].channel_title}さんほか、{facts.channelCount}人が紹介</p>
                </div>
              );
            })()}
            <ShareButtons text={`${entry.brand}「${entry.name}」を紹介しているYouTube動画${facts.videoCount}本・インフルエンサー${facts.channelCount}人`} class="mt-8" />
          </div>
        </div>

        <!-- スマホで縦に長くなるので、各セクションへ飛べる目次の帯を固定で出す -->
        <PageNav
          class="mt-6 md:mt-8"
          items={[
            { label: `紹介した人 ${facts.introductions.length}`, target: "#who" },
            ...(coMentioned.length > 0 ? [{ label: "一緒に紹介", target: "#paired" }] : []),
            ...(facts.mainTag && categoryTop.length > 0 ? [{ label: "ランキング", target: "#ranking" }] : []),
            ...(brandTop.length > 0 ? [{ label: "同じブランド", target: "#brand-top" }] : []),
          ]}
        />

        <!-- ===== 01 いつ・誰が紹介したか ===== -->
        <section id="who" class="panel mt-6 md:mt-8">
          <SectionHead
            num="01"
            en="Who used it"
            title="いつ・誰が紹介したか"
            lead={`${facts.introductions.length}件の紹介${concernIntroCount > 0 ? `（うち肌悩みに触れた紹介${concernIntroCount}件）` : ""}。●の数は投稿者の発信力（登録者数・掲載動画数・紹介コスメ数から算出したスコアの順位。上位5％・20％・40％・70％で5段階）です。`}
          />
          <!-- 並び替え（スクリプトで行う。スクリプトなしでは新しい順の先頭10件だけ） -->
          {facts.introductions.length > 1 && (
            <div class="flex flex-wrap items-center gap-2 text-xs mb-2" role="group" aria-label="並び替え">
              <span class="label-caps text-neutral-500 mr-1">Sort</span>
              <button type="button" class="intro-sort chip is-active" data-sort="date">新しい順</button>
              <button type="button" class="intro-sort chip" data-sort="views">再生数順</button>
              <button type="button" class="intro-sort chip" data-sort="subs">発信力順</button>
            </div>
          )}
          <!-- 日付・チャンネル・動画タイトルを固定の列にする。件数が多い商品は、先頭10件だけ表示して残りは「残りを表示」で出す -->
          <div class="text-sm">
            <ul id="intro-list" data-initial={INTRO_SHOWN}>
              {facts.introductions.map((i, k) => <IntroRow i={i} pos={k} concernPages={concernPages} extra={k >= INTRO_SHOWN} />)}
            </ul>
            {facts.introductions.length > INTRO_SHOWN && (
              <button type="button" id="intro-more" class="w-full flex items-center justify-center gap-3 py-5 text-xs tracking-[0.1em] cursor-pointer select-none hover:text-rose">
                <span>残り{facts.introductions.length - INTRO_SHOWN}件を表示</span><span class="w-7 h-7 rounded-full border border-ink/20 flex items-center justify-center" aria-hidden="true">↓</span>
              </button>
            )}
          </div>
        </section>

        {coMentioned.length > 0 && (
          <section id="paired" class="panel mt-8 md:mt-10">
            <SectionHead num="02" en="Paired with" title="一緒に紹介されているコスメ" lead={`${entry.name}を紹介した動画で、あわせて紹介されているコスメです。`} />
            <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-x-4 gap-y-8">
              {coMentioned.map((t) => <CosmeticTile tile={t} caption={`${t.together}本の動画で一緒に紹介`} />)}
            </div>
          </section>
        )}

        {facts.mainTag && categoryTop.length > 0 && (
          <section id="ranking" class="panel mt-8 md:mt-10">
            <SectionHead num="03" en="Ranking" title={`「${facts.mainTag}」の人気ランキング`} lead={`${facts.rankTotal}品中、この商品は${facts.rank}位です。`} href={categoryUrl(facts.mainTag)} cta={`All ${facts.rankTotal}`} />
            <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-x-4 gap-y-8">
              {categoryTop.map(({ rank, tile }) => (
                <CosmeticTile tile={tile} rank={rank} caption={`${tile.videoCount}本の動画で紹介`} current={tile.brand_id === brand_id && tile.name_id === name_id} />
              ))}
            </div>
          </section>
        )}

        {brandTop.length > 0 && (
          <section id="brand-top" class="panel mt-8 md:mt-10">
            <SectionHead num="04" en="From the brand" title={`${entry.brand}の人気商品`} lead={`${entry.brand}の商品のうち、紹介されている動画が多いものです。`} href={withBase(`/brand/${canonicalBrandId(entry.brand_id)}`)} />
            <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-x-4 gap-y-8">
              {brandTop.map((t) => <CosmeticTile tile={t} showBrand={false} caption={`${t.videoCount}本の動画で紹介`} />)}
            </div>
          </section>
        )}
      </>
    )
  }
</Layout>

<script>
  // 「いつ・誰が紹介したか」の並び替え（新しい順・再生数順・発信力順）と「残りを表示」（228章）
  const introList = document.getElementById("intro-list");
  if (introList) {
    const rows = Array.from(introList.querySelectorAll<HTMLLIElement>(".intro-row"));
    const INITIAL = Number(introList.dataset.initial);
    const more = document.getElementById("intro-more");
    let all = false;
    let key = "date";
    const n = (li: HTMLLIElement, k: string) => Number(li.dataset[k]);
    const cmp: Record<string, (a: HTMLLIElement, b: HTMLLIElement) => number> = {
      date: (a, b) => n(a, "pos") - n(b, "pos"),
      views: (a, b) => n(b, "views") - n(a, "views") || n(a, "pos") - n(b, "pos"),
      subs: (a, b) => n(b, "score") - n(a, "score") || n(b, "views") - n(a, "views") || n(a, "pos") - n(b, "pos"),
    };
    const render = () => {
      rows.sort(cmp[key]).forEach((li, i) => {
        introList.appendChild(li);
        li.hidden = !all && i >= INITIAL;
      });
      document.querySelectorAll<HTMLButtonElement>(".intro-sort").forEach((b) => b.classList.toggle("is-active", b.dataset.sort === key));
      more?.classList.toggle("hidden", all);
    };
    document.querySelectorAll<HTMLButtonElement>(".intro-sort").forEach((b) =>
      b.addEventListener("click", () => {
        key = b.dataset.sort || "date";
        render();
      })
    );
    more?.addEventListener("click", () => {
      all = true;
      render();
    });
  }
</script>


<script is:inline>
  // 画像のURLはあっても実際に読み込めない場合（楽天側で画像が消えている）は、購入できないリンクの可能性が高いので、価格・購入ボタンを取り除く。
  // Yahoo!ショッピングの画像があれば、そちらの画像と価格に差し替える（115章）
  (function () {
    var box = document.querySelector("[data-item-image]");
    var img = box && box.querySelector("img");
    if (!img) return;
    function drop() {
      document.querySelectorAll("[data-buy]").forEach(function (e) { e.remove(); });
      var link = box.getAttribute("data-yahoo-link");
      var src = box.getAttribute("data-yahoo-image");
      if (!link || !src) return;
      var a = document.createElement("a");
      a.href = link; a.target = "_blank"; a.rel = "nofollow sponsored noopener";
      var y = document.createElement("img");
      y.src = src; y.alt = img.alt; y.width = 240; y.height = 240; y.className = "rounded object-contain";
      a.appendChild(y); box.replaceChildren(a);
      var p = document.querySelector("[data-yahoo-price]");
      if (p) p.hidden = false;
    }
    if (img.complete && img.naturalWidth === 0) drop();
    else img.addEventListener("error", drop);
  })();
</script>
