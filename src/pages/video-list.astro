---
import Layout from "../layouts/Layout.astro";
import VideoCard from "../components/VideoCard.astro";
import PageHead from "../components/PageHead.astro";
import { getVisibleVideos, getVideoScore, formatCount } from "../lib/data";

const gallery = [...getVisibleVideos()].sort((a, b) => getVideoScore(b) - getVideoScore(a));
const PAGE_SIZE = 60;
---

<Layout
  title="コスメ紹介動画一覧"
  description={`YouTubeのコスメ紹介動画${gallery.length}本の一覧。新着順・人気順で探せます。`}
>
  <PageHead en="Videos" title="動画一覧" lead="コスメを紹介しているYouTube動画です。新着順・人気順で並べ替えられます。" stats={[{ n: formatCount(gallery.length), label: "本" }]} />
  <div class="flex items-center justify-end gap-2 mb-8">
    <span class="label-caps text-neutral-500 mr-1">Sort</span>
    <button id="sort-newest" data-sort="newest" class="sort-btn chip">新着順</button>
    <button id="sort-popular" data-sort="popular" class="sort-btn chip is-active">人気順</button>
  </div>

  <div id="video-gallery" class="grid sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-x-6 gap-y-10 [&>*]:min-w-0">
    {
      gallery.map((v, i) => (
        <div
          class:list={["gallery-item", { hidden: i >= PAGE_SIZE }]}
          data-published={v.published_at}
          data-score={getVideoScore(v)}
        >
          <VideoCard video={v} />
        </div>
      ))
    }
  </div>

  <div class="text-center mt-8">
    <button id="load-more-btn" class="mt-4 px-8 py-3 rounded-full border border-ink/25 text-sm hover:bg-ink hover:text-paper transition-colors duration-500" data-page-size={PAGE_SIZE}>
      もっと見る
    </button>
  </div>
</Layout>

<script define:vars={{ PAGE_SIZE }}>
  // --- ギャラリー: 新着順/人気順の切り替え + もっと見る ---
  const gallery = document.getElementById("video-gallery");
  const loadMoreBtn = document.getElementById("load-more-btn");
  let currentSort = "popular";

  function applySort(sort) {
    currentSort = sort;
    const items = Array.from(gallery.querySelectorAll(".gallery-item"));
    items.sort((a, b) => {
      if (sort === "popular") {
        return parseFloat(b.dataset.score) - parseFloat(a.dataset.score);
      }
      return new Date(b.dataset.published).getTime() - new Date(a.dataset.published).getTime();
    });
    items.forEach((item, i) => {
      gallery.appendChild(item);
      item.classList.toggle("hidden", i >= PAGE_SIZE);
    });
    if (loadMoreBtn) loadMoreBtn.classList.toggle("hidden", items.length <= PAGE_SIZE);

    document.querySelectorAll(".sort-btn").forEach((btn) => {
      const active = btn.dataset.sort === sort;
      btn.classList.toggle("is-active", active);
    });
  }

  document.querySelectorAll(".sort-btn").forEach((btn) => {
    btn.addEventListener("click", () => applySort(btn.dataset.sort));
  });

  if (loadMoreBtn) {
    loadMoreBtn.addEventListener("click", () => {
      const hidden = gallery.querySelectorAll(".gallery-item.hidden");
      Array.from(hidden)
        .slice(0, PAGE_SIZE)
        .forEach((item) => item.classList.remove("hidden"));
      if (gallery.querySelectorAll(".gallery-item.hidden").length === 0) {
        loadMoreBtn.classList.add("hidden");
      }
    });
  }
</script>
