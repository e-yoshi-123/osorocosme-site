---
import Layout from "../layouts/Layout.astro";
import { withBase } from "../lib/data";
---

<Layout title="ページが見つかりません" noindex>
  <div class="text-center py-12 md:py-20">
    <p class="num-display text-rose text-[44px] md:text-[56px] leading-none">404</p>
    <h1 class="mt-5 font-serif font-semibold h-page">お探しのページが見つかりませんでした</h1>
    <p class="mt-4 text-sm text-neutral-600 mb-10">
      URLが間違っているか、ページが削除された可能性があります。
    </p>
    <div class="flex flex-wrap justify-center gap-3 text-sm">
      <a href={withBase("/")} class="!no-underline !text-paper inline-block bg-ink px-7 py-3.5 rounded-full text-sm tracking-[0.04em] hover:bg-rose transition-colors duration-500">
        トップページへ戻る
      </a>
      <a href={withBase("/ranking/")} class="inline-block px-7 py-3.5 rounded-full text-sm tracking-[0.04em] border border-ink/25 hover:border-ink transition-colors duration-500">
        ランキングを見る
      </a>
    </div>
    <p class="mt-8 text-sm">
      <a href={withBase("/brand-list")} class="link-u">ブランド一覧</a>
      <span class="text-neutral-300 mx-2">/</span>
      <a href={withBase("/influencer-list")} class="link-u">インフルエンサー一覧</a>
      <span class="text-neutral-300 mx-2">/</span>
      <a href={withBase("/video-list")} class="link-u">動画一覧</a>
    </p>
  </div>
</Layout>
