---
// 肌質の自己診断（314章）。洗顔後の肌の様子から分かれていくフローチャート。回答はブラウザの中だけで、どこにも送らない。
// 結果から、同じ肌質のインフルエンサーと愛用スキンケアのページ（/skin-type/<肌質>/）と、マイコスメへの設定につなぐ。
// 一般的な見分け方（洗顔後に何もつけずに待つ）をもとにした自前の文。効果・効能は書かない（薬機法）
import Layout from "../../layouts/Layout.astro";
import PageHead from "../../components/PageHead.astro";
import { getPublishedSkinTypes, getSkinType, withBase, breadcrumbLd } from "../../lib/data";

type Opt = { label: string; next?: string; set?: string };
const NODES: Record<string, { q: string; opts: Opt[] }> = {
  start: {
    q: "洗顔のあと、何もつけずに15分ほど待ちます。肌はどうなりましたか？",
    opts: [
      { label: "顔全体がつっぱる・カサつく", set: "乾燥肌", next: "sens" },
      { label: "おでこや鼻（Tゾーン）はテカるのに、頬はつっぱる", set: "混合肌", next: "sens" },
      { label: "顔全体がテカる・ベタつく", next: "oily" },
      { label: "特に気にならない", set: "普通肌", next: "sens" },
    ],
  },
  oily: {
    q: "テカるのに、肌の内側はつっぱる・ごわつく感じがありますか？",
    opts: [
      { label: "ある（表面は皮脂、内側は乾いている感じ）", set: "インナードライ", next: "sens" },
      { label: "ない", set: "脂性肌", next: "sens" },
    ],
  },
  sens: {
    q: "新しい化粧品を使ったときに、赤み・ピリピリ・かゆみが出やすいですか？",
    opts: [
      { label: "出やすい", set: "+敏感肌" },
      { label: "あまり出ない" },
    ],
  },
};
const TEXT: Record<string, string> = {
  乾燥肌: "皮脂も水分も少なめで、つっぱりやカサつきを感じやすい肌です。",
  混合肌: "Tゾーンは皮脂が出やすく、頬などは乾きやすい、部分によって違う肌です。",
  インナードライ: "表面は皮脂でテカるのに、内側は乾いている肌です。",
  脂性肌: "皮脂が出やすく、テカりやベタつきを感じやすい肌です。",
  普通肌: "皮脂と水分のバランスがとれていて、トラブルを感じにくい肌です。",
  敏感肌: "化粧品や季節の変わり目などで、赤み・ピリピリを感じやすい肌です。",
};
const pub = getPublishedSkinTypes();
const pages = Object.fromEntries(
  Object.keys(TEXT).map((k) => {
    const d = pub.find((x) => x.slug === k);
    return [k, d ? { href: withBase(`/skin-type/${encodeURIComponent(d.slug)}/`), people: getSkinType(d.slug)!.people.length, slug: d.slug } : null];
  }),
);
const title = "肌質自己診断（乾燥肌・脂性肌・混合肌・インナードライ・敏感肌）";
const description = "洗顔後の肌の様子から、乾燥肌・混合肌・脂性肌・インナードライ・普通肌と、敏感肌かどうかを自己診断できるフローチャート。結果から、同じ肌質だと本人が話しているYouTuber・インフルエンサーと、その人たちの愛用スキンケアを見られます。";
const crumbs = [
  { name: "ホーム", path: "/" },
  { name: "肌質から探す", path: "/skin-type/" },
  { name: "肌質自己診断", path: "/skin-type/check/" },
];
---

<Layout title={title} description={description} jsonLd={[breadcrumbLd(crumbs, Astro.site!)]}>
  <nav class="text-xs text-neutral-500 mb-8 flex flex-wrap gap-2" aria-label="パンくず">
    <a href={withBase("/")} class="link-u">Home</a><span aria-hidden="true">/</span>
    <a href={withBase("/skin-type/")} class="link-u">肌質から探す</a><span aria-hidden="true">/</span>
    <span>自己診断</span>
  </nav>
  <PageHead en="Self check" title="肌質自己診断" lead="洗顔後の肌の様子から、あなたの肌質を見分けます。結果から、同じ肌質のインフルエンサーが使っているスキンケア・ベースメイクを見られます。" />

  <div id="skin-check" class="panel max-w-2xl mx-auto" data-nodes={JSON.stringify(NODES)} data-text={JSON.stringify(TEXT)} data-pages={JSON.stringify(pages)}>
    <noscript><p class="text-sm text-neutral-600">診断にはJavaScriptが必要です。下のフローチャートを参考にしてください。</p></noscript>
    <div data-stage class="min-h-[16rem]"></div>
  </div>

  {/* 同じ分かれ道を図でも載せる（スクリプトなしでも読める） */}
  <section class="max-w-2xl mx-auto mt-10" aria-labelledby="skin-flow">
    <h2 id="skin-flow" class="font-serif h-section font-semibold mb-4">肌質のフローチャート</h2>
    <ol class="space-y-3 text-sm">
      <li class="rounded-2xl border border-ink/10 bg-white p-4">
        <p class="font-medium">① {NODES.start.q}</p>
        <ul class="mt-3 grid sm:grid-cols-2 gap-2">
          {NODES.start.opts.map((o) => (
            <li class="rounded-xl bg-paper px-3 py-2"><span class="text-neutral-700">{o.label}</span><span class="block mt-1 text-rose font-medium">→ {o.set ?? "②へ"}</span></li>
          ))}
        </ul>
      </li>
      <li class="rounded-2xl border border-ink/10 bg-white p-4">
        <p class="font-medium">② {NODES.oily.q}</p>
        <ul class="mt-3 grid sm:grid-cols-2 gap-2">
          {NODES.oily.opts.map((o) => (<li class="rounded-xl bg-paper px-3 py-2"><span class="text-neutral-700">{o.label}</span><span class="block mt-1 text-rose font-medium">→ {o.set}</span></li>))}
        </ul>
      </li>
      <li class="rounded-2xl border border-ink/10 bg-white p-4">
        <p class="font-medium">③ どの肌質でも：{NODES.sens.q}</p>
        <p class="mt-2 text-neutral-700">出やすいなら<span class="text-rose font-medium">敏感肌</span>も当てはまります（例：乾燥肌・敏感肌）。</p>
      </li>
    </ol>
    <p class="mt-4 text-xs text-neutral-500">この診断は目安です。肌の状態は季節や体調で変わります。肌トラブルが続くときは皮膚科に相談してください。回答はこの端末の中だけで使い、どこにも送りません。</p>
    <p class="mt-4 text-sm"><a href={withBase("/personal-color/check/")} class="link-u text-ink">パーソナルカラーの自己診断はこちら →</a></p>
  </section>
</Layout>

<script>
  import { add, load } from "../../scripts/my-cosme-store";
  type Opt = { label: string; next?: string; set?: string };
  type Node = { q: string; opts: Opt[] };
  type Page = { href: string; people: number; slug: string } | null;
  const root = document.getElementById("skin-check")!;
  const stage = root.querySelector<HTMLElement>("[data-stage]")!;
  const NODES = JSON.parse(root.dataset.nodes!) as Record<string, Node>;
  const TEXT = JSON.parse(root.dataset.text!) as Record<string, string>;
  const PAGES = JSON.parse(root.dataset.pages!) as Record<string, Page>;
  const BASE = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL.slice(0, -1) : import.meta.env.BASE_URL;
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);
  const track = (action: string) => {
    const g = (window as unknown as { gtag?: (...a: unknown[]) => void }).gtag;
    if (typeof g === "function") g("event", "self_check", { kind: "skin_type", action }); // どの結果かは送らない
  };
  let path: string[] = [];
  let picks: string[] = [];
  const drop = "<svg viewBox='0 0 24 24' style='width:22px;height:22px' aria-hidden='true'><path d='M12 2.5S5.5 9.6 5.5 14a6.5 6.5 0 0 0 13 0C18.5 9.6 12 2.5 12 2.5Z' fill='currentColor' opacity='.8'/></svg>";

  function show() {
    const id = path[path.length - 1];
    if (!id) return result();
    const n = NODES[id];
    const step = path.length;
    stage.innerHTML = `
      <p class="text-xs text-neutral-500">STEP ${step}</p>
      <h2 class="mt-3 font-serif text-xl md:text-2xl font-semibold leading-snug">${esc(n.q)}</h2>
      <div class="mt-6 grid gap-3">${n.opts.map((o, k) => `<button type="button" data-opt="${k}" class="text-left w-full rounded-2xl border border-ink/15 bg-white px-5 py-4 text-sm hover:border-rose hover:text-rose transition-colors cursor-pointer">${esc(o.label)}</button>`).join("")}</div>
      ${step > 1 ? `<button type="button" data-back class="mt-6 text-xs text-neutral-500 hover:text-ink cursor-pointer">← 1つ前に戻る</button>` : ""}`;
  }
  function result() {
    track("done");
    const sets = picks.map((s) => s.replace(/^\+/, ""));
    const mine = load().skin;
    const card = (k: string) => {
      const pg = PAGES[k];
      return `<div class="rounded-2xl border border-ink/10 bg-white p-5">
        <div class="flex items-center gap-3"><span class="rounded-full bg-blush text-rose flex items-center justify-center" style="width:44px;height:44px">${drop}</span>
          <h3 class="font-serif font-semibold" style="font-size:1.5rem">${esc(k)}</h3></div>
        <p class="mt-3 text-sm leading-relaxed text-neutral-700">${esc(TEXT[k] || "")}</p>
        ${pg ? `<a href="${pg.href}" class="mt-4 block rounded-xl bg-ink text-paper px-4 py-3 text-sm hover:bg-rose transition-colors">${esc(k)}のインフルエンサーと愛用スキンケアを見る →<span class="block text-xs opacity-70 mt-0.5">${pg.people}人のインフルエンサー</span></a>`
          : `<p class="mt-4 text-xs text-neutral-500">${esc(k)}だと話しているインフルエンサーはまだ少なく、ページはありません。<a href="${BASE}/skin-type/" class="link-u">ほかの肌質を見る →</a></p>`}
      </div>`;
    };
    const settable = sets.filter((k) => PAGES[k]);
    const done = settable.length > 0 && settable.every((k) => mine[PAGES[k]!.slug]);
    stage.innerHTML = `
      <p class="eyebrow">Result</p>
      <h2 class="mt-2 font-serif font-semibold" style="font-size:1.75rem;line-height:1.3">${sets.map(esc).join("・")}<span class="text-base font-normal text-neutral-500 ml-1">に近いかも</span></h2>
      <div class="mt-6 grid gap-3">${sets.map(card).join("")}</div>
      ${settable.length ? `<button type="button" data-set class="mt-4 w-full rounded-2xl border border-ink/20 px-5 py-4 text-sm text-left hover:border-rose hover:text-rose transition-colors cursor-pointer">${done ? "✓ マイコスメに設定済み" : `マイコスメの肌質に「${settable.map(esc).join("・")}」を入れる`}<span class="block text-xs text-neutral-500 mt-1">おすすめに反映されます（この端末に保存）</span></button>` : ""}
      <p class="mt-6 text-xs text-neutral-500">自己診断の目安です。肌の状態は季節や体調で変わります。</p>
      <button type="button" data-restart class="mt-6 text-xs text-neutral-500 hover:text-ink cursor-pointer">もう一度診断する</button>`;
    stage.querySelector("[data-set]")?.addEventListener("click", (e) => {
      for (const k of settable) add(PAGES[k]!.slug, undefined, "skin");
      track("set_my_cosme");
      (e.currentTarget as HTMLElement).innerHTML = `✓ マイコスメに設定しました<span class="block text-xs text-neutral-500 mt-1"><a href="${BASE}/my-cosme/" class="link-u">マイコスメでおすすめを見る →</a></span>`;
    });
  }
  root.addEventListener("click", (e) => {
    const t = e.target as HTMLElement;
    const opt = t.closest<HTMLElement>("[data-opt]");
    if (opt) {
      const o = NODES[path[path.length - 1]].opts[Number(opt.dataset.opt)];
      if (path.length === 1) track("start");
      if (o.set) picks.push(o.set);
      path.push(o.next ?? "");
      if (!o.next) { path.pop(); path.push(""); }
      return show();
    }
    if (t.closest("[data-back]")) {
      path.pop();
      // 戻った質問で付けた肌質を外す（その質問の選択肢の set のどれか）
      const n = NODES[path[path.length - 1]];
      const last = picks[picks.length - 1];
      if (last && n.opts.some((o) => o.set === last)) picks.pop();
      return show();
    }
    if (t.closest("[data-restart]")) {
      path = ["start"];
      picks = [];
      return show();
    }
  });
  path = ["start"];
  show();
</script>
