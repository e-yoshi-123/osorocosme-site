---
// 肌質の自己診断（314章、315章で作り直し）。洗顔後の肌の様子から分かれていくフローチャート。回答はブラウザの中だけで、どこにも送らない。
// 最初の質問は顔のイラストで選ぶ（つっぱる所はひびの線、テカる所は光の印）。結果は、同じ肌質だと本人が話しているインフルエンサーと、その人たちに人気のスキンケア。
// 下のフローチャートは図で載せ、診断が終わると、たどった道を色で示す。一般的な見分け方をもとにした自前の文で、効果・効能は書かない（薬機法）。
// 見た目はこのページの中のCSS（sk-。パーソナルカラーの診断の ck- と共通の考え方）
import Layout from "../../layouts/Layout.astro";
import { getPublishedSkinTypes, selfCheckExtras, withBase, breadcrumbLd } from "../../lib/data";

type Opt = { label: string; next?: string; set?: string; face?: "dry" | "mix" | "oily" | "calm" | "inner" | "red" | "ok" };
const NODES: Record<string, { q: string; hint: string; opts: Opt[] }> = {
  start: {
    q: "洗顔のあと、何もつけずに15分。肌はどうなりましたか？",
    hint: "いちばん近いものを選んでください",
    opts: [
      { label: "顔全体がつっぱる・カサつく", set: "乾燥肌", next: "sens", face: "dry" },
      { label: "Tゾーンはテカるのに、頬はつっぱる", set: "混合肌", next: "sens", face: "mix" },
      { label: "顔全体がテカる・ベタつく", next: "oily", face: "oily" },
      { label: "特に気にならない", set: "普通肌", next: "sens", face: "calm" },
    ],
  },
  oily: {
    q: "テカるのに、肌の内側はつっぱる・ごわつく感じがありますか？",
    hint: "夕方や、エアコンの効いた部屋で",
    opts: [
      { label: "ある（表面は皮脂、内側は乾いている感じ）", set: "インナードライ", next: "sens", face: "inner" },
      { label: "ない", set: "脂性肌", next: "sens", face: "oily" },
    ],
  },
  sens: {
    q: "新しい化粧品を使ったとき、赤み・ピリピリ・かゆみが出やすいですか？",
    hint: "季節の変わり目なども思い出して",
    opts: [
      { label: "出やすい", set: "+敏感肌", face: "red" },
      { label: "あまり出ない", face: "ok" },
    ],
  },
};
const TYPES: Record<string, { en: string; text: string; tone: string }> = {
  乾燥肌: { en: "Dry", text: "皮脂も水分も少なめで、つっぱりやカサつきを感じやすい肌です。", tone: "#F3D9C8" },
  混合肌: { en: "Combination", text: "Tゾーンは皮脂が出やすく、頬などは乾きやすい、部分によって違う肌です。", tone: "#E6DDF2" },
  インナードライ: { en: "Inner dry", text: "表面は皮脂でテカるのに、内側は乾いている肌です。", tone: "#D8ECEF" },
  // 脂性肌だと話す人は少なく肌質のページが無いので、肌悩みの「テカリ・化粧崩れ・脂性肌」へ案内する（338章）
  脂性肌: { en: "Oily", text: "皮脂が出やすく、テカりやベタつきを感じやすい肌です。", tone: "#F6EBC4", alt: { path: "/concern/oil/", label: "「脂性肌でも使える」「皮脂を抑える」と紹介されたコスメを見る" } },
  普通肌: { en: "Normal", text: "皮脂と水分のバランスがとれていて、トラブルを感じにくい肌です。", tone: "#E3EFDF" },
  敏感肌: { en: "Sensitive", text: "化粧品や季節の変わり目などで、赤み・ピリピリを感じやすい肌です。", tone: "#F8D9DF" },
};
const pub = getPublishedSkinTypes();
const pages = Object.fromEntries(
  Object.keys(TYPES).map((k) => {
    const d = pub.find((x) => x.slug === k);
    return [k, d ? { href: withBase(`/skin-type/${encodeURIComponent(d.slug)}/`), slug: d.slug, ...selfCheckExtras("skin", d.slug, 6) } : null];
  }),
);
const title = "肌質自己診断（乾燥肌・脂性肌・混合肌・インナードライ・敏感肌）";
const description = "洗顔後の肌の様子から、乾燥肌・混合肌・脂性肌・インナードライ・普通肌と、敏感肌かどうかを見分ける自己診断のフローチャート。結果では、同じ肌質だと本人が話しているYouTuber・インフルエンサーと、その人たちに人気のスキンケアが見られます。";
const crumbs = [
  { name: "ホーム", path: "/" },
  { name: "肌質から探す", path: "/skin-type/" },
  { name: "肌質自己診断", path: "/skin-type/check/" },
];
const pageUrl = new URL(withBase("/skin-type/check/"), Astro.site!).href;
---

<Layout title={title} description={description} jsonLd={[breadcrumbLd(crumbs, Astro.site!)]}>
  <nav class="text-xs text-neutral-500 mb-6 flex flex-wrap gap-2" aria-label="パンくず">
    <a href={withBase("/")} class="link-u">Home</a><span aria-hidden="true">/</span>
    <a href={withBase("/skin-type/")} class="link-u">肌質から探す</a><span aria-hidden="true">/</span>
    <span>自己診断</span>
  </nav>

  <section class="sk-hero" aria-labelledby="sk-title">
    <div class="sk-blobs" aria-hidden="true">
      <span style="--c:#BFE3EA;--x:6%;--y:12%;--d:0s"></span>
      <span style="--c:#F8D3DC;--x:70%;--y:6%;--d:-5s"></span>
      <span style="--c:#E6DDF2;--x:22%;--y:66%;--d:-9s"></span>
      <span style="--c:#F6EBC4;--x:78%;--y:62%;--d:-13s"></span>
    </div>
    <svg class="sk-drops" viewBox="0 0 400 400" aria-hidden="true">
      <path d="M90 60 C90 60 60 100 60 122 a30 30 0 0 0 60 0 C120 100 90 60 90 60Z" />
      <path d="M320 260 C320 260 300 286 300 300 a20 20 0 0 0 40 0 C340 286 320 260 320 260Z" />
      <path d="M250 70 C250 70 238 86 238 94 a12 12 0 0 0 24 0 C262 86 250 70 250 70Z" />
    </svg>
    <div class="sk-hero-in">
      <p class="sk-eyebrow">Skin type self check</p>
      <h1 id="sk-title" class="sk-h1">あなたの肌は、<br />どのタイプ？</h1>
      <p class="sk-lead">洗顔後の肌の様子から、乾燥肌・混合肌・脂性肌・インナードライ・普通肌と、敏感肌かどうかを見分けます。結果では、同じ肌質のインフルエンサーと、その人たちに人気のスキンケアも。</p>
      <p class="sk-meta"><span>3 steps</span><span>約30秒</span><span>回答は送信されません</span></p>
    </div>
    <div id="skin-check" class="sk-card" data-nodes={JSON.stringify(NODES)} data-types={JSON.stringify(TYPES)} data-pages={JSON.stringify(pages)} data-page-url={pageUrl}>
      <noscript><p class="sk-note">診断にはJavaScriptが必要です。下のフローチャートを参考にしてください。</p></noscript>
      <div data-stage class="sk-stage"></div>
    </div>
  </section>

  {/* フローチャート（スクリプトなしでも読める。診断が終わると、たどった道に色が付く） */}
  <section class="sk-flow-wrap" aria-labelledby="sk-flow">
    <p class="sk-eyebrow">Flowchart</p>
    <h2 id="sk-flow" class="sk-h2">肌質のフローチャート</h2>
    <div class="sk-flow" data-flow>
      <div class="sk-node q" data-node="start"><span class="sk-num">1</span>洗顔後、何もつけずに15分。肌は？</div>
      <div class="sk-branch">
        <div class="sk-col"><div class="sk-edge" data-edge="start-乾燥肌">全体がつっぱる</div><div class="sk-node r" data-res="乾燥肌"><img src={withBase("/images/skin-check/dry.webp")} alt="" width="345" height="360" class="sk-node-face" />乾燥肌</div></div>
        <div class="sk-col"><div class="sk-edge" data-edge="start-混合肌">Tゾーンだけテカる</div><div class="sk-node r" data-res="混合肌"><img src={withBase("/images/skin-check/mix.webp")} alt="" width="345" height="360" class="sk-node-face" />混合肌</div></div>
        <div class="sk-col"><div class="sk-edge" data-edge="start-oily">全体がテカる</div>
          <div class="sk-node q" data-node="oily"><span class="sk-num">2</span>内側はつっぱる？</div>
          <div class="sk-branch sub">
            <div class="sk-col"><div class="sk-edge" data-edge="oily-インナードライ">つっぱる</div><div class="sk-node r" data-res="インナードライ"><img src={withBase("/images/skin-check/inner.webp")} alt="" width="345" height="360" class="sk-node-face" />インナードライ</div></div>
            <div class="sk-col"><div class="sk-edge" data-edge="oily-脂性肌">つっぱらない</div><div class="sk-node r" data-res="脂性肌"><img src={withBase("/images/skin-check/oily.webp")} alt="" width="345" height="360" class="sk-node-face" />脂性肌</div></div>
          </div>
        </div>
        <div class="sk-col"><div class="sk-edge" data-edge="start-普通肌">気にならない</div><div class="sk-node r" data-res="普通肌"><img src={withBase("/images/skin-check/normal.webp")} alt="" width="345" height="360" class="sk-node-face" />普通肌</div></div>
      </div>
      <div class="sk-join" aria-hidden="true"></div>
      <div class="sk-node q" data-node="sens"><span class="sk-num">3</span>どの肌質でも：新しい化粧品で赤み・ピリピリが出やすい？</div>
      <div class="sk-branch two">
        <div class="sk-col"><div class="sk-edge" data-edge="sens-敏感肌">出やすい</div><div class="sk-node r" data-res="敏感肌"><img src={withBase("/images/skin-check/sensitive.webp")} alt="" width="345" height="360" class="sk-node-face" />＋ 敏感肌</div></div>
        <div class="sk-col"><div class="sk-edge" data-edge="sens-none">あまり出ない</div><div class="sk-node r muted" data-res="none">そのまま</div></div>
      </div>
    </div>
    <p class="sk-note mt">この診断は目安です。肌の状態は季節や体調で変わります。肌トラブルが続くときは皮膚科に相談してください。回答はこの端末の中だけで使い、どこにも送りません。顔のイラストは、イラストACの素材（作者：身爪さん）をもとにしています。</p>
    <p class="sk-cross"><a href={withBase("/personal-color/check/")}>パーソナルカラーの自己診断もする →</a></p>
  </section>
</Layout>

<style is:global>
  .sk-hero { position: relative; overflow: hidden; border-radius: 2rem; padding: clamp(1.5rem, 4vw, 3.5rem); background: linear-gradient(150deg, #f2fafb 0%, #fdf3f6 55%, #f7f3fb 100%); display: grid; gap: clamp(1.5rem, 4vw, 3rem); }
  @media (min-width: 1024px) { .sk-hero { grid-template-columns: 5fr 7fr; align-items: start; } .sk-hero-in { padding-top: 2.5rem; } }
  .sk-blobs { position: absolute; inset: 0; filter: blur(48px); opacity: .6; pointer-events: none; }
  .sk-blobs span { position: absolute; left: var(--x); top: var(--y); width: 32vmax; height: 32vmax; max-width: 400px; max-height: 400px; border-radius: 50%; background: var(--c); animation: sk-float 24s ease-in-out infinite; animation-delay: var(--d); }
  @keyframes sk-float { 0%, 100% { transform: translate(0, 0); } 50% { transform: translate(5%, -7%) scale(1.07); } }
  .sk-drops { position: absolute; right: 2%; top: 4%; width: min(46vw, 420px); fill: rgba(255,255,255,.55); pointer-events: none; }
  @media (prefers-reduced-motion: reduce) { .sk-blobs span { animation: none; } }
  .sk-hero-in, .sk-card { position: relative; }
  .sk-eyebrow { font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: var(--color-rose); font-weight: 600; }
  .sk-h1 { margin-top: .75rem; font-family: var(--font-serif, serif); font-weight: 600; font-size: clamp(2.1rem, 5.4vw, 3.6rem); line-height: 1.12; letter-spacing: -.02em; color: var(--color-ink); }
  .sk-lead { margin-top: 1.25rem; font-size: .9rem; line-height: 1.95; color: #4b4547; max-width: 30rem; }
  .sk-meta { margin-top: 1.25rem; display: flex; flex-wrap: wrap; gap: .5rem; }
  .sk-meta span { font-size: 11px; padding: .3rem .75rem; border-radius: 999px; background: rgba(255,255,255,.7); border: 1px solid rgba(0,0,0,.06); color: #555; }
  .sk-card { border-radius: 1.75rem; background: rgba(255,255,255,.8); backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px); border: 1px solid rgba(255,255,255,.9); box-shadow: 0 30px 60px -30px rgba(40, 70, 90, .35); padding: clamp(1.25rem, 3.5vw, 2.25rem); }
  .sk-stage { min-height: 24rem; }
  .sk-in { animation: sk-in .45s cubic-bezier(.2,.7,.2,1) both; }
  @keyframes sk-in { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .sk-in { animation: none; } }
  .sk-steps { display: flex; align-items: center; gap: .5rem; font-size: 11px; color: #8a8285; }
  .sk-steps i { width: 26px; height: 26px; border-radius: 50%; display: grid; place-items: center; font-style: normal; font-weight: 600; background: rgba(0,0,0,.06); color: #8a8285; }
  .sk-steps i.on { background: var(--color-rose); color: #fff; }
  .sk-steps b { flex: 0 0 22px; height: 2px; background: rgba(0,0,0,.1); }
  .sk-q { margin-top: 1.5rem; font-family: var(--font-serif, serif); font-weight: 600; font-size: clamp(1.25rem, 2.6vw, 1.6rem); line-height: 1.45; color: var(--color-ink); }
  .sk-hint { margin-top: .4rem; font-size: 12px; color: #8a8285; }
  .sk-opts { margin-top: 1.5rem; display: grid; gap: .75rem; }
  .sk-opts.faces { grid-template-columns: 1fr 1fr; }
  .sk-opt { display: flex; align-items: center; gap: 1rem; width: 100%; text-align: left; padding: 1rem 1.1rem; border-radius: 1.1rem; border: 1px solid rgba(0,0,0,.09); background: #fff; font-size: .9rem; color: var(--color-ink); cursor: pointer; transition: transform .2s, border-color .2s, box-shadow .2s; }
  .sk-opts.faces .sk-opt { flex-direction: column; text-align: center; gap: .6rem; padding: 1rem .75rem; font-size: .82rem; line-height: 1.5; }
  .sk-opt:hover, .sk-opt:focus-visible { transform: translateY(-2px); border-color: var(--color-rose); box-shadow: 0 12px 24px -16px rgba(200, 60, 110, .55); outline: none; }
  .sk-face { width: 64px; height: auto; aspect-ratio: 345 / 360; flex-shrink: 0; object-fit: contain; }
  .sk-opts.faces .sk-face { width: 104px; }
  .sk-back { margin-top: 1.5rem; font-size: 12px; color: #8a8285; cursor: pointer; background: none; border: 0; }
  .sk-back:hover { color: var(--color-ink); }
  /* 結果 */
  .sk-res-en { font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: var(--color-rose); font-weight: 600; }
  .sk-res-name { margin-top: .3rem; font-family: var(--font-serif, serif); font-weight: 600; font-size: clamp(2rem, 5.2vw, 3rem); line-height: 1.1; color: var(--color-ink); }
  .sk-res-name small { font-size: .95rem; font-weight: 400; color: #8a8285; margin-left: .4rem; }
  @media (max-width: 520px) { .sk-res-name small { display: block; margin: .3rem 0 0; } }
  .sk-types { margin-top: 1.25rem; display: grid; gap: .75rem; }
  .sk-type { border-radius: 1.25rem; padding: 1.1rem 1.2rem; background: linear-gradient(140deg, var(--t) 0%, #fff 75%); border: 1px solid rgba(0,0,0,.05); display: flex; gap: 1rem; align-items: flex-start; animation: sk-in .5s both; }
  .sk-type-face { flex-shrink: 0; width: 64px; height: auto; aspect-ratio: 345 / 360; border-radius: 1rem; background: rgba(255,255,255,.75); padding: 4px; }
  .sk-type h3 { font-family: var(--font-serif, serif); font-weight: 600; font-size: 1.35rem; color: var(--color-ink); }
  .sk-type h3 span { font-size: 10px; letter-spacing: .2em; text-transform: uppercase; color: #8a8285; margin-left: .5rem; font-family: inherit; font-weight: 500; }
  .sk-type p { margin-top: .35rem; font-size: .85rem; line-height: 1.8; color: #4b4547; }
  .sk-block { margin-top: 1.5rem; }
  .sk-block h4 { font-size: 11px; letter-spacing: .16em; text-transform: uppercase; color: #8a8285; font-weight: 600; margin-bottom: .7rem; }
  .sk-people { display: flex; flex-wrap: wrap; gap: .25rem; align-items: center; }
  .sk-people a img { width: 42px; height: 42px; border-radius: 50%; object-fit: cover; border: 3px solid #fff; box-shadow: 0 6px 14px -8px rgba(0,0,0,.5); transition: transform .2s; }
  .sk-people a:hover img { transform: translateY(-3px); }
  .sk-people span { font-size: 12px; color: #6b6366; margin-left: .5rem; }
  .sk-items { display: grid; grid-template-columns: repeat(3, 1fr); gap: .75rem; }
  .sk-item { display: block; border-radius: 1rem; background: #fff; border: 1px solid rgba(0,0,0,.06); padding: .6rem; transition: transform .2s, box-shadow .2s; }
  .sk-item:hover { transform: translateY(-3px); box-shadow: 0 14px 26px -18px rgba(0,0,0,.5); }
  .sk-item img { width: 100%; aspect-ratio: 1; object-fit: contain; border-radius: .7rem; background: #f6f8f8; }
  .sk-item b { display: block; margin-top: .45rem; font-size: 10px; color: var(--color-rose); font-weight: 600; }
  .sk-item span { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; font-size: 11px; line-height: 1.4; color: var(--color-ink); }
  .sk-item em { display: block; margin-top: .2rem; font-style: normal; font-size: 10px; color: #8a8285; }
  .sk-link { display: inline-block; margin-top: .9rem; font-size: 12px; color: var(--color-ink); text-decoration: underline; text-underline-offset: 4px; }
  .sk-none { margin-top: .7rem; font-size: 12px; color: #8a8285; }
  .sk-cta { margin-top: 1.5rem; display: grid; gap: .6rem; }
  .sk-btn { display: block; text-align: left; border-radius: 1.1rem; padding: 1rem 1.15rem; font-size: .88rem; cursor: pointer; transition: background .2s, color .2s, border-color .2s; background: #fff; border: 1px solid rgba(0,0,0,.14); color: var(--color-ink); }
  .sk-btn:hover { border-color: var(--color-rose); color: var(--color-rose); }
  .sk-btn-main { background: var(--color-ink); color: #fff; border-color: var(--color-ink); }
  .sk-btn-main:hover { background: var(--color-rose); border-color: var(--color-rose); color: #fff; }
  .sk-btn small { display: block; margin-top: .2rem; font-size: 11px; opacity: .7; }
  .sk-share { margin-top: 1.25rem; display: flex; flex-wrap: wrap; align-items: center; gap: .5rem; font-size: 12px; color: #8a8285; }
  .sk-share a, .sk-share button { font-size: 12px; padding: .35rem .85rem; border-radius: 999px; border: 1px solid rgba(0,0,0,.12); background: #fff; color: var(--color-ink); cursor: pointer; }
  .sk-share a:hover, .sk-share button:hover { border-color: var(--color-rose); color: var(--color-rose); }
  .sk-note { font-size: 11px; line-height: 1.8; color: #8a8285; }
  .sk-note.mt { margin-top: 1.5rem; }
  /* フローチャート */
  .sk-flow-wrap { margin-top: clamp(3rem, 7vw, 5rem); }
  .sk-h2 { margin-top: .5rem; font-family: var(--font-serif, serif); font-weight: 600; font-size: clamp(1.5rem, 3vw, 2rem); }
  .sk-flow { margin-top: 1.5rem; padding: clamp(1rem, 3vw, 2rem); border-radius: 1.75rem; background: #fff; border: 1px solid rgba(0,0,0,.06); display: flex; flex-direction: column; align-items: center; gap: 0; overflow-x: auto; }
  .sk-node { position: relative; border-radius: 1rem; padding: .7rem 1rem; font-size: .82rem; line-height: 1.5; text-align: center; transition: background .4s, color .4s, box-shadow .4s, border-color .4s; }
  .sk-node.q { background: #faf7f6; border: 1px solid rgba(0,0,0,.08); max-width: 26rem; display: flex; gap: .6rem; align-items: center; text-align: left; }
  .sk-num { flex-shrink: 0; width: 24px; height: 24px; border-radius: 50%; display: grid; place-items: center; background: var(--color-ink); color: #fff; font-size: 11px; font-weight: 600; }
  .sk-node.r { background: #fff; border: 1.5px solid rgba(0,0,0,.12); font-family: var(--font-serif, serif); font-weight: 600; font-size: .95rem; min-width: 6.5rem; }
  .sk-node-face { display: block; width: 44px; height: auto; margin: 0 auto .3rem; background: #fff; border-radius: .6rem; }
  .sk-node.r.muted { font-family: inherit; font-weight: 400; font-size: .8rem; color: #8a8285; border-style: dashed; }
  .sk-branch { display: grid; grid-template-columns: repeat(4, minmax(7.5rem, 1fr)); gap: .75rem; width: 100%; max-width: 54rem; position: relative; padding-top: 1.5rem; margin-top: .25rem; }
  .sk-branch::before { content: ""; position: absolute; top: .55rem; left: 12.5%; right: 12.5%; height: 2px; background: rgba(0,0,0,.12); }
  .sk-branch::after { content: ""; position: absolute; top: -.25rem; left: 50%; width: 2px; height: .8rem; background: rgba(0,0,0,.12); }
  .sk-branch.sub { grid-template-columns: 1fr 1fr; max-width: none; }
  .sk-branch.sub::before { left: 25%; right: 25%; }
  .sk-branch.two { grid-template-columns: 1fr 1fr; max-width: 26rem; }
  .sk-branch.two::before { left: 25%; right: 25%; }
  .sk-col { display: flex; flex-direction: column; align-items: center; gap: .4rem; position: relative; }
  .sk-col::before { content: ""; position: absolute; top: -.95rem; left: 50%; width: 2px; height: .95rem; background: rgba(0,0,0,.12); }
  .sk-edge { font-size: 11px; color: #6b6366; padding: .2rem .6rem; border-radius: 999px; background: #f6f2f1; transition: background .4s, color .4s; }
  .sk-join { width: 2px; height: 1.5rem; background: rgba(0,0,0,.12); margin: .5rem 0; }
  .sk-flow.done .sk-node, .sk-flow.done .sk-edge { opacity: .45; }
  .sk-flow .on { opacity: 1 !important; }
  .sk-node.r.on { background: var(--color-rose); border-color: var(--color-rose); color: #fff; box-shadow: 0 12px 24px -12px rgba(230, 0, 118, .6); }
  .sk-node.q.on { border-color: var(--color-rose); box-shadow: 0 0 0 3px rgba(230, 0, 118, .12); }
  .sk-edge.on { background: var(--color-rose); color: #fff; }
  @media (max-width: 720px) { .sk-branch { grid-template-columns: 1fr 1fr; } .sk-branch::before, .sk-branch::after, .sk-col::before { display: none; } .sk-branch { padding-top: .75rem; } }
  .sk-cross { margin-top: 1rem; font-size: .9rem; }
  .sk-cross a { color: var(--color-ink); text-decoration: underline; text-underline-offset: 4px; }
</style>

<script>
  import { add, load } from "../../scripts/my-cosme-store";
  type Opt = { label: string; next?: string; set?: string; face?: string };
  type Node = { q: string; hint: string; opts: Opt[] };
  type Page = { href: string; slug: string; people: { href: string; icon: string; name: string }[]; items: { href: string; img: string; brand: string; name: string; cat: string; users: number }[]; total: number } | null;
  const root = document.getElementById("skin-check")!;
  const stage = root.querySelector<HTMLElement>("[data-stage]")!;
  const flow = document.querySelector<HTMLElement>("[data-flow]");
  const NODES = JSON.parse(root.dataset.nodes!) as Record<string, Node>;
  const TYPES = JSON.parse(root.dataset.types!) as Record<string, { en: string; text: string; tone: string; alt?: { path: string; label: string } }>;
  const PAGES = JSON.parse(root.dataset.pages!) as Record<string, Page>;
  const PAGE_URL = root.dataset.pageUrl!;
  const BASE = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL.slice(0, -1) : import.meta.env.BASE_URL;
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);
  const track = (action: string) => {
    const g = (window as unknown as { gtag?: (...a: unknown[]) => void }).gtag;
    if (typeof g === "function") g("event", "self_check", { kind: "skin_type", action }); // どの結果かは送らない
  };
  const ORDER = ["start", "oily", "sens"];
  let path: string[] = ["start"];
  let chosen: { node: string; opt: Opt }[] = [];

  /** 顔のイラスト（イラストACの「肌タイプ4種」〈作者：身爪さん〉から切り出して加工したもの。316章） */
  const FACE_IMG: Record<string, string> = { dry: "dry", mix: "mix", oily: "oily", calm: "normal", inner: "inner", red: "sensitive", ok: "normal" };
  function face(kind?: string): string {
    if (!kind || !FACE_IMG[kind]) return "";
    return `<img class="sk-face" src="${BASE}/images/skin-check/${FACE_IMG[kind]}.webp" alt="" width="345" height="360" decoding="async">`;
  }
  const TYPE_IMG: Record<string, string> = { 乾燥肌: "dry", 混合肌: "mix", インナードライ: "inner", 脂性肌: "oily", 普通肌: "normal", 敏感肌: "sensitive" };

  function stepsBar(cur: string) {
    const idx = ORDER.indexOf(cur);
    return `<div class="sk-steps" aria-hidden="true">${ORDER.map((n, k) => {
      const done = chosen.some((c) => c.node === n) || n === cur;
      const skip = n === "oily" && !chosen.some((c) => c.node === "oily") && idx > 1;
      return `${k ? "<b></b>" : ""}<i class="${done && !skip ? "on" : ""}">${k + 1}</i>`;
    }).join("")}<span style="margin-left:.5rem">STEP ${ORDER.indexOf(cur) + 1}</span></div>`;
  }
  function show() {
    const id = path[path.length - 1];
    if (!id) return result();
    const n = NODES[id];
    const faces = id === "start";
    stage.innerHTML = `<div class="sk-in">
      ${stepsBar(id)}
      <h2 class="sk-q">${esc(n.q)}</h2>
      <p class="sk-hint">${esc(n.hint)}</p>
      <div class="sk-opts ${faces ? "faces" : ""}">${n.opts.map((o, k) => `<button type="button" class="sk-opt" data-opt="${k}">${face(o.face)}<span>${esc(o.label)}</span></button>`).join("")}</div>
      ${path.length > 1 ? `<button type="button" data-back class="sk-back">← 1つ前に戻る</button>` : ""}
    </div>`;
    paintFlow(false);
  }
  function setsOf(): string[] {
    return chosen.map((c) => c.opt.set).filter((s): s is string => !!s).map((s) => s.replace(/^\+/, ""));
  }
  /** フローチャートに、たどった道を付ける */
  function paintFlow(done: boolean) {
    if (!flow) return;
    flow.classList.toggle("done", done);
    flow.querySelectorAll(".on").forEach((e) => e.classList.remove("on"));
    for (const c of chosen) {
      flow.querySelector(`[data-node="${c.node}"]`)?.classList.add("on");
      const target = c.opt.set ? c.opt.set.replace(/^\+/, "") : c.opt.next === "oily" ? "oily" : "none";
      flow.querySelector(`[data-edge="${c.node}-${target}"]`)?.classList.add("on");
      if (c.opt.set) flow.querySelector(`[data-res="${target}"]`)?.classList.add("on");
      if (c.node === "sens" && !c.opt.set) flow.querySelector(`[data-res="none"]`)?.classList.add("on");
    }
  }
  function result() {
    track("done");
    const sets = setsOf();
    const mine = load().skin;
    const settable = sets.filter((k) => PAGES[k]);
    const isSet = settable.length > 0 && settable.every((k) => mine[PAGES[k]!.slug]);
    const card = (k: string, i: number) => {
      const t = TYPES[k];
      const pg = PAGES[k];
      return `<div class="sk-type" style="--t:${t.tone};animation-delay:${i * 0.12}s"><img class="sk-type-face" src="${BASE}/images/skin-check/${TYPE_IMG[k]}.webp" alt="" width="345" height="360">
        <div style="min-width:0;flex:1">
          <h3>${esc(k)}<span>${esc(t.en)}</span></h3>
          <p>${esc(t.text)}</p>
          ${pg ? `${pg.people.length ? `<div class="sk-block"><h4>同じ${esc(k)}のインフルエンサー</h4><div class="sk-people">${pg.people.map((p) => `<a href="${p.href}" title="${esc(p.name)}"><img src="${esc(p.icon)}" alt="${esc(p.name)}" width="42" height="42" loading="lazy" referrerpolicy="no-referrer"></a>`).join("")}<span>${pg.total}人</span></div></div>` : ""}
            ${pg.items.length ? `<div class="sk-block"><h4>${esc(k)}の人に人気のスキンケア</h4><div class="sk-items">${pg.items.map((it) => `<a class="sk-item" href="${it.href}"><img src="${esc(it.img)}" alt="" loading="lazy" onerror="this.style.visibility='hidden'"><b>${esc(it.cat)}</b><span>${esc(it.brand)} ${esc(it.name)}</span><em>同じ${esc(k)}の${it.users}人が使用</em></a>`).join("")}</div></div>` : ""}
            <a class="sk-link" href="${pg.href}">${esc(k)}のインフルエンサーと愛用スキンケアを見る →</a>`
          : TYPES[k]?.alt
            ? `<p class="sk-none">${esc(k)}だと話しているインフルエンサーはまだ少ないため、紹介のされ方から集めたページがあります。<a href="${BASE}${TYPES[k].alt!.path}" style="text-decoration:underline">${esc(TYPES[k].alt!.label)} →</a></p>`
            : `<p class="sk-none">${esc(k)}だと話しているインフルエンサーはまだ少なく、ページはありません。<a href="${BASE}/skin-type/" style="text-decoration:underline">ほかの肌質を見る →</a></p>`}
        </div>
      </div>`;
    };
    const share = `肌質の自己診断の結果は「${sets.join("・")}」でした。同じ肌質のインフルエンサーの愛用スキンケアもチェック #OsoroCosme`;
    stage.innerHTML = `<div class="sk-in">
      <p class="sk-res-en">Your skin type</p>
      <h2 class="sk-res-name">${sets.map(esc).join("・")}<small>に近いかも</small></h2>
      <div class="sk-types">${sets.map(card).join("")}</div>
      <div class="sk-cta">
        ${settable.length ? `<button type="button" data-set class="sk-btn sk-btn-main">${isSet ? "✓ 登録済み・マイコスメでおすすめを見る →" : `「${settable.map(esc).join("・")}」をマイコスメに登録して、おすすめを見る →`}<small>この端末のマイコスメに保存し、そのままマイコスメを開きます</small></button>` : ""}
      </div>
      <div class="sk-share">結果をシェア
        <a href="https://twitter.com/intent/tweet?text=${encodeURIComponent(share)}&url=${encodeURIComponent(PAGE_URL)}" target="_blank" rel="noopener">X</a>
        <a href="https://social-plugins.line.me/lineit/share?url=${encodeURIComponent(PAGE_URL)}" target="_blank" rel="noopener">LINE</a>
        <button type="button" data-copy>リンクをコピー</button>
      </div>
      <p class="sk-note mt">自己診断の目安です。肌の状態は季節や体調で変わります。下のフローチャートに、たどった道を示しています。</p>
      <button type="button" data-restart class="sk-back">もう一度診断する</button>
    </div>`;
    paintFlow(true);
  }
  root.addEventListener("click", async (e) => {
    const t = e.target as HTMLElement;
    const optEl = t.closest<HTMLElement>("[data-opt]");
    if (optEl) {
      const id = path[path.length - 1];
      const o = NODES[id].opts[Number(optEl.dataset.opt)];
      if (id === "start") track("start");
      chosen.push({ node: id, opt: o });
      path.push(o.next ?? "");
      return show();
    }
    if (t.closest("[data-back]")) {
      path.pop();
      chosen.pop();
      return show();
    }
    if (t.closest("[data-restart]")) {
      path = ["start"];
      chosen = [];
      show();
      root.scrollIntoView({ behavior: "smooth", block: "start" });
      return;
    }
    const cp = t.closest<HTMLElement>("[data-copy]");
    if (cp) {
      try { await navigator.clipboard.writeText(PAGE_URL); cp.textContent = "コピーしました"; } catch { cp.textContent = PAGE_URL; }
      return;
    }
    const s = t.closest<HTMLElement>("[data-set]");
    if (s) {
      for (const k of setsOf()) if (PAGES[k]) add(PAGES[k]!.slug, undefined, "skin");
      track("set_my_cosme");
      // 登録したらマイコスメを開き、おすすめの欄を見せる（マイコスメ側で「登録しました」と出す。316章）
      location.href = `${BASE}/my-cosme/?registered=skin#foryou`;
    }
  });
  show();
</script>
