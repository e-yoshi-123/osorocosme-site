---
// 肌質から探す（310章）。本人が言った肌質の人たちが紹介したスキンケア・ベースメイクを、同じ肌質の人数で並べる
import HowWeCount from "../../components/HowWeCount.astro";
import PageHead from "../../components/PageHead.astro";
import Layout from "../../layouts/Layout.astro";
import ShareButtons from "../../components/ShareButtons.astro";
import RankingRow from "../../components/RankingRow.astro";
import PeopleGrid from "../../components/PeopleGrid.astro";
import {
  getPublishedSkinTypes,
  getSkinType,
  PC_MIN_CHANNELS,
  PC_PER_GROUP,
  getCosmeticListEntry,
  productOffer,
  categoryUrl,
  hasRankingPage,
  withBase,
  breadcrumbLd,
  cosmeticHref,
} from "../../lib/data";

export function getStaticPaths() {
  return getPublishedSkinTypes().map((d) => ({ params: { slug: d.slug }, props: { slug: d.slug } }));
}

const { slug } = Astro.props;
const c = getSkinType(slug)!;
const name = c.def.name;
const others = getPublishedSkinTypes().filter((x) => x.slug !== slug);
const total = c.groups.reduce((n, g) => n + g.items.length, 0);
const pcHref = (s: string) => withBase(`/skin-type/${encodeURIComponent(s)}/`);

// 表示用データ。価格・楽天とYahoo!のリンク・画像は cosmetics_list.json を正とする（特集・ランキングと同じ）
const groups = c.groups.map((g) => ({
  group: g.group,
  rows: g.items.map((it, i) => {
    const entry = getCosmeticListEntry(it.brand_id, it.name_id);
    const offer = productOffer(entry);
    return {
      it,
      rank: i + 1,
      imageSrc: offer.imageSrc,
      price: offer.price,
      link: offer.rakutenLink,
      fromYahoo: offer.source === "yahoo",
      yahooLink: entry?.yahoo_text_link || undefined,
      note: `使っている${name}の人：${it.users.join("・")}`,
    };
  }),
}));

const firstOf = (g: string) => groups.find((x) => x.group === g)?.rows[0]?.it;
const care = firstOf("スキンケア");
const base = firstOf("ベースメイク");
const title = `${name}のYouTuber・インフルエンサーと愛用スキンケア・ベースメイク`;
const description =
  `肌質が${name}だと本人が話しているYouTuber・インフルエンサー${c.people.length}人と、その人たちが紹介したスキンケア・ベースメイク（同じ${name}の何人が使ったかで集計）。` +
  (care ? `スキンケアでは${care.brand}「${care.name}」、` : "") +
  (base ? `ベースメイクでは${base.brand}「${base.name}」などが上位です。` : "");
const topImage = groups.flatMap((g) => g.rows).find((r) => r.imageSrc)?.imageSrc;
const crumbs = [
  { name: "ホーム", path: "/" },
  { name: "肌質から探す", path: "/skin-type/" },
  { name, path: `/skin-type/${encodeURIComponent(slug)}/` },
];
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: title,
    numberOfItems: total,
    itemListElement: groups
      .flatMap((g) => g.rows)
      .slice(0, 10)
      .map((r, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: `${r.it.brand} ${r.it.name}`,
        url: new URL(cosmeticHref(r.it.brand_id, r.it.name_id), Astro.site!).href,
      })),
  },
  breadcrumbLd(crumbs, Astro.site!),
];
---

<Layout title={title} description={description} image={topImage} jsonLd={jsonLd}>
  <nav class="text-xs text-neutral-500 mb-8 flex flex-wrap gap-2" aria-label="パンくず">
    <a href={withBase("/")} class="link-u">Home</a><span aria-hidden="true">/</span>
    <a href={withBase("/skin-type/")} class="link-u">肌質から探す</a><span aria-hidden="true">/</span>
    <span>{name}</span>
  </nav>

  <PageHead en={c.def.en} title={`${name}のインフルエンサーと愛用コスメ`} lead={`肌質が${name}だと本人が話している${c.people.length}人のYouTuber・インフルエンサーと、その人たちが紹介したスキンケアとベースメイクです。`}>
    <ShareButtons text={`${name}のインフルエンサーが使っているコスメ`} class="mt-5" />
  </PageHead>

  <nav class="mb-8 flex flex-wrap gap-2 text-sm" aria-label="このページの中">
    <a href="#people" class="chip">インフルエンサー（{c.people.length}人）</a>
    <a href="#cosme" class="chip">スキンケア・ベースメイク（{total}品）</a>
    <a href={withBase("/skin-type/check/")} class="chip border-rose/40 text-rose">自分が分からない人は肌質自己診断 →</a>
  </nav>

  <section id="people" class="panel mb-8 md:mb-10 scroll-mt-24" aria-labelledby="pc-people">
    <h2 id="pc-people" class="font-serif h-section font-semibold mb-1">{name}のインフルエンサー</h2>
    <p class="text-xs text-neutral-500 mb-4">肌質が{name}だと、本人が動画・概要欄・タイトルで言っている人です（紹介動画の多い順）。</p>
    <PeopleGrid people={c.people} />
  </section>

  <h2 id="cosme" class="font-serif h-section font-semibold mb-4 scroll-mt-24">{name}の人が使っているスキンケア・ベースメイク</h2>
  <HowWeCount>
    <ul class="list-disc pl-5 space-y-1">
      <li>対象：肌質が{name}だと、本人が動画・概要欄・タイトルで言っているインフルエンサー<b>{c.people.length}人</b>の、紹介動画<b>{c.videoCount}本</b>（「敏感肌・乾燥肌」のように2つ言っている人は両方に入ります）</li>
      <li>掲載条件：同じ{name}の<b>{PC_MIN_CHANNELS}人以上</b>が紹介したコスメのみ。PR・提供と、本人がプロデュースしたブランドの紹介は数えていません</li>
      <li>並び順：紹介した{name}の人数 → 紹介動画数 → 合計再生回数。各カテゴリ上位{PC_PER_GROUP}品まで</li>
      <li>肌質は本人の自己申告によるもので、肌に合うかどうかを保証するものではありません。肌の悩みについて動画で話された紹介は「<a href={withBase("/concern/")} class="link-u">肌悩みから探す</a>」にまとめています</li>
    </ul>
  </HowWeCount>

  {
    groups.map((g) => (
      <section class="panel mb-6 md:mb-8">
        <h2 class="font-serif h-section font-semibold mb-4">{name}の人の{g.group}</h2>
        <div class="@container">
          <ol class="divide-y divide-ink/10">
            {g.rows.map((r) => (
              <RankingRow
                rank={r.rank}
                base={r.rank}
                brand_id={r.it.brand_id}
                brand={r.it.brand}
                name_id={r.it.name_id}
                name={r.it.name}
                imageSrc={r.imageSrc}
                videoCount={r.it.videoCount}
                channelCount={r.it.channelCount}
                price={r.price}
                fromYahoo={r.fromYahoo}
                link={r.link}
                yahooLink={r.yahooLink}
                subLabel={r.it.tag}
                note={r.note}
              />
            ))}
          </ol>
        </div>
        <p class="mt-2 text-xs text-neutral-500">
          {g.rows
            .map((r) => r.it.tag)
            .filter((v, i, a) => a.indexOf(v) === i)
            .map((t, i) => (
              <>
                {i > 0 && " / "}
                {hasRankingPage(t) ? <a href={categoryUrl(t)} class="link-u text-ink">{t}のランキング</a> : t}
              </>
            ))}
        </p>
      </section>
    ))
  }


  <p class="text-xs text-neutral-500 mb-8">価格は楽天市場で確認した時点の参考価格です。最新の価格・在庫は楽天市場でご確認ください。肌に合うかどうかには個人差があります。</p>

  <ShareButtons text={`${name}のインフルエンサーが使っているコスメ`} label="このページをシェア" class="mb-10" />

  <p class="text-sm">
    {others.map((o) => (<><a href={pcHref(o.slug)} class="link-u text-ink">{o.name} →</a>{" "}</>))}
    <a href={withBase("/ranking/")} class="link-u text-ink">カテゴリ別ランキング →</a>
  </p>
</Layout>
