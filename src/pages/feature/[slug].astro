---
import Layout from "../../layouts/Layout.astro";
import RankingRow from "../../components/RankingRow.astro";
import VideoCard from "../../components/VideoCard.astro";
import {
  FEATURES,
  FEATURE_MIN_CHANNELS,
  FEATURE_PER_GROUP,
  getFeature,
  getCosmeticListEntry,
  extractImageSrc,
  cosmeticSlug,
  categoryUrl,
  formatJaDate,
  withBase,
  breadcrumbLd,
} from "../../lib/data";

export function getStaticPaths() {
  return FEATURES.map((f) => ({ params: { slug: f.slug }, props: { slug: f.slug } }));
}

const { slug } = Astro.props;
const f = getFeature(slug)!;
const others = FEATURES.filter((x) => x.slug !== slug);
const total = f.groups.reduce((n, g) => n + g.items.length, 0);

// 表示用データ。価格・楽天リンク・画像は cosmetics_list.json を正とする（ランキングページと同じ）
const groups = f.groups.map((g) => ({
  group: g.group,
  rows: g.items.map((it, i) => {
    const entry = getCosmeticListEntry(it.brand_id, it.name_id);
    return {
      it,
      rank: i + 1,
      imageSrc: extractImageSrc(entry?.rakuten_image_link) || "",
      price: entry?.now_price,
      link: entry?.rakuten_text_link || undefined,
      subLabel: it.tag,
    };
  }),
}));

const title = `${f.def.name}動画で人気のコスメ（カテゴリ別）`;
const first = groups[0]?.rows[0]?.it;
const description =
  `YouTubeの「${f.def.name}」をテーマにした動画${f.videoCount}本（${f.channelCount}チャンネル）で紹介されたコスメを、カテゴリ別に集計。` +
  `${FEATURE_MIN_CHANNELS}人以上が紹介したコスメだけを載せています。` +
  (first ? `${first.tag}では${first.brand}「${first.name}」などが上位です。` : "");
const topImage = groups.flatMap((g) => g.rows).find((r) => r.imageSrc)?.imageSrc;
const crumbs = [
  { name: "ホーム", path: "/" },
  { name: "特集", path: "/feature/" },
  { name: f.def.name, path: `/feature/${slug}/` },
];
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: title,
    numberOfItems: total,
    itemListElement: groups
      .flatMap((g) => g.rows)
      .slice(0, 10)
      .map((r, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: `${r.it.brand} ${r.it.name}`,
        url: new URL(withBase(`/cosmetics/${cosmeticSlug(r.it.brand_id, r.it.name_id)}`), Astro.site!).href,
      })),
  },
  breadcrumbLd(crumbs, Astro.site!),
];
---

<Layout title={title} description={description} image={topImage} jsonLd={jsonLd}>
  <nav class="text-xs text-neutral-500 mb-4" aria-label="パンくず">
    <a href={withBase("/")} class="hover:text-pink-600">ホーム</a> ›
    <a href={withBase("/feature/")} class="hover:text-pink-600">特集</a> ›
    <span>{f.def.name}</span>
  </nav>

  <h1 class="text-xl font-bold mb-2">{f.def.name}動画で人気のコスメ</h1>
  <p class="text-sm text-neutral-700 mb-3">{f.def.lead}</p>

  <div class="bg-white rounded-lg shadow-sm p-4 mb-8 text-xs text-neutral-600 leading-relaxed">
    <p class="font-bold text-neutral-800 mb-1">この特集の集計方法</p>
    <ul class="list-disc pl-5 space-y-0.5">
      <li>対象：タイトルに「{f.def.keywords.join("」「")}」のいずれかを含む動画 <b>{f.videoCount}本</b>（<b>{f.channelCount}チャンネル</b>）</li>
      <li>掲載条件：<b>{FEATURE_MIN_CHANNELS}チャンネル以上</b>が紹介したコスメのみ（1人が何本も紹介しただけのものは除外）</li>
      <li>並び順：紹介したチャンネル数 → 紹介動画数 → 合計再生回数。各カテゴリ上位{FEATURE_PER_GROUP}品まで</li>
      {f.newest && <li>最新の対象動画：{formatJaDate(f.newest)}投稿</li>}
    </ul>
  </div>

  {
    groups.map((g) => (
      <section class="mb-10">
        <h2 class="text-lg font-bold mb-3 pl-3 border-l-4 border-pink-500">{g.group}</h2>
        <div class="bg-white rounded-lg shadow-sm overflow-hidden">
          <ol class="divide-y divide-neutral-100">
            {g.rows.map((r) => (
              <RankingRow
                rank={r.rank}
                base={r.rank}
                brand_id={r.it.brand_id}
                brand={r.it.brand}
                name_id={r.it.name_id}
                name={r.it.name}
                imageSrc={r.imageSrc}
                videoCount={r.it.videoCount}
                channelCount={r.it.channelCount}
                price={r.price}
                link={r.link}
                subLabel={r.subLabel}
              />
            ))}
          </ol>
        </div>
        <p class="mt-2 text-xs text-neutral-500">
          {g.rows
            .map((r) => r.subLabel)
            .filter((v, i, a) => a.indexOf(v) === i)
            .map((t, i) => (
              <>
                {i > 0 && " / "}
                <a href={categoryUrl(t)} class="text-pink-600 hover:underline">{t}のランキング</a>
              </>
            ))}
        </p>
      </section>
    ))
  }

  <p class="text-xs text-neutral-500 mb-8">価格は楽天市場で確認した時点の参考価格です。最新の価格・在庫は楽天市場でご確認ください。</p>

  <section class="mb-10">
    <h2 class="text-lg font-bold mb-3 pl-3 border-l-4 border-pink-500">対象になった動画（再生回数の多い順）</h2>
    <p class="text-xs text-neutral-500 mb-3">実際にどう使っているかは、動画で確認できます。</p>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {f.sample.map((v) => <VideoCard video={v} />)}
    </div>
  </section>

  <p class="text-sm">
    {
      others.map((o) => (
        <>
          <a href={withBase(`/feature/${o.slug}/`)} class="text-pink-600 hover:underline">{o.name}動画で人気のコスメ →</a>{" "}
        </>
      ))
    }
    <a href={withBase("/ranking/")} class="text-pink-600 hover:underline">カテゴリ別ランキング →</a>
  </p>
</Layout>
