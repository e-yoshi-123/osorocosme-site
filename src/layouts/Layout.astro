---
import "../styles/global.css";
import { withBase } from "../lib/data";
import { GA_MEASUREMENT_ID } from "../lib/site-info";
import Logo from "../components/Logo.astro";

interface Props {
  title: string;
  description?: string;
  image?: string;
  ogType?: "website" | "article" | "video.other";
  noindex?: boolean;
  jsonLd?: object[];
}

const SITE_NAME = "OsoroCosme";
const DEFAULT_DESCRIPTION =
  "YouTubeのコスメ紹介動画から、誰がいつどのコスメを使っているかを集めたデータベース。カテゴリ別ランキング、ブランド、インフルエンサー別の使用コスメ遍歴を確認できます。";
const { title, description = DEFAULT_DESCRIPTION, image, ogType = "website", noindex = false, jsonLd = [] } = Astro.props;
const ogImage = image ? largerOgImage(image) : Astro.site ? new URL("/og-default.png", Astro.site).href : undefined;
// SNSのカード（176章）：商品画像・チャンネルアイコンは正方形なので、横長の大きいカード（summary_large_image）だと上下が切れる。
// 正方形の画像は summary（小さい正方形のカード）、動画のサムネイルと既定の画像（1200×630）は大きいカードにする
const twitterCard = !image || ogType === "video.other" ? "summary_large_image" : "summary";

// ページで表示している小さい画像のURLを、SNSのカード用に大きいサイズへ置き換える（いずれも同じ画像の別サイズで、存在を確認済み）
function largerOgImage(src: string): string {
  return src
    .replace(/(thumbnail\.image\.rakuten\.co\.jp\/.*[?&]_ex=)\d+x\d+/, (_, head) => `${head}500x500`) // 楽天：240×240 → 500×500（楽天の上限）
    .replace(/(i\.ytimg\.com\/vi\/[^/]+\/)mqdefault\.jpg/, "$1hqdefault.jpg") // YouTube：320×180 → 480×360
    .replace(/(yt3\.ggpht\.com\/[^=]+=)s\d+-/, "$1s400-"); // チャンネルアイコン：88 → 400
}
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;

const navLinks = [
  { href: "/ranking/", label: "ランキング", en: "Ranking" },
  { href: "/feature/", label: "特集", en: "Features" },
  { href: "/concern/", label: "肌悩み", en: "Concerns" },
  { href: "/brand-list", label: "ブランド", en: "Brands" },
  { href: "/influencer-list", label: "インフルエンサー", en: "Influencers" },
  { href: "/video-list", label: "動画", en: "Videos" },
];
const path = Astro.url.pathname;
const isCurrent = (href: string) => href !== "/" && path.startsWith(href.replace(/\/$/, ""));
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href={withBase("/favicon.ico")} sizes="32x32" />
    <link rel="icon" href={withBase("/favicon.svg")} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase("/apple-touch-icon.png")} />
    <title>{title} | {SITE_NAME}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,600;1,600&display=swap" rel="stylesheet" />
    <meta name="theme-color" content="#fdf8f6" />
    <!-- チャンネルアイコン・動画サムネイル・商品画像の主な配信元に事前接続してLCPを短縮する -->
    <link rel="preconnect" href="https://yt3.ggpht.com" crossorigin />
    <link rel="preconnect" href="https://i.ytimg.com" crossorigin />
    <link rel="preconnect" href="https://thumbnail.image.rakuten.co.jp" crossorigin />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={`${title} | ${SITE_NAME}`} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="ja_JP" />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={twitterCard} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    {jsonLd.map((ld) => <script type="application/ld+json" set:html={JSON.stringify(ld)} />)}
    {/* Googleアナリティクス4。開発中の閲覧を数えないよう、本番ビルドのときだけ出す。外部リンク（楽天など）のクリックは拡張計測機能で自動記録される */}
    {import.meta.env.PROD && GA_MEASUREMENT_ID && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}></script>
        <script is:inline define:vars={{ id: GA_MEASUREMENT_ID }}>
          window.dataLayer = window.dataLayer || [];
          // define:vars で関数の中に包まれるので、ほかのスクリプト（シェアボタン等）から呼べるよう window に置く
          window.gtag = function () { dataLayer.push(arguments); };
          gtag("js", new Date());
          gtag("config", id);
        </script>
      </>
    )}
    <!-- 商品画像が読み込めない（店が画像を差し替えて古いURLが消えた等）ときの共通の処理（135章）。
         Yahoo!ショッピングの画像があれば差し替え、無ければ「No Image」にする。
         自前の onerror を持つ画像（ランキング行・タイル）と、商品ページの画像（data-item-image、専用のスクリプト）は対象外。
         画像の error はバブルしないので、キャプチャで拾う。body より前に置き、読み込み中の失敗も取りこぼさない -->
    <script is:inline>
      window.addEventListener("error", function (ev) {
        var img = ev.target;
        if (!img || img.tagName !== "IMG" || img.hasAttribute("onerror") || img.closest("[data-item-image]")) return;
        // チャンネルアイコン：YouTube側が短時間の多数の読み込みを断ることがある（192章のあとの見直し）。
        // 少し待って1回だけ読み直し、それでも駄目なら同じ大きさの丸に名前の頭文字を出す
        if (/yt3\.ggpht\.com|googleusercontent\.com/.test(img.src)) {
          if (!img.dataset.retried) {
            img.dataset.retried = "1";
            var src = img.src;
            setTimeout(function () { img.src = src + (src.indexOf("?") < 0 ? "?" : "&") + "r=1"; }, 400 + Math.random() * 1200);
            return;
          }
          var link = img.closest("a");
          var name = (img.alt || img.dataset.name || (link && link.getAttribute("title")) || "").trim();
          var m = document.createElement("span");
          m.className = img.className + " avatar-fallback";
          m.setAttribute("aria-hidden", "true");
          m.textContent = name ? Array.from(name)[0].toUpperCase() : "";
          var w = img.getBoundingClientRect().width;
          if (w) m.style.fontSize = Math.max(10, Math.round(w * 0.42)) + "px";
          img.replaceWith(m);
          return;
        }
        if (!/thumbnail\.image\.rakuten\.co\.jp|item-shopping\.c\.yimg\.jp/.test(img.src)) return;
        var box = img.closest("[data-yahoo-image]");
        if (box && !box.hasAttribute("data-swapped")) {
          box.setAttribute("data-swapped", "");
          var a = document.createElement("a");
          a.href = box.getAttribute("data-yahoo-link"); a.target = "_blank"; a.rel = "nofollow sponsored noopener";
          var y = document.createElement("img");
          y.src = box.getAttribute("data-yahoo-image"); y.alt = img.alt; y.loading = "lazy";
          a.appendChild(y); box.replaceChildren(a);
          return;
        }
        var s = document.createElement("span");
        s.className = "noimg"; s.textContent = "No image";
        (img.parentElement && img.parentElement.tagName === "A" && img.parentElement.children.length === 1 ? img.parentElement : img).replaceWith(s);
      }, true);
    </script>
  </head>
  <body class="min-h-screen bg-paper text-ink flex flex-col font-sans">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 bg-ink text-white px-3 py-2 text-sm">本文へ</a>
    <header class="sticky top-0 z-40 bg-paper/85 backdrop-blur-md border-b border-ink/10">
      <div class="max-w-[1320px] mx-auto px-4 md:px-8 h-14 md:h-[72px] flex items-center gap-6">
        <a href={withBase("/")} class="text-ink text-[20px] md:text-[22px] shrink-0" aria-label="OsoroCosme ホーム"><Logo /></a>
        <nav class="hidden lg:flex items-center gap-7 ml-6" aria-label="メイン">
          {navLinks.map((l) => (
            <a href={withBase(l.href)} class:list={["group relative text-sm tracking-[0.04em] py-2", isCurrent(l.href) ? "text-ink" : "text-neutral-600 hover:text-ink"]} aria-current={isCurrent(l.href) ? "page" : undefined}>
              {l.label}
              <span class:list={["absolute left-0 -bottom-0.5 h-px bg-rose transition-all duration-500 ease-out-expo", isCurrent(l.href) ? "w-full" : "w-0 group-hover:w-full"]} />
            </a>
          ))}
        </nav>
        <form action={withBase("/search-result")} method="get" role="search" class="ml-auto hidden md:flex items-center gap-2 border-b border-ink/25 focus-within:border-rose transition-colors w-64 xl:w-72">
          <svg viewBox="0 0 24 24" class="w-4 h-4 text-neutral-500 shrink-0" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
          <input type="search" name="q" placeholder="コスメ・ブランド・動画を検索" aria-label="サイト内検索" class="w-full bg-transparent py-2 text-sm placeholder:text-neutral-400 focus:outline-none" />
        </form>
        <button type="button" data-search-toggle class="md:hidden ml-auto -mr-2 w-11 h-11 flex items-center justify-center" aria-label="検索を開く" aria-expanded="false" aria-controls="mobile-search">
          <svg viewBox="0 0 24 24" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
        </button>
      </div>
      <form id="mobile-search" action={withBase("/search-result")} method="get" role="search" class="md:hidden hidden px-4 pb-3">
        <div class="flex items-center gap-2 border-b border-ink/30 focus-within:border-rose">
          <input type="search" name="q" placeholder="コスメ・ブランド・動画を検索" aria-label="サイト内検索" class="w-full bg-transparent py-2.5 text-base focus:outline-none" />
          <button type="submit" class="label-caps text-rose py-2">Search</button>
        </div>
      </form>
      <!-- 6項目だと390px幅に収まらない（228章）。右端をぼかして続きがあることを示し、端まで送ったらぼかしを消す（下のスクリプト） -->
      <nav id="mobile-nav" class="nav-fade lg:hidden border-t border-ink/5 overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden" aria-label="メイン（スマホ）">
        <!-- 間隔は8px（12pxだと390px幅で6項目が収まらない）。横スクロールの入れ物では右の余白が幅に数えられないので、末尾に余白の要素を置く（228章） -->
        <div class="flex justify-between min-[400px]:justify-start gap-2 min-[400px]:gap-5 pl-4 md:pl-8 whitespace-nowrap text-[13px] min-[380px]:text-sm after:content-[''] after:shrink-0 after:w-2 md:after:w-6">
          {navLinks.map((l) => (
            <a href={withBase(l.href)} aria-current={isCurrent(l.href) ? "page" : undefined} class:list={["relative py-2.5 shrink-0", isCurrent(l.href) ? "text-ink font-medium" : "text-neutral-600"]}>
              {l.label}
              {isCurrent(l.href) && <span class="absolute left-0 right-0 bottom-0 h-px bg-rose" />}
            </a>
          ))}
        </div>
      </nav>
    </header>

    <main id="main" tabindex="-1" class="focus:outline-none flex-1 max-w-[1320px] w-full mx-auto px-4 md:px-8 py-8 md:py-12">
      <slot />
    </main>

    <!-- 上へ戻るボタン（画面1.5枚分より下にいるときだけ出す） -->
    <button type="button" id="to-top" class="to-top" aria-label="ページの先頭へ戻る" tabindex="-1">
      <svg viewBox="0 0 24 24" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7" /></svg>
    </button>

    <footer class="relative bg-ink text-paper mt-16 md:mt-24 overflow-hidden">
      <div class="max-w-[1320px] mx-auto px-4 md:px-8 pt-16 md:pt-24 pb-10">
        <div class="grid md:grid-cols-12 gap-10">
          <div class="md:col-span-5">
            <p class="eyebrow !text-pink-300 mb-4">The YouTube Cosme Database</p>
            <p class="font-serif text-xl md:text-2xl leading-relaxed">あの人の愛用コスメを、<br />動画から見つける。</p>
            <form action={withBase("/search-result")} method="get" role="search" class="mt-8 flex items-center gap-3 border-b border-paper/30 focus-within:border-pink-300 max-w-sm">
              <input type="search" name="q" placeholder="コスメ・ブランドを検索" aria-label="サイト内検索" class="w-full bg-transparent py-3 text-sm placeholder:text-paper/40 focus:outline-none" />
              <button type="submit" class="label-caps text-pink-300 shrink-0">Search →</button>
            </form>
          </div>
          <nav class="md:col-span-3 md:col-start-7" aria-label="探す">
            <p class="label-caps text-paper/40 mb-4">Explore</p>
            <ul class="space-y-2.5 text-sm">
              {navLinks.map((l) => <li><a href={withBase(l.href)} class="link-u text-paper/80 hover:text-paper">{l.label}</a></li>)}
            </ul>
          </nav>
          <nav class="md:col-span-3" aria-label="サイト情報">
            <p class="label-caps text-paper/40 mb-4">About</p>
            <ul class="space-y-2.5 text-sm">
              <li><a href={withBase("/about")} class="link-u text-paper/80 hover:text-paper">OsoroCosmeについて</a></li>
              <li><a href={withBase("/contact")} class="link-u text-paper/80 hover:text-paper">お問い合わせ</a></li>
              <li><a href={withBase("/for-creators")} class="link-u text-paper/80 hover:text-paper">インフルエンサーの方へ</a></li>
              <li><a href={withBase("/privacy")} class="link-u text-paper/80 hover:text-paper">プライバシーポリシー</a></li>
              <li><a href={withBase("/disclaimer")} class="link-u text-paper/80 hover:text-paper">免責事項・広告表記</a></li>
            </ul>
          </nav>
        </div>
        <svg viewBox="0 0 1000 200" class="block w-full mt-14 md:mt-20 -mb-1 text-paper/[0.08]" aria-hidden="true"><text x="0" y="168" textLength="1000" lengthAdjust="spacingAndGlyphs" fill="currentColor" font-family="Cormorant Garamond, serif" font-style="italic" font-size="220">OsoroCosme</text></svg>
        <div class="border-t border-paper/15 pt-6 flex flex-col md:flex-row md:items-center justify-between gap-3 text-xs text-paper/50">
          <p>当サイトは楽天アフィリエイト・バリューコマースなどの広告を利用しており、商品リンクから収益を得ることがあります。</p>
          <p class="font-display text-sm">&copy; {new Date().getFullYear()} OsoroCosme</p>
        </div>
      </div>
    </footer>

    <script>
      // スマホのナビ：今いるページの項目が隠れていれば見える位置まで送り、右端まで送ったらぼかしを消す（228章）
      const mnav = document.getElementById("mobile-nav");
      if (mnav) {
        const cur = mnav.querySelector<HTMLElement>('[aria-current="page"]');
        if (cur && cur.offsetLeft + cur.offsetWidth > mnav.clientWidth) mnav.scrollLeft = cur.offsetLeft - 16;
        const edge = () => mnav.classList.toggle("at-end", mnav.scrollLeft + mnav.clientWidth >= mnav.scrollWidth - 2);
        mnav.addEventListener("scroll", edge, { passive: true });
        window.addEventListener("resize", edge);
        edge();
      }
      // スクロールで .reveal を表示する
      const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add("is-in"); io.unobserve(e.target); } }), { rootMargin: "0px 0px -8% 0px" });
      document.querySelectorAll(".reveal").forEach((el) => io.observe(el));
      // 横にめくる一覧（data-swipe）の位置を、直後の点（data-swipe-dots）で示す
      document.querySelectorAll<HTMLElement>("[data-swipe]").forEach((track) => {
        const dots = track.parentElement?.querySelector<HTMLElement>(":scope > [data-swipe-dots]");
        const items = Array.from(track.children) as HTMLElement[];
        if (!dots || items.length < 2) return;
        dots.classList.add("swipe-dots");
        const ds = items.map(() => dots.appendChild(document.createElement("span")));
        const update = () => {
          const x = track.scrollLeft, max = track.scrollWidth - track.clientWidth;
          let i = items.findIndex((el) => el.offsetLeft - track.offsetLeft + el.offsetWidth / 2 > x + 16);
          if (max > 0 && x >= max - 4) i = items.length - 1;
          ds.forEach((d, k) => d.classList.toggle("is-on", k === Math.max(0, i)));
        };
        track.addEventListener("scroll", update, { passive: true });
        update();
      });
      // 「もっと見る」：data-more の一覧の、隠してある子を data-more 件ずつ出す。ボタンは一覧と同じ親の中の data-more-btn
      document.querySelectorAll<HTMLElement>("[data-more]").forEach((list) => {
        const btn = list.parentElement?.querySelector<HTMLButtonElement>("[data-more-btn]");
        const step = Number(list.dataset.more) || 12;
        btn?.addEventListener("click", () => {
          const hidden = Array.from(list.children).filter((el) => el.classList.contains("hidden"));
          hidden.slice(0, step).forEach((el) => el.classList.remove("hidden"));
          const rest = hidden.length - step;
          if (rest > 0) btn.textContent = btn.textContent!.replace(/\d+/, String(rest));
          else btn.parentElement!.remove();
        });
      });
      // ヘッダーの高さ（スマホは2段・検索を開くと3段）を --hdr-h に入れる。固定の帯の位置と、ページ内リンクで飛んだ先の余白に使う
      const hdr = document.querySelector<HTMLElement>("body > header");
      if (hdr) new ResizeObserver(() => document.documentElement.style.setProperty("--hdr-h", `${hdr.offsetHeight}px`)).observe(hdr);
      // 上へ戻るボタン
      const toTop = document.getElementById("to-top")!;
      let toTopOn = false;
      const updateToTop = () => {
        const on = window.scrollY > window.innerHeight * 1.5;
        if (on === toTopOn) return;
        toTopOn = on;
        toTop.classList.toggle("is-on", on);
        toTop.tabIndex = on ? 0 : -1;
      };
      window.addEventListener("scroll", updateToTop, { passive: true });
      updateToTop();
      toTop.addEventListener("click", () => {
        window.scrollTo({ top: 0, behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" });
        document.getElementById("main")?.focus({ preventScroll: true });
      });
      // スマホの検索の開閉
      const t = document.querySelector<HTMLButtonElement>("[data-search-toggle]");
      const f = document.getElementById("mobile-search");
      t?.addEventListener("click", () => {
        const open = f!.classList.toggle("hidden") === false;
        t.setAttribute("aria-expanded", String(open));
        if (open) f!.querySelector("input")?.focus();
      });
    </script>
  </body>
</html>
