---
import "../styles/global.css";
import { withBase } from "../lib/data";
import { GA_MEASUREMENT_ID } from "../lib/site-info";

interface Props {
  title: string;
  description?: string;
  image?: string;
  ogType?: "website" | "article" | "video.other";
  noindex?: boolean;
  jsonLd?: object[];
}

const SITE_NAME = "OsoroCosme";
const DEFAULT_DESCRIPTION =
  "YouTubeのコスメ紹介動画から、誰がいつどのコスメを使っているかを集めたデータベース。カテゴリ別ランキング、ブランド、インフルエンサー別の使用コスメ遍歴を確認できます。";
const { title, description = DEFAULT_DESCRIPTION, image, ogType = "website", noindex = false, jsonLd = [] } = Astro.props;
const ogImage = image ? largerOgImage(image) : Astro.site ? new URL("/og-default.png", Astro.site).href : undefined;
// SNSのカード（176章）：商品画像・チャンネルアイコンは正方形なので、横長の大きいカード（summary_large_image）だと上下が切れる。
// 正方形の画像は summary（小さい正方形のカード）、動画のサムネイルと既定の画像（1200×630）は大きいカードにする
const twitterCard = !image || ogType === "video.other" ? "summary_large_image" : "summary";

// ページで表示している小さい画像のURLを、SNSのカード用に大きいサイズへ置き換える（いずれも同じ画像の別サイズで、存在を確認済み）
function largerOgImage(src: string): string {
  return src
    .replace(/(thumbnail\.image\.rakuten\.co\.jp\/.*[?&]_ex=)\d+x\d+/, (_, head) => `${head}500x500`) // 楽天：240×240 → 500×500（楽天の上限）
    .replace(/(i\.ytimg\.com\/vi\/[^/]+\/)mqdefault\.jpg/, "$1hqdefault.jpg") // YouTube：320×180 → 480×360
    .replace(/(yt3\.ggpht\.com\/[^=]+=)s\d+-/, "$1s400-"); // チャンネルアイコン：88 → 400
}
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;

const navLinks = [
  { href: "/", label: "ホーム", short: "ホーム" },
  { href: "/ranking/", label: "ランキング", short: "ランキング" },
  { href: "/feature/", label: "特集", short: "特集" },
  { href: "/brand-list", label: "ブランド一覧", short: "ブランド" },
  { href: "/influencer-list", label: "インフルエンサー一覧", short: "インフルエンサー" },
  { href: "/video-list", label: "動画一覧", short: "動画" },
];
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href={withBase("/favicon.ico")} sizes="32x32" />
    <link rel="icon" href={withBase("/favicon.svg")} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase("/apple-touch-icon.png")} />
    <title>{title} | {SITE_NAME}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <!-- チャンネルアイコン・動画サムネイル・商品画像の主な配信元に事前接続してLCPを短縮する -->
    <link rel="preconnect" href="https://yt3.ggpht.com" crossorigin />
    <link rel="preconnect" href="https://i.ytimg.com" crossorigin />
    <link rel="preconnect" href="https://thumbnail.image.rakuten.co.jp" crossorigin />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={`${title} | ${SITE_NAME}`} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="ja_JP" />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={twitterCard} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    {jsonLd.map((ld) => <script type="application/ld+json" set:html={JSON.stringify(ld)} />)}
    {/* Googleアナリティクス4。開発中の閲覧を数えないよう、本番ビルドのときだけ出す。外部リンク（楽天など）のクリックは拡張計測機能で自動記録される */}
    {import.meta.env.PROD && GA_MEASUREMENT_ID && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}></script>
        <script is:inline define:vars={{ id: GA_MEASUREMENT_ID }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag("js", new Date());
          gtag("config", id);
        </script>
      </>
    )}
    <!-- 商品画像が読み込めない（店が画像を差し替えて古いURLが消えた等）ときの共通の処理（135章）。
         Yahoo!ショッピングの画像があれば差し替え、無ければ「No Image」にする。
         自前の onerror を持つ画像（ランキング行・タイル）と、商品ページの画像（data-item-image、専用のスクリプト）は対象外。
         画像の error はバブルしないので、キャプチャで拾う。body より前に置き、読み込み中の失敗も取りこぼさない -->
    <script is:inline>
      window.addEventListener("error", function (ev) {
        var img = ev.target;
        if (!img || img.tagName !== "IMG" || img.hasAttribute("onerror") || img.closest("[data-item-image]")) return;
        if (!/thumbnail\.image\.rakuten\.co\.jp|item-shopping\.c\.yimg\.jp/.test(img.src)) return;
        var box = img.closest("[data-yahoo-image]");
        if (box && !box.hasAttribute("data-swapped")) {
          box.setAttribute("data-swapped", "");
          var a = document.createElement("a");
          a.href = box.getAttribute("data-yahoo-link"); a.target = "_blank"; a.rel = "nofollow sponsored noopener";
          var y = document.createElement("img");
          y.src = box.getAttribute("data-yahoo-image"); y.alt = img.alt; y.loading = "lazy";
          a.appendChild(y); box.replaceChildren(a);
          return;
        }
        var s = document.createElement("span");
        s.className = "text-neutral-300 text-xs"; s.textContent = "No Image";
        (img.parentElement && img.parentElement.tagName === "A" && img.parentElement.children.length === 1 ? img.parentElement : img).replaceWith(s);
      }, true);
    </script>
  </head>
  <body class="min-h-screen bg-neutral-50 text-neutral-900 flex flex-col">
    <header class="bg-white border-b border-neutral-200 md:sticky md:top-0 z-30">
      <div class="max-w-6xl mx-auto px-4 py-2 md:py-3 flex items-center gap-x-4 gap-y-1 flex-wrap">
        <a href={withBase("/")} class="text-xl font-bold text-pink-600 shrink-0">OsoroCosme</a>
        <nav class="order-3 md:order-none w-full md:w-auto -mx-4 px-4 md:mx-0 md:px-0 flex gap-1 md:gap-4 text-sm overflow-x-auto md:overflow-visible whitespace-nowrap">
          {
            navLinks.map((link) => (
              <a href={withBase(link.href)} class="text-neutral-600 hover:text-pink-600 px-1 min-[400px]:px-1.5 py-2 md:p-0 shrink-0 text-[12px] min-[400px]:text-[13px] md:text-sm">
                <span class="md:hidden">{link.short}</span><span class="hidden md:inline">{link.label}</span>
              </a>
            ))
          }
        </nav>
        <form action={withBase("/search-result")} method="get" class="ml-auto flex items-center gap-2 flex-1 md:flex-none justify-end min-w-0">
          <input
            type="text"
            name="q"
            placeholder="コスメ・動画を検索"
            class="border border-neutral-300 rounded px-3 py-1.5 text-sm w-full min-w-0 md:w-48 max-w-xs focus:outline-none focus:ring-2 focus:ring-pink-300"
          />
          <button
            type="submit"
            class="bg-pink-600 text-white text-sm px-3 py-1.5 rounded hover:bg-pink-700 shrink-0"
          >
            検索
          </button>
        </form>
      </div>
    </header>

    <main class="flex-1 max-w-6xl w-full mx-auto px-4 py-6 md:py-8">
      <slot />
    </main>

    <footer class="bg-white border-t border-neutral-200 mt-12">
      <div class="max-w-6xl mx-auto px-4 py-6 text-sm text-neutral-500 space-y-3">
        <nav class="flex flex-wrap gap-x-5 gap-y-1" aria-label="サイト情報">
          <a href={withBase("/about")} class="hover:text-pink-600">OsoroCosmeについて</a>
          <a href={withBase("/contact")} class="hover:text-pink-600">お問い合わせ</a>
          <a href={withBase("/for-creators")} class="hover:text-pink-600">インフルエンサーの方へ</a>
          <a href={withBase("/privacy")} class="hover:text-pink-600">プライバシーポリシー</a>
          <a href={withBase("/disclaimer")} class="hover:text-pink-600">免責事項・広告表記</a>
        </nav>
        <p class="text-xs text-neutral-400">当サイトは楽天アフィリエイト・バリューコマースなどの広告を利用しており、商品リンクから収益を得ることがあります。</p>
        <p>&copy; {new Date().getFullYear()} OsoroCosme</p>
      </div>
    </footer>
  </body>
</html>
