---
import { cosmeticSlug, withBase, largerRakutenImage, type CosmeticTileData } from "../lib/data";

interface Props {
  tile: CosmeticTileData;
  /** ランキング上位の順位バッジ（1〜3位は色付き） */
  rank?: number;
  /** 補足の1行（例: 「3本の動画で一緒に紹介」） */
  caption?: string;
  /** 現在表示中の商品なら枠を強調する */
  current?: boolean;
  showBrand?: boolean;
}

const { tile, rank, caption, current = false, showBrand = true } = Astro.props;
---

<a
  href={withBase(`/cosmetics/${cosmeticSlug(tile.brand_id, tile.name_id)}`)}
  class:list={["min-w-0 block group", { "outline outline-1 outline-rose outline-offset-4 rounded-2xl": current }]}
>
  <div class="product-well relative aspect-square rounded-2xl flex items-center justify-center overflow-hidden">
    {
      tile.imageSrc ? (
        <img
          src={largerRakutenImage(tile.imageSrc, 400)}
          alt={`${tile.brand} ${tile.name}`}
          class="w-full h-full object-contain p-[11%] transition-transform duration-[1.2s] ease-out-expo group-hover:scale-[1.06]"
          loading="lazy"
          onerror="this.replaceWith(Object.assign(document.createElement('span'),{className:'noimg',textContent:'No image'}))"
        />
      ) : (
        <span class="noimg">No image</span>
      )
    }
    {
      rank !== undefined && (
        <span class:list={["absolute top-0 left-0 num-display italic leading-none bg-paper rounded-br-2xl pl-3 pr-3.5 pt-1.5 pb-2", rank <= 3 ? "text-rose text-[28px]" : "text-ink/60 text-[22px]"]}>
          {rank}
        </span>
      )
    }
  </div>
  {showBrand && <p class="mt-3 text-[10px] tracking-[0.14em] uppercase text-neutral-500 truncate">{tile.brand}</p>}
  <p class:list={["text-[13px] leading-snug line-clamp-2 group-hover:text-rose transition-colors", showBrand ? "mt-1" : "mt-3"]}>{tile.name}</p>
  {caption && <p class="mt-1.5 text-[11px] text-neutral-500">{caption}</p>}
</a>
