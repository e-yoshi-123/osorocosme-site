---
import { cosmeticSlug, withBase, largerRakutenImage, type CosmeticTileData } from "../lib/data";

interface Props {
  tile: CosmeticTileData;
  /** ランキング上位の順位バッジ（1〜3位は色付き） */
  rank?: number;
  /** 補足の1行（例: 「3本の動画で一緒に紹介」） */
  caption?: string;
  /** 現在表示中の商品なら枠を強調する */
  current?: boolean;
  showBrand?: boolean;
}

const { tile, rank, caption, current = false, showBrand = true } = Astro.props;
---

<a
  href={withBase(`/cosmetics/${cosmeticSlug(tile.brand_id, tile.name_id)}`)}
  class:list={["min-w-0 block group", { "outline outline-1 outline-rose outline-offset-4 rounded-2xl": current }]}
>
  <div class="product-well overflow-hidden tile-4">
    {
      tile.imageSrc ? (
        <img
          src={largerRakutenImage(tile.imageSrc, 400)}
          alt={`${tile.brand} ${tile.name}`}
          class="tile-1"
          loading="lazy"
          data-err="noimg"
        />
      ) : (
        <span class="noimg">No image</span>
      )
    }
    {
      rank !== undefined && (
        <span class={rank <= 3 ? "num-display tile-r1" : "num-display tile-r2"}>
          {rank}
        </span>
      )
    }
  </div>
  {showBrand && <p class="tile-3">{tile.brand}</p>}
  <p class:list={["phrase tile-name", showBrand ? "mt-1" : "mt-3"]}>{tile.name}</p>
  {caption && <p class="u-2">{caption}</p>}
</a>
