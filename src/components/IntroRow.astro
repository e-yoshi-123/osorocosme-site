---
import { formatDateDot, withBase, profilePagesOf, type CosmeticIntro } from "../lib/data";
import PrBadge from "./PrBadge.astro";
import ProfileChips from "./ProfileChips.astro";

interface Props {
  i: CosmeticIntro;
  /** 新しい順での位置（並び替えを戻すときの基準） */
  pos: number;
  /** 公開中の肌悩みページの slug（チップをリンクにする） */
  concernPages: Set<string>;
  /** スクリプトなしでは隠す行（先頭10件より後） */
  extra?: boolean;
  /** この動画で使った色（公式の並びの番号と表示名。商品ページの色で絞り込むのに使う。363章） */
  colors?: { idx: number; label: string; hex?: string }[];
}

const { i, pos, concernPages, extra = false, colors = [] } = Astro.props;
const views = i.views >= 10_000 ? `${(i.views / 10_000).toFixed(1).replace(/\.0$/, "")}万回` : `${i.views.toLocaleString("ja-JP")}回`;
// 発言（言及）は、効能を言い切るものを除いた先頭2つ（301章）。肌悩みの節は、その発言に含まれていれば重ねて出さない
const quotes = i.quotes;
// 同じ節が複数の悩みに当たることがある（「赤み・クマをカバー」など）ので、発言は重ねて出さない
const concernQuotes = [...new Set(i.concerns.map((c) => c.quote).filter(Boolean))].filter((q) => !quotes.some((m) => m.includes(q))); // 効能を言い切る発言は空（253章）
---

{/*
  コスメ詳細「いつ・誰が紹介したか」の1行。
  PC（1024px以上。タブレット幅では動画の題の列が70pxほどにつぶれるので、スマホと同じ2段にする。195章）: 固定幅の3列（日付 / チャンネル / 動画）。動画の列はサムネイル＋タイトル（最大2行、全文は title 属性）。
  スマホ: 1行目に「日付＋チャンネル」、2行目にサムネイル＋タイトル（最大3行）。
  チャンネルの下に発信力（インフルエンサー一覧と同じスコアの順位と、それを5段階にした●）、動画の下に再生回数、肌悩みに触れた紹介なら悩みのチップと発言を出す（228章）。
  data-* は並び替え（新しい順・再生数順・発信力順）のスクリプトが使う。
*/}
<li
  class="intro-row intro-1"
  data-pos={pos}
  data-views={i.views}
  data-score={i.influenceScore}
  data-prof={profilePagesOf(i.channel_id).map((p) => p.key).join(" ")}
  data-colors={colors.map((c) => c.idx).join(" ")}
  hidden={extra}
>
  <div class="intro-7">
    <span class="num-display intro-4">{formatDateDot(i.published_at)}</span>
    <div class="min-w-0">
      <a href={withBase(`/influencer/${i.channel_id}`)} class="intro-5" title={i.channel_title}>
        {i.channel_icon && <img referrerpolicy="no-referrer" src={i.channel_icon} alt={i.channel_title} data-name={i.channel_title} width="28" height="28" class="intro-10" loading="lazy" />}
        <span class="truncate">{i.channel_title}</span>
      </a>
      {/* 本人が言ったパーソナルカラー・肌質（311章）。パーソナルカラー・肌質のページから来た人が、誰が同じかを見分けられるように */}
      <ProfileChips channel_id={i.channel_id} class="mt-1" />
      {
        i.influence > 0 && (
          <a href={withBase("/influencer-list")} class="intro-3" title={`発信力 ${i.influence}/5（発信力スコア${i.influenceRank}位。掲載動画数・紹介コスメ数からOsoroCosmeが算出）`}>
            <span class="intro-11" role="img" aria-label={`発信力 5段階中${i.influence}`}>
              {[1, 2, 3, 4, 5].map((n) => (
                <span class={n <= i.influence ? "intro-d1" : "intro-d0"} />
              ))}
            </span>
            <span>発信力{i.influenceRank}位</span>
          </a>
        )
      }
    </div>
  </div>
  <div class="min-w-0">
    <a href={withBase(`/video/${i.videoKey}`)} class="group intro-8" title={i.videoTitle}>
      {i.thumbnail && <span class="intro-15"><img src={i.thumbnail} alt={i.videoTitle} class="u-3" loading="lazy" /></span>}
      <span class="min-w-0">
        <span class="intro-2">{i.pr && <PrBadge own={i.own} class="mr-1.5 align-[1px]" />}{i.videoTitle}</span>
        {i.views > 0 && <span class="intro-9">YouTube再生 {views}</span>}
      </span>
    </a>
    {colors.length > 0 && (
      <p class="intro-9 mt-1 flex flex-wrap items-center gap-x-2 gap-y-0.5">
        <span>使った色：</span>
        {colors.map((c) => <span class="inline-flex items-center gap-1">{c.hex && <span class="inline-block w-3 h-3 rounded-full border border-ink/15 shrink-0" style={`background:${c.hex}`} aria-hidden="true" />}{c.label}</span>)}
      </p>
    )}
    {/* 発言（字幕からの言及の要約）と、肌悩みに触れた紹介ならそのチップ。発言は「商品名 使ってみた」のような検索に当たる本文でもある（301章） */}
    {
      (quotes.length > 0 || i.concerns.length > 0) && (
        <div class="intro-13">
          {quotes.map((q) => <span class="block">「{q}」</span>)}
          {i.concerns.length > 0 && (
            <span class:list={["block", quotes.length > 0 && "mt-1"]}>
              <span class="intro-14">
                <span class="u-11">肌悩み</span>
                {i.concerns.map((c) =>
                  concernPages.has(c.slug) ? (
                    <a href={withBase(`/concern/${c.slug}/`)} class="intro-t">{c.name}</a>
                  ) : (
                    <span class="text-xs text-neutral-600 border border-ink/15 rounded-full px-2 py-0.5">{c.name}</span>
                  )
                )}
              </span>
              <span class="align-middle">{concernQuotes.map((q) => `「${q}」`).join("")}</span>
            </span>
          )}
        </div>
      )
    }
  </div>
</li>
