---
import { formatJaDate, withBase } from "../lib/data";

interface Props {
  i: { channel_id: string; channel_title: string; channel_icon?: string; videoKey: string; videoTitle: string; published_at: string };
}

const { i } = Astro.props;
---

<!--
  コスメ詳細「いつ・誰が紹介したか」の1行。
  PC: 固定幅の3列（日付 / チャンネル / 動画）で、長い名前・タイトルは1行で省略（全文は title 属性）。
  スマホ: 1行目に「日付＋チャンネル」、2行目に動画タイトル（最大2行）。
-->
<li class="px-4 py-3 md:py-2.5 grid grid-cols-1 gap-y-1 md:grid-cols-[8rem_14rem_minmax(0,1fr)] md:gap-x-4 md:items-center">
  <div class="flex items-center gap-3 min-w-0 md:contents">
    <span class="shrink-0 text-xs md:text-sm text-neutral-500 whitespace-nowrap">{formatJaDate(i.published_at)}</span>
    <a href={withBase(`/influencer/${i.channel_id}`)} class="flex items-center gap-2 min-w-0 font-medium hover:text-pink-600" title={i.channel_title}>
      {i.channel_icon && <img src={i.channel_icon} alt="" class="w-5 h-5 rounded-full shrink-0" loading="lazy" />}
      <span class="truncate">{i.channel_title}</span>
    </a>
  </div>
  <a href={withBase(`/video/${i.videoKey}`)} class="min-w-0 text-neutral-600 hover:text-pink-600 line-clamp-2 md:line-clamp-1" title={i.videoTitle}>{i.videoTitle}</a>
</li>
