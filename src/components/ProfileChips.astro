---
// 人のパーソナルカラー・肌質の小さな札（商品ページの紹介の行。311章）。本人が言ったもの（influencer-profile.json）だけ。
// パーソナルカラーは色見本の丸、肌質はしずくの印。ページがあれば、そのパーソナルカラー・肌質のページへ
import { profileBadges, withBase } from "../lib/data";

interface Props {
  channel_id: string;
  class?: string;
}
const { channel_id, class: cls } = Astro.props;
const badges = profileBadges(channel_id).filter((b) => b.kind !== "face");
const swatchBg = (c: string[]) => (c.length > 1 ? `conic-gradient(${c.map((x, i) => `${x} ${(i * 360) / c.length}deg ${((i + 1) * 360) / c.length}deg`).join(", ")})` : c[0]);
---

{
  badges.length > 0 && (
    <span class:list={["pchips", cls]}>
      {badges.map((b) => {
        const inner = (
          <>
            {b.kind === "pc" && b.swatch && b.swatch.length > 0 && <span class="pchip-sw" style={`background:${swatchBg(b.swatch)}`} aria-hidden="true" />}
            {b.kind === "skin" && (
              <svg viewBox="0 0 12 12" class="pchip-ic" aria-hidden="true"><path d="M6 1.2C6 1.2 2.6 5 2.6 7.3A3.4 3.4 0 0 0 9.4 7.3C9.4 5 6 1.2 6 1.2Z" fill="currentColor" opacity=".75" /></svg>
            )}
            <span class="truncate">{b.label.replace(/（.*?）/g, "")}</span>
          </>
        );
        const c = "pchip";
        return b.href ? (
          <a href={withBase(b.href)} class="pchip pchip-a" title={`${b.kind === "pc" ? "パーソナルカラー" : "肌質"}：${b.label}（本人が言ったもの）`}>{inner}</a>
        ) : (
          <span class={c} title={`${b.kind === "pc" ? "パーソナルカラー" : "肌質"}：${b.label}（本人が言ったもの）`}>{inner}</span>
        );
      })}
    </span>
  )
}
