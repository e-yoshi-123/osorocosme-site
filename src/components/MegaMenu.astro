---
// ヘッダーの「探す」を押すと上から降りてくる領域（パソコン、lg以上。248章）。
// カテゴリ（ランキング）・肌悩み・成分・特集を一望できるようにする。開け閉めは Layout.astro のスクリプト（data-menu-toggle）。
// HTMLに入れておくので、閉じていても検索エンジンはリンクをたどれる。スマホのメニュー（MobileMenu）も、このリンクから組み立てる（280章）。
import { getMenuData, withBase } from "../lib/data";

const m = getMenuData();
const cols = [
  // 幅（12列のうち）：カテゴリ5・肌悩み2・成分3（2列に並べる）・特集2
  // パーソナルカラー（309章）・肌質（310章）は列を増やさず、肌悩みの列の下に続ける（12列が埋まっているため）
  { title: "肌悩みから探す", all: "/concern/", items: m.concerns, span: "col-span-2", twoCols: false, subs: [{ title: "パーソナルカラー", all: "/personal-color/", items: m.personalColors }, { title: "肌質", all: "/skin-type/", items: m.skinTypes }].filter((x) => x.items.length > 0) },
  { title: "成分から探す", all: "/ingredient/", items: m.ingredients, span: "col-span-3", twoCols: true },
  // メイクレシピ（283章）は、特集の列の先頭に置く（ページが1つだけなので列は立てない）
  { title: "特集", all: "/feature/", items: [{ path: "/recipe/", label: "メイクレシピ" }, ...m.features], span: "col-span-2", twoCols: false },
].filter((c) => c.items.length > 0);
---

<div id="mega-menu" data-menu hidden class="mega-2">
  <div class="mega-3">
    <section class="col-span-5" aria-labelledby="mega-cat">
      <p class="mega-5">
        <span id="mega-cat" class="label-caps text-neutral-500">カテゴリから探す</span>
        <a href={withBase("/ranking/")} class="mega-4">すべてのカテゴリ →</a>
      </p>
      <div class="mega-6">
        {m.categories.map((g) => (
          <div>
            <p class="text-neutral-500 u-24">{g.group}</p>
            <ul class="space-y-1 mega-links">
              {g.items.map((it) => <li><a href={withBase(it.path)}>{it.label}</a></li>)}
            </ul>
          </div>
        ))}
      </div>
    </section>
    {cols.map((c) => (
      <section class:list={[c.span, "mega-7"]}>
        <p class="mega-1">
          <span class="label-caps text-neutral-500">{c.title}</span>
          <a href={withBase(c.all)} class="u-9">一覧 →</a>
        </p>
        <ul class:list={["mega-links", c.twoCols ? "grid grid-cols-2 gap-x-4 gap-y-1" : "space-y-1"]}>
          {c.items.map((it) => <li><a href={withBase(it.path)}>{it.label}</a></li>)}
        </ul>
        {("subs" in c ? c.subs ?? [] : []).map((sub) => (
          <>
            <p class="mega-1 mt-6">
              <span class="label-caps text-neutral-500">{sub.title}</span>
              <a href={withBase(sub.all)} class="u-9">一覧 →</a>
            </p>
            <ul class="mega-links space-y-1">
              {sub.items.map((it) => <li><a href={withBase(it.path)}>{it.label}</a></li>)}
            </ul>
          </>
        ))}
      </section>
    ))}
  </div>
</div>
