---
import { cosmeticSlug, formatCount, formatDateDot, getInfluencerHighlights, withBase, type InfluencerRanking } from "../lib/data";

interface Props {
  influencer: InfluencerRanking;
  rank: number;
  /** large: 動画3本＋コスメ6点（上位向け） / medium: 最新動画1本＋コスメ4点 */
  size: "large" | "medium";
}

const { influencer: inf, rank, size } = Astro.props;
const large = size === "large";
const h = getInfluencerHighlights(inf.channel_id, large ? 3 : 1, large ? 6 : 4);
const href = withBase(`/influencer/${inf.channel_id}`);
---

<!--
  親のグリッドの4行（見出し・動画・コスメ・リンク）を subgrid で共有する。横に並んだカードどうしで
  各段の位置と高さが揃い、名前・タグ・統計・動画タイトルの折り返しの違いでずれない。
  （親側は gap-y-0、行間は各カードの gap-y-4 と mb-4 で取る）
-->
<div class="min-w-0 rounded-[24px] border border-ink/10 bg-panel p-5 mb-6 grid grid-cols-1 grid-rows-subgrid row-span-4 gap-y-5 transition-shadow duration-500 hover:shadow-[0_24px_48px_-28px_rgba(29,21,23,0.35)]">
  <!-- 見出し：順位・アイコン・名前・実績 -->
  <div class="flex items-start gap-3">
    <span class:list={["shrink-0 num-display leading-none w-7", large ? "text-[30px]" : "text-[22px]", rank <= 3 ? "text-rose" : "text-neutral-400"]}>{rank}</span>
    {inf.channel_icon && <img referrerpolicy="no-referrer" src={inf.channel_icon} alt={inf.channel_title} data-name={inf.channel_title} width={large ? 56 : 44} height={large ? 56 : 44} class:list={["rounded-full shrink-0 ring-1 ring-ink/5", large ? "w-14 h-14" : "w-11 h-11"]} loading="lazy" />}
    <div class="min-w-0 flex-1">
      <a href={href} class:list={["font-semibold leading-snug line-clamp-2 mb-0.5 hover:text-rose transition-colors", large ? "text-lg" : "text-base"]}>{inf.channel_title}</a>
      <p class="text-xs text-neutral-500 flex flex-wrap gap-x-2">
        <span class="whitespace-nowrap">登録者 {formatCount(inf.subscriber_count)}人</span>
        <span class="whitespace-nowrap">動画 {inf.videoCount}本</span>
        <span class="whitespace-nowrap">コスメ {inf.cosmeticCount}品</span>
      </p>
      {
        h.topTags.length > 0 && (
          <div class="mt-1.5">
            <p class="sr-only">紹介が多いカテゴリ</p>
            <div class="flex gap-1 flex-wrap">
              {h.topTags.map((t) => (
                <span class="text-xs border border-ink/15 rounded-full px-2 py-0.5 text-neutral-600">{t}</span>
              ))}
            </div>
          </div>
        )
      }
    </div>
  </div>

  <!-- 最新の動画 -->
  {
    h.latestVideos.length > 0 ? (
      <div>
        <p class="label-caps text-neutral-500 mb-2">Latest videos</p>
        {large ? (
          <div class="grid grid-cols-3 gap-2">
            {h.latestVideos.map((v) => (
              <a href={withBase(`/video/${v.key}`)} class="min-w-0 block group">
                <img src={v.thumbnail} alt={v.title} class="w-full aspect-video object-cover rounded-lg" loading="lazy" />
                <p class="mt-1 text-xs leading-snug line-clamp-2 group-hover:text-rose">{v.title}</p>
                <p class="mt-0.5 num-display font-normal text-xs text-neutral-400 whitespace-nowrap">{formatDateDot(v.published_at)}</p>
              </a>
            ))}
          </div>
        ) : (
          h.latestVideos.map((v) => (
            <a href={withBase(`/video/${v.key}`)} class="flex items-center gap-2 group">
              <img src={v.thumbnail} alt={v.title} class="w-24 aspect-video object-cover rounded-lg shrink-0" loading="lazy" />
              <span class="min-w-0">
                <span class="text-xs leading-snug line-clamp-3 group-hover:text-rose">{v.title}</span>
                <span class="block mt-0.5 num-display font-normal text-xs text-neutral-400 whitespace-nowrap">{formatDateDot(v.published_at)}</span>
              </span>
            </a>
          ))
        )}
      </div>
    ) : (
      <div />
    )
  }

  <!-- よく紹介するコスメ -->
  {
    h.topCosmetics.length > 0 ? (
      <div>
        <p class="label-caps text-neutral-500 mb-2">Favorite cosmetics</p>
        <div class:list={["grid gap-2", large ? "grid-cols-3" : "grid-cols-4"]}>
          {h.topCosmetics.map((c) => (
            <a href={withBase(`/cosmetics/${cosmeticSlug(c.brand_id, c.name_id)}`)} class="min-w-0 block group" title={`${c.brand} ${c.name}`}>
              <div class="product-well aspect-square rounded-xl flex items-center justify-center overflow-hidden">
                <img
                  src={c.imageSrc}
                  alt={`${c.brand} ${c.name}`}
                  class="w-[86%] h-[86%] object-contain"
                  loading="lazy"
                  onerror="this.replaceWith(Object.assign(document.createElement('span'),{className:'noimg',textContent:'No image'}))"
                />
              </div>
              <p class="mt-1 text-xs leading-snug line-clamp-2 group-hover:text-rose">{c.name}</p>
              {c.videoCount > 1 && <p class="text-xs text-neutral-400">{c.videoCount}本で紹介</p>}
            </a>
          ))}
        </div>
      </div>
    ) : (
      <div />
    )
  }

  <a href={href} class="link-u text-xs self-end justify-self-end" aria-label={`${inf.channel_title}の使用コスメをすべて見る`}>使用コスメをすべて見る →</a>
</div>
