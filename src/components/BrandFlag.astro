---
// ブランド名の前に付ける小さな国旗（brand-meta.json の国。不明なら何も出さない）。
// 画像は public/flags/（flag-icons 7.5.0 の4:3版、MIT。public/flags/LICENSE.txt）
import { getBrandCountry, COUNTRY_NAMES } from "../lib/data";

interface Props {
  brand_id: string;
  class?: string;
}
const { brand_id, class: cls } = Astro.props;
const code = getBrandCountry(brand_id);
const name = code ? COUNTRY_NAMES[code] ?? code : "";
const base = (import.meta.env.BASE_URL || "/").replace(/\/?$/, "/");
---

{code && (
  <img src={`${base}flags/${code.toLowerCase()}.svg`} alt={name} title={`${name}のブランド`} width="14" height="10" loading="lazy" decoding="async" class:list={["brand-flag", cls]} />
)}
