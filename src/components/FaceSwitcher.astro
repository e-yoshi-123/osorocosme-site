---
// メイクレシピの顔の色の版を見比べる切り替え（試作のあいだだけ、283章）。選んだ版はこの端末に覚えておく（localStorage）。
// 版を決めたら、FACE_DEFAULT を決めた版にして、この部品を外す
import { FACE_VARIANTS, FACE_DEFAULT } from "../lib/recipe";
import { withBase } from "../lib/data";
const base = withBase("/recipe/faces/");
---

<div class="fsw" data-base={base} data-default={FACE_DEFAULT} role="group" aria-label="顔の色（試作）">
  <p class="fsw-h">顔の色<small>試作</small></p>
  <div class="fsw-list">
    {FACE_VARIANTS.map((v) => (
      <button type="button" class="fsw-btn" data-face={v.key} style={`--h:${v.hair}`} aria-pressed={v.key === FACE_DEFAULT ? "true" : "false"}>
        <span class="fsw-dot" aria-hidden="true"></span>{v.label}
      </button>
    ))}
  </div>
</div>

<script>
  const box = document.querySelector<HTMLElement>(".fsw");
  if (box) {
    const base = box.dataset.base!;
    const apply = (key: string) => {
      document.querySelectorAll("[data-face-src]").forEach((el) => el.setAttribute("href", `${base}face-${key}.webp`));
      box.querySelectorAll<HTMLButtonElement>(".fsw-btn").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.face === key)));
    };
    let saved: string | null = null;
    try { saved = localStorage.getItem("osoro-recipe-face"); } catch {}
    if (saved && box.querySelector(`[data-face="${saved}"]`)) apply(saved);
    box.addEventListener("click", (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>(".fsw-btn");
      if (!b) return;
      apply(b.dataset.face!);
      try { localStorage.setItem("osoro-recipe-face", b.dataset.face!); } catch {}
    });
  }
</script>

<style is:global>
  .fsw { position: fixed; right: 16px; bottom: 16px; z-index: 40; max-width: calc(100vw - 32px); padding: 10px 12px; border-radius: 18px; background: color-mix(in srgb, var(--c-panel) 92%, transparent); backdrop-filter: blur(10px); box-shadow: 0 0 0 1px rgb(134 10 70 / .1), 0 18px 40px -20px rgb(29 21 23 / .45); }
  .fsw-h { font-size: 11px; font-weight: 700; letter-spacing: .08em; margin-bottom: 6px; }
  .fsw-h small { margin-left: 6px; font-weight: 400; color: var(--color-rose); }
  .fsw-list { display: flex; flex-wrap: wrap; gap: 6px; }
  .fsw-btn { display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px 4px 5px; border-radius: 999px; font-size: 12px; border: 1px solid rgb(29 21 23 / .12); background: #fff; transition: border-color .3s, background-color .3s; }
  .fsw-btn:hover { border-color: var(--color-ink); }
  .fsw-btn[aria-pressed="true"] { border-color: var(--color-ink); background: var(--color-ink); color: var(--color-paper); }
  .fsw-dot { width: 16px; height: 16px; border-radius: 999px; background: var(--h); box-shadow: inset 0 0 0 1px rgb(29 21 23 / .15); }
  @media (pointer: coarse) { .fsw-btn { min-height: 36px; } }
  @media (max-width: 639px) { .fsw { left: 16px; right: 16px; } }
</style>
