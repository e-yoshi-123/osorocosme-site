---
import { withBase, type InfluencerMatch } from "../lib/data";

interface Props {
  title: string;
  items: InfluencerMatch[];
  unit: string; // 件数の添え書き（例：「共通のコスメ」）
}

const { title, items, unit } = Astro.props;
---

<!-- 人のページへの内部リンク（似た人・カテゴリをよく紹介している人）。履歴171章 -->
{
  items.length > 0 && (
    <section class="mb-12">
      <h2 class="font-bold mb-3">{title}</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3">
        {items.map((i) => (
          <a href={withBase(`/influencer/${i.channel_id}`)} class="min-w-0 bg-white rounded-lg shadow-sm p-3 flex items-center gap-3 hover:shadow-md">
            {i.channel_icon ? (
              <img referrerpolicy="no-referrer" src={i.channel_icon} alt="" data-name={i.channel_title} width="40" height="40" class="w-10 h-10 rounded-full shrink-0" loading="lazy" />
            ) : (
              <div class="w-10 h-10 rounded-full shrink-0 bg-pink-50" />
            )}
            <div class="min-w-0">
              <p class="text-sm font-medium truncate">{i.channel_title}</p>
              <p class="text-xs text-neutral-400">{unit} {i.count}品</p>
            </div>
          </a>
        ))}
      </div>
    </section>
  )
}
