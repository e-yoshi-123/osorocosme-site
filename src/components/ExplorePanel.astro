---
// 検索欄に何も入力せずに触れたときに出す「探し方」のパネル（247章）。
// 上のメニューを4項目に絞った代わりに、肌悩み・成分・特集の入口をここに並べる。
// 開け閉めは scripts/search-suggest.ts（data-explore）。HTMLに入れておくので、閉じていてもリンクはたどれる。
import { getExploreEntries, withBase } from "../lib/data";

const entries = getExploreEntries();
const groups = [
  { kind: "肌悩み", title: "肌悩みから探す", all: "/concern/" },
  { kind: "成分", title: "成分から探す", all: "/ingredient/" },
  { kind: "特集", title: "特集", all: "/feature/" },
].map((g) => ({ ...g, items: entries.filter((e) => e.kind === g.kind) })).filter((g) => g.items.length > 0);
---

<div data-explore hidden class="absolute left-0 right-0 top-full mt-2 max-md:fixed max-md:inset-x-3 max-md:top-[3.75rem] max-md:mt-0 z-50 max-h-[min(75vh,32rem)] overflow-y-auto overscroll-contain rounded-2xl bg-white text-ink text-left shadow-[0_12px_40px_-12px_rgba(0,0,0,0.25)] ring-1 ring-ink/10 px-4 py-3">
  {
    groups.map((g) => (
      <div class="py-2">
        <p class="flex items-baseline justify-between mb-2">
          <span class="label-caps text-[10px] text-neutral-400">{g.title}</span>
          <a href={withBase(g.all)} class="text-xs text-neutral-500 hover:text-rose">一覧 →</a>
        </p>
        <p class="flex flex-wrap gap-1.5">
          {g.items.map((e) => (
            <a href={withBase(e.path)} class="text-xs border border-ink/15 rounded-full px-2.5 py-1 hover:border-rose hover:text-rose transition-colors">{e.label}</a>
          ))}
        </p>
      </div>
    ))
  }
  <p class="pt-2 mt-1 border-t border-ink/10 text-xs text-neutral-500">コスメ・ブランド・インフルエンサーの名前、カテゴリ（例：化粧水）でも探せます</p>
</div>
