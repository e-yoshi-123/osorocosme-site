---
// 見出しの組：番号（欧文の数字）・欧文のラベル・日本語の題・右端のリンク（カードに載せるので下の罫線は無し。190章）
interface Props { num?: string; en: string; title: string; lead?: string; href?: string; cta?: string; id?: string }
const { num, en, title, lead, href, cta = "View all", id } = Astro.props;
---
<header class="reveal shead-4" id={id}>
  <div class="shead-2">
    <div class="min-w-0">
      <p class="eyebrow mb-2">{num && <span class="num-display shead-3">{num}</span>}{en}</p>
      <h2 class="font-serif h-section u-25">{title}</h2>
    </div>
    {href && (
      <a href={href} class="group shead-a">
        <span class="link-u hidden sm:inline">{cta}</span><span class="sr-only sm:hidden">{cta}</span>
        <span class="u-5" aria-hidden="true">→</span>
      </a>
    )}
  </div>
  {lead && <p class="u-8">{lead}</p>}
</header>
