---
// 見出しの組：番号（欧文の数字）・欧文のラベル・日本語の題・右端のリンク・下の罫線（試作）
interface Props { num?: string; en: string; title: string; lead?: string; href?: string; cta?: string; id?: string }
const { num, en, title, lead, href, cta = "View all", id } = Astro.props;
---
<header class="reveal mb-8 md:mb-12" id={id}>
  <div class="flex items-end justify-between gap-6 pb-4 border-b border-ink/15">
    <div class="min-w-0">
      <p class="eyebrow mb-2">{num && <span class="num-display text-ink/40 mr-2">{num}</span>}{en}</p>
      <h2 class="font-serif text-[26px] md:text-[34px] leading-[1.3] font-semibold text-balance">{title}</h2>
    </div>
    {href && (
      <a href={href} class="group shrink-0 inline-flex items-center gap-2 text-xs font-bold tracking-[0.2em] uppercase pb-2">
        <span class="link-u hidden sm:inline">{cta}</span><span class="sr-only sm:hidden">{cta}</span>
        <span class="inline-flex w-8 h-8 rounded-full border border-ink/20 items-center justify-center transition-all duration-500 ease-out-expo group-hover:bg-ink group-hover:text-paper group-hover:border-ink" aria-hidden="true">→</span>
      </a>
    )}
  </div>
  {lead && <p class="mt-4 text-sm text-neutral-600 max-w-2xl leading-relaxed">{lead}</p>}
</header>
