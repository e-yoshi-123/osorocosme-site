---
import BrandFlag from "./BrandFlag.astro";
import { amazonSearchUrl, cosmeticSlug, formatCount, withBase } from "../lib/data";

interface Props {
  /** 現在の表示順での順位（並び替えのたびにスクリプトが書き換える） */
  rank: number;
  /** 標準（人気スコア順）での順位。並び替えの基準。 */
  base: number;
  brand_id: string;
  brand: string;
  name_id: string;
  name: string;
  imageSrc: string;
  videoCount: number;
  channelCount: number;
  price?: number;
  link?: string;
  /** Yahoo!ショッピングのアフィリエイトリンク。楽天の画像の有無とは別に、あれば出す */
  yahooLink?: string;
  /** 画像・価格がYahoo!ショッピングのものか（楽天の画像が無い商品。115章） */
  fromYahoo?: boolean;
  /** 標準順位が表示上限を超える行（スクリプトなしでは非表示） */
  extra?: boolean;
  /** 「まとめ」ランキングで、その商品がどの細かいカテゴリか（例: リキッドファンデーション） */
  subLabel?: string;
  /** 直近RECENT_DAYS日に投稿された動画での紹介数（「最近話題」の並び替え用） */
  recentVideos?: number;
  recentChannels?: number;
  recentDays?: number;
  /** 肌悩みのページで、根拠の発言（言及）とその投稿者を商品名の下に出す（228章） */
  quote?: string;
  quoteBy?: string;
  /** 成分のページで、全成分の表示名と出典を商品名の下に出す（246章） */
  note?: string;
}

const { rank, base, brand_id, brand, name_id, name, imageSrc, videoCount, channelCount, price, link, yahooLink, fromYahoo = false, extra = false, subLabel, recentVideos = 0, recentChannels = 0, recentDays = 90, quote, quoteBy, note } = Astro.props;
const top = rank <= 3;
// 画像の無い商品（＝楽天側に出品が無い・画像が消えている）は、購入できないリンクの可能性が高いので、価格・購入ボタンを出さない。
// 画像のURLはあっても、実際に読み込めない場合は、下の onerror で価格・購入ボタンを取り除く。
const buyable = !!imageSrc;
const amazonLink = amazonSearchUrl(brand, name);
const href = withBase(`/cosmetics/${cosmeticSlug(brand_id, name_id)}`);
---

{/*
  ランキングの1行（一覧全体は親で1つの表にまとめる）。広い枠: 順位／画像／商品名／実績／価格と購入ボタンの5列（親に列の見出しがある）。狭い枠: 1段目に順位・画像・商品名、2段目に実績、3段目に価格と購入ボタン。
  切り替えは画面の幅ではなく、親の枠（@container）の幅で決める。画面の幅で決めていたときは、左にカテゴリ一覧がある768〜1100pxで商品名の列が20pxほどにつぶれ、名前が縦に1文字ずつ並んでいた（195章）。
  data-* と rank-badge は、カテゴリページの並び替え・「もっと見る」のスクリプトが使う。
*/}
<li
  id={`item-${brand_id}-${name_id}`}
  class:list={["ranking-row group/row rrow-g scroll-mt-32", { "is-top": top }]}
  data-base={base}
  data-videos={videoCount}
  data-channels={channelCount}
  data-recent-videos={recentVideos}
  data-recent-channels={recentChannels}
  hidden={extra}
>
  <span class="rank-badge num-display rrow-13">{rank}</span>
  <a href={href} class="product-well rrow-16" tabindex="-1" aria-hidden="true">
    {
      imageSrc ? (
        <img
          src={imageSrc}
          alt={`${brand} ${name}`}
          class="rrow-7"
          loading="lazy"
          data-err="noimg-row"
        />
      ) : (
        <span class="noimg">No image</span>
      )
    }
  </a>
  <a href={href} class="min-w-0 group">
    <span class="rrow-11"><BrandFlag brand_id={brand_id} />{brand}</span>
    <span class="phrase rrow-8">{name}</span>
    {subLabel && <span class="rrow-15">{subLabel}</span>}
    {quote && <span class="block mt-1.5 text-[13px] leading-relaxed text-neutral-600 line-clamp-2">「{quote}」{quoteBy && <span class="text-neutral-500">（{quoteBy}）</span>}</span>}
    {note && <span class="block mt-1 text-xs leading-relaxed text-neutral-500 line-clamp-2 [overflow-wrap:anywhere]">{note}</span>}
  </a>
  <p class="rrow-9">
    <span class="whitespace-nowrap">動画 <b class="num-display rrow-12">{videoCount}</b>本</span>
    <span class="mx-1.5 text-ink/20">|</span>
    <span class="whitespace-nowrap"><b class="num-display rrow-12">{channelCount}</b>人</span>
    {/* 「最近話題」の並び替えのときだけスクリプトが表示する */}
    <span class="recent-info hidden rrow-ri block">直近{recentDays}日：{recentVideos}本 / {recentChannels}チャンネル</span>
  </p>
  <div class="rrow-2">
    {buyable && price !== undefined && <span data-buy class="num-display rrow-14" title={fromYahoo ? "Yahoo!ショッピングの参考価格" : "楽天市場の参考価格"}>¥{formatCount(price)}</span>}
    {/* 楽天・Yahoo!・Amazonのボタンを短いラベルで横に並べる（列が狭いため。正式名は aria-label と title に入れる）。
         Yahoo!・Amazonのボタンには data-buy を付けないので、楽天の画像が読み込めずに楽天のボタンが消えても残る。
         ボタンは幅を決めた3つの枠に置く。狭い枠では3つ並ぶと幅が足りないため、この段を左端（順位の列）から始め、それでも足りない幅（320px）ではボタンを価格の下に回す。どれかが無い行でも、価格とボタンの位置が他の行と縦に揃う（205章）。
         Amazonは商品を特定しない検索結果へのリンクなので、全商品に出す。3つとも同じ白い枠にして、どこか1社を特別扱いしない（206章） */}
    <div class="rrow-5">
      {
        buyable && link && (
          <a data-buy href={link} target="_blank" rel="nofollow sponsored noopener" aria-label="楽天市場で見る" title="楽天市場で見る" class="rrow-3">
            楽天
          </a>
        )
      }
      {
        yahooLink && (
          <a href={yahooLink} target="_blank" rel="nofollow sponsored noopener" aria-label="Yahoo!ショッピングで見る" title="Yahoo!ショッピングで見る" class="rrow-4">
            Yahoo!
          </a>
        )
      }
      <a href={amazonLink} target="_blank" rel="nofollow sponsored noopener" aria-label="Amazonで探す" title="Amazonで探す（検索結果）" class="rrow-1">
        Amazon
      </a>
    </div>
  </div>
</li>
