---
import { formatCount, formatDateDot, formatDuration, withBase, getCosmeticListEntry, productImageSrc, getPrInfo, isShort, ytThumb, type VideoEntry } from "../lib/data";
import PrBadge from "./PrBadge.astro";

interface Props {
  video: VideoEntry;
}

const { video } = Astro.props;
// この動画で紹介されたコスメ。以前は先頭2品の名前を文字で出していたが、途中で切れて読めず、
// どの動画も同じ見た目になっていた。画像を並べて「何が出てくる動画か」が分かるようにする（196章）
const items = (video.cosmetics || []).filter((c) => c.brand && c.name && c.brand_id && c.name_id);
const seen = new Set<string>();
const thumbs = items
  .map((c) => ({ src: productImageSrc(getCosmeticListEntry(c.brand_id, c.name_id), c.rakuten_image_link), alt: `${c.brand} ${c.name}` }))
  .filter((t) => t.src && !seen.has(t.src) && seen.add(t.src))
  .slice(0, 4);
const duration = formatDuration(video.duration);
const pr = getPrInfo(video.key);
const short = isShort(video);
const thumb = ytThumb(video.thumbnail);
---

<a href={withBase(`/video/${video.key}`)} class="group block">
  <div class="overflow-hidden vcard-12">
    <img src={thumb.src} srcset={thumb.srcset} sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw" alt={video.title} class="vcard-4" loading="lazy" />
    <span class="vcard-2">▶ {formatCount(video.view_count)}</span>
    {pr && <PrBadge tone="solid" class="absolute top-2.5 left-2.5" />}
    {(duration || short) && <span class="vcard-3">{short ? `ショート${duration ? ` ${duration}` : ""}` : duration}</span>}
  </div>
  <div class="pt-3.5">
    <p class="vcard-6">
      {video.channel_icon && <img referrerpolicy="no-referrer" src={video.channel_icon} alt={video.channel_title} data-name={video.channel_title} width="20" height="20" class="vcard-10" loading="lazy" />}
      <span class="truncate">{video.channel_title}</span>
      <span class="vcard-8">{formatDateDot(video.published_at)}</span>
    </p>
    <h3 class="vcard-5">{video.title}</h3>
    {
      items.length > 0 && (
        <p class="vcard-9">
          {thumbs.map((t) => (
            <span class="product-well overflow-hidden vcard-11">
              <img src={t.src} alt={t.alt} class="u-4" loading="lazy" data-err="remove-parent" />
            </span>
          ))}
          <span class="u-10"><b class="num-display u-12">{items.length}</b>品を紹介</span>
        </p>
      )
    }
  </div>
</a>
