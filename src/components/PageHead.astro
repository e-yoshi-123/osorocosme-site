---
// 一覧系のページの見出し：英字の小見出し・題・説明・数字（任意）・右の補足（slot）
// 数字は「見出し（紹介動画）＋数字＋単位（本）」の組で出す。数字と単位だけを離して置くと、何の数か分かりにくかった（195章）
// スマホでは大きな数字の段が本文を押し下げるので、英字の小見出しの行の右端に小さく出す（204章）
interface Props { en: string; title: string; lead?: string; stats?: { n: string | number; label: string; unit?: string }[] }
const { en, title, lead, stats = [] } = Astro.props;
---
<header class="mb-6 md:mb-14 grid md:grid-cols-12 gap-6 md:gap-10 items-end">
  <div class="md:col-span-8">
    <div class="flex items-baseline justify-between gap-4">
      <p class="eyebrow">{en}</p>
      {stats.length > 0 && (
        <p class="md:hidden text-xs text-neutral-500 whitespace-nowrap">
          {stats.map((s, i) => <span class:list={[i > 0 && "ml-3"]}>{s.label} <span class="num-display text-sm text-ink">{s.n}</span>{s.unit}</span>)}
        </p>
      )}
    </div>
    <h1 class="mt-2 font-serif font-semibold h-page tracking-[-0.01em]">{title}</h1>
    {lead && <p class="mt-4 text-sm leading-[1.9] text-neutral-600 max-w-2xl">{lead}</p>}
    <slot />
  </div>
  {stats.length > 0 && (
    <dl class="hidden md:col-span-4 md:flex md:justify-end divide-x divide-ink/15">
      {stats.map((s) => (
        <div class="px-5 first:pl-0 last:pr-0 flex flex-col-reverse">
          <dd class="mt-1.5 num-display text-[26px] md:text-[30px] leading-none whitespace-nowrap">{s.n}{s.unit && <span class="font-sans font-normal text-xs ml-1 text-neutral-500">{s.unit}</span>}</dd>
          <dt class="text-xs text-neutral-500 whitespace-nowrap">{s.label}</dt>
        </div>
      ))}
    </dl>
  )}
</header>
