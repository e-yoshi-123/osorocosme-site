---
// パーソナルカラー・肌質のページのインフルエンサーのカード（312章）。アイコン・名前・本人が言ったパーソナルカラーと肌質の札・掲載動画の本数。
// 人のページへつなぐ。人数が多いときは先頭 initial 人だけ出し、残りは <details> で開く（スクリプトなしでも動く）
import ProfileChips from "./ProfileChips.astro";
import { withBase } from "../lib/data";

interface Props {
  people: { channel_id: string; channel_title: string; channel_icon?: string; videoCount: number }[];
  initial?: number;
}
const { people, initial = 12 } = Astro.props;
const head = people.slice(0, initial);
const rest = people.slice(initial);
---

{
  [head, rest].map((list, k) =>
    list.length === 0 ? null : k === 0 ? (
      <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
        {list.map((p) => (
          <li class="rounded-2xl border border-ink/10 bg-gradient-to-br from-white to-paper p-3 flex items-center gap-3">
            <a href={withBase(`/influencer/${p.channel_id}`)} class="shrink-0" tabindex="-1" aria-hidden="true">
              {p.channel_icon ? <img referrerpolicy="no-referrer" src={p.channel_icon} alt="" width="48" height="48" loading="lazy" class="w-12 h-12 rounded-full object-cover ring-2 ring-white" /> : <span class="block w-12 h-12 rounded-full bg-blush" />}
            </a>
            <span class="min-w-0 flex-1">
              <a href={withBase(`/influencer/${p.channel_id}`)} class="block truncate text-sm font-medium text-ink hover:text-rose">{p.channel_title}</a>
              <ProfileChips channel_id={p.channel_id} class="mt-1" />
              <span class="block mt-1 text-[11px] text-neutral-500">紹介動画 {p.videoCount}本</span>
            </span>
          </li>
        ))}
      </ul>
    ) : (
      <details class="mt-3 group">
        <summary class="cursor-pointer select-none text-xs text-neutral-600 hover:text-rose list-none inline-flex items-center gap-2"><span class="w-6 h-6 rounded-full border border-ink/20 inline-flex items-center justify-center group-open:rotate-180 transition-transform" aria-hidden="true">↓</span>残り{list.length}人を表示</summary>
        <ul class="mt-3 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
          {list.map((p) => (
            <li class="rounded-2xl border border-ink/10 bg-gradient-to-br from-white to-paper p-3 flex items-center gap-3">
              <a href={withBase(`/influencer/${p.channel_id}`)} class="shrink-0" tabindex="-1" aria-hidden="true">
                {p.channel_icon ? <img referrerpolicy="no-referrer" src={p.channel_icon} alt="" width="48" height="48" loading="lazy" class="w-12 h-12 rounded-full object-cover ring-2 ring-white" /> : <span class="block w-12 h-12 rounded-full bg-blush" />}
              </a>
              <span class="min-w-0 flex-1">
                <a href={withBase(`/influencer/${p.channel_id}`)} class="block truncate text-sm font-medium text-ink hover:text-rose">{p.channel_title}</a>
                <ProfileChips channel_id={p.channel_id} class="mt-1" />
                <span class="block mt-1 text-[11px] text-neutral-500">紹介動画 {p.videoCount}本</span>
              </span>
            </li>
          ))}
        </ul>
      </details>
    )
  )
}
