---
// メイクレシピのカード（284章で作り直し。283章の顔のイラストと引き出し線はやめた）。
// 動画のサムネイルの顔（lib/recipe-faces.json、Vision で探した位置）を真ん中に切り出し、まわりに使ったコスメの画像をぎっしり大きく並べる。
// 並びは部位の順（ベース→眉→アイ→チーク・陰影→リップ）に、左の下から時計回り（左＝ベース、上＝眉・アイ、右＝チーク、下＝リップのあたりに来る）
import { TASTES, recipeNo, PARTS, type Recipe } from "../lib/recipe";
import { formatCount, withBase } from "../lib/data";
import FACES from "../lib/recipe-faces.json";

interface Props {
  recipe: Recipe;
  /** 一覧の絞り込み用に data-tastes を付け、最初は隠す */
  hidden?: boolean;
  /** 大きく出す1枚（品名の札を付ける） */
  large?: boolean;
  class?: string;
}
const { recipe: r, hidden = false, large = false, class: cls } = Astro.props;
const tasteLabels = r.tastes.map((k) => TASTES.find((t) => t.key === k)!.label).slice(0, 3);

// 顔：サムネイル（16:9）から、顔が枠の約45%になる正方形を切り出す（画像は i.ytimg.com のものをそのまま読み、CSSで位置を合わせる）
const MAX_ITEMS = 16;
const items = r.steps.flatMap((s, i) => s.map((x) => ({ x, color: PARTS[i].color }))).filter((it) => it.x.img).slice(0, MAX_ITEMS);
const more = r.itemCount - items.length;
const N = items.length;
const F = N <= 6 ? 60 : N <= 10 ? 56 : 54; // 顔の枠の一辺（カードの%）
const B = (100 - F) / 2; // まわりの帯の幅
const face = (FACES as Record<string, [number, number, number, number, number, string]>)[r.video.video_id];
let faceImg = `https://i.ytimg.com/vi/${r.video.video_id}/hqdefault.jpg`;
let faceStyle = "inset:0;width:100%;height:100%;object-fit:cover";
if (face) {
  const [cx, cy, , fh, a, q] = face;
  faceImg = `https://i.ytimg.com/vi/${r.video.video_id}/${q === "maxres" ? "maxresdefault" : "mqdefault"}.jpg`;
  const S = Math.min(1, Math.max(0.32, fh / 0.5)); // 切り出す正方形の一辺（画像の高さを1とする）
  const x0 = Math.min(Math.max(cx * a - S / 2, 0), a - S);
  const y0 = Math.min(Math.max(cy - S * 0.46, 0), 1 - S); // 顔を少し上に（あごの下まで入れる）
  faceStyle = `height:${(100 / S).toFixed(2)}%;width:${((a * 100) / S).toFixed(2)}%;left:${(-(x0 / S) * 100).toFixed(2)}%;top:${(-(y0 / S) * 100).toFixed(2)}%`;
}

// まわりの帯の中心線（一辺 L の正方形）を、左の下の角から時計回りに N 等分して置く
const L = 100 - B;
const P = 4 * L;
const at = (t: number) => {
  const d = t * P;
  if (d < L) return { x: B / 2, y: 100 - B / 2 - d }; // 左（下→上）
  if (d < 2 * L) return { x: B / 2 + (d - L), y: B / 2 }; // 上（左→右）
  if (d < 3 * L) return { x: 100 - B / 2, y: B / 2 + (d - 2 * L) }; // 右（上→下）
  return { x: 100 - B / 2 - (d - 3 * L), y: 100 - B / 2 }; // 下（右→左）
};
// 商品の枠は帯の幅いっぱいまで（顔に大きくかからないように）。品数が多いときは隣と少し重なる
const size = Math.min(B * 0.9, (P / Math.max(N, 1)) * 1.08);
const placed = items.map((it, i) => {
  const { x, y } = at((i + 0.5) / N);
  const rot = ((i * 37) % 7) - 3; // -3〜3度、決まった値（ビルドごとに変わらない）
  const s = size * (i % 3 === 0 ? 1.04 : i % 3 === 1 ? 0.94 : 1);
  return { ...it, style: `left:${x.toFixed(2)}%;top:${y.toFixed(2)}%;width:${s.toFixed(2)}%;--r:${rot}deg;z-index:${(i % 2) + 1}` };
});
---

<a href={`${withBase(`/video/${r.key}`)}#cosmetics`} class:list={["rcard group", large && "is-large", cls]} data-tastes={r.tastes.join(" ")} hidden={hidden}>
  <div class="rcard-fig">
    <span class="rcard-face" style={`width:${F}%;left:${B}%;top:${B}%`}>
      <img src={faceImg} alt="" loading="lazy" referrerpolicy="no-referrer" style={faceStyle} data-err="hide" />
    </span>
    {placed.map((p) => (
      <span class="rcard-th" style={`${p.style};--c:${p.color}`} title={`${p.x.brand} ${p.x.name}`}>
        <img src={p.x.img} alt="" loading="lazy" data-err="hide" />
      </span>
    ))}
    {more > 0 && <span class="rcard-more num-display">+{more}</span>}
  </div>
  <div class="rcard-body">
    {tasteLabels.length > 0 && <p class="rcard-tastes">{tasteLabels.map((t) => <span>{t}</span>)}</p>}
    <h3 class="rcard-h phrase">{r.headline}<span>レシピ</span><small class="rcard-no num-display">{recipeNo(r.no)}</small></h3>
    <p class="rcard-v">{r.video.title}</p>
    <p class="rcard-m">
      <span><b class="num-display">{r.itemCount}</b>品</span>
      <span><b class="num-display">{r.stepCount}</b>ステップ</span>
      {r.pricedCount > 0 && <span>そろえて約<b class="num-display">¥{formatCount(r.total)}</b></span>}
    </p>
  </div>
</a>

<style is:global>
  .rcard { display: flex; flex-direction: column; min-width: 0; border-radius: 28px; background: var(--c-panel); box-shadow: var(--panel-shadow); overflow: hidden; transition: transform .6s var(--ease-out-expo), box-shadow .6s var(--ease-out-expo); }
  .rcard:hover { transform: translateY(-4px); box-shadow: 0 0 0 1px rgb(134 10 70 / .08), 0 30px 50px -36px rgb(134 10 70 / .45); }
  .rcard[hidden] { display: none; }
  .rcard-fig { position: relative; aspect-ratio: 1; overflow: hidden; background: radial-gradient(90% 90% at 50% 50%, #fff 0%, var(--c-well) 62%, var(--c-accent) 100%); }
  .rcard-face { position: absolute; aspect-ratio: 1; border-radius: 26%; overflow: hidden; background: var(--c-well); box-shadow: 0 0 0 4px #fff, 0 18px 36px -20px rgb(29 21 23 / .5); }
  .rcard-face img { position: absolute; max-width: none; }
  .rcard-th { position: absolute; aspect-ratio: 1; transform: translate(-50%, -50%) rotate(var(--r)); border-radius: 16%; background: #fff; box-shadow: 0 0 0 1px rgb(29 21 23 / .06), 0 8px 16px -10px rgb(29 21 23 / .4); display: flex; align-items: center; justify-content: center; transition: transform .6s var(--ease-out-expo); }
  .rcard:hover .rcard-th { transform: translate(-50%, -50%) rotate(0deg) scale(1.04); }
  .rcard-th img { width: 86%; height: 86%; object-fit: contain; }
  .rcard-fig .rcard-more { position: absolute; right: 12px; top: 12px; z-index: 3; padding: 0 .6em; border-radius: 999px; background: var(--color-ink); color: #fff; font-size: 12px; line-height: 1.8; }
  .rcard-no { margin-left: .6em; font-size: 11px; font-weight: 400; letter-spacing: .1em; color: var(--color-neutral-400); }
  .rcard-body { padding: 18px 22px 22px; display: flex; flex-direction: column; gap: 6px; flex: 1; }
  .rcard-tastes { display: flex; flex-wrap: wrap; gap: 6px; }
  .rcard-tastes span { font-size: 11px; line-height: 1.6; padding: 0 .6em; border-radius: 999px; background: var(--c-accent); color: color-mix(in srgb, var(--color-ink) 80%, transparent); }
  .rcard-h { font-size: 17px; font-weight: 700; line-height: 1.45; transition: color .3s; }
  .rcard-h span { margin-left: .25em; font-size: 12px; font-weight: 600; color: var(--color-rose); letter-spacing: .06em; }
  .rcard:hover .rcard-h { color: var(--color-rose); }
  .rcard-v { font-size: 12px; line-height: 1.6; color: var(--color-neutral-500); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .rcard-m { margin-top: auto; padding-top: 10px; display: flex; flex-wrap: wrap; gap: 4px 14px; font-size: 12px; color: var(--color-neutral-500); border-top: 1px solid color-mix(in srgb, var(--color-ink) 8%, transparent); }
  .rcard-m b { font-size: 15px; color: var(--color-ink); margin-right: 1px; }
</style>
