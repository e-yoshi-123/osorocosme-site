---
import { cosmeticSlug, withBase, extractImageSrc, getCosmeticListEntry } from "../lib/data";

interface Props {
  brand_id: string;
  brand: string;
  name_id: string;
  name: string;
  rakutenImageHtml?: string;
}

const { brand_id, brand, name_id, name, rakutenImageHtml } = Astro.props;
// 楽天の画像が無い商品は、Yahoo!ショッピングの画像があればそれを出す（115章）
const entry = extractImageSrc(rakutenImageHtml) ? undefined : getCosmeticListEntry(brand_id, name_id);
const yahooImage = entry?.yahoo_text_link && entry.yahoo_image_url ? entry : undefined;
---

<div class="bg-white rounded-lg shadow-sm p-3 flex flex-col gap-2">
  <div class="cosmetic-image-box aspect-square w-full bg-neutral-50 rounded flex items-center justify-center overflow-hidden">
    {
      rakutenImageHtml ? (
        <Fragment set:html={rakutenImageHtml} />
      ) : yahooImage ? (
        <a href={yahooImage.yahoo_text_link} target="_blank" rel="nofollow sponsored noopener">
          <img src={yahooImage.yahoo_image_url} alt={`${brand} ${name}`} loading="lazy" />
        </a>
      ) : (
        <span class="text-neutral-300 text-xs">No Image</span>
      )
    }
  </div>
  <a href={withBase(`/cosmetics/${cosmeticSlug(brand_id, name_id)}`)} class="text-sm hover:text-pink-600">
    <div class="text-neutral-500 text-xs">{brand}</div>
    <div class="font-medium line-clamp-2">{name}</div>
  </a>
</div>

<style>
  .cosmetic-image-box :global(a) {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
  }
  .cosmetic-image-box :global(img) {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 0.25rem;
  }
</style>
