---
import { cosmeticSlug, withBase, extractImageSrc, getCosmeticListEntry } from "../lib/data";

interface Props {
  brand_id: string;
  brand: string;
  name_id: string;
  name: string;
  rakutenImageHtml?: string;
  /** ブランド名の行を出すか（ブランドのページでは全部同じ名前になるので出さない） */
  showBrand?: boolean;
  /** 補足の1行（例: 「12本の動画で紹介」） */
  caption?: string;
}

const { brand_id, brand, name_id, name, rakutenImageHtml, showBrand = true, caption } = Astro.props;
// 楽天の画像が無い商品は、Yahoo!ショッピングの画像があればそれを出す（115章）。
// 楽天の画像はあっても読み込めない場合に備え、Yahoo!の画像を data-* に持たせる（Layout の共通の処理が差し替える。135章）
const entry = getCosmeticListEntry(brand_id, name_id);
const yahooEntry = entry?.yahoo_text_link && entry.yahoo_image_url ? entry : undefined;
const yahooImage = extractImageSrc(rakutenImageHtml) ? undefined : yahooEntry;
---

<div class="group flex flex-col">
  <div
    class="cosmetic-image-box product-well aspect-square w-full rounded-2xl flex items-center justify-center overflow-hidden"
    data-yahoo-image={rakutenImageHtml ? yahooEntry?.yahoo_image_url : undefined}
    data-yahoo-link={rakutenImageHtml ? yahooEntry?.yahoo_text_link : undefined}
  >
    {
      rakutenImageHtml ? (
        <Fragment set:html={rakutenImageHtml} />
      ) : yahooImage ? (
        <a href={yahooImage.yahoo_text_link} target="_blank" rel="nofollow sponsored noopener">
          <img src={yahooImage.yahoo_image_url} alt={`${brand} ${name}`} loading="lazy" />
        </a>
      ) : (
        <span class="noimg">No image</span>
      )
    }
  </div>
  <a href={withBase(`/cosmetics/${cosmeticSlug(brand_id, name_id)}`)} class="block pt-3">
    {showBrand && <div class="mb-1 text-xs tracking-[0.14em] uppercase text-neutral-500 truncate">{brand}</div>}
    <div class="phrase text-sm leading-snug line-clamp-2 group-hover:text-rose transition-colors">{name}</div>
    {caption && <div class="mt-1.5 text-xs text-neutral-500">{caption}</div>}
  </a>
</div>

<style>
  .cosmetic-image-box :global(a) {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
  }
  .cosmetic-image-box :global(img) {
    width: 78%;
    height: 78%;
    object-fit: contain;
    border-radius: 4px;
    transition: transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .group:hover .cosmetic-image-box :global(img) {
    transform: scale(1.06);
  }
</style>
