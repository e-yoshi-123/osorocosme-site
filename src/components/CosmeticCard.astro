---
import BrandFlag from "./BrandFlag.astro";
import { cosmeticSlug, withBase, parseRakutenImage, getCosmeticListEntry } from "../lib/data";
import PrBadge from "./PrBadge.astro";

interface Props {
  brand_id: string;
  brand: string;
  name_id: string;
  name: string;
  rakutenImageHtml?: string;
  /** ブランド名の行を出すか（ブランドのページでは全部同じ名前になるので出さない） */
  showBrand?: boolean;
  /** 補足の1行（例: 「12本の動画で紹介」） */
  caption?: string;
  /** PR・提供としての紹介なら、画像の左上に「PR」の印を重ねる（213章） */
  pr?: boolean;
  /** 本人のブランドの紹介（307章） */
  own?: boolean;
  /** カテゴリ（例: 「化粧下地」）。渡すとブランド名の上に出す（動画ページ。213章） */
  category?: string;
  /** カテゴリのランキングでの順位（ブランドのページ。322章）。画像の左上に札を重ねる。rankLabel は札の説明（例: 「化粧下地ランキング」） */
  rank?: number;
  rankLabel?: string;
  /** 札を押したときの行き先（ランキングのページのその商品の行） */
  rankHref?: string;
}

const { brand_id, brand, name_id, name, rakutenImageHtml, showBrand = true, caption, pr = false, own = false, category, rank, rankLabel, rankHref } = Astro.props;
// 楽天の画像が無い商品は、Yahoo!ショッピングの画像があればそれを出す（115章）。
// 楽天の画像はあっても読み込めない場合に備え、Yahoo!の画像を data-* に持たせる（Layout の共通の処理が差し替える。135章）
const entry = getCosmeticListEntry(brand_id, name_id);
const yahooEntry = entry?.yahoo_text_link && entry.yahoo_image_url ? entry : undefined;
// 楽天のHTMLはそのまま差し込まず、リンク先・画像・altだけ取り出して自前のタグで出す（276章）
const rakuten = parseRakutenImage(rakutenImageHtml);
const yahooImage = rakuten ? undefined : yahooEntry;
---

<div class="group card-5">
  <div
    class="cosmetic-image-box product-well overflow-hidden card-7"
    data-yahoo-image={rakuten ? yahooEntry?.yahoo_image_url : undefined}
    data-yahoo-link={rakuten ? yahooEntry?.yahoo_text_link : undefined}
  >
    {
      rakuten ? (
        <a href={rakuten.href} target="_blank" rel="nofollow sponsored noopener">
          <img src={rakuten.src} alt={rakuten.alt || `${brand} ${name}`} width="240" height="240" loading="lazy" />
        </a>
      ) : yahooImage ? (
        <a href={yahooImage.yahoo_text_link} target="_blank" rel="nofollow sponsored noopener">
          <img src={yahooImage.yahoo_image_url} alt={`${brand} ${name}`} width="240" height="240" loading="lazy" />
        </a>
      ) : (
        <span class="noimg">No image</span>
      )
    }
    {rank !== undefined && rank > 0 && (
      <a href={rankHref} class:list={["rank-tag num-display z-10 hover:opacity-80 transition-opacity", rank <= 3 ? "tile-r1" : "tile-r2", !rankHref && "pointer-events-none"]} title={`${rankLabel ?? "ランキング"} ${rank}位`} aria-label={`${rankLabel ?? "ランキング"} ${rank}位`}>
        {rank}<span class="ml-0.5 font-sans text-[10px] font-normal">位</span>
      </a>
    )}
    {pr && <PrBadge tone="solid" own={own} class="absolute top-2 left-2 pointer-events-none" />}
  </div>
  <a href={withBase(`/cosmetics/${cosmeticSlug(brand_id, name_id)}`)} class="card-6">
    {category && <div class="mb-1.5"><span class="card-3">{category}</span></div>}
    {showBrand && <div class="card-4"><BrandFlag brand_id={brand_id} />{brand}</div>}
    <div class="phrase card-2">{name}</div>
    {caption && <div class="u-2">{caption}</div>}
  </a>
</div>

<style>
  /* 画像のリンクだけを枠いっぱいに（順位の札〈rank-tag〉は左上の小さな札のまま。322章） */
  .cosmetic-image-box :global(a:not(.rank-tag)) {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
  }
  .cosmetic-image-box :global(img) {
    width: 78%;
    height: 78%;
    object-fit: contain;
    border-radius: 4px;
    transition: transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .group:hover .cosmetic-image-box :global(img) {
    transform: scale(1.06);
  }
</style>
