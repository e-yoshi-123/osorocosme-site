---
import Layout from "../layouts/Layout.astro";
interface Props { title: string; description: string; }
const { title, description } = Astro.props;
---
<Layout title={title} description={description}>
  <article class="max-w-[760px] mx-auto pt-4 md:pt-10">
    <p class="eyebrow">OsoroCosme</p>
    <h1 class="mt-3 font-serif font-semibold text-[24px] md:text-[30px] leading-[1.25] tracking-[-0.02em] pb-8 border-b border-ink/15">{title}</h1>
    <div class="mt-10 text-[15px] leading-[2] text-neutral-700 space-y-5 [&_h2]:font-serif [&_h2]:text-[20px] [&_h2]:md:text-[22px] [&_h2]:font-semibold [&_h2]:tracking-[-0.02em] [&_h2]:text-ink [&_h2]:mt-14 [&_h2]:pt-6 [&_h2]:border-t [&_h2]:border-ink/10 [&_ul]:list-none [&_ul]:pl-0 [&_ul]:space-y-2 [&_li]:relative [&_li]:pl-5 [&_li]:before:content-[''] [&_li]:before:absolute [&_li]:before:left-0 [&_li]:before:top-[0.95em] [&_li]:before:w-2 [&_li]:before:h-px [&_li]:before:bg-rose [&_a]:text-ink [&_a]:underline [&_a]:decoration-rose [&_a]:underline-offset-4">
      <slot />
    </div>
  </article>
</Layout>
