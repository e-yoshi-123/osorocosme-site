---
// スマホ・タブレット（lg未満）のメニュー。右上の☰で、ヘッダーの下に画面いっぱいで出す（248章）。
// 上に主な一覧（ランキング・インフルエンサー・ブランド・動画）、下に探し方（カテゴリ・肌悩み・成分・特集）を折りたたみで並べる。
// 探し方のリンクはパソコンの「探す」の領域（MegaMenu）と同じなので、HTMLには1回だけ入れ（MegaMenu側）、
// こちらは初めて開くときにMegaMenuのリンクから組み立てる。全ページに2回ずつ入っていて、サイト全体で約75MBあった（280章）
interface Props { links: { href: string; label: string; en: string }[] }
const { links } = Astro.props;
import { withBase } from "../lib/data";
---

<div id="mobile-menu" data-menu data-lock hidden class="mmenu-6">
  <nav class="mmenu-10" aria-label="メニュー">
    <ul class="mmenu-11">
      {links.map((l) => (
        <li>
          <a href={withBase(l.href)} class="mmenu-c">
            <span class="label-caps mmenu-13">{l.en}</span>
            <span class="mmenu-9">{l.label}</span>
          </a>
        </li>
      ))}
    </ul>
    <div data-mmenu-sections></div>
  </nav>
</div>

<script>
  // MegaMenu（#mega-menu）のリンクから、折りたたみの節を組み立てる（280章）
  const box = document.querySelector<HTMLElement>("#mobile-menu [data-mmenu-sections]");
  const mega = document.getElementById("mega-menu");
  const el = <K extends keyof HTMLElementTagNameMap>(tag: K, cls = "", text = "") => {
    const e = document.createElement(tag);
    if (cls) e.className = cls;
    if (text) e.textContent = text;
    return e;
  };
  const link = (a: HTMLAnchorElement, cls: string, text = a.textContent || "") => {
    const x = el("a", cls, text);
    x.href = a.getAttribute("href")!;
    return x;
  };
  const section = (title: string) => {
    const d = el("details", "group mmenu-7");
    d.open = true;
    const s = el("summary", "mmenu-2");
    s.append(el("span", "font-medium", title));
    const mark = el("span", "text-neutral-500 mmenu-12", "⌄");
    mark.setAttribute("aria-hidden", "true");
    s.append(mark);
    d.append(s);
    return d;
  };
  const build = () => {
    if (!box || !mega || box.childElementCount > 0) return;
    // カテゴリ：グループごとに見出しとリンク
    const cat = mega.querySelector<HTMLElement>("section[aria-labelledby]");
    if (cat) {
      const d = section(cat.querySelector(".label-caps")?.textContent || "カテゴリから探す");
      const body = el("div", "pb-4 space-y-3");
      cat.querySelectorAll<HTMLElement>(".mega-6 > div").forEach((g) => {
        const wrap = el("div");
        wrap.append(el("p", "text-neutral-500 u-24", g.querySelector("p")?.textContent || ""));
        const p = el("p", "u-6");
        g.querySelectorAll<HTMLAnchorElement>("ul a").forEach((a) => p.append(link(a, "mmenu-1")));
        wrap.append(p);
        body.append(wrap);
      });
      const all = cat.querySelector<HTMLAnchorElement>(".mega-4");
      if (all) body.append(link(all, "inline-block text-xs text-rose"));
      d.append(body);
      box.append(d);
    }
    // 肌悩み・パーソナルカラー・成分・特集：見出し（.mega-1）ごとに節を作る（肌悩みの列の下にパーソナルカラーが続くため。309章）
    mega.querySelectorAll<HTMLElement>("section:not([aria-labelledby]) .mega-1").forEach((head) => {
      const d = section(head.querySelector(".label-caps")?.textContent || "");
      const body = el("div", "pb-4");
      const p = el("p", "u-6");
      const ul = head.nextElementSibling;
      ul?.querySelectorAll<HTMLAnchorElement>("a").forEach((a) => p.append(link(a, "mmenu-1")));
      body.append(p);
      // 自己診断のボタン（316章）
      const chk = ul?.nextElementSibling;
      if (chk?.classList.contains("mega-check")) body.append(chk.cloneNode(true));
      const all = head.querySelector<HTMLAnchorElement>(".u-9");
      if (all) body.append(link(all, "text-rose mmenu-14"));
      d.append(body);
      box.append(d);
    });
  };
  document.querySelector('[data-menu-toggle][aria-controls="mobile-menu"]')?.addEventListener("click", build);
</script>
