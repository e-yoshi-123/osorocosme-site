---
// スマホ・タブレット（lg未満）のメニュー。右上の☰で、ヘッダーの下に画面いっぱいで出す（248章）。
// 上に主な一覧（ランキング・インフルエンサー・ブランド・動画）、下に探し方（カテゴリ・肌悩み・成分・特集）を折りたたみで並べる。
import { getMenuData, withBase } from "../lib/data";

interface Props { links: { href: string; label: string; en: string }[] }
const { links } = Astro.props;
const m = getMenuData();
const sections = [
  { title: "肌悩みから探す", all: "/concern/", items: m.concerns },
  { title: "成分から探す", all: "/ingredient/", items: m.ingredients },
  { title: "特集", all: "/feature/", items: m.features },
].filter((s) => s.items.length > 0);
---

<div id="mobile-menu" data-menu data-lock hidden class="mmenu-6">
  <nav class="mmenu-10" aria-label="メニュー">
    <ul class="mmenu-11">
      {links.map((l) => (
        <li>
          <a href={withBase(l.href)} class="bg-white block rounded-2xl ring-1 ring-ink/10 px-4 py-3">
            <span class="label-caps text-rose mmenu-13">{l.en}</span>
            <span class="mmenu-9">{l.label}</span>
          </a>
        </li>
      ))}
    </ul>
    <details class="group mmenu-7" open>
      <summary class="mmenu-2">
        <span class="font-medium">カテゴリから探す</span><span class="text-neutral-400 mmenu-12" aria-hidden="true">⌄</span>
      </summary>
      <div class="pb-4 space-y-3">
        {m.categories.map((g) => (
          <div>
            <p class="text-neutral-400 u-24">{g.group}</p>
            <p class="u-6">
              {g.items.map((it) => <a href={withBase(it.path)} class="mmenu-1">{it.label}</a>)}
            </p>
          </div>
        ))}
        <a href={withBase("/ranking/")} class="inline-block text-xs text-rose">すべてのカテゴリ →</a>
      </div>
    </details>
    {sections.map((s) => (
      <details class="group mmenu-7" open>
        <summary class="mmenu-2">
          <span class="font-medium">{s.title}</span><span class="text-neutral-400 mmenu-12" aria-hidden="true">⌄</span>
        </summary>
        <div class="pb-4">
          <p class="u-6">
            {s.items.map((it) => <a href={withBase(it.path)} class="mmenu-1">{it.label}</a>)}
          </p>
          <a href={withBase(s.all)} class="text-rose mmenu-14">一覧 →</a>
        </div>
      </details>
    ))}
  </nav>
</div>
